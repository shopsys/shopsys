    "conflict": {
        "symfony/symfony": "*",
        "guzzlehttp/psr7": "<=1.8.3 || >=2.0.0 <=2.1.0"
    },
    "scripts": {
        "pre-install-cmd": [
            "./check-composer-json.sh"
        ],
        "pre-update-cmd": [
            "./check-composer-json.sh"
        ],
        "post-install-cmd": [
            "App\\Environment::checkEnvironment",
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "App\\Environment::checkEnvironment",
            "@auto-scripts",
            "@security-check"
        ],
        "post-create-project-cmd": [
            "php app/scripts/downloadShopsysCli.php",
            "php app/shopsys.phar configure ."
        ],
        "auto-scripts": {
            "php app/downloadPhing.php --phing-version=3.0.0": "script",
            "php phing clean": "script",
            "shopsys:domains-urls:configure": "symfony-cmd",
            "ckeditor:install --clear=skip --release=full --tag=4.22.1": "symfony-cmd"
        },
        "security-check": "security-checker security:check"
    },
    "config": {
        "process-timeout": 1200,
        "preferred-install": "dist",
        "component-dir": "web/components",
        "sort-packages": true,
        "platform": {
            "php": "8.5.0"
        },
        "allow-plugins": {
            "cweagans/composer-patches": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "ocramius/package-versions": true,
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        }
    },
    "extra": {
        "bin-dir": "bin",
        "config-dir": "config",
        "src-dir": "src",
        "var-dir": "var",
        "public-dir": "web",
        "patches": {
            "enlightn/security-checker": {
                "Use Application::addCommand() because Application::add() was removed in Symfony 8": "patch/enlightn-security-checker-symfony8.patch"
            },
            "jms/translation-bundle": {
                "Load DI config via PHP files because Symfony 8 removed the XML configuration format": "patch/jms-translation-symfony8-php-config.patch"
            },
            "overblog/graphiql-bundle": {
                "Load DI config via PHP files because Symfony 8 removed the XML configuration format": "patch/overblog-graphiql-symfony8-php-config.patch"
            },
            "overblog/graphql-bundle": {
                "Remove kernel.reset tag from Executor to prevent schema clearing": "patch/overblog-executor-reset.patch",
                "Use customerValidators translation domain in InputValidator": "patch/overblog-validator.patch"
            },
            "prezent/doctrine-translatable-bundle": {
                "Load DI config via PHP files because Symfony 8 removed the XML configuration format": "patch/prezent-translatable-symfony8-php-config.patch"
            }
        },
        "symfony": {
            "allow-contrib": true,
            "require": "^8.1",
            "docker": false
        }
    },
