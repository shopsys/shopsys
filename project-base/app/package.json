{
    "name": "project-base",
    "private": true,
    "scripts": {
        "dev-server": "encore dev-server",
        "dev": "encore dev",
        "watch": "encore dev --watch",
        "build": "encore production --progress",
        "prettier-check": "prettier --config ./.prettierrc.json --check",
        "prettier-fix": "prettier --config ./.prettierrc.json --write",
        "copy-assets": "node ./assets/js/bin/copyAssets.js",
        "trans": "node ./assets/js/bin/trans.js",
        "trans:dump": "node ./assets/js/bin/transDump.js",
        "tests": "npm run tests:unit",
        "tests:unit": "jest assets",
        "format-graphql": "LANG=en_US.UTF-8 format-graphql --write schema.graphql",
        "standards-check": "biome check ./assets",
        "standards-fix": "biome check --fix --unsafe ./assets",
        "stylelint": "stylelint --color assets/styles",
        "stylelint-fix": "stylelint --color --fix assets/styles"
    },
    "preferGlobal": false,
    "devDependencies": {
        "@babel/core": "^7.29.0",
        "@babel/parser": "^7.29.0",
        "@babel/plugin-proposal-object-rest-spread": "^7.20.7",
        "@babel/preset-env": "^7.29.0",
        "@babel/traverse": "^7.29.0",
        "@biomejs/biome": "^2.4.7",
        "@shopsys/biome-config": "file:vendor/shopsys/biome-config",
        "@symfony/webpack-encore": "^6.0.0",
        "autoprefixer": "^10.4.27",
        "babel-jest": "^30.3.0",
        "copy-webpack-plugin": "^14.0.0",
        "core-js": "^3.48.0",
        "es6-promise": "^4.2.8",
        "format-graphql": "^1.5.0",
        "glob": "^13.0.6",
        "jest": "^30.3.0",
        "js-yaml": "^4.1.1",
        "ncp": "^2.0.0",
        "pofile": "^1.1.4",
        "postcss-loader": "^8.2.1",
        "prettier": "^3.8.1",
        "regenerator-runtime": "^0.14.1",
        "require-context": "^1.1.0",
        "sass": "^1.98.0",
        "sass-loader": "^16.0.7",
        "stylelint": "^17.4.0",
        "stylelint-webpack-plugin": "^5.1.0",
        "webpack-livereload-plugin": "^3.0.2",
        "webpack-notifier": "^1.15.0"
    },
    "dependencies": {
        "@shopsys/framework": "file:vendor/shopsys/framework/assets",
        "@shopsys/administration": "file:vendor/shopsys/administration/assets",
        "@yaireo/tagify": "^4.25.1",
        "bazinga-translator": "^2.6.6",
        "buffer": "^6.0.3",
        "grapesjs": "^0.20.3",
        "grapesjs-plugin-ckeditor": "^1.0.1",
        "grapesjs-preset-newsletter": "^1.0.2",
        "grapesjs-preset-webpage": "^1.0.3",
        "jquery-hoverintent": "^1.10.1",
        "jquery.cookie": "^1.4.1",
        "juice": "^11.0.0",
        "select2": "^4.0.12",
        "sortablejs": "^1.15.6"
    },
    "jest": {
        "testEnvironment": "jsdom"
    }
}
