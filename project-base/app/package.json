{
    "name": "project-base",
    "private": true,
    "scripts": {
        "dev-server": "rsbuild dev",
        "dev": "NODE_ENV=development rsbuild build",
        "watch": "NODE_ENV=development rsbuild build --watch",
        "build": "rsbuild build",
        "prettier-check": "prettier --config ./.prettierrc.json --check",
        "prettier-fix": "prettier --config ./.prettierrc.json --write",
        "copy-assets": "node ./assets/js/bin/copyAssets.js",
        "trans": "node ./assets/js/bin/trans.js",
        "trans:dump": "node ./assets/js/bin/transDump.js",
        "tests": "npm run tests:unit",
        "tests:unit": "jest assets",
        "format-graphql": "LANG=en_US.UTF-8 format-graphql --write schema.graphql",
        "standards-check": "biome check ./assets",
        "standards-fix": "biome check --fix --unsafe ./assets",
        "stylelint": "stylelint --color assets/styles",
        "stylelint-fix": "stylelint --color --fix assets/styles"
    },
    "preferGlobal": false,
    "devDependencies": {
        "@babel/core": "^7.14.3",
        "@babel/parser": "^7.14.4",
        "@babel/preset-env": "^7.14.4",
        "@babel/traverse": "^7.14.2",
        "@biomejs/biome": "^2.2.0",
        "@hotwired/stimulus": "^3.0.0",
        "@hotwired/stimulus-webpack-helpers": "^1.0.1",
        "@rsbuild/core": "^2.2.1",
        "@rsbuild/plugin-sass": "^2.0.1",
        "@shopsys/biome-config": "file:vendor/shopsys/biome-config",
        "@symfony/reprise": "^1.1.0",
        "@symfony/ux-live-component": "^3.0.0",
        "autoprefixer": "^10.2.6",
        "babel-jest": "^30.4.1",
        "format-graphql": "^1.5.0",
        "glob": "^13.0.6",
        "jest": "^30.4.2",
        "jest-environment-jsdom": "^30.4.1",
        "js-yaml": "^4.1.1",
        "license-checker": "^25.0.1",
        "ncp": "^2.0.0",
        "pofile": "^1.1.1",
        "postcss-scss": "^4.0.9",
        "prettier": "^3.4.1",
        "stylelint": "^17.11.0"
    },
    "dependencies": {
        "@shopsys/administration": "file:vendor/shopsys/administration/assets",
        "@shopsys/mcp": "file:vendor/shopsys/mcp/assets",
        "@shopsys/framework": "file:vendor/shopsys/framework/assets",
        "@yaireo/tagify": "^4.25.1",
        "bazinga-translator": "^8.0.0",
        "buffer": "^6.0.3",
        "grapesjs": "^0.22.16",
        "grapesjs-plugin-ckeditor": "^1.0.1",
        "grapesjs-preset-newsletter": "^1.0.2",
        "grapesjs-preset-webpage": "^1.0.3",
        "intl-messageformat": "^11.2.5",
        "juice": "^11.0.0",
        "sortablejs": "^1.15.6"
    },
    "jest": {
        "testEnvironment": "jsdom"
    }
}
