<table role="presentation" width="100%" border="0" cellspacing="0" cellpadding="0">
    <tr>
        <td bgcolor="#f2f2f2" style="padding:20px; background-color:#f2f2f2; font-family:Arial, Helvetica, sans-serif; font-size:16px; line-height:1.3; color:#000000;">
            <div style="padding:0 0 10px 0; font-size:20px; font-weight:bold;">
                {% if data.url %}
                    <a href="{{ data.url }}" style="color:#000000; text-decoration:underline;">{{ data.headline }}</a>
                {% else %}
                    {{ data.headline }}
                {% endif %}
            </div>
            <div>{{ data.text|raw }}</div>
        </td>
    </tr>
</table>
