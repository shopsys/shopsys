# Dead code detection exemptions: intentional downstream api surface and members kept for hidden callers.
# Api classes whose whole public surface is downstream contract are exempt per file; individual members
# are exempt by exact message. Every entry must match a currently reported error (reportUnmatched stays
# at the default true), so entries whose members come alive again must be removed.

parameters:
    ignoreErrors:
        # whole api classes
        -
            identifier: shipmonk.deadMethod
            path: tests/FrontendApiBundle/Test/GraphQlTestCase.php
        # individual members
        -
            identifier: shipmonk.deadMethod
            message: '#^Unused\ App\\Component\\DataBridge\\BridgeConfig::getBaseUri$#'
            path: src/Component/DataBridge/BridgeConfig.php
        # called from config/shopsys-routing/routing_friendly_url.php
        -
            identifier: shipmonk.deadMethod
            message: '#^Unused\ App\\Component\\FriendlyUrl\\FriendlyUrlRouteEnum::getOptionsForCase$#'
            path: src/Component/FriendlyUrl/FriendlyUrlRouteEnum.php
        # dispatched by name via loadRoutesForConfiguration
        -
            identifier: shipmonk.deadMethod
            message: '#^Unused\ App\\Kernel::configureRoutesApp$#'
            path: src/Kernel.php
        # dispatched by name via loadRoutesForConfiguration
        -
            identifier: shipmonk.deadMethod
            message: '#^Unused\ App\\Kernel::configureRoutesAdministration$#'
            path: src/Kernel.php
        # test entity read only through its Doctrine metadata, the constructor keeps the embeddables written;
        # unmatched in the monorepo, where dynamic "new $className()" calls in the analysed packages mark every constructor as used
        -
            identifier: shipmonk.deadMethod
            message: '#^Unused\ Tests\\App\\Functional\\Component\\Database\\Schema\\Model\\QueryableEntity::__construct$#'
            path: tests/App/Functional/Component/Database/Schema/Model/QueryableEntity.php
            reportUnmatched: false
