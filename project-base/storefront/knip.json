{
    "$schema": "https://unpkg.com/knip@5/schema.json",
    "ignoreIssues": {
        "**/*.generated.tsx": ["exports", "types"]
    },
    "project": ["**/*.{ts,tsx}"],
    "ignore": ["cypress/**", "graphql/types.ts", "vitest/biome/fixtures/**"],
    "ignoreDependencies": ["license-checker", "tailwindcss"],
    "next": true,
    "vitest": {
        "entry": ["vitest/**/*.test.{ts,tsx}", "vitest/setup.ts"],
        "config": ["vitest.config.js"]
    },
    "postcss": true,
    "graphql-codegen": {
        "config": ["codegen-config.ts"]
    }
}
