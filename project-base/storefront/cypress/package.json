{
    "name": "cypress-tests-shopsys-platform-storefront",
    "version": "0.1.0",
    "description": "Acceptance tests of Shopsys Platform Storefront",
    "private": true,
    "scripts": {
        "typecheck": "tsc --pretty --noEmit --project tsconfig.json",
        "open-base": "cypress open --expose visualRegressionType=base",
        "open-regression": "cypress open --expose visualRegressionType=regression",
        "base": "cypress run --expose visualRegressionType=base",
        "regression": "cypress run --expose visualRegressionType=regression",
        "specific-base": "cypress run --expose visualRegressionType=base --spec",
        "specific-regression": "cypress run --expose visualRegressionType=regression --spec",
        "selected-regression": "./runSelectedTests.js visualRegressionType=regression",
        "selected-base": "./runSelectedTests.js visualRegressionType=base",
        "generate-snapshots-table": "./generateSnapshotsInfoTable.js",
        "smoke": "cypress run --spec ./smokeTests/smokeTests.cy.ts"
    },
    "devDependencies": {
        "cypress": "16.1.1",
        "cypress-real-events": "1.15.1",
        "cypress-visual-regression": "6.0.1",
        "glob": "^13.0.6",
        "inquirer": "^14.2.3",
        "typescript": "~5.9.3",
        "uuid": "^14.0.2"
    }
}
