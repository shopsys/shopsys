{
    "name": "shopsys-storefront",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "analyze": "ANALYZE=true next build",
        "build": "next build",
        "check": "concurrently \"pnpm run typecheck\" \"pnpm run lint\"",
        "check--fix": "concurrently \"pnpm run typecheck\" \"pnpm run lint--fix\"",
        "compile-tailwind-for-admin": "tailwindcss -i styles/globals.css -o ./public/tailwind-for-admin/style.css --minify",
        "dev": "NODE_OPTIONS='--inspect=0.0.0.0:9229' next dev",
        "format": "prettier --config ./prettier.config.js --write '**/*.{js,ts,tsx,json}'",
        "format-check": "prettier --config ./prettier.config.js --check '**/*.{js,ts,tsx,json}'",
        "gql": "pnpm run gql:docs && pnpm run gql:codegen && node schema-compress.js",
        "gql:codegen": "graphql-code-generator --config codegen-config.ts",
        "gql:docs": "graphql-markdown schema.graphql > graphql/docs/schema.md",
        "lint": "pnpm run format-check && eslint '**/*.{js,ts,tsx,json}'",
        "lint--fix": "pnpm run format && eslint '**/*.{js,ts,tsx,json}' --fix",
        "start": "next start",
        "translate": "i18next --config config/i18next-parser.config.js",
        "typecheck": "tsc --pretty --noEmit --project tsconfig.json",
        "test": "vitest",
        "test--update": "vitest -u",
        "test--no-watch": "vitest run",
        "knip": "knip"
    },
    "dependencies": {
        "@hookform/resolvers": "~2.6.1",
        "@next/bundle-analyzer": "~15.5.9",
        "@sentry/nextjs": "~10.40.0",
        "@urql/devtools": "~2.0.3",
        "@urql/exchange-auth": "~2.2.1",
        "@urql/exchange-graphcache": "~7.2.4",
        "cookies-next": "~4.3.0",
        "framer-motion": "^11.18.2",
        "google-map-react": "^2.2.5",
        "graphql": "~16.12.0",
        "graphql-tag": "~2.12.6",
        "js-base64": "~3.7.8",
        "jwt-decode": "~4.0.0",
        "lz-string": "~1.5.0",
        "next": "~15.5.12",
        "next-translate": "~2.6.2",
        "next-translate-plugin": "~2.6.2",
        "next-urql": "~5.0.2",
        "nprogress": "~0.2.0",
        "react": "~19.2.4",
        "react-dom": "~19.2.4",
        "react-dropzone": "^14.4.1",
        "react-hook-form": "~7.71.1",
        "react-infinite-scroll-component": "~6.1.1",
        "react-remove-scroll": "^2.7.2",
        "react-swipeable": "~7.0.2",
        "react-toastify": "~10.0.6",
        "redis": "~4.7.1",
        "supercluster": "^8.0.1",
        "tailwind-merge": "~3.4.0",
        "urql": "~5.0.1",
        "use-supercluster": "^1.2.0",
        "uuid": "~9.0.1",
        "wonka": "~6.3.5",
        "yup": "~1.7.1",
        "zustand": "~4.4.7"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.3",
        "@eslint/js": "^9.39.2",
        "@graphql-codegen/add": "^6.0.0",
        "@graphql-codegen/cli": "~5.0.7",
        "@graphql-codegen/introspection": "~4.0.3",
        "@graphql-codegen/near-operation-file-preset": "^3.1.0",
        "@graphql-codegen/typescript": "^5.0.7",
        "@graphql-codegen/typescript-operations": "~4.0.1",
        "@graphql-codegen/typescript-urql": "~4.0.1",
        "@mswjs/interceptors": "0.41.3",
        "@tailwindcss/cli": "^4.1.18",
        "@tailwindcss/postcss": "~4.2.2",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "~16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@trivago/prettier-plugin-sort-imports": "~4.3.0",
        "@types/google-map-react": "^2.1.10",
        "@types/node": "~20.11.30",
        "@types/nprogress": "~0.2.3",
        "@types/react": "~19.2.13",
        "@types/react-dom": "~19.2.3",
        "@types/supercluster": "^7.1.3",
        "@types/uuid": "~9.0.8",
        "@typescript-eslint/eslint-plugin": "~8.55.0",
        "@typescript-eslint/parser": "~8.55.0",
        "@urql/introspection": "^1.2.1",
        "@vitejs/plugin-react": "4.2.1",
        "babel-plugin-react-compiler": "1.0.0",
        "concurrently": "~8.2.2",
        "eslint": "~9.22.0",
        "eslint-config-prettier": "~9.1.2",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-no-relative-import-paths": "~1.6.1",
        "eslint-plugin-react": "~7.37.5",
        "eslint-plugin-react-hooks": "~7.0.1",
        "eslint-plugin-unused-imports": "~4.4.1",
        "globals": "^16.5.0",
        "graphql-markdown": "~7.3.0",
        "i18next-parser": "~9.3.0",
        "jsdom": "~24.0.0",
        "knip": "^5.83.1",
        "license-checker": "^25.0.1",
        "postcss": "~8.5.6",
        "prettier": "~3.8.1",
        "prettier-plugin-tailwindcss": "~0.6.14",
        "tailwindcss": "~4.1.18",
        "typescript": "~5.9.3",
        "vite-tsconfig-paths": "~4.3.2",
        "vitest": "~2.1.9"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "esbuild",
            "next-translate-plugin",
            "sharp"
        ],
        "ignoredOptionalDependencies": [
            "@sentry/cli-darwin",
            "@sentry/cli-linux-arm",
            "@sentry/cli-linux-arm64",
            "@sentry/cli-linux-i686",
            "@sentry/cli-linux-x64",
            "@sentry/cli-win32-arm64",
            "@sentry/cli-win32-i686",
            "@sentry/cli-win32-x64"
        ],
        "overrides": {
            "@urql/core": "6.0.1",
            "esbuild": "0.27.2",
            "vite": "5.4.21",
            "brace-expansion@>=1.0.0 <=1.1.11": "1.1.12",
            "brace-expansion@>=2.0.0 <=2.0.1": "1.1.12",
            "form-data@>=4.0.0 <4.0.4": ">=4.0.4",
            "@eslint/plugin-kit@<0.3.4": ">=0.3.4",
            "tmp@<=0.2.3": ">=0.2.4",
            "minimatch@<3.1.3": "3.1.3",
            "minimatch@>=8.0.0 <8.0.5": "8.0.5",
            "minimatch@>=9.0.0 <9.0.6": "9.0.6"
        }
    },
    "packageManager": "pnpm@10.30.3+sha512.c961d1e0a2d8e354ecaa5166b822516668b7f44cb5bd95122d590dd81922f606f5473b6d23ec4a5be05e7fcd18e8488d47d978bbe981872f1145d06e9a740017"
}
