{
    "name": "shopsys-storefront",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "analyze": "ANALYZE=true next build",
        "build": "next build",
        "check": "concurrently \"pnpm run typecheck\" \"pnpm run lint\"",
        "check--fix": "concurrently \"pnpm run typecheck\" \"pnpm run lint--fix\"",
        "compile-tailwind-for-admin": "tailwindcss -i styles/globals.css -o ./public/tailwind-for-admin/style.css --minify",
        "dev": "next dev",
        "dev:debug": "NODE_OPTIONS='--inspect=0.0.0.0:9229' next dev",
        "format": "biome format --write .",
        "format-check": "biome format .",
        "gql": "pnpm run gql:docs && pnpm run gql:codegen && node schema-compress.js",
        "gql:codegen": "graphql-code-generator --config codegen-config.ts",
        "gql:docs": "graphql-markdown schema.graphql > graphql/docs/schema.md",
        "lint": "biome check .",
        "lint--fix": "biome check --write .",
        "lint--fix-unsafe": "biome check --write --unsafe .",
        "start": "next start",
        "translate": "i18next --config config/i18next-parser.config.js",
        "typecheck": "tsc --pretty --noEmit --project tsconfig.json",
        "test": "vitest",
        "test--update": "vitest -u",
        "test--no-watch": "vitest run",
        "knip": "knip"
    },
    "dependencies": {
        "@hookform/resolvers": "~5.4.0",
        "@next/bundle-analyzer": "~15.5.18",
        "@radix-ui/react-popover": "^1.1.15",
        "@radix-ui/react-tooltip": "^1.2.16",
        "@sentry/nextjs": "~10.58.0",
        "@urql/devtools": "~2.0.3",
        "@urql/exchange-auth": "~2.2.1",
        "@urql/exchange-graphcache": "~7.2.4",
        "cookies-next": "~4.3.0",
        "framer-motion": "^12.40.0",
        "google-map-react": "^2.2.5",
        "graphql": "~16.14.0",
        "graphql-tag": "~2.12.6",
        "js-base64": "~3.7.8",
        "jwt-decode": "~4.0.0",
        "lz-string": "~1.5.0",
        "next": "~15.5.21",
        "next-translate": "~3.1.3",
        "next-translate-plugin": "~3.1.3",
        "next-urql": "~5.0.2",
        "nprogress": "~0.2.0",
        "react": "~19.2.7",
        "react-day-picker": "^10.0.1",
        "react-dom": "~19.2.7",
        "react-dropzone": "^15.0.0",
        "react-hook-form": "~7.81.0",
        "react-infinite-scroll-component": "~7.2.1",
        "react-remove-scroll": "^2.7.2",
        "react-swipeable": "~7.0.2",
        "react-toastify": "~11.1.0",
        "redis": "~4.7.1",
        "supercluster": "^8.0.1",
        "tailwind-merge": "~3.6.0",
        "urql": "5.0.2",
        "use-supercluster": "^1.2.0",
        "uuid": "~14.0.0",
        "wonka": "~6.3.6",
        "yup": "~1.7.1",
        "zustand": "~4.4.7"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.0",
        "@graphql-codegen/add": "^7.0.1",
        "@graphql-codegen/cli": "~7.1.3",
        "@graphql-codegen/introspection": "~6.0.1",
        "@graphql-codegen/near-operation-file-preset": "^5.2.1",
        "@graphql-codegen/typescript": "^6.0.2",
        "@graphql-codegen/typescript-operations": "~6.0.4",
        "@graphql-codegen/typescript-urql": "~5.0.1",
        "@mswjs/interceptors": "0.41.9",
        "@tailwindcss/cli": "^4.3.1",
        "@tailwindcss/postcss": "~4.3.1",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "~16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@types/google-map-react": "^2.1.10",
        "@types/node": "~20.19.39",
        "@types/nprogress": "~0.2.3",
        "@types/react": "~19.2.17",
        "@types/react-dom": "~19.2.3",
        "@types/supercluster": "^7.1.3",
        "@urql/introspection": "^1.2.1",
        "@vitejs/plugin-react": "5.1.1",
        "babel-plugin-react-compiler": "1.0.0",
        "concurrently": "~10.0.3",
        "graphql-markdown": "~7.3.0",
        "i18next-parser": "~9.4.0",
        "jsdom": "~29.1.1",
        "knip": "^6.17.1",
        "license-checker": "^25.0.1",
        "postcss": "8.5.15",
        "tailwindcss": "~4.3.1",
        "typescript": "~5.9.3",
        "vite-tsconfig-paths": "~6.1.1",
        "vitest": "~4.1.9"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "@sentry/cli",
            "esbuild",
            "next-translate-plugin",
            "sharp"
        ],
        "overrides": {
            "@urql/core": "6.0.1",
            "esbuild": "0.28.1",
            "postcss": "8.5.15",
            "undici": "7.28.0"
        }
    },
    "packageManager": "pnpm@10.30.3+sha512.c961d1e0a2d8e354ecaa5166b822516668b7f44cb5bd95122d590dd81922f606f5473b6d23ec4a5be05e7fcd18e8488d47d978bbe981872f1145d06e9a740017"
}
