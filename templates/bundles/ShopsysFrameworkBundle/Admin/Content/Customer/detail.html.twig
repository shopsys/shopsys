{% extends '@!ShopsysFramework/Admin/Content/Customer/detail.html.twig' %}

{% block main_content %}

    {{ form_start(form) }}
        {{ form_errors(form) }}
        {% embed '@ShopsysFramework/Admin/Inline/FixedBar/fixedBar.html.twig' %}
            {% block fixed_bar_content %}
                <a href="{{ url('admin_customer_list') }}" class="btn-link-style">{{ 'Back to overview'|trans }}</a>
                {% if is_granted(constant('App\\Model\\Security\\Roles::ROLE_CUSTOMER_CARE')) == false %}
                    {{ form_save(customerUser|default(null), form) }}
                {% else %}
                    {% do form.save.setRendered() %}
                {% endif %}
            {% endblock %}
        {% endembed %}
    {{ form_end(form) }}

{% endblock %}
