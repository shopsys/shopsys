{% block order_items_widget %}

    {% import '@ShopsysFramework/Admin/Content/Order/orderItem.html.twig' as orderItemMacro %}
    <div class="wrap-divider">
        <div class="form-group">
            <div class="form-group__title">{{ 'Order items'|trans }}</div>
            <div class="form-line">
                <div class="table-touch-always">
                    {{ form_errors(form.itemsWithoutTransportAndPayment) }}
                    <div class="table-touch-always__in">
                        <table class="table-main table-main--with-inline-form">
                            <thead>
                                <tr>
                                    <th><span class="padding-left-10">{{ 'Name'|trans }}</span></th>
                                    <th class="text-right">{{ 'Catalogue number'|trans }}</th>
                                    <th class="text-right"><span class="table-main__column-with-info">{{ 'Unit price including VAT'|trans }} ({{ currencySymbolByCurrencyId(order.currency.id) }})</span></th>
                                    <th class="text-right">{{ 'Amount'|trans }}</th>
                                    <th class="text-right">{{ 'Unit'|trans }}</th>
                                    <th class="text-right">{{ 'VAT rate (%)'|trans }}</th>
                                    <th class="text-center">
                                        <span class="display-inline-block min-width-80">
                                            {{ 'Set prices manually'|trans }}
                                            <i class="svg svg-info cursor-help js-tooltip"
                                               data-toggle="tooltip" data-placement="bottom"
                                               title="{{ 'All prices have to be handled manually if checked, otherwise the unit price without VAT and the total prices for that item will be recalculated automatically.'|trans }}"
                                            ></i>
                                        </span>
                                    </th>
                                    <th class="text-right">{{ 'Unit price excluding VAT'|trans }} ({{ currencySymbolByCurrencyId(order.currency.id) }})</th>
                                    <th class="text-right">{{ 'Total including VAT'|trans }} ({{ currencySymbolByCurrencyId(order.currency.id) }})</th>
                                    <th class="text-right">{{ 'Total excluding VAT'|trans }} ({{ currencySymbolByCurrencyId(order.currency.id) }})</th>
                                    <th></th>
                            </tr>
                            </thead>
                            <tbody
                                id="js-order-items"
                                data-prototype="{{ orderItemMacro.orderItem(form.itemsWithoutTransportAndPayment.vars.prototype, null, null)|escape }}"
                                data-order-product-add-url="{{ url('admin_order_addproduct', { orderId: order.id }) }}"
                            >
                                {% for productItem in order.productItems %}
                                    {{ orderItemMacro.orderItem(form.itemsWithoutTransportAndPayment[productItem.id], productItem.id, productItem) }}
                                {% endfor %}

                                {% for orderItem in order.transportAndPaymentItems %}
                                    <tr>
                                        <td>{{ orderItem.name }}</td>
                                        <td>{{ orderItem.catnum }}</td>
                                        <td class="text-right">{{ orderItem.priceWithVat|priceWithCurrency(order.currency) }}</td>
                                        <td class="text-right">{{ orderItem.quantity }}</td>
                                        <td>{{ orderItem.unitName }}</td>
                                        <td class="text-right">{{ orderItem.vatPercent|formatPercent }}</td>
                                        <td></td>
                                        <td class="text-right">{{ orderItem.priceWithoutVat|priceWithCurrency(order.currency) }}</td>
                                        <td class="text-right">{{ orderItem.totalPriceWithVat|priceWithCurrency(order.currency) }}</td>
                                        <td class="text-right">{{ orderItem.totalPriceWithoutVat ? orderItem.totalPriceWithoutVat|priceWithCurrency(order.currency) : '' }}</td>
                                        <td class="table-col-5 table-grid__cell--actions"></td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                            <tfoot>
                                <tr>
                                    <th colspan="8">
                                        <div class="padding-left-10">
                                            {{ 'Total'|trans }} {{ '(včetně dopravy a platby)'|trans }}:
                                        </div>
                                    </th>
                                    <th class="text-right">{{ order.totalPriceWithVat|priceWithCurrency(order.currency) }}</th>
                                    <th class="text-right">{{ order.totalPriceWithoutVat|priceWithCurrency(order.currency) }}</th>
                                    <th></th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock order_items_widget %}
