{% extends '@!ShopsysFramework/Front/Form/deliveryAddressChoiceFields.html.twig' %}
{% block delivery_address_choice_row %}
    {% if deliveryAddresses|length > 0 %}
        <div class="wrap-divide box-chooser-adresses-wrap">
            <h2 class="in-title">{{ 'Dodací adresy'|trans }}</h2>
            <ul class="box-chooser box-chooser--adresses">
                {% for child in form %}
                    {% if child.vars.value|isInteger %}
                        {% set deliveryAddress = deliveryAddresses[child.vars.value] %}
                        <li class="box-chooser__item {% if child.vars.checked %} active {% endif %} js-delivery-address-row">
                            <label for="{{ child.vars.id }}" class="form-choice">
                                {{ form_widget(child, { attr: { class: 'css-checkbox js-delivery-address-input' } }) }}
                                <span class="css-checkbox__image"></span>
                                <strong class="box-chooser__item__name">
                                    {{ deliveryAddress.firstName }} {{ deliveryAddress.lastName }}
                                </strong>
                                <span class="box-chooser__item__address">
                                    {% if deliveryAddress.companyName %}
                                        <span class="box-chooser__item__company">
                                            {{ deliveryAddress.companyName }}
                                        </span>
                                    {% endif %}
                                    <span>
                                        {{ deliveryAddress.street }},
                                        {{ deliveryAddress.city }} {{ deliveryAddress.postcode }}
                                    </span>
                                    {% if deliveryAddress.country is not null %}
                                        , {{ deliveryAddress.country.name }}
                                    {% endif %}
                                </span>
                                {% if deliveryAddress.telephone %}
                                    <span class="box-chooser__item__phone">
                                        <i class="svg svg-phone"></i>
                                        {{ deliveryAddress.telephone }}
                                    </span>
                                {% endif %}
                                <a
                                    data-href="{{ url('front_customer_delivery_address_delete', { deliveryAddressId: deliveryAddress.id }) }}"
                                    class="box-chooser__item__remove js-delivery-address-remove-button"
                                >
                                    <i class="svg svg-remove"></i>
                                </a>
                            </label>
                        </li>
                    {% else %}
                        <li class="box-chooser__item box-chooser__item--no-bg box-chooser__item--last {% if child.vars.checked %} active {% endif %} js-delivery-address-row">
                            <label for="{{ child.vars.id }}" class="form-choice">
                                {{ form_widget(child, { attr: { class: 'css-checkbox js-delivery-address-input' } }) }}
                                <span class="css-checkbox__image"></span>
                                <span class="box-chooser__item__title">{{ 'Přidat novou dodací adresu'|trans }}</span>
                                <picture>
                                    <source srcset="{{ asset('public/frontend/images/marker_2x.png') }} 2x, {{ asset('public/frontend/images/marker.png') }} 1x" />
                                    <img
                                        class="box-chooser__item__marker"
                                        loading="lazy"
                                        src=""
                                        data-src="{{ asset('public/frontend/images/marker.png') }}"
                                        alt="{{ 'Dodací adresa'|trans }}"
                                    >
                                </picture>
                            </label>
                        </li>
                    {% endif %}
                {% endfor %}
            </ul>
        </div>
    {% endif %}
{% endblock %}
