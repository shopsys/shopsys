{% macro priceToAndPriceItemMacro(priceToAndPriceForm, index, currencySymbol)%}
    <tr class="table-form__row js-transport-pallet-prices-item" data-index="{{ index }}" id="{{ priceToAndPriceForm.vars.id }}">
        <td class="table-form__cell">
            <span class="visibility-hidden js-transport-pallet-prices-price-to-label">{{ 'od' }}</span>&nbsp;
            {{ form_widget(priceToAndPriceForm.priceTo, {attr: {class: 'js-transport-pallet-prices-price-to-input'}}) }}&nbsp;{{ currencySymbol }}
            {{ form_errors(priceToAndPriceForm.priceTo, { errors_attr: { class: 'table-limits__cell__error' } }) }}
        </td>
        <td class="table-form__cell">
            {{ form_widget(priceToAndPriceForm.price) }}&nbsp;{{ currencySymbol }}
            {{ form_errors(priceToAndPriceForm.price, { errors_attr: { class: 'table-limits__cell__error' } }) }}
        </td>
        <td class="table-form__cell">
            <button type="button" class="btn btn--small btn--light js-transport-pallet-prices-delete-button">
                <i class="svg svg-delete-thin in-icon"></i>
                {{ 'Odebrat'|trans }}
            </button>
        </td>
    </tr>
{% endmacro %}

{% block _transport_form_palletPricesGroup_palletPricesByDomainId_row %}
    {% import _self as self %}
    <div class="form-line">
        {{ form_errors(form) }}
        {% for domainId, domainPrices in form %}
            {% set currencySymbol = currencySymbolByDomainId(domainId) %}
            <div class="form-line__box js-transport-pallet-prices" id="{{ domainPrices.vars.id }}" data-prototype="{{ self.priceToAndPriceItemMacro(domainPrices.vars.prototype, '', currencySymbol)|e('html_attr') }}">
                <div class="form-line__box__title">
                    <span class="form-line__box__title__image">
                        <span class="in-image in-image--large">
                            <span class="in-image__in">
                                {{ domainIcon(domainId) }}
                            </span>
                        </span>
                    </span>
                    <strong class="form-line__box__title__name">
                        {{ getDomainName(domainId) }}
                        <button type="button" class="btn btn--small btn--plus js-transport-pallet-prices-add-button" style="margin-left: 50px">
                            <i class="btn__icon">+</i>
                            {{ 'Přidat'|trans }}
                        </button>
                    </strong>
                </div>
                <div class="form-line__box__content">
                    {{ form_errors(domainPrices) }}
                    <div class="table-touch js-table-touch">
                        <table class="table-grid">
                            <thead>
                                <tr class="table-form__row">
                                    <th class="table-form__cell">{{ 'Cena zboží s DPH do'|trans }}</th>
                                    <th class="table-form__cell">{{ 'Cena dopravy (vstupní cena s DPH)'|trans }}</th>
                                    <th class="table-form__cell"></th>
                                </tr>
                            </thead>
                            <tbody class="js-transport-pallet-prices-items">
                                {% for index, priceToAndPriceForm in domainPrices %}
                                    {{ self.priceToAndPriceItemMacro(priceToAndPriceForm, index, currencySymbol) }}
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
{% endblock %}
