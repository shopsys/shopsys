{% extends '@!ShopsysFramework/Admin/Layout/layoutWithPanel.html.twig' %}

{% block title %}- {{ 'Přehled skladů'|trans }}{% endblock %}
{% block h1 %}{{ 'Přehled skladů'|trans }}{% endblock %}

{% block btn %}
    <a href="{{ url('admin_stock_new') }}" class="btn btn--primary btn--plus wrap-bar__btn">
        <i class="btn__icon">+</i>{{ 'Vytvořit nový sklad'|trans }}
    </a>
{% endblock %}

{% block main_content %}

    <div class="js-multiple-grids-rows-unified">
        {{ render(controller('ShopsysFrameworkBundle:Admin/Domain:domainTabs')) }}

        {% if settingsForm %}
            <div class="stock-settings">
                <h2>{{ 'Nastavení skladů'|trans  }}</h2>
                {{ form(settingsForm) }}
            </div>
        {% endif %}
        <div class="wrap-divider wrap-divider--no-border">
            <h2>{{ 'Sklady'|trans }}</h2>
            {{ gridView.render() }}
        </div>
    </div>

{% endblock %}

