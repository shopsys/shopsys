{% block slider_filter_form_row %}
    <div class="box-price-slider">
        <div
            class="js-range-slider"
            data-minimum-input-id="{{ form.min.vars.id }}"
            data-minimal-value="{{ form.vars.min.value }}"
            data-maximum-input-id="{{ form.max.vars.id }}"
            data-maximal-value="{{ form.vars.max.value }}"
            data-decimals="0"
        ></div>
        <div>
            <div class="box-price-slider__form__item" data-unit="{{ form.vars.min.unit }}">
                <div class="form-line-block is-focused">
                    {{ form_widget(form.min) }} 
                    <span class="box-price-slider__form__item__currency">{{ form.vars.min.unit }}</span>
                    {% if form.vars.min.unit is defined %}
                        <label>{{'od'|trans}}</label>
                    {% endif %}
                </div>
            </div>
            <div class="box-price-slider__form__item">
                <div class="form-line-block is-focused">
                    {{ form_widget(form.max) }} 
                    <span class="box-price-slider__form__item__currency">{{ form.vars.max.unit }}</span>
                    {% if form.vars.max.unit is defined %}
                        <label>{{ 'do'|trans }}</label>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
