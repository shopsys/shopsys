{% block slider_filter_form_row %}
    <div class="box-filter__slider__wrap">
        <div class="ui-slider-wrap">
            <div
                class="box-filter__slider__wrap__range js-range-slider"
                data-minimum-input-id="{{ form.min.vars.id }}"
                data-minimal-value="{{ form.vars.min.value }}"
                data-maximum-input-id="{{ form.max.vars.id }}"
                data-maximal-value="{{ form.vars.max.value }}"
                data-decimals="0"
            ></div>
        </div>
        <div class="box-filter__content__item__wrap">
            <div class="box-filter__content__item" data-unit="{{ form.vars.min.unit }}">
                {{ form_widget(form.min) }}
                {% if form.vars.min.unit is defined %}
                    {{ form.vars.min.unit }}
                {% endif %}
            </div>
            <div class="box-filter__content__item box-filter__content__item--right">
                {{ form_widget(form.max) }}
                {% if form.vars.max.unit is defined %}
                    {{ form.vars.max.unit }}
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}
