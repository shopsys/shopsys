{% extends 'Front/Layout/layoutWithoutPanel.html.twig' %}
{% import 'Front/Content/Product/productListMacro.html.twig' as productList %}

{% set domain = getDomain() %}
{% set showGalleryMaxCount = 4 %}
{% block meta_description %}
    {{- productSeries.getSeoMetaDescription(domain.id)|default(getSeoMetaDescription()) -}}
{% endblock %}

{% block title %}
    {{ productSeries.getSeoTitle(domain.id)|default(productSeries.getName(domain.locale)) }}
{% endblock %}

{% block main_content %}
    <div class="web__line">
        <link rel="stylesheet" type="text/css" href="{{ asset('assets/frontend/styles/fancybox/jquery.fancybox.min-' ~ getCssVersion() ~ '.css') }}">
        <div class="web__container">
            <div class="box-detail">
                <div class="box-detail__info">
                    <h1 itemprop="name">
                        {{ productSeries.getSeoH1(domain.id)|default(productSeries.name) }}
                    </h1>
                    <div class="product-series-categories">
                        {% for seriesCategory in productSeries.productSeriesCategories %}
                            <a href="{{ url('front_productseriescategory_detail', { id: seriesCategory.id }) }}">{{ seriesCategory.getName(domain.locale) }}</a>
                        {% endfor %}
                    </div>
                    <p>
                        {{ productSeries.description|raw }}
                    </p>
                </div>
                <div class="box-detail__image">
                    {% set galleryImages = getImages(productSeries) %}
                    {% set showGallery = galleryImages|length > 1 %}
                    <div class="box-detail__image__main">
                        {% if imageExists(productSeries) %}
                            <a data-fancybox="products-gallery" data-caption="{{ productSeries.name }}" href="{{ imageUrl(productSeries, 'original') }}" class="{{ showGallery ? 'js-gallery-main-image' }}">
                                {{ image(productSeries, { itemprop: 'image', size: 'preview' }) }}
                            </a>
                        {% else %}
                            {{ noimage({ alt: productSeries.name }) }}
                        {% endif %}
                    </div>

                    {% if showGallery %}
                        <div class="box-gallery dont-print js-gallery">
                            <div class="box-gallery__in js-gallery-slides">
                                {% for galleryImage in galleryImages %}
                                    {% if loop.index != 1 %}
                                        <div class="box-gallery__item js-gallery-item {% if loop.index > showGalleryMaxCount %}display-none{% endif %}">
                                            <a data-fancybox="products-gallery" data-caption="{{ productSeries.name }}" href="{{ imageUrl(galleryImage, 'original') }}" class="box-gallery__item__link">
                                                {{ image(galleryImage, {size: 'galleryThumbnail', lazy: false}) }}
                                            </a>
                                        </div>
                                    {% endif %}
                                {% endfor %}
                                {% if galleryImages|length > showGalleryMaxCount %}
                                    <div class="box-gallery__item js-gallery-item-more">
                                        <a href="#" class="box-gallery__item__link underline">
                                            {{ 'Další'|trans }} ({{ galleryImages|length - showGalleryMaxCount }})
                                        </a>
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    {% endif %}
                </div>
                <div class="box-detail__info">
                    <h2>
                        {{ "Produkty programu"|trans }}
                    </h2>
                    {{ productList.list(products, null, 'h2') }}
                </div>
            </div>

        </div>
    </div>
{% endblock %}
