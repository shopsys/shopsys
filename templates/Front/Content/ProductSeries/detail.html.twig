{% extends 'Front/Layout/layoutWithoutPanel.html.twig' %}
{% import 'Front/Content/Product/productListMacro.html.twig' as productList %}

{% set domain = getDomain() %}
{% set showGalleryMaxCount = 4 %}
{% block meta_description %}
    {{- productSeries.getSeoMetaDescription(domain.id)|default(getSeoMetaDescription()) -}}
{% endblock %}

{% block title %}
    {{ productSeries.getSeoTitle(domain.id)|default(productSeries.getName(domain.locale)) }}
{% endblock %}

{% block breadcrumb %}
{% endblock %}

{% block main_content %}
    <div class="web__line web__line--spacing--medium">
        <div class="web__container">
            <h1 class="heading heading--primary heading--primary-subpage" itemprop="name">
                {{ productSeries.getSeoH1(domain.id)|default(productSeries.name) }}
            </h1>
            {{ render(controller('App\\Controller\\Front\\BreadcrumbController:indexAction', { routeName: getRoute(), routeParameters: getRouteParams() } )) }}
            <div class="box-blog__desc box-blog__desc--detail">
                {{ productSeries.description|raw }}
            </div>

            <div class="box-series box-series--detail">
                {% set galleryImages = getImages(productSeries) %}
                {% set showGallery = galleryImages|length > 1 %}
                <ul class="box-series__grid box-series__grid--detail{{ galleryImages|length == 2 ? ' box-series__grid--centered' }}">
                    {% if showGallery %}
                        {% for galleryImage in galleryImages %}
                            {% if loop.index != 1 %}
                                <li class="box-series__grid__item">
                                    <a data-fancybox="products-gallery" data-caption="{{ productSeries.name }}" href="{{ imageUrl(galleryImage, 'original') }}">
                                        {{ image(galleryImage, {size: 'largePreview', lazy: false, alt: productSeries.name ~ ' ' ~ loop.index}) }}
                                    </a>
                                </li>
                            {% endif %}
                        {% endfor %}
                    {% endif %}
                </ul>
            </div>
        </div>
    </div>
    {% if products|length > 0 %}
        <div class="web__line web__line--bg-color web__line--spacing--big  web__line--spacing--bottom-small web__line--margin-bottom-up-big">
            <div class="web__container">
                {{ productList.list(products, 'list-products--series', 'h2') }}
            </div>
        </div>
    {% endif %}
{% endblock %}
