{% extends 'Front/Layout/layoutWithoutPanel.html.twig' %}

{% set domain = getDomain() %}
{% block meta_description %}
    {{- "Nábytkové programy"|trans|default(getSeoMetaDescription()) -}}
{% endblock %}

{% block title %}
    {{- "Nábytkové programy"|trans -}}
{% endblock %}

{% block main_content %}
    <div class="web__line">
        <div class="web__container">
            <h1>{{ "Nábytkové programy"|trans }}</h1>
            <p>
                {{ "Zde najdete přehled všech nábytkových programů."|trans }}
            </p>
            {% for seriesCategory in productSeriesCategories %}
                <a href="{{ url('front_productseriescategory_detail', { id: seriesCategory.id }) }}">{{ seriesCategory.getName(domain.locale) }}</a>
            {% endfor %}

            {% for productSeries in productSeriesList %}
                <div class="box-detail">
                    <h3><a href="{{ url('front_productseries_detail', { id: productSeries.id }) }}">{{ productSeries.getName(domain.locale) }}</a></h3>
                    <div class="box-detail__image">
                        <div class="box-detail__image__main">
                            <a href="{{ url('front_productseries_detail', { id: productSeries.id }) }}">
                                {% if imageExists(productSeries) %}
                                    {{ image(productSeries, { itemprop: 'image', size: 'preview' }) }}
                                {% else %}
                                    {{ noimage({ alt: productSeries.getName(domain.locale) }) }}
                                {% endif %}
                            </a>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}
