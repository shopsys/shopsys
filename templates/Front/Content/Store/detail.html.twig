{% extends 'Front/Layout/layoutWithoutPanel.html.twig' %}

{% block breadcrumb %}
{% endblock %}

{% block title %}
    {{- store.name -}}
{% endblock %}

{% block main_content %}
    <style>
        #js-google-map-box {
            width: 100%;
            height: 400px;
            background-color: grey;
        }
    </style>
    <div id="js-google-map-box"></div>

    {% if imageExists(store, 'main') %}
        {{ image(store, { itemprop: 'image', lazy:true, type: 'main' }) }}
    {% endif %}

    <h1>{{ store.name }}</h1>
    {{ store.street }} <br>
    {{ store.city }} <br>
    {{ store.openingHours }} <br>
    {{ store.extraordinaryOpeningHours }} <br>
    {{ store.contactInfo }} <br>
    {{ store.contactText1 }} <br>
    {{ store.contactText2 }} <br>

    {% set galleryImages = getImages(store, 'gallery') %}
    {% for galleryImage in galleryImages %}
        {{ image(galleryImage, { itemprop: 'image', lazy:true, type: 'gallery' }) }}
    {% endfor %}

{% endblock %}

{% block javascripts_bottom %}
    {{ parent() }}
    <script type="text/javascript">
        var markersData = [];

        {% if store.locationLng is not null and store.locationLat is not null  %}
            markersData.push({locations: {lat: {{ store.locationLat }}, lng: {{ store.locationLng }} }, data: {id: '{{ store.id }}' }});
        {% endif %}
    </script>
    <script src="https://maps.googleapis.com/maps/api/js?key="></script>
{% endblock %}
