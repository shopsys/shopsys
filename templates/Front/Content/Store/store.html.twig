{% extends 'Front/Layout/layoutWithoutPanel.html.twig' %}

{% block breadcrumb %}
{% endblock %}

{% block title %}
    {{- 'Prodejny'|trans -}}
{% endblock %}

{% block main_content %}
    <div class="web__line web__line--spacing--big">
        <div class="web__container">
            <h1 class="heading heading--primary heading--primary-subpage">{{ "Prodejny"|trans }}</h1>
            <div class="web__container web__container--fullwidth web__container--max-width web__container--no-spacing">
                <div class="box-breadcrumb">
                    {{ render(controller('App\\Controller\\Front\\BreadcrumbController:indexAction', { routeName: getRoute(), routeParameters: getRouteParams() } )) }}
                </div>
            </div>
            <div class="box-stores">
                <div class="box-stores__map">
                    <div id="js-google-map-box" class="box-stores__map__google"></div>
                </div>
                <div class="box-stores__info">
                    <div class="box-stores__store box-stores__store--default">
                        <picture>
                            <source
                                    srcset="
                                    {{ asset('public/frontend/images/prodejny2x.png') }} 2x,
                                    {{ asset('public/frontend/images/prodejny.png') }} 1x"
                            />
                            <img
                                    class="box-stores__store__img box-stores__store__img--default"
                                    loading="lazy"
                                    src="{{ imgLazyloadPlaceholder }}"
                                    data-src="{{ asset('public/frontend/images/prodejny.png') }}"
                                    alt="{{ 'Prodejny Sconto'|trans }}">
                        </picture>
                        <h2 class="box-stores__store__title">{{ 'Prodejny Sconto'|trans }}</h2>
                        <p class="box-stores__store__desc">
                            {{ 'Další doplňkový sortiment, zákaznické<br>centrum nebo osobní vyzvednutí zboží z<br>e-shopu zdarma na 8 místech v ČR.'|transHtml }}
                        </p>
                    </div>
                    {% for store in stores %}
                        <div
                            class="box-stores__store js-store-info display-none"
                            data-store-id="{{ store.id }}"
                            data-store-href="{{ url('front_stores_detail', {id: store.id}) }}"
                        >
                            <button class="window-popup__close js-google-map-close-store">
                                <i class="svg svg-remove"></i>
                            </button>

                            <h2 class="box-stores__store__title">{{ store.name }}</h2>
                            {{ store.street }} <br>
                            {{ store.city }} <br>
                            {% if store.openingHours is not empty %}
                                <strong class="box-stores__store__subtitle">{{ 'Otevírací doba'|trans }}</strong>
                                <div class="box-stores__store__hours">
                                    <div class="box-stores__store__hours__classic">{{ store.openingHours }}</div>
                                </div>
                            {% endif %}
                            {% if store.contactText1 is not empty or store.contactText2 is not empty %}
                                <strong class="box-stores__store__subtitle">{{ 'Kontakt na obchodní dům'|trans }}</strong>
                                <div class="box-stores__store__phones">
                                    {{ store.contactText1 }}
                                </div>
                            {% endif %}

                            <a
                                class="btn btn--success box-stores__store__link"
                                href="{{ url('front_stores_detail', {id: store.id}) }}"
                            >
                                {{ 'Detail prodejny'|trans }}
                            </a>

                            {% if imageExists(store, 'main') %}
                                {{ image(store, { itemprop: 'image', lazy: true, type: 'main', class: 'box-stores__store__img' }) }}
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>
            </div>
            <div class="box-stores-list">
                {% for store in stores %}
                    <div class="box-stores-list__item">
                        <a class="box-stores-list__item__link" href="{{ url('front_stores_detail', {id: store.id}) }}">
                            <i class="box-stores-list__item__icon svg svg-marker svg-fw-bold"></i>
                            <strong class="box-stores-list__item__name">{{ store.name }}</strong>
                            <span class="box-stores-list__item__to-detail">
                                <span class="box-stores-list__item__to-detail__text">{{ 'Detail prodejny'|trans }}</span>
                                <i class="svg svg-chevron"></i>
                            </span>
                        </a>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts_bottom %}
    {{ parent() }}
    <script type="text/javascript">
        var markersData = [];

        {% for store in stores %}
        {% if store.locationLng is not null and store.locationLat is not null  %}
            markersData.push({locations: {lat: {{ store.locationLat }}, lng: {{ store.locationLng }} }, data: {id: '{{ store.id }}' }});
        {% endif %}
        {% endfor %}
    </script>
    <script src="https://maps.googleapis.com/maps/api/js?key={{ googleMapApiKey }}"></script>
{% endblock %}
