{% extends 'Front/Content/Error/errorCommon.html.twig' %}

{% block error_content %}
    <div class="box-error-page__text">
        <h1 class="box-error-page__text__heading">{{ 'Na téhle url adrese žádný nábytek ani doplňky nemáme.'|trans }}</h1>
        <p class="box-error-page__text__main">
            {{ 'Ale na jiných adresách toho pro Vás máme spousty...'|trans }}
        </p>
        <a class="btn btn--primary btn--primary--v2 box-error-page__text__btn" href="{{ url('front_homepage') }}">{{ 'Zpět do e-shopu'|trans }}</a>
    </div>
    <picture class="box-error-page__picture">
        <source media="(max-width: 599px)" srcset="{{ asset('public/frontend/images/404_m.png') }}">
        <img loading="lazy" class="box-error-page__image" data-src="{{ asset('public/frontend/images/404_desktop.jpg') }}" alt="{{ 'Předsíň'|trans }}">
    </picture>
{% endblock %}
