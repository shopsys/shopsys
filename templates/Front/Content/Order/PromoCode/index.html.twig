{% set domain = getDomain() %}
<div class="box-promo-code">
    {% set promoDescUrl = '/akce' %}
    {% if domain.id == 2 %}
        {% set promoDescUrl = '/akcia' %}
    {% endif %}
    {% if validEnteredPromoCode is null %}
        <a class="box-promo-code__button js-responsive-toggle js-promo-code-button" data-element="promo-code">
            <i class="svg svg-plus"></i>
            {{ 'Mám slevový kupón'|trans }}
        </a>

        <div class="display-none" id="promo-code">
            <div class="box-promo-code__content">
                <input type="text" placeholder="{{ 'Kupón'|trans }}" id="js-promo-code-input" class="box-promo-code__content__input input" data-apply-code-url="{{ url('front_promo_code_apply') }}"/>
                <label for="js-promo-code-input" class="input-label">{{ 'Kupón'|trans }}</label>
                <button type="button" id="js-promo-code-submit-button" class="box-promo-code__content__btn btn">
                    {{ 'Apply'|trans }}
                </button>
            </div>
        </div>
    {% else %}
        <strong class="box-promo-code__title">{{ 'Vaše sleva s kódem byla uplatněna'|trans }}</strong>
        <span class="box-promo-code__added">
            <strong>{{ validEnteredPromoCode.code }}</strong>
            <a href="{{ url('front_promo_code_remove') }}" id="js-promo-code-remove-button" class="box-promo-code__added__remove">
                <i class="svg svg-cross"></i>
            </a>
        </span>
        <p class="margin-bottom-0">
            {{ 'Sleva byla uplatněna na všechny již neslevněné položky na které se akce vztahuje podle <a href="%url%">pravidel</a>.'|transHtml({'%url%': promoDescUrl}) }}
        </p>
    {% endif %}
</div>
