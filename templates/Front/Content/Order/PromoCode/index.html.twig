{% set domain = getDomain() %}
<div class="box-promo-code">
    {% set promoDescUrl = '/akce' %}
    {% if domain.id == 2 %}
        {% set promoDescUrl = '/akcia' %}
    {% endif %}
    {% if validEnteredPromoCode is null %}
        <div class="box-promo-code__wrap form-line-block js-form-field">
            <label>{{ 'Slevový kód'|trans }}</label>
            <input type="text" value="" id="js-promo-code-input" class="input box-promo-code__input" data-apply-code-url="{{ url('front_promo_code_apply') }}"/>
            <button type="button" id="js-promo-code-submit-button" class="btn btn--primary box-promo-code__btn">{{ 'Apply'|trans }}</button>
        </div>
        <p class="box-cart__promo__desc">
            {{ 'Nemáte slevový kód? Prohlédněte si seznam našich<br><a class="box-cart__promo__desc__link" href="%url%">aktuálně platných akcí</a>.'|transHtml({'%url%': promoDescUrl}) }}
        </p>
    {% else %}
        <strong class="box-promo-code__title">{{ 'Vaše sleva s kódem byla uplatněna'|trans }}</strong>
        <span class="box-promo-code__added">
            <span class="box-promo-code__added__discount color-purple">
                <strong class="cart-tag cart-tag--promo cart-tag cart-tag--promo--primary">
                    {{ validEnteredPromoCode.code }}
                    <a href="{{ url('front_promo_code_remove') }}" id="js-promo-code-remove-button" class="box-promo-code__added__remove">
                        <i class="svg svg-remove"></i>
                    </a>
                </strong>
            </span>
        </span>
        <p class="box-cart__promo__desc box-cart__promo__desc--apply">
            {{ 'Sleva byla uplatněna na všechny již neslevněné položky na které se akce vztahuje podle <a class="box-cart__promo__desc__link" href="%url%">pravidel</a>.'|transHtml({'%url%': promoDescUrl}) }}
        </p>
    {% endif %}
</div>
