{% set companyTabActiveClass = isCompanyCustomer ? "active" : "" %}
{% set isUserLogged = app.getUser() is not null %}
{% do form.note.setRendered %}

{% block content %}
    <div class="web__line web__line--cart">
        <div class="web__container">
            <div class="box-order">
                <div class="box-order__info">
                    {% if not isUserLogged %}
                        <h3 class="box-order__title" id="js-user-email-label">{{ 'Začněte zadáním e-mailu'|trans }}</h3>
                    {% else %}
                        <h3 class="box-order__title">{{ 'Váš e-mail'|trans }}</h3>
                    {% endif %}

                    <div class="js-responsive-tabs js-tabs-only">
                        <div class="form-columns" id="js-order-form-login-email">
                            <div class="form-columns__left">
                                <div class="form-columns__item">
                                    {{ form_row(form.email, { label: 'Váš e-mail'|trans }) }}
                                </div>
                            </div>
                        </div>

                        <div id="js-order-form-details-container">
                            {% if not isUserLogged %}
                                <div class="form-columns" id="js-order-form-login-container">
                                    <div class="form-columns__left">
                                        <div class="form-columns__item">
                                            <div class="box-order__login">
                                                <i class="svg svg-user"></i>
                                                <p class="box-order__login__content">
                                                    <strong class="box-order__login__content__text">{{ 'Nejste tu poprvé?'|trans }}</strong>
                                                    <a class="box-order__login__content__link" href="#" id="js-order-form-login-button">
                                                        {{ 'Přihlášte se'|trans }}
                                                    </a>
                                                </p>
                                            </div>

                                            <div class="display-none" id="js-order-form-login-window-content">
                                                <div class="in-message--error display-none js-order-form-login-error"></div>
                                                <div class="form-line">
                                                    <div class="form-line__input">
                                                        <input type="password" class="input js-order-form-login-password" placeholder="{{ 'Vaše heslo'|trans }}" id="form-login-window-password"/>
                                                        <label for="form-login-window-password" class="input-label">{{ 'Vaše heslo'|trans }}</label>
                                                    </div>
                                                </div>
                                                <a href="{{ url('front_registration_reset_password') }}">{{ 'Zapomněli jste vaše heslo?'|trans }}</a>
                                                <button class="margin-top-20 window-popup__actions__btn js-window-button-continue btn js-order-form-login-submit">
                                                    {{ 'Přihlásit'|trans }}
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="box-order__info__block active" id="js-order-form-register-container-wrap">
                                    <div class="form-columns" id="js-order-form-register-container">
                                        <div class="form-columns__left">
                                            <div class="form-columns__item margin-bottom-10">
                                                {{ form_widget(form.register, { attr: { class: 'css-checkbox' } }) }}
                                                <label for="{{ form.register.vars.id }}" class="css-checkbox__image input-label input-label--checkbox">
                                                    {{ 'Chci se registrovat s objednávkou'|trans }}
                                                </label>
                                                {{ form_errors(form.register) }}
                                            </div>
                                        </div>
                                    </div>

                                    {% if not isUserLogged %}
                                        <div class="margin-top-10" id="js-order-form-password-container">
                                            <h3 class="box-order__title">{{ 'Vytvořte si heslo'|trans }}</h3>
                                            <div class="form-columns">
                                                <div class="form-columns__left">
                                                    <div class="form-columns__item">
                                                        {{ form_row(form.password.first, { label: 'Password'|trans }) }}
                                                    </div>
                                                    <div class="form-columns__item">
                                                        {{ form_row(form.password.second, { label: 'Password again'|trans }) }}
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    {% endif %}

                                    <div class="form-columns" id="js-order-form-activation-info">
                                        <div class="form-columns__left">
                                            <div class="form-columns__item margin-bottom-10">
                                                <div class="box-order__message">
                                                    {{ 'Dokončete objednávku, na e-mail vám zašleme odkaz pro potvrzení registrace a vytvoření hesla.'|trans }}
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            {% endif %}

                            <div class="box-order__info__block active">
                                {% if not isUserLogged %}
                                    <h3 class="box-order__title" id="js-order-form-customer-type-selector-heading">
                                        {{ 'Budete u nás nakupovat jako' }}
                                    </h2>
                                {% endif %}
                                <div class="form-columns dont-print {{ isUserLogged ? 'display-none' }}" id="js-order-form-customer-type-selector">
                                    <div class="form-columns__left">
                                        <div class="form-columns__item margin-bottom-10">
                                            <input type="checkbox" class="css-radio"></input>
                                            <label class="css-radio__image js-tabs-button" data-tab-id="common-customer">
                                                {{ "Soukromá osoba"|trans }}
                                            </label>
                                        </div>
                                        <div class="form-columns__item margin-bottom-10">
                                            <input type="checkbox" class="css-radio"></input>
                                            <label class="css-radio__image js-tabs-button" data-tab-id="company-customer">
                                                {{ "Firma"|trans }}
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <h3 class="box-order__title">{{ 'Informace o zákazníkovi'|trans }}</h3>
                            <div class="form-columns">
                                <div class="form-columns__left">
                                    <div class="form-columns__item">
                                        {{ form_row(form.telephone, { label: 'Telephone'|trans }) }}
                                    </div>
                                </div>        
                            </div>

                            <div class="box-order__info__block active js-tabs-content">
                                <div class="form-columns">
                                    <div class="form-columns__left">
                                        <div class="form-columns__item">
                                            {{ form_row(form.firstName, { label: 'First name'|trans }) }}
                                        </div>
                                        <div class="form-columns__item">
                                            {{ form_row(form.lastName, { label: 'Last name'|trans }) }}
                                        </div>
                                    </div>        
                                </div>
                            </div>

                            <div class="box-order__info__block js-tabs-content {{ companyTabActiveClass }}" data-tab-id="company-customer">
                                <h3 class="box-order__title">{{ 'Company data'|trans }}</h3>
                                {{ form_row(form.companyCustomer, { rowClass: "display-none" }) }}
                                
                                <div id="js-company-fields">
                                    <div class="form-columns">
                                        <div class="form-columns__left">
                                            <div class="form-columns__item">
                                                {{ form_row(form.companyName, { label: 'Název společnosti'|trans }) }}
                                            </div>
                                        </div>        
                                    </div>
                                    <div class="form-columns">
                                        <div class="form-columns__left">
                                            <div class="form-columns__item">
                                                {{ form_row(form.companyNumber, { label: 'Company number'|trans }) }}
                                            </div>
                                        </div>        
                                    </div>
                                    <div class="form-columns">
                                        <div class="form-columns__left">
                                            <div class="form-columns__item">
                                                {{ form_row(form.companyTaxNumber, { label: 'Tax number'|trans }) }}
                                            </div>
                                        </div>        
                                    </div>
                                </div>
                            </div>

                            <div class="box-order__info__block active">
                                <h3 class="box-order__title">{{ 'Fakturační adresa'|trans }}</h3>

                                <div class="form-columns">
                                    <div class="form-columns__left">
                                        <div class="form-columns__item">
                                            {{ form_row(form.street, { label: 'Ulice a č. popisné'|trans }) }}
                                        </div>
                                    </div>
                                </div>

                                <div class="form-columns">
                                    <div class="form-columns__left">
                                        <div class="form-columns__item">
                                            {{ form_row(form.city, { label: 'City'|trans }) }}
                                        </div>
                                        <div class="form-columns__item form-columns__item--postcode">
                                            {{ form_row(form.postcode, { label: 'Postcode'|trans }) }}
                                        </div>
                                    </div>
                                </div>

                                <div class="form-columns">
                                    <div class="form-columns__left">
                                        <div class="form-columns__item">
                                            {{ form_row(form.country, { label: 'Country'|trans }) }}
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="box-order__info__block box-order__info__block--small-gap active js-delivery-address-form">
                                {% set hasEmptyAddresses = true %}
                                {% if customerUser is null or customerUser.customer.deliveryAddresses is null and app.user is null %}
                                    {% set hasEmptyAddresses = false %}
                                {% endif %}
                                {% if customerUser is not null and customerUser.customer.deliveryAddresses is empty %}
                                    {% set hasEmptyAddresses = false %}
                                {% endif %}
                                {% if app.user is not null %}
                                    {{ form_row(form.deliveryAddress) }}
                                {% endif %}
                                <div class="form-columns{{ hasEmptyAddresses == true ? ' display-none' }}">
                                    <div class="form-columns__left">
                                        <div class="form-columns__item">
                                            {% if hasEmptyAddresses == true %}
                                                {{ form_widget(form.deliveryAddressFilled, { attr: { class: 'css-checkbox js-checkbox-toggle js-order-delivery-address',
                                                'data-checkbox-toggle-container-id': 'js-order-delivery-address',
                                                checked: 'checked' } }) }}
                                            {% else %}
                                                {{ form_widget(form.deliveryAddressFilled, { attr: { class: 'css-checkbox js-checkbox-toggle js-order-delivery-address',
                                                'data-checkbox-toggle-container-id': 'js-order-delivery-address'} }) }}
                                            {% endif %}
                                            <label for="{{ form.deliveryAddressFilled.vars.id }}" class="css-checkbox__image input-label input-label--checkbox">
                                                {{ 'Přidat novou dodací adresu'|trans }}
                                            </label>
                                            {{ form_errors(form.deliveryAddressFilled) }}
                                        </div>
                                    </div>
                                </div>

                                <div class="margin-bottom-40" id="js-order-delivery-address">
                                    <div class="margin-top-10 js-order-delivery-address-fields{% if app.user is not null and form.deliveryAddress.vars.value is not same as('') %} display-none{% endif %}">
                                        <div class="form-columns">
                                            <div class="form-columns__left">
                                                <div class="form-columns__item">
                                                    {{ form_row(form.deliveryFirstName, { label: 'First name'|trans }) }}
                                                </div>
                                                <div class="form-columns__item">
                                                    {{ form_row(form.deliveryLastName, { label: 'Last name'|trans }) }}
                                                </div>
                                            </div>
                                        </div>
                                        <div class="form-columns">
                                            <div class="form-columns__left">
                                                <div class="form-columns__item">
                                                    {{ form_row(form.deliveryCompanyName, { label: 'Company'|trans }) }}
                                                </div>
                                            </div>
                                        </div>
                                        <div class="form-columns">
                                            <div class="form-columns__left">
                                                <div class="form-columns__item">
                                                    {{ form_row(form.deliveryTelephone, { label: 'Telephone'|trans }) }}
                                                </div>
                                            </div>
                                        </div>
                                        <div class="form-columns">
                                            <div class="form-columns__left">
                                                <div class="form-columns__item">
                                                    {{ form_row(form.deliveryStreet, { label: 'Ulice a č. popisné'|trans}) }}
                                                </div>
                                            </div>
                                        </div>
                                        <div class="form-columns">
                                            <div class="form-columns__left">
                                                <div class="form-columns__item">
                                                    {{ form_row(form.deliveryCity, { label: 'City'|trans }) }}
                                                </div>
                                                <div class="form-columns__item form-columns__item--postcode">
                                                    {{ form_row(form.deliveryPostcode, { label: 'Postcode'|trans }) }}
                                                </div>
                                            </div>
                                        </div>
                                        <div class="form-columns">
                                            <div class="form-columns__left">
                                                <div class="form-columns__item">
                                                    {{ form_row(form.deliveryCountry, { label: 'Country'|trans }) }}
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="in-action" id="js-order-form-submit-container">
                        <div class="in-action__text">
                            <p>
                                {% if privacyPolicyArticle is not null and termsAndConditionsArticle is not null %}
                                    {% set privacyPolicyUrl = url('front_article_detail', {'id': privacyPolicyArticle.id}) %}
                                    {% set termsAndConditionsUrl = url('front_article_detail', {'id': termsAndConditionsArticle.id}) %}
                                    {{ 'Kliknutím na tlačítko Odeslat objednávku souhlasíte s <a href="%termsAndConditionsUrl%" target="_blank">obchodními podmínkami</a> e-shopu a se <a href="%privacyPolicyUrl%" target="_blank">zpracováním osobních údajů</a>.'|transHtml({'%privacyPolicyUrl%': privacyPolicyUrl, '%termsAndConditionsUrl%': termsAndConditionsUrl})|raw }}
                                {% elseif privacyPolicyArticle is not null %}
                                    {% set privacyPolicyUrl = url('front_article_detail', {'id': privacyPolicyArticle.id}) %}
                                    {{ 'I agree with terms and conditions and <a href="%privacyPolicyUrl%" target="_blank">privacy policy</a>.'|trans({'%privacyPolicyUrl%': privacyPolicyUrl })|raw }}
                                {% elseif termsAndConditionsArticle is not null %}
                                    {% set termsAndConditionsUrl = url('front_article_detail', {'id': termsAndConditionsArticle.id}) %}
                                    {{ 'I agree with <a href="%termsAndConditionsUrl%" target="_blank">terms and conditions</a> and privacy policy.'|trans({'%termsAndConditionsUrl%': termsAndConditionsUrl })|raw }}
                                {% else %}
                                    {{ 'I agree with terms and conditions and privacy policy.'|trans }}
                                {% endif %}
                            </p>

                            <div class="form-choice">
                                {{ form_widget(form.newsletterSubscription, { attr: { class: "css-checkbox" } }) }}
                                <label class="css-checkbox__image" for="{{ form.newsletterSubscription.vars.id }}">
                                    {{ 'I want to subscribe to the newsletter'|trans }}
                                </label>
                            </div>
                        </div>

                        <div class="in-action__left">
                            <button type="submit" name="{{ flow.getFormTransitionKey() }}" value="back" class="in-action__back btn btn-no-style btn--arrow btn--arrow-prev js-no-validate-button">
                                {{ 'Zpět'|trans }}
                            </button>
                        </div>

                        <div class="in-action__right">
                            {% set buttonClass = 'in-action__next btn btn--primary btn--big-radius btn-with-icon btn-with-icon--right' %}
                            {% if app.user is null %}
                                {% set buttonClass = 'in-action__next btn btn--disabled btn--primary btn--big-radius btn-with-icon btn-with-icon--right' %}
                            {% endif %}

                            {{ form_widget(form.save, { label: 'Odeslat objednávku'|trans, attr: { class: buttonClass } }) }}
                        </div>
                    </div>
                </div>

                <div class="box-order__cart">
                    <h3 class="box-order__title">{{ 'Vaše objednávka'|trans }}</h3>
                    <div id="js-order-preview" data-url="{{ url('front_order_preview') }}">
                        {{ render(controller('App\\Controller\\Front\\OrderController:previewAction', {
                            transportId: orderPreview.transport is not null ? orderPreview.transport.id : null,
                            paymentId: orderPreview.payment is not null ? orderPreview.payment.id : null,
                            orderStep: '3',
                            showAdvert: false,
                            showPromo: false
                        })) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
