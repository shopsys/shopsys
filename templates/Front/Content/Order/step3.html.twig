{% set commonTabActiveClass = isCompanyCustomer ? "" : "active" %}
{% set companyTabActiveClass = isCompanyCustomer ? "active" : "" %}
{% set finishOrderSubmitText = isWithoutRegistration ? 'Odeslat objednávku'|trans : 'Registrovat a odeslat objednávku'|trans %}
{% do form.note.setRendered %}

{% block content %}
    <div class="web__line web__line--cart web__line--cart-final-step">
        <div class="web__container">

            <div class="box-cart box-cart--personals">
                <div class="box-cart__col box-cart__col--info">
                    <div class="box-cart-card box-cart-card--form box-cart-card box-cart-card--form--spaced">
                        <div class="box-cart-card__form">
                            <h2 class="box-cart-card__form__title box-cart-card__form__title--centered">
                                {% if(isWithoutRegistration == false) %}
                                    {{ '<strong class="box-cart-card__form__title__strong">Ještě jste u nás nenakupovali?</strong>
                                    Pro dokončení nákupu se prosím zaregistrujte. Budete u nás nakupovat jako:'|transHtml }}
                                {% else %}
                                    {{ 'Zkontrolujte prosím vaše údaje:'|trans }}
                                {% endif %}
                            </h2>
                            <div class="in-tab js-responsive-tabs js-tabs-only">
                                {% if(isWithoutRegistration == false) %}
                                <div class="in-tab__head dont-print">
                                    <a href="#" class="in-tab__head__item js-tabs-button  {{ commonTabActiveClass }}"
                                    data-tab-id="common-customer">
                                        {{ "Koncový zákazník"|trans }}
                                    </a>
                                    <a href="#" class="in-tab__head__item js-tabs-button  {{ companyTabActiveClass }}"
                                    data-tab-id="company-customer">
                                        {{ "Firma"|trans }}
                                    </a>
                                </div>
                                {% endif %}
                                <div class="in-tab__content{{ isWithoutRegistration == false ? ' in-tab__content--spaced' }} personal-info-order-form">
                                    {% if(isWithoutRegistration == true) %}
                                        <h2 class="form-line-block-section__heading">{{ 'Vaše údaje'|trans }}</h2>
                                    {% endif %}
                                    {% if prefilledCustomerEmail is not null %}
                                        {{ form_row(form.email, {
                                            label: 'Váš e-mail'|trans,
                                            value: prefilledCustomerEmail, rowClass: 'form-line-block js-form-field'
                                        }) }}
                                    {% else %}
                                        {{ form_row(form.email, {
                                            label: 'Váš e-mail'|trans,
                                            rowClass: 'form-line-block js-form-field'
                                        }) }}
                                    {% endif %}
                                    <div class="form-line-block-wrap form-line-block-wrap--phone">
                                        {{ form_row(form.telephone, {
                                            label: 'Telephone'|trans,
                                            rowClass: 'form-line-block js-form-field'
                                        }) }}
                                    </div>
                                    <div class="in-tab__content__item js-tabs-content  {{ commonTabActiveClass }}"
                                        data-tab-id="common-customer">
                                        {% if isCompanyCustomer == false %}
                                            <div class="form-line-block-section">
                                                {{ form_row(form.gender, {
                                                    label: 'Oslovení'|trans,
                                                    rowClass: 'form-line-block form-line-block--three-quarters js-form-field'
                                                }) }}
                                                {{ form_row(form.firstName, {
                                                    label: 'First name'|trans,
                                                    rowClass: 'form-line-block js-form-field'
                                                }) }}
                                                {{ form_row(form.lastName, {
                                                    label: 'Last name'|trans,
                                                    rowClass: 'form-line-block js-form-field'
                                                }) }}
                                            </div>
                                        {% endif %}
                                    </div>
                                    <div class="in-tab__content__item js-tabs-content  {{ companyTabActiveClass }}"
                                        data-tab-id="company-customer">
                                        <div class="hidden">
                                            {{ form_row(form.companyCustomer) }}
                                        </div>
                                        <div id="js-company-fields" class="form-line-block-section">
                                            {{ form_row(form.companyName, {
                                                label: 'Název společnosti'|trans,
                                                rowClass: 'form-line-block js-form-field'
                                            }) }}
                                            {{ form_row(form.companyNumber, {
                                                label: 'Company number'|trans,
                                                rowClass: 'form-line-block js-form-field'
                                            }) }}
                                            {{ form_row(form.companyTaxNumber, {
                                                label: 'Tax number'|trans,
                                                rowClass: 'form-line-block js-form-field'
                                            }) }}
                                            {% if getDomain().id == 2 %}
                                                {{ form_row(form.companyNumberWithVat, {
                                                    label: 'Tax number with vat'|trans,
                                                    rowClass: 'form-line-block js-form-field'
                                                }) }}
                                            {% endif %}
                                        </div>
                                    </div>

                                    {% if isWithoutRegistration == false %}
                                        <div class="form-line-block-section">
                                            <h2 class="form-line-block-section__heading">{{ 'Password'|trans }}</h2>
                                            {{ form_row(form.password.first, {
                                                label: 'Password'|trans,
                                                rowClass: 'form-line-block js-form-field'
                                            }) }}
                                            {{ form_row(form.password.second, {
                                                label: 'Password again'|trans,
                                                rowClass: 'form-line-block js-form-field'
                                            }) }}
                                        </div>
                                    {% endif %}

                                    <div class="form-line-block-section">
                                        <h2 class="form-line-block-section__heading">{{ 'Fakturační adresa'|trans }}</h2>
                                        {{ form_row(form.street, {
                                            label: 'Ulice a č. popisné'|trans,
                                            rowClass: 'form-line-block js-form-field'
                                        }) }}
                                         <div class="form-line-block-section__grid">
                                            {{ form_row(form.city, {
                                                label: 'City'|trans,
                                                rowClass: 'form-line-block form-line-block--full-width form-line-block--first js-form-field'
                                            }) }}
                                            {{ form_row(form.postcode, {
                                                label: 'Postcode'|trans,
                                                rowClass: 'form-line-block form-line-block--small-width js-form-field'
                                            }) }}
                                        </div>
                                        <div class="hidden">
                                        {{ form_row(form.country, { label: 'Country'|trans }) }}
                                        </div>
                                    </div>
                                    <fieldset>
                                        <div class="box-chooser box-chooser--check">
                                            <span class="box-chooser__item">
                                                {{ form_row(form.deliveryAddressFilled, {
                                                    attr: { class: 'js-checkbox-toggle', 'data-checkbox-toggle-container-id': 'js-order-delivery-address' },
                                                    label: 'Přidat dodací adresu'|trans
                                                }) }}
                                                <picture>
                                                    <source srcset="{{ asset('public/frontend/images/marker_2x.png') }} 2x, {{ asset('public/frontend/images/marker.png') }} 1x" />
                                                    <img class="box-chooser__item__marker" loading="lazy" src="" data-src="{{ asset('public/frontend/images/marker.png') }}" alt="{{ 'Dodací adresa'|trans }}">
                                                </picture>
                                            </span>
                                        </div>

                                        <div id="js-order-delivery-address">
                                            {% if app.user is not null %}
                                                {{ form_row(form.deliveryAddress) }}
                                            {% endif %}

                                            <div class="js-order-delivery-address-fields{% if app.user is not null and form.deliveryAddress.vars.value is not same as('') %} display-none{% endif %}">
                                                {{ form_row(form.deliveryFirstName, {
                                                    label: 'First name'|trans,
                                                    rowClass: 'form-line-block js-form-field'
                                                }) }}
                                                {{ form_row(form.deliveryLastName, {
                                                    label: 'Last name'|trans,
                                                    rowClass: 'form-line-block js-form-field'
                                                }) }}
                                                {{ form_row(form.deliveryCompanyName, {
                                                    label: 'Company'|trans,
                                                    rowClass: 'form-line-block js-form-field'
                                                }) }}
                                                {{ form_row(form.deliveryTelephone, {
                                                    label: 'Telephone'|trans,
                                                    rowClass: 'form-line-block js-form-field'
                                                }) }}
                                                {{ form_row(form.deliveryStreet, {
                                                    label: 'Ulice a č. popisné'|trans,
                                                    rowClass: 'form-line-block js-form-field'
                                                }) }}
                                                {{ form_row(form.deliveryCity, {
                                                    label: 'City'|trans,
                                                    rowClass: 'form-line-block js-form-field'
                                                }) }}
                                                {{ form_row(form.deliveryPostcode, {
                                                    label: 'Postcode'|trans,
                                                    rowClass: 'form-line-block form-line-block--small-width js-form-field'
                                                }) }}
                                                <div class="hidden">
                                                {{ form_row(form.deliveryCountry, {
                                                    label: 'Country'|trans
                                                }) }}
                                                </div>
                                            </div>
                                        </div>
                                    </fieldset>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="box-cart__buttons box-cart__buttons--final">
                        <div class="box-cart__buttons__back">
                            <button type="submit" name="{{ flow.getFormTransitionKey() }}" value="back" class="btn btn--prev btn-no-style btn--arrow btn--arrow-prev js-no-validate-button">
                                <i class="btn__icon svg svg-chevron"></i>
                                {{ 'Zpět na Dopravu a platbu'|trans }}
                            </button>
                        </div>
                        <div class="box-cart__buttons__next box-cart__buttons__next--terms">
                            <span class="box-cart__buttons__terms">
                                {% if privacyPolicyArticle is not null and termsAndConditionsArticle is not null %}
                                    {% set privacyPolicyUrl = url('front_article_detail', {'id': privacyPolicyArticle.id}) %}
                                    {% set termsAndConditionsUrl = url('front_article_detail', {'id': termsAndConditionsArticle.id}) %}
                                    {{ 'Kliknutím na tlačítko Odeslat objednávku souhlasíte<br>s <a href="%termsAndConditionsUrl%" target="_blank">obchodními podmínkami</a> e-shopu a se<br><a href="%privacyPolicyUrl%" target="_blank">zpracováním osobních údajů</a>.'|transHtml({'%privacyPolicyUrl%': privacyPolicyUrl, '%termsAndConditionsUrl%': termsAndConditionsUrl})|raw }}
                                {% elseif privacyPolicyArticle is not null %}
                                    {% set privacyPolicyUrl = url('front_article_detail', {'id': privacyPolicyArticle.id}) %}
                                    {{ 'I agree with terms and conditions and <a href="%privacyPolicyUrl%" target="_blank">privacy policy</a>.'|trans({'%privacyPolicyUrl%': privacyPolicyUrl })|raw }}
                                {% elseif termsAndConditionsArticle is not null %}
                                    {% set termsAndConditionsUrl = url('front_article_detail', {'id': termsAndConditionsArticle.id}) %}
                                    {{ 'I agree with <a href="%termsAndConditionsUrl%" target="_blank">terms and conditions</a> and privacy policy.'|trans({'%termsAndConditionsUrl%': termsAndConditionsUrl })|raw }}
                                {% else %}
                                    {{ 'I agree with terms and conditions and privacy policy.'|trans }}
                                {% endif %}
                            </span>
                            {{ form_widget(form.save, { label: finishOrderSubmitText, attr: { class: 'btn btn--checkout-send' } }) }}
                        </div>
                    </div>
                </div>
                <div class="box-cart__col box-cart__col--preview box-cart__col--preview-step-3">
                    <div id="js-order-preview" class="box-cart-card box-cart-card--preview" data-url="{{ url('front_order_preview') }}">
                        {{ render(controller('App\\Controller\\Front\\OrderController:previewAction', {
                            transportIdsByProductTypeId: splitOrderPreview.transportIdsIndexedByProductTypeId,
                            paymentId: splitOrderPreview.hasPayment() ? splitOrderPreview.payment.id : null,
                            showAdvert: false,
                            showPromo: false
                        })) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
