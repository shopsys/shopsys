{% set commonTabActiveClass = isCompanyCustomer ? "" : "active" %}
{% set companyTabActiveClass = isCompanyCustomer ? "active" : "" %}
{% set isUserLogged = app.getUser() is not null %}
{% do form.note.setRendered %}

{% block content %}

    <div class="web__line web__line--cart">
        <div class="web__container">

            <div class="box-order">
                <div>
                    <h1>{{ 'Vaše údaje'|trans }}</h1>
                    <div>
                        <div>
                            {% if not isUserLogged %}
                                <h2 class="in-title in-title--small-spacing" id="js-user-email-label">{{ 'Začněte zadáním e-mailu'|trans }}</h2>
                            {% else %}
                                <h2 class="in-title">{{ 'Váš e-mail'|trans }}</h2>
                            {% endif %}
                            <div class="in-tab js-responsive-tabs js-tabs-only">
                                {{ form_row(form.email, { label: 'Váš e-mail'|trans }) }}
                                <div id="js-order-form-details-container">
                                    {% if not isUserLogged %}
                                        <div class="in-tab__password-box" id="js-order-form-login-container">
                                            <h2 class="in-tab__password-box__heading">{{ 'Vítejte zpět ve Scontu'|trans }}</h2>
                                            {{ '<button type="button" class="btn-no-style link-style in-tab__password-box__link" id="js-order-form-login-button">Přihlaste se a všechny vaše údaje vyplníme za vás</button>'|transHtml }}
                                            <i class="in-tab__password-box__icon svg svg-arrow"></i>
                                            <div class="display-none" id="js-order-form-login-window-content">
                                                <div class="in-message--error display-none js-order-form-login-error"></div>
                                                <div class="form-line">
                                                    <label>{{ 'Vaše heslo'|trans }}</label>
                                                    <input type="password" class="input js-order-form-login-password" />
                                                </div>
                                                <button class="window-popup__actions__btn window-popup__actions__btn--continue window-button-continue btn js-order-form-login-submit">
                                                    {{ 'Přihlásit'|trans }}
                                                </button>
                                                <a class="window-popup__link" href="{{ url('front_registration_reset_password') }}">{{ 'Zapomněli jste vaše heslo?'|trans }}</a>
                                            </div>
                                        </div>
                                        <div class="box-chooser-check-wrap box-chooser-check-wrap--checkout box-chooser-check-wrap--no-spacing" id="js-order-form-register-container-wrap">
                                            <div class="box-chooser-check-wrap__in">
                                                <div class="box-chooser box-chooser--check">
                                                    <div id="js-order-form-register-container" class="box-chooser__item box-chooser__item--big-label">
                                                        {{ form_row(form.register, { label: 'Chci se registrovat s objednávkou'|trans }) }}
                                                    </div>
                                                </div>
                                                {% if not isUserLogged %}
                                                    <div class="box-chooser__item__in box-chooser__item__in--no-spacing" id="js-order-form-password-container">
                                                        <h2 class="in-title in-title--mini">{{ 'Vytvořte si heslo'|trans }}</h2>
                                                        {{ form_row(form.password.first, { label: 'Password'|trans }) }}
                                                        {{ form_row(form.password.second, { label: 'Password again'|trans }) }}
                                                    </div>
                                                {% endif %}
                                                <div class="box-chooser__item__in box-chooser__item__in--no-spacing" id="js-order-form-activation-info">
                                                    <div class="in-title in-title--mini">
                                                        {{ 'Dokončete objednávku, na e-mail vám zašleme odkaz pro potvrzení registrace a vytvoření hesla.'|trans }}
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    {% endif %}
                                    {% if not isUserLogged %}
                                        <h2 class="in-tab__heading" id="js-order-form-customer-type-selector-heading">
                                            {{ 'Budete u nás nakupovat jako' }}
                                        </h2>
                                    {% endif %}
                                    <div class="in-tab__head dont-print {{ isUserLogged ? 'display-none' }}" id="js-order-form-customer-type-selector">
                                        <input type="checkbox" class="css-radio"></input>
                                        <label class="css-radio__image js-tabs-button" data-tab-id="common-customer">
                                            {{ "Soukromá osoba"|trans }}
                                        </label>
                                        <input type="checkbox" class="css-radio"></input>
                                        <label class="css-radio__image js-tabs-button" data-tab-id="company-customer">
                                            {{ "Firma"|trans }}
                                        </label>
                                    </div>
                                    <div class="in-tab__content in-tab__content--spaced in-tab__content--spaced-small personal-info-order-form">
                                        <h2 class="in-title">{{ 'Základní údaje'|trans }}</h2>
                                        {{ form_row(form.telephone, { label: 'Telephone'|trans }) }}
                                        <div class="in-tab__content__item in-tab__content__item--no-spacing js-tabs-content active">
                                            {{ form_row(form.firstName, { label: 'First name'|trans }) }}
                                            {{ form_row(form.lastName, { label: 'Last name'|trans }) }}
                                        </div>
                                        <div class="in-tab__content__item in-tab__content__item--no-padding js-tabs-content  {{ companyTabActiveClass }}"
                                            data-tab-id="company-customer">
                                            <h2 class="in-title">{{ 'Company data'|trans }}</h2>
                                            <div class="hidden">
                                                {{ form_row(form.companyCustomer) }}
                                            </div>
                                            <div id="js-company-fields">
                                                {{ form_row(form.companyName, { label: 'Název společnosti'|trans }) }}
                                                {{ form_row(form.companyNumber, { label: 'Company number'|trans }) }}
                                                {{ form_row(form.companyTaxNumber, { label: 'Tax number'|trans }) }}
                                            </div>
                                        </div>

                                        <div class="margin-bottom-20">
                                            <h2 class="in-title">{{ 'Fakturační adresa'|trans }}</h2>
                                            {{ form_row(form.street, { label: 'Ulice a č. popisné'|trans }) }}
                                            <div class="form-columns">
                                                <div class="form-columns__item">
                                                    {{ form_row(form.city, { label: 'City'|trans }) }}
                                                </div>
                                                <div class="form-columns__item">
                                                    {{ form_row(form.postcode, { label: 'Postcode'|trans }) }}
                                                </div>
                                            </div>
                                            {{ form_row(form.country, { label: 'Country'|trans }) }}
                                        </div>
                                        <div class="box-chooser-check-wrap js-delivery-address-form">
                                            {% set hasEmptyAddresses = true %}
                                            {% if customerUser is null or customerUser.customer.deliveryAddresses is null and app.user is null %}
                                                {% set hasEmptyAddresses = false %}
                                            {% endif %}
                                            {% if customerUser is not null and customerUser.customer.deliveryAddresses is empty %}
                                                {% set hasEmptyAddresses = false %}
                                            {% endif %}
                                            {% if app.user is not null %}
                                                {{ form_row(form.deliveryAddress) }}
                                            {% endif %}
                                            <div class="box-chooser-check-wrap box-chooser-check-wrap--checkout{{ hasEmptyAddresses == true ? ' box-chooser-check-wrap--child' }}">
                                                <div class="box-chooser-check-wrap__in">
                                                    <div class="box-chooser box-chooser--check{{ hasEmptyAddresses == true ? ' display-none' }}">
                                                        <span class="box-chooser__item">
                                                            {% if hasEmptyAddresses == true %}
                                                                {{ form_row(form.deliveryAddressFilled, {
                                                                    attr: {
                                                                        class: 'js-checkbox-toggle js-order-delivery-address',
                                                                        'data-checkbox-toggle-container-id': 'js-order-delivery-address',
                                                                        checked: 'checked'
                                                                    },
                                                                    label: 'Přidat novou dodací adresu'|trans
                                                                }) }}
                                                            {% else %}
                                                                {{ form_row(form.deliveryAddressFilled, {
                                                                    attr: {
                                                                        class: 'js-checkbox-toggle js-order-delivery-address',
                                                                        'data-checkbox-toggle-container-id': 'js-order-delivery-address'
                                                                    },
                                                                    label: 'Přidat novou dodací adresu'|trans
                                                                }) }}
                                                            {% endif %}
                                                            <picture>
                                                                <source srcset="{{ asset('public/frontend/images/marker_2x.png') }} 2x, {{ asset('public/frontend/images/marker.png') }} 1x" />
                                                                <img class="box-chooser__item__marker" loading="lazy" src="" data-src="{{ asset('public/frontend/images/marker.png') }}" alt="{{ 'Dodací adresa'|trans }}">
                                                            </picture>
                                                        </span>
                                                    </div>
                                                    <div class="box-chooser__item__in" id="js-order-delivery-address">
                                                        <div class="box-chooser__delivery-address-fields js-order-delivery-address-fields{% if app.user is not null and form.deliveryAddress.vars.value is not same as('') %} display-none{% endif %}">
                                                            {{ form_row(form.deliveryFirstName, { label: 'First name'|trans }) }}
                                                            {{ form_row(form.deliveryLastName, { label: 'Last name'|trans }) }}
                                                            {{ form_row(form.deliveryCompanyName, { label: 'Company'|trans }) }}
                                                            {{ form_row(form.deliveryTelephone, { label: 'Telephone'|trans }) }}
                                                            {{ form_row(form.deliveryStreet, { label: 'Ulice a č. popisné'|trans}) }}
                                                            <div class="form-columns">
                                                                <div class="form-columns__item">
                                                                    {{ form_row(form.deliveryCity, { label: 'City'|trans }) }}
                                                                </div>
                                                                <div class="form-columns__item">
                                                                    {{ form_row(form.deliveryPostcode, { label: 'Postcode'|trans }) }}
                                                                </div>
                                                            </div>
                                                            {{ form_row(form.deliveryCountry, { label: 'Country'|trans }) }}
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div>
                        <div>
                            <button type="submit" name="{{ flow.getFormTransitionKey() }}" value="back" class="btn btn-no-style btn--arrow btn--arrow-prev js-no-validate-button">
                                <i class="btn__icon svg svg-arrow"></i>
                                {{ 'Zpět na Dopravu a platbu'|trans }}
                            </button>
                        </div>
                        <div class="{{ app.user is null ? 'is-disabled' : '' }}" id="js-order-form-submit-container">
                            <span>
                                {% if privacyPolicyArticle is not null and termsAndConditionsArticle is not null %}
                                    {% set privacyPolicyUrl = url('front_article_detail', {'id': privacyPolicyArticle.id}) %}
                                    {% set termsAndConditionsUrl = url('front_article_detail', {'id': termsAndConditionsArticle.id}) %}
                                    {{ 'Kliknutím na tlačítko Odeslat objednávku souhlasíte<br>s <a href="%termsAndConditionsUrl%" target="_blank">obchodními podmínkami</a> e-shopu a se<br><a href="%privacyPolicyUrl%" target="_blank">zpracováním osobních údajů</a>.'|transHtml({'%privacyPolicyUrl%': privacyPolicyUrl, '%termsAndConditionsUrl%': termsAndConditionsUrl})|raw }}
                                {% elseif privacyPolicyArticle is not null %}
                                    {% set privacyPolicyUrl = url('front_article_detail', {'id': privacyPolicyArticle.id}) %}
                                    {{ 'I agree with terms and conditions and <a href="%privacyPolicyUrl%" target="_blank">privacy policy</a>.'|trans({'%privacyPolicyUrl%': privacyPolicyUrl })|raw }}
                                {% elseif termsAndConditionsArticle is not null %}
                                    {% set termsAndConditionsUrl = url('front_article_detail', {'id': termsAndConditionsArticle.id}) %}
                                    {{ 'I agree with <a href="%termsAndConditionsUrl%" target="_blank">terms and conditions</a> and privacy policy.'|trans({'%termsAndConditionsUrl%': termsAndConditionsUrl })|raw }}
                                {% else %}
                                    {{ 'I agree with terms and conditions and privacy policy.'|trans }}
                                {% endif %}
                            </span>
                            {{ form_row(form.newsletterSubscription, { label: 'I want to subscribe to the newsletter'|trans }) }}
                            {{ form_widget(form.save, { label: 'Odeslat objednávku'|trans, attr: { class: 'btn' } }) }}
                        </div>
                    </div>
                </div>
                <div>
                    <div>
                        <div id="js-order-preview" data-url="{{ url('front_order_preview') }}">
                            {{ render(controller('App\\Controller\\Front\\OrderController:previewAction', {
                                transportId: orderPreview.transport is not null ? orderPreview.transport.id : null,
                                paymentId: orderPreview.payment is not null ? orderPreview.payment.id : null,
                                showAdvert: false,
                                showPromo: false
                            })) }}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
