{% extends 'Front/Layout/layoutWithoutPanel.html.twig' %}

{% block meta_robots -%}
    <meta name="robots" content="noindex, follow">
{% endblock %}

{% block title %}
    {{ 'Order [noun]'|trans }}
{% endblock %}

{% block header %}
    {% include 'Front/Layout/headerCart.html.twig' %}
{% endblock %}

{% block breadcrumb %}
{% endblock %}

{% block main_content %}

    {% block mainMenu %}
    {% endblock %}

    {% block mobileMenu %}
    {% endblock %}

    {% include 'Front/Inline/OrderProgress/index.html.twig' with {step: flow.getCurrentStepNumber()} only %}
    {% if displayFormType == 'login'%}
        {% include 'Front/Content/Login/loginSimpleForm.html.twig' %}
    {% else %}
        {{ form_start(form, { attr: { id: "js-order-form", 'data-ajax-save-url': url('front_order_save_form') }}) }}
        <div class="web__line">
            <div class="web__container">
                {{ form_errors(form) }}
            </div>
        </div>
        {% include 'Front/Content/Order/step' ~ flow.getCurrentStepNumber() ~ '.html.twig' %}
        {{ form_end(form) }}
    {% endif %}

    {% if displayFormType == 'order_flow' %}
        <span class="js-payment-transport-relations" data-relations="{{ paymentTransportRelations }}"></span>
    {% endif %}
{% endblock %}
