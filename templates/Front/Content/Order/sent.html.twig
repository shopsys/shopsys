{% extends 'Front/Layout/layoutWithoutPanel.html.twig' %}

{% block meta_robots -%}
    <meta name="robots" content="noindex, follow">
{% endblock %}

{% block title %}
    {{ 'Order completed'|trans }}
{% endblock %}

{% block breadcrumb %}
{% endblock %}

{% block main_content %}

    {{ render(controller('App\\Controller\\Front\\ScriptController:embedOrderSentPageScriptsAction', {order: order})) }}
    {{ render(controller('App\\Controller\\Front\\ScriptController:embedOrderSentPageGoogleAnalyticsScriptAction', {order: order})) }}

    <div class="web__line">
        <div class="web__container">
            <div class="box-cart-sent">
                <div class="box-cart-sent__text">
                    <h1 class="box-cart-sent__heading">{{ 'Děkujeme za vaši objednávku'|trans }}</h1>
                    <p class="box-cart-sent__info">{{ 'Rekapitulaci jsme zaslali také na váš e-mail' }} <strong>{{ order.email }}</strong></p>
                    <div class="box-cart-sent__buttons">
                        {{ pageContent|raw }}
                        <a class="box-cart-sent__btn btn btn--outline" href="{{ url('front_homepage') }}">Přejít do e-shopu</a>
                    </div>
                </div>
                <div class="box-cart-sent__figure">
                    <picture>
                        <source
                            srcset="{{ asset('public/frontend/images/sent-cart2x.png') }} 2x, {{ asset('public/frontend/images/sent-cart.png') }} 1x">
                        <img
                            class="box-cart-sent__image"
                            loading="lazy"
                            data-src="{{ asset('public/frontend/images/sent-cart.png') }}"
                            alt="{{ 'Objednávka odeslána'|trans }}">
                    </picture>
                </div>
            </div>
        </div>
    </div>

    {% if goPayData is defined and goPayData|length != 0 %}
        {% include '/Front/Inline/Payment/goPayPayment.html.twig' %}
    {% endif %}
{% endblock %}
