
{% import 'Front/Content/Cart/cartFreeTransportMacro.html.twig' as cartFreeTransportMacro %}

{% set promoCodeCode = '' %}
{% set previewNumber = 0 %}
{% set promoCodeCode = orderPreview.promoCodeCode %}
{% set previewNumber = previewNumber + 1 %}
{% set cartItemDiscounts = orderPreview.quantifiedItemsDiscounts %}
{% set isDiscountInOrderPreview = false %}
{% for index, quantifiedProduct in orderPreview.quantifiedProducts %}
    {% set cartItemDiscount = cartItemDiscounts[index] %}
    {% if cartItemDiscount is not null %}
        {% set isDiscountInOrderPreview = true %}
    {% endif %}
{% endfor %}

<div class="box-preview">
    {% if orderStep == 1 %}
        {% if showPromo %}
            <div class="box-preview__item box-preview__item--promo-code">
                {% if not isDiscountInOrderPreview %}
                    {% if showAdvert %}
                        {{ render(controller('App\\Controller\\Front\\AdvertController:boxAction',{'positionName' : 'cartPreview'})) }}
                    {% endif %}
                {% endif %}
                {{ render(controller('App\\Controller\\Front\\PromoCodeController:indexAction')) }}
            </div>
        {% endif %}

        {% if orderPreview.isTransportForFree() %}
            <div class="box-preview__item box-preview__item--free-transport">
                {{ cartFreeTransportMacro.progressBar(orderPreview) }}
            </div>
        {% endif %}

<div class="box-preview__item box-preview__item--free-transport">
        <div class="box-free-transport">
                <div class="box-free-transport__desc">
                    {{ 'Nakupte ještě za <strong class="box-free-transport__desc__strong">1200 kč</strong> a získáte doručení <strong class="box-free-transport__desc__strong">Zdarma</strong>'|trans|raw }}
                </div>
                <div class="box-free-transport__progress">
                    <div class="box-free-transport__progress__bar" style="width: 55%;"></div>
                </div>
        </div>
        </div>

        <div class="box-preview__item box-preview__item--preview">
            <table class="table-cart-preview">
                <tbody>
                    {% if orderPreview.roundingPrice is not empty %}
                        <tr class="table-cart-preview__row">
                            <td class="table-cart-preview__cell">
                                {{ 'Rounding'|trans }}:
                            </td>
                            <td class="table-cart-preview__cell table-cart-preview__cell--price">
                                {{ orderPreview.roundingPrice.priceWithVat|price }}
                            </td>
                        </tr>
                    {% endif %}

                    {% if orderPreview.totalPriceDiscount.priceWithVat.isZero() == false %}
                        <tr class="table-cart-preview__row">
                            <td class="table-cart-preview__cell">
                                {{ 'Místo'|trans }}
                            </td>
                            <td class="table-cart-preview__cell table-cart-preview__cell--price">
                                <span>{{ orderPreview.totalPriceDiscount.priceWithVat|price }}</span>
                            </td>
                        </tr>
                        <tr class="table-cart-preview__row">
                            <td class="table-cart-preview__cell">
                                <span>{{ 'Sleva'|trans }} - {{ promoCodeCode }}</span>
                            </td>
                            <td class="table-cart-preview__cell table-cart-preview__cell--price">
                                <span class="cart-price cart-price--promo cart-price--promo-preview">- {{ orderPreview.totalPriceDiscount.priceWithVat|price }}</span>
                            </td>
                        </tr>
                    {% endif %}

                    <tr class="table-cart-preview__row">
                        <td class="table-cart-preview__cell">
                            {{ 'Zaplatíte'|trans }}
                        </td>
                        <td class="table-cart-preview__cell table-cart-preview__cell--total-price">
                            <strong class="js-cart-total-price">{{ orderPreview.totalPrice.priceWithVat|price }}</strong>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    {% else %}
        <div class="box-preview__summary">
            <table class="table-cart-preview">
                <tbody class="table-cart-preview__body">
                    <tr class="table-cart-preview__body__row">
                        <td class="table-cart-preview__body__col">
                            <table class="table-cart-preview__section">
                                <tbody class="table-cart-preview__section__body">
                                    {% if showProducts %}
                                        {% for quantifiedProductKey, quantifiedProduct in orderPreview.quantifiedProducts %}
                                            {% set quantifiedProductPrice = orderPreview.quantifiedItemsPrices[quantifiedProductKey] %}
                                            <tr class="table-cart-preview__row">
                                                <td class="table-cart-preview__cell">
                                                    {% if quantifiedProduct.quantity > 1 %}
                                                        <strong>{{ quantifiedProduct.quantity|formatNumber }} {{ quantifiedProduct.product.unit.name }}</strong>
                                                    {% endif %}
                                                    {{ quantifiedProduct.product.fullname }}
                                                </td>
                                                <td class="table-cart-preview__cell">
                                                    {{ quantifiedProductPrice.totalPrice.priceWithVat|price }}
                                                </td>
                                            </tr>
                                        {% endfor %}
                                    {% endif %}

                                    {% if orderPreview.transport is not null %}
                                        <tr class="table-cart-preview__row">
                                            <td class="table-cart-preview__cell">
                                                {{ orderPreview.transport.name }}
                                                {% if imageExists(orderPreview.transport) %}
                                                    {{ image(orderPreview.transport) }}
                                                {% endif %}
                                            </td>
                                            <td class="table-cart-preview__cell">
                                                {{ orderPreview.transportPrice(orderPreview.transport).priceWithVat|priceText }}
                                            </td>
                                        </tr>
                                    {% endif %}
                                </tbody>
                            </table>

                            {% if orderPreview.payment is not null %}
                                <table class="table-cart-preview__section">
                                    <tbody class="table-cart-preview__section__body">
                                        <tr class="table-cart-preview__row">
                                            <td class="table-cart-preview__cell">
                                                <span>{{ orderPreview.payment.name }}</span>
                                                {% if imageExists(orderPreview.payment) %}
                                                    {{ image(orderPreview.payment) }}
                                                {% endif %}
                                            </td>
                                            <td class="table-cart-preview__cell">
                                                {{ orderPreview.paymentPrice(orderPreview.payment).priceWithVat|priceText }}
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            {% endif %}
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    {% endif %}
</div>
