{% extends 'Front/Layout/layoutWithoutPanel.html.twig' %}

{% block meta_robots -%}
    <meta name="robots" content="noindex, follow">
{% endblock %}

{% block title %}
    {{ 'Změna způsobu platby objednávky'|trans }}
{% endblock %}

{% block breadcrumb %}
{% endblock %}

{% block main_content %}
    <div class="web__line web__line web__line--spacing--big">
        <div class="web__container">
            <div class="js-change-payment-container">
                {{ form_start(form) }}
                <div class="display-none">{{ form_errors(form.payment) }}</div>

                <div class="wrap-box wrap-box--with-form wrap-box--payment-error">
                    <h1 class="wrap-box__heading heading heading--primary heading--primary-subpage">
                        {{ 'Během placení objednávky došlo k potížím'|trans }}
                    </h1>
                    <p class="wrap-box__desc">
                        {% trans with {'%orderNumber%': order.number} %}
                            Pro úspěšné dokončení objednávky č. <strong>%orderNumber%</strong> zkuste zopakovat platbu, nebo si zvolte jiný způsob platby.
                            K platbě se můžete vrátit později i ve vašem uživatelském profilu.
                        {% endtrans %}
                    </p>
                    <div class="wrap-box__button-wrap">
                        <a
                            href="{{ url('front_order_repeat_gopay_payment', { urlHash: order.urlHash }) }}"
                            class="btn btn--submit-next btn--success"
                        >
                            {{ 'Opakovat platbu'|trans }}
                        </a>
                    </div>
                    <div class="wrap-box__in">
                        <div class="wrap-box__buttons">
                            {% for child in form.payment %}
                                {% set choice = form.payment.vars.choices[child.vars.name] %}
                                {% set payment = choice.data %}

                                {% if payment is not same as (unsuccessfulPayment) %}
                                    <label for="{{child.vars.id}}" class="wrap-box__button-label">
                                        <span class="btn wrap-box__button">
                                            {{ form_widget(child, { attr: { class: 'display-none js-order-change-payment', 'data-id': payment.id} }) }}
                                            <span class="wrap-box__button__content">
                                                <span class="wrap-box__button__name">{{ payment.name }}</span>
                                                <span
                                                class="wrap-box__button__price{{ payment.getPrice(getDomain().id).price.isZero() ? '' : ' wrap-box__button__price--not-free' }}">
                                                    {{ payment.getPrice(getDomain().id).price|priceText }}
                                                </span>
                                            </span>
                                            <i class="wrap-box__button__icon svg svg-chevron"></i>
                                        </span>
                                    </label>
                                {% endif %}
                            {% endfor %}
                        </div>
                    </div>
                </div>

                {% do form.goPayBankSwift.setRendered %}

                {{ form_end(form) }}
            </div>
        </div>
    </div>
{% endblock %}
