{% extends 'Front/Content/Order/step.html.twig' %}

{% block h1 %}
    {{ 'Order [noun]'|trans }}
{% endblock %}

{% block content %}
    <div class="web__line">
        <div class="web__container">
            <div class="box-order">

                <div id="{{ form.vars.id }}" class="box-order__info js-no-validate">

                    <div id="{{ form.transportsByProductTypeId.vars.id }}">
                        {% set previewNumber = 0 %}
                        {% for orderPreview in splitOrderPreview.orderPreviews %}
                            {% set previewNumber = previewNumber + 1 %}
                            {% set transportForm = form.transportsByProductTypeId[orderPreview.productType.id] %}
                            <div class="box-order__info__item js-payment-transport-group">

                                <h2 id="js-label-{{ transportForm.vars.id }}">
                                    {{ 'Shipping selection'|trans }}
                                    {% if splitOrderPreview.morePreviews %}
                                        -
                                        {{ 'Zásilka č. %number%'|trans({ '%number%': previewNumber }) }}
                                        -
                                        {{ orderPreview.productType.name }}
                                    {% endif %}
                                </h2>

                                <div class="box-chooser js-form-group">
                                    {{ form_errors(transportForm, { errors_attr: {class: 'form-error--inline'} }) }}

                                    <div id="{{ transportForm.vars.id }}">
                                        {% for child in transportForm %}
                                            {% set choice = transportForm.vars.choices[child.vars.name] %}
                                            {% set transportPrice = transportsPrices[choice.data.id] %}
                                            <label class="box-chooser__item js-payment-transport-checkbox-container" for="{{ child.vars.id }}">
                                                <span class="box-chooser__item__check">
                                                    {{ form_widget(child, { attr: { class: 'css-checkbox js-order-transport-input js-payment-transport-checkbox', 'data-id': choice.data.id} }) }}
                                                    <span class="css-checkbox__image"></span>
                                                </span>

                                                <span class="box-chooser__item__image">
                                                    {% if imageExists(choice.data) %}
                                                        {{ image(choice.data) }}
                                                    {% endif %}
                                                </span>

                                                <span class="box-chooser__item__title">
                                                    <strong class="box-chooser__item__title__name">
                                                        {{ choice.data.name }}
                                                    </strong>
                                                    {% if choice.data.description %}
                                                        <span class="box-chooser__item__title__description">
                                                            - {{ choice.data.description }}
                                                        </span>
                                                    {% endif %}
                                                </span>

                                                <span class="box-chooser__item__price">
                                                    {{ transportPrice.priceWithVat|priceText }}
                                                </span>
                                            </label>
                                        {% else %}
                                            {% do transportForm.setRendered %}
                                            {{ 'Nothing to choose from'|trans }}
                                        {% endfor %}
                                        <button type="button" class="box-chooser__wide-button js-payment-transport-change-button">{{ 'Změnit způsob dopravy' }}</button>
                                    </div>
                                </div>
                            </div>
                        {% else %}
                            {% do form.transportsByProductTypeId.setRendered %}
                            {{ 'Nothing to choose from'|trans }}
                        {% endfor %}
                    </div>

                    <div class="box-order__info__item js-payment-transport-group">

                        <h2 id="js-label-{{ form.payment.vars.id }}">{{ 'Payment selection'|trans }}</h2>

                        <div class="box-chooser box-chooser--smaller js-form-group">
                            {{ form_errors(form.payment, { errors_attr: {class: 'form-error--inline'} }) }}

                            <div id="{{ form.payment.vars.id }}">
                                {% for child in form.payment %}
                                    {% set choice = form.payment.vars.choices[child.vars.name] %}
                                    {% set paymentPrice = paymentsPrices[choice.data.id] %}
                                    <label class="box-chooser__item js-payment-transport-checkbox-container" for="{{ child.vars.id }}">
                                        <span class="box-chooser__item__check">
                                            {{ form_widget(child, { attr: { class: 'css-checkbox js-order-payment-input js-payment-transport-checkbox', 'data-id': choice.data.id} }) }}
                                            <span class="css-checkbox__image"></span>
                                        </span>

                                        <span class="box-chooser__item__image">
                                            {% if imageExists(choice.data) %}
                                                {{ image(choice.data) }}
                                            {% endif %}
                                        </span>

                                        <span class="box-chooser__item__title">
                                            <strong class="box-chooser__title__name">
                                                {{ choice.data.name }}
                                            </strong>
                                            {% if choice.data.description %}
                                                <span class="box-chooser__item__title__description">
                                                    - {{ choice.data.description }}
                                                </span>
                                            {% endif %}
                                        </span>

                                        <span class="box-chooser__item__price">
                                            {{ paymentPrice.priceWithVat|priceText }}
                                        </span>
                                    </label>
                                {% else %}
                                    {% do form.payment.setRendered %}
                                    {{ 'Nothing to choose from'|trans }}
                                {% endfor %}
                                <button type="button" class="box-chooser__wide-button js-payment-transport-change-button">{{ 'Změnit způsob platby' }}</button>
                            </div>
                        </div>
                    </div>
                </div>

                <div id="js-order-preview" class="box-order__cart" data-url="{{ url('front_order_preview') }}">
                    {# TODO: Transport is not one, but more (by product types) #}
                    {{ render(controller('App\\Controller\\Front\\OrderController:previewAction', {
                        transportId: null,
                        paymentId: payment is empty ? null : payment.id
                    })) }}
                </div>
            </div>

            <div class="in-action">
                <div class="in-action__right">
                    {{ form_widget(form.save, { label: 'Continue in order'|trans, attr: { class: 'btn btn--success in-action__btn in-action__btn--big js-no-validate-button' } }) }}
                </div>

                <div class="in-action__left">
                    <button type="submit" name="{{ flow.getFormTransitionKey() }}" value="back" class="btn in-action__btn js-no-validate-button">
                        {{ 'Back to cart'|trans }}
                    </button>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
