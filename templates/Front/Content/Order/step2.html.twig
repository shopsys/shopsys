{% import 'Front/Content/Cart/cartFreeTransportMacro.html.twig' as cartFreeTransportMacro %}

{% block content %}
    <div class="web__line web__line--cart">
        <div class="web__container">
            <div class="box-order">
                <div class="box-order__info js-no-validate" id="{{ form.vars.id }}">
                    <div class="box-order__info__item" id="{{ form.transport.vars.id }}">
                        {% set transportForm = form.transport %}
                        {% set transportFormId = transportForm.vars.id %}

                        {% set transportPersonalPickupForm = form.personalPickupStock %}
                        {% set transportPersonalPickupFormId = transportPersonalPickupForm.vars.id %}
                        {% set personalPickupStock = form.personalPickupStock.vars.value %}

                        <div class="js-payment-transport-group">
                            <h3 class="box-order__title" id="js-label-{{ transportFormId }}">
                                {{ 'Vyberte způsob dopravy'|trans }}
                            </h3>

                            <input type="hidden"
                                id="{{ transportPersonalPickupFormId }}"
                                name="{{ form.personalPickupStock.vars.full_name }}"
                                class="js-order-transport-personal-pickup-input"
                                value="{{ personalPickupStock }}"
                            >

                            <div class="box-chooser js-form-group">
                                {% if transportForm %}
                                    {{ form_errors(transportForm, { errors_attr: {class: 'form-error--inline'} }) }}
                                {% else %}
                                    <span class="js-validation-errors-list js-validation-error-list-{{ transportFormId }} form-error form-error--inline display-none"></span>
                                {% endif %}

                                <div id="{{ transportFormId }}">
                                    {% for transport in transports %}
                                        {% set transportPrice = transportsPrices[transport.id] %}
                                        <label class="box-chooser__item js-payment-transport-checkbox-container" for="{{ transportFormId ~ '_' ~ transport.id }}">
                                            <div class="box-chooser__item__side">
                                                <span class="box-chooser__item__check">
                                                    <input
                                                        type="checkbox"
                                                        id="{{ transportFormId ~ '_' ~ transport.id }}"
                                                        name="{{ form.transport.vars.full_name }}"
                                                        class="css-radio js-order-transport-input js-payment-transport-checkbox {{ transport.personalPickup ? 'js-transport-personal-pickup-checkbox' : '' }}"
                                                        data-id="{{ transport.id }}"
                                                        data-hidden-id="{{ transportPersonalPickupFormId }}"
                                                        value="{{ transport.id }}"
                                                        {{ orderPreview.transport is same as(transport) ? 'checked' : '' }}
                                                    >
                                                    <span class="css-radio__image"></span>
                                                </span>

                                                <span class="box-chooser__item__image">
                                                    {% if imageExists(transport) %}
                                                        {{ image(transport) }}
                                                    {% endif %}
                                                </span>
                                            </div>

                                            <div class="box-chooser__item__info">
                                                <span class="box-chooser__item__title">
                                                    <span class="box-chooser__item__title__name">
                                                        {{ transport.name }}
                                                    </span>
                                                    {% if transport.description %}
                                                        <span class="box-chooser__item__title__description{% if transport.isPersonalPickup() != false and personalPickupStock != null %} box-chooser__item__title__description--full-width{% endif %}" data-origin="{{ transport.description }}">
                                                            {% if transport.isPersonalPickup() == false %}
                                                                <div class="box-chooser__item__tooltip__wrap">
                                                                    <i class="box-chooser__item__tooltip__handler">i</i>
                                                                    <div class="box-chooser__item__tooltip">{{ transport.description }}</div>
                                                                </div>
                                                            {% elseif personalPickupStock == null %}
                                                                <div class="box-chooser__item__tooltip__wrap">
                                                                    <i class="box-chooser__item__tooltip__handler">i</i>
                                                                    <div class="box-chooser__item__tooltip">{{ transport.description }}</div>
                                                                </div>
                                                            {% else %}
                                                                {{ stocksById[personalPickupStock].name }}, sdsd <br>
                                                                {{ 'Otevřeno'|trans }}: sdsd <br>
                                                                {% set minimalDaysAvailability = stockDayAvailabilitiesByStockId[personalPickupStock] %}
                                                                {% if minimalDaysAvailability < 7 %}
                                                                    {% transchoice minimalDaysAvailability with {'%daysAvailability%': minimalDaysAvailability} %}
                                                                    {0} Můžete mít ihned
                                                                    | [1,Inf] Osobní odběr do %daysAvailability% dnů
                                                                    {% endtranschoice %}
                                                                {% else %}
                                                                    {% transchoice minimalDaysAvailability|daysToWeeks with {'%weeksAvailability%': minimalDaysAvailability|daysToWeeks} %}
                                                                        {1} K dispozici do 1 týdne
                                                                        | [2,Inf] K dispozici do %weeksAvailability% týdnů
                                                                    {% endtranschoice %}
                                                                {% endif %}
                                                            {% endif %}
                                                        </span>
                                                    {% endif %}
                                                </span>

                                                <span class="box-chooser__item__avail js-chooser-delivery-information {% if transport.isPersonalPickup() and personalPickupStock != null %}display-none{% endif %}">
                                                    {% set minimalDaysAvailability = minimalDaysAvailabilityIndexedByTransportIds[transport.id] %}
                                                    {% if minimalDaysAvailability < 7 %}
                                                        {% if transport.isPersonalPickup() %}
                                                            {% transchoice minimalDaysAvailability with {'%daysAvailability%': minimalDaysAvailability} %}
                                                                {0} Můžete mít ihned
                                                            | [1,Inf] Osobní odběr do %daysAvailability% dnů
                                                            {% endtranschoice %}
                                                        {% else %}
                                                            {% transchoice minimalDaysAvailability with {'%daysAvailability%': minimalDaysAvailability} %}
                                                                {0} Můžete mít ještě dnes
                                                            | [1,Inf] Doručení do %daysAvailability% dnů
                                                            {% endtranschoice %}
                                                        {% endif %}
                                                    {% else %}
                                                        {% transchoice minimalDaysAvailability|daysToWeeks with {'%weeksAvailability%': minimalDaysAvailability|daysToWeeks} %}
                                                            {1} K dispozici do 1 týdne
                                                            | [2,Inf] K dispozici do %weeksAvailability% týdnů
                                                        {% endtranschoice %}
                                                    {% endif %}
                                                </span>

                                                <strong class="box-chooser__item__price">
                                                    {{ transportPrice.priceWithVat|priceText }}
                                                </strong>
                                            </div>
                                        </label>
                                    {% endfor %}
                                    <div class="box-chooser__toggle display-none">
                                        <button type="button" class="btn btn-no-style box-chooser__toggle__btn js-payment-transport-change-button">
                                            {{ 'Změnit dopravu' }}
                                            <i class="box-chooser__toggle__btn__icon svg svg-arrow"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        {% do form.transport.setRendered %} {# When session contains transport for productType without products with them, it must be skipped #}
                        {% do form.personalPickupStock.setRendered %} {# When session contains transport for productType without products with them, it must be skipped #}
                        </div>
                        <div class="box-chooser__free-transport {{ orderPreview.transportForFree ? '' : ' box-chooser__free-transport--empty' }}">
                            {{ cartFreeTransportMacro.progressBar(orderPreview) }}
                        </div>
                    </div>

                    <div class="box-order__info__item box-order__info__item--with-gap js-payment-transport-group is-disabled">
                        <h3 class="box-order__title" id="js-label-{{ form.payment.vars.id }}">{{ 'Vyberte způsob platby'|trans }}</h3>

                        <div class="box-chooser box-chooser--smaller js-form-group">
                            {{ form_errors(form.payment, { errors_attr: {class: 'form-error--inline'} }) }}

                            <div id="{{ form.payment.vars.id }}" class="js-payments-wrapper">
                                {% set bankTransferRendered = false %}
                                {% set goPayBankSwiftForm = form.goPayBankSwift %}

                                {% for child in form.payment %}
                                    {% set choice = form.payment.vars.choices[child.vars.name] %}
                                    {% set payment = choice.data %}
                                    {% set paymentPrice = paymentsPrices[payment.id] %}

                                    {% set goPayPaymentMethod = choice.data.getGoPayPaymentMethod() %}
                                    {% set isGoPayBankTransfer = goPayPaymentMethod != null and goPayPaymentMethod.identifier == goPayBankTransferIdentifier %}
                                    {% if isGoPayBankTransfer %}
                                        {% set bankTransferRendered = true %}
                                    {% endif %}

                                    <label class="box-chooser__item js-payment-transport-checkbox-container" for="{{ child.vars.id }}">
                                        <div class="box-chooser__item__side">
                                            <span class="box-chooser__item__check">
                                                {{ form_widget(child, { attr: { class: 'css-radio js-order-payment-input js-payment-transport-checkbox' ~ (isGoPayBankTransfer ? ' js-gopay-bank-transfer-input' : ''), 'data-id': payment.id} }) }}
                                                <span class="css-radio__image"></span>
                                            </span>

                                            <span class="box-chooser__item__image">
                                                {% if imageExists(payment) %}
                                                    {{ image(payment) }}
                                                {% elseif payment.goPayPaymentMethod is not empty %}
                                                    <img src="{{ payment.goPayPaymentMethod.imageNormalUrl }}" itemprop="image" />
                                                {% endif %}
                                            </span>
                                        </div>

                                        <div class="box-chooser__item__info box-chooser__item__info--in-row">
                                            <div class="box-chooser__item__title">
                                                <span class="box-chooser__item__title__name">
                                                    {{ payment.name }}
                                                </span>
                                                {% if payment.description %}
                                                    <div class="box-chooser__item__title__description">
                                                        <div class="box-chooser__item__tooltip__wrap">
                                                            <i class="box-chooser__item__tooltip__handler">i</i>
                                                            <div class="box-chooser__item__tooltip">{{ payment.description }}</div>
                                                        </div>
                                                    </div>
                                                {% endif %}
                                            </div>

                                            <strong class="box-chooser__item__price">
                                                {{ paymentPrice.priceWithVat|priceText }}
                                            </strong>
                                        </div>
                                    </label>
                                    {# TODO gopay
                                    this section is temporary disabled. It is a list goPay supported banks. List will be allowed in next US. List should be displayed when is
                                    checked Payment with goPay type and subtype is bank transfer. For this function is copied JS file GoPyaySelection with original logic.
                                     #}
                                    {% if isGoPayBankTransfer %}
                                        <div class="box-chooser__sub-selection js-gopay-list-banks display-none">
                                            {% for goPayBankSwiftFormChild in goPayBankSwiftForm %}
                                                {% set goPayBankSwiftFormChildChoice = goPayBankSwiftForm.vars.choices[goPayBankSwiftFormChild.vars.name] %}
                                                {% set goPayBankSwift = goPayBankSwiftFormChildChoice.data %}
                                                <label class="box-chooser__item" for="{{goPayBankSwiftFormChild.vars.id}}">
                                                    <span class="box-chooser__item__check">
                                                        {{ form_widget(goPayBankSwiftFormChild, { attr: { class: 'css-radio js-order-gopay-bank-swift-input', 'data-swift': goPayBankSwift.swift} }) }}
                                                        <span class="css-radio__image"></span>
                                                    </span>

                                                    <span class="box-chooser__item__image">
                                                        <picture>
                                                            <source
                                                                srcset="{{ goPayBankSwift.imageLargeUrl }} 2x, {{ goPayBankSwift.imageNormalUrl }} 1x" />
                                                            <img
                                                                class="box-chooser__item__img"
                                                                src="{{ asset('public/frontend/images/empty-cart.png') }}"
                                                                alt="GoPay">
                                                        </picture>
                                                    </span>

                                                    <span class="box-chooser__item__title">
                                                        <span class="box-chooser__item__title__name">
                                                            {{ goPayBankSwift.name }}
                                                        </span>
                                                    </span>

                                                    <strong class="box-chooser__item__price">
                                                        {{ paymentPrice.priceWithVat|priceText }}
                                                    </strong>
                                                </label>
                                            {% endfor %}
                                        </div>
                                    {% endif %}
                                {% else %}
                                    {% do form.payment.setRendered %}
                                    {{ 'Nothing to choose from'|trans }}
                                {% endfor %}
                                {% if not bankTransferRendered %}
                                    {% do goPayBankSwiftForm.setRendered %}
                                {% endif %}
                                <div class="box-chooser__toggle display-none">
                                    <button type="button" class="btn btn-no-style box-chooser__toggle__btn js-payment-transport-change-button">
                                        {{ 'Změnit platbu' }}
                                        <i class="box-chooser__toggle__btn__icon svg svg-arrow"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="in-action in-action--with-gap">
                        <div class="in-action__left">
                            <button type="submit" name="{{ flow.getFormTransitionKey() }}" value="back" class="in-action__back btn btn-no-style btn--arrow btn--arrow-prev js-no-validate-button">
                                {{ 'Zpět'|trans }}
                            </button>
                        </div>
                        <div class="in-action__right">
                            {{ form_widget(form.save, { label: 'Dodací údaje'|trans, attr: { class: 'in-action__next btn btn--primary btn--big-radius btn-with-icon btn-with-icon--right js-no-validate-button js-transport_and_payment_form_save' } }) }}
                        </div>
                    </div>
                </div>


                <div class="box-order__cart">
                    <h3 class="box-order__title">{{ 'Vaše objednávka'|trans }}</h3>
                    <div id="js-order-preview" data-url="{{ url('front_order_preview') }}">
                        {{ render(controller('App\\Controller\\Front\\OrderController:previewAction', {
                            transportId: orderPreview.transport is not null ? orderPreview.transport.id : null,
                            paymentId: orderPreview.payment,
                            orderStep: '2',
                            showAdvert: false,
                            showPromo: false
                        })) }}
                    </div>
                </div>
            </div>


        </div>
    </div>

    {{ render(controller('App\\Controller\\Front\\PersonalPickupController:indexAction')) }}
{% endblock %}
