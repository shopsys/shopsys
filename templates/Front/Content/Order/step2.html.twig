{% import 'Front/Content/Cart/cartFreeTransportMacro.html.twig' as cartFreeTransportMacro %}

{% block content %}
    <div class="web__line web__line--bg-color web__line--cart">
        <div class="web__container">
            <div class="box-cart box-cart--order">
                <div id="{{ form.vars.id }}" class="box-cart__col box-cart__col--info js-no-validate">

                    {{ form_errors(form.transportsByProductTypeId) }}

                    <div class="box-cart__buttons box-cart__buttons--mobile">
                        <button
                            type="submit"
                            name="transport_and_payment_form[save]"
                            class="btn btn--dark btn--checkout-step js-no-validate-button js-transport_and_payment_form_save">
                            {{ 'Další krok'|trans }}
                        </button>
                    </div>

                    <div id="{{ form.transportsByProductTypeId.vars.id }}" class="box-cart-card-wrap">
                        {% set previewNumber = 0 %}
                        {% for orderPreview in splitOrderPreview.orderPreviews %}
                            {% set previewNumber = previewNumber + 1 %}
                            {% set transportForm = form.transportsByProductTypeId[orderPreview.productType.id]|default(null) %}
                            {% set transportFormId = transportForm.vars.id|default(form.transportsByProductTypeId.vars.id ~ '_' ~ orderPreview.productType.id) %}

                            {% set transportPersonalPickupForm = form.transportPersonalPickupStockByProductTypeId[orderPreview.productType.id]|default(null) %}
                            {% set transportPersonalPickupFormId = transportPersonalPickupForm.vars.id|default(form.transportPersonalPickupStockByProductTypeId.vars.id ~ '_' ~ orderPreview.productType.id) %}
                            {% set transportPersonalPickupStockId = form.transportPersonalPickupStockByProductTypeId.vars.value[orderPreview.productType.id] ?? null %}

                            <div class="box-cart-card box-cart-card--transport js-payment-transport-group" data-product-type-id="{{ orderPreview.productType.id }}">
                                <div class="box-cart-card__top box-cart-card__top--bordered">
                                    <h2 class="box-cart-card__title box-cart-card__title--no-margin" id="js-label-{{ transportFormId }}">
                                        {% if splitOrderPreview.morePreviews %}
                                            {{ 'Shipping selection'|trans }}
                                            -
                                            {{ 'Zásilka č. %number%'|trans({ '%number%': previewNumber }) }}
                                            -
                                            {{ orderPreview.productType.name }}
                                        {% else %}
                                            {{ 'Doprava pro celý nákup'|trans }}
                                        {% endif %}
                                    </h2>
                                    {% if loop.first and not splitOrderPreview.morePreviews %}
                                        {{ cartFreeTransportMacro.progressBar(orderPreview) }}
                                    {% endif %}
                                    {% if splitOrderPreview.morePreviews %}
                                        {{ cartFreeTransportMacro.progressBar(orderPreview, loop) }}
                                    {% endif %}
                                </div>

                                <input type="hidden"
                                    id="{{ transportPersonalPickupFormId }}"
                                    name="{{ form.transportPersonalPickupStockByProductTypeId.vars.full_name ~ '[' ~ orderPreview.productType.id ~ ']' }}"
                                    class="js-order-transport-personal-pickup-input"
                                    value="{{ transportPersonalPickupStockId }}"
                                >

                                <div class="box-chooser js-form-group">
                                    {% if transportForm %}
                                        {{ form_errors(transportForm, { errors_attr: {class: 'form-error--inline'} }) }}
                                    {% else %}
                                        <span class="js-validation-errors-list js-validation-error-list-{{ transportFormId }} form-error form-error--inline display-none"></span>
                                    {% endif %}

                                    <div id="{{ transportFormId }}">
                                        {% for transport in transports if transport.hasProductType(orderPreview.productType) %}
                                            {% set transportPrice = splitOrderPreview.transportAndPaymentPricesPreview.getTransportPrice(transport, orderPreview.productType) %}
                                            <label class="box-chooser__item js-payment-transport-checkbox-container" for="{{ transportFormId ~ '_' ~ transport.id }}">
                                                <span class="box-chooser__item__check">
                                                    <input
                                                            type="checkbox"
                                                            id="{{ transportFormId ~ '_' ~ transport.id }}"
                                                            name="{{ form.transportsByProductTypeId.vars.full_name ~ '[' ~ orderPreview.productType.id ~ ']' }}"
                                                            class="css-checkbox js-order-transport-input js-payment-transport-checkbox {{ transport.personalPickup ? 'js-transport-personal-pickup-checkbox' : '' }}"
                                                            data-id="{{ transport.id }}"
                                                            data-hidden-id="{{ transportPersonalPickupFormId }}"
                                                            value="{{ transport.id }}"
                                                            {{ orderPreview.transport is same as(transport) ? 'checked' : '' }}
                                                    >
                                                    <span class="css-checkbox__image"></span>
                                                </span>

                                                <span class="box-chooser__item__image">
                                                    {% if imageExists(transport) %}
                                                        {{ image(transport) }}
                                                    {% endif %}
                                                </span>

                                                <span class="box-chooser__item__title">
                                                    <strong class="box-chooser__item__title__name">
                                                        {{ transport.name }}
                                                    </strong>
                                                    {% if transport.description %}
                                                        <span class="box-chooser__item__title__description" data-origin="{{ transport.description }}">
                                                            {% if transportPersonalPickupStockId == null %}
                                                                {{ transport.description }}
                                                            {% else %}
                                                                <span class="box-chooser__item__title__description__name">{{ stocksById[transportPersonalPickupStockId].name }}</span>
                                                                <span class="box-chooser__item__title__description__address">
                                                                    <span class="box-chooser__item__title__description__street">{{ stocksById[transportPersonalPickupStockId].street }}</span>
                                                                    <span class="box-chooser__item__title__description__city">{{ stocksById[transportPersonalPickupStockId].city }}</span>
                                                                </span>
                                                            {% endif %}
                                                        </span>
                                                    {% endif %}
                                                </span>

                                                <span class="box-chooser__item__price">
                                                    {{ transportPrice.priceWithVat|priceText }}
                                                </span>
                                            </label>
                                        {% endfor %}
                                        <div class="box-chooser__toggle">
                                            <button type="button" class="btn box-chooser__toggle__btn js-payment-transport-change-button">
                                                {{ 'Změnit dopravu' }}
                                                <i class="box-chooser__toggle__btn__icon svg svg-arrow"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        {% else %}
                            {{ 'Nothing to choose from'|trans }}
                        {% endfor %}
                        {% do form.transportsByProductTypeId.setRendered %} {# When session contains transport for productType without products with them, it must be skipped #}
                        {% do form.transportPersonalPickupStockByProductTypeId.setRendered %} {# When session contains transport for productType without products with them, it must be skipped #}
                    </div>

                    <div class="box-cart-card box-cart-card--payments js-payment-transport-group">
                        <div class="box-cart-card__top box-cart-card__top--bordered">
                            <h2 class="box-cart-card__title box-cart-card__title--no-margin" id="js-label-{{ form.payment.vars.id }}">{{ 'Payment selection'|trans }}</h2>
                        </div>

                        <div class="box-chooser box-chooser--smaller js-form-group">
                            {{ form_errors(form.payment, { errors_attr: {class: 'form-error--inline'} }) }}

                            <div id="{{ form.payment.vars.id }}" class="js-payments-wrapper">
                                {% set bankTransferRendered = false %}
                                {% set goPayBankSwiftForm = form.goPayBankSwift %}

                                {% for child in form.payment %}
                                    {% set choice = form.payment.vars.choices[child.vars.name] %}
                                    {% set payment = choice.data %}
                                    {% set paymentPrice = splitOrderPreview.transportAndPaymentPricesPreview.getPaymentPrice(payment) %}

                                    {% set goPayPaymentMethod = choice.data.getGoPayPaymentMethod() %}
                                    {% set isGoPayBankTransfer = goPayPaymentMethod != null and goPayPaymentMethod.identifier == goPayBankTransferIdentifier %}
                                    {% if isGoPayBankTransfer %}
                                        {% set bankTransferRendered = true %}
                                    {% endif %}

                                    <label class="box-chooser__item box-chooser__item--payment js-payment-transport-checkbox-container" for="{{ child.vars.id }}">
                                        <span class="box-chooser__item__check">
                                            {{ form_widget(child, { attr: { class: 'css-checkbox js-order-payment-input js-payment-transport-checkbox' ~ (isGoPayBankTransfer ? ' js-gopay-bank-transfer-input' : ''), 'data-id': payment.id} }) }}
                                            <span class="css-checkbox__image"></span>
                                        </span>

                                        <span class="box-chooser__item__image">
                                            {% if imageExists(payment) %}
                                                {{ image(payment) }}
                                            {% elseif payment.goPayPaymentMethod is not empty %}
                                                <img src="{{ payment.goPayPaymentMethod.imageNormalUrl }}" itemprop="image" />
                                            {% endif %}
                                        </span>

                                        <span class="box-chooser__item__title">
                                            <strong class="box-chooser__item__title__name">
                                                {{ payment.name }}
                                            </strong>
                                            {% if payment.description %}
                                                <span class="box-chooser__item__title__description">
                                                    - {{ payment.description }}
                                                </span>
                                            {% endif %}
                                        </span>

                                        <span class="box-chooser__item__price">
                                            {{ paymentPrice.priceWithVat|priceText }}
                                        </span>
                                    </label>
                                    {# TODO gopay
                                    this section is temporary disabled. It is a list goPay supported banks. List will be allowed in next US. List should be displayed when is
                                    checked Payment with goPay type and subtype is bank transfer. For this function is copied JS file GoPyaySelection with original logic.
                                    In next US update this JS with actual logic in PaymentTransportChooser.js.
                                     #}
                                    {% if isGoPayBankTransfer %}
                                        <div class="box-chooser__sub-selection js-gopay-list-banks display-none">
                                            {% for goPayBankSwiftFormChild in goPayBankSwiftForm %}
                                                {% set goPayBankSwiftFormChildChoice = goPayBankSwiftForm.vars.choices[goPayBankSwiftFormChild.vars.name] %}
                                                {% set goPayBankSwift = goPayBankSwiftFormChildChoice.data %}
                                                <label class="box-chooser__item">
                                                    <span class="box-chooser__item__check">
                                                        {{ form_widget(goPayBankSwiftFormChild, { attr: { class: 'js-order-gopay-bank-swift-input css-checkbox', 'data-swift': goPayBankSwift.swift} }) }}
                                                        <label for="{{goPayBankSwiftFormChild.vars.id}}" class="css-label-checkbox"></label>
                                                    </span>

                                                    <span class="box-chooser__item__image">
                                                        <img src="{{ goPayBankSwift.imageLargeUrl }}">
                                                    </span>

                                                    <span class="box-chooser__item__title">
                                                        <strong class="box-chooser__title__name">
                                                            {{ goPayBankSwift.name }}
                                                        </strong>
                                                    </span>

                                                    <span class="box-chooser__item__price">
                                                        {{ paymentPrice.priceWithVat|priceText }}
                                                    </span>
                                                </label>
                                            {% endfor %}
                                        </div>
                                    {% endif %}
                                {% else %}
                                    {% do form.payment.setRendered %}
                                    {{ 'Nothing to choose from'|trans }}
                                {% endfor %}
                                {% if not bankTransferRendered %}
                                    {% do goPayBankSwiftForm.setRendered %}
                                {% endif %}
                                <div class="box-chooser__toggle">
                                    <button type="button" class="btn box-chooser__toggle__btn js-payment-transport-change-button">
                                        {{ 'Změnit platbu' }}
                                        <i class="box-chooser__toggle__btn__icon svg svg-arrow"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="box-cart__buttons">
                        <div class="box-cart__buttons__back">
                            <button type="submit" name="{{ flow.getFormTransitionKey() }}" value="back" class="btn btn--prev btn-no-style btn--arrow btn--arrow-prev js-no-validate-button">
                                <i class="btn__icon svg svg-chevron"></i>
                                {{ 'Back to cart'|trans }}
                            </button>
                        </div>
                        <div class="box-cart__buttons__next">
                            {{ form_widget(form.save, { label: 'Další krok'|trans, attr: { class: 'btn btn--dark btn--checkout-step js-no-validate-button js-transport_and_payment_form_save' } }) }}
                        </div>
                    </div>
                </div>


                <div class="box-cart__col box-cart__col--preview box-cart__col--preview-step-2">
                    <div id="js-order-preview" class="box-cart-card box-cart-card--preview" data-url="{{ url('front_order_preview') }}">
                        {{ render(controller('App\\Controller\\Front\\OrderController:previewAction', {
                            transportIdsByProductTypeId: splitOrderPreview.transportIdsIndexedByProductTypeId,
                            paymentId: splitOrderPreview.hasPayment() ? splitOrderPreview.payment.id : null,
                            showAdvert: false,
                            showPromo: false
                        })) }}
                    </div>
                </div>
            </div>


        </div>
    </div>

    {{ render(controller('App\\Controller\\Front\\PersonalPickupController:indexAction')) }}
{% endblock %}
