<div id="js-order-transport-stores" class="display-none">
    <h2 class="window-popup__heading window-popup__heading--personal-pickup">{{ 'Vyberte prodejnu kde si vyzvednete zásilku'|trans }}</h2>
    <div class="box-chooser box-chooser--personal-pickup box-chooser--in-popup">
        {% for store in stores %}
            {% set storeAvailabilityText = '' %}
            {% set storeAvailabilityNumber = storeDayAvailabilitiesByStoreId[store.id]|daysToWeeks %}
            {% if storeAvailabilityNumber == 0 %}
                {% set storeAvailabilityText = 'Můžete mít <strong>ihned</strong>'|transHtml %}
            {% elseif storeAvailabilityNumber == 1 %}
                {% set storeAvailabilityText = 'K dispozici do <span>týdne</span>'|transHtml %}
            {% else %}
                {% set storeAvailabilityText = "K dispozici do <span>#{storeAvailabilityNumber}</span> týdnů"|transHtml %}
            {% endif %}
            <label class="box-chooser__item">
                <div class="box-chooser__item__side">
                    <span class="box-chooser__item__check">
                        <input type="radio"
                            name="personalPickupStore"
                            value="{{ store.id }}"
                            class="css-radio personal-pickup-store"
                            data-store-name="{{ store.name }}"
                            data-store-street="{{ store.street }}"
                            data-store-city="{{ store.city }}"
                            data-store-postcode="{{ store.postcode }}"
                            data-store-opening-hours="{{ store.openingHours }}"
                            data-store-availability="{{ storeAvailabilityText|raw }}"
                        />
                        <span class="css-radio__image"></span>
                    </span>
                </div>
                <div class="box-chooser__item__info">
                    <span class="box-chooser__item__title">
                        <strong class="box-chooser__item__title__name">{{ store.name }}</strong>
                    </span>
                    <span class="box-chooser__item__availability">
                        {% transchoice storeDayAvailabilitiesByStoreId[store.id]|daysToWeeks with {'%weeksAvailability%': storeDayAvailabilitiesByStoreId[store.id]|daysToWeeks} %}
                            {0} Můžete mít ihned
                            | {1} K dispozici do 1 týdne
                            | [2,Inf] K dispozici do %weeksAvailability% týdnů
                        {% endtranschoice %}
                    </span>
                </div>
            </label>
        {% endfor %}
    </div>
</div>
