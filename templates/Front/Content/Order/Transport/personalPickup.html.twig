<div id="js-order-transport-stocks" class="display-none">
    <div>
        <h3>{{ 'Vyberte prodejnu kde si vyzvednete zásilku'|trans }}</h3>
        <table>
            <tbody>
            {% for stock in stocks %}
                <tr>
                    <td>
                        <label>
                            <input type="radio"
                                name="personalPickupStock"
                                value="{{ stock.id }}"
                                class="personal-pickup-stock"
                                data-stock-name="{{ stock.name }}"
                                data-stock-street="{{ stock.street }}"
                                data-stock-city="{{ stock.city }}"
                            />
                            {{ stock.name }}
                        </label>
                    </td>
                    <td>{{ stock.street }}<br>{{ stock.city }}</td>
                    <td>
                        {% if stock.openingHours is not empty %}
                            <strong>{{ 'Otevřeno' }}</strong><br/>
                            {{ stock.openingHours|nl2br }}
                        {% endif %}
                    </td>
                    <td></td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>