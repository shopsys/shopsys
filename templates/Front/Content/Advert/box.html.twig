{% if advert %}
    <div class="in-place in-place--{{advert.positionName}}">
        {% if advert.type == 'image' %}
            {% if advert.link == null %}
                <picture>
                    <source media="(max-width: 425px)" srcset="{{ imageUrl(advert, advert.positionName, 'mobile') }}" />
                    <source media="(min-width: 425px)" srcset="{{ imageUrl(advert, advert.positionName, 'web') }}" />
                    <img
                        data-src="{{ imageUrl(advert, advert.positionName, 'web') }}"
                        itemprop="image" class="in-place__img image-noticer-{{advert.positionName}}"
                        loading="lazy"
                    />
                </picture>
            {% else %}
                {% if advert.positionName == "productListMiddle" %}
                    <div class="in-place__wrap">
                        <div class="in-place__content">
                            <h2 class="in-place__heading">{{ advert.name }}</h2>
                            <a class="in-place__btn btn btn--outline" href="{{ advert.link }}">{{ 'Víc informací'|trans }}</a>
                        </div>
                        <div class="in-place__picture">
                            <picture>
                                <source media="(max-width: 425px)" srcset="{{ imageUrl(advert, advert.positionName, 'mobile') }}" />
                                <source
                                    media="(min-width: 425px)"
                                    srcset="{{ imageUrl(advert, 'productListMiddleRetina', 'web') }} 2x, {{ imageUrl(advert, advert.positionName, 'web') }} 1x"
                                />
                                <img
                                    data-src="{{ imageUrl(advert, advert.positionName, 'web') }}"
                                    itemprop="image"
                                    class="in-place__img image-noticer-{{advert.positionName}}"
                                    loading="lazy"
                                />
                            </picture>
                        </div>
                    </div>
                {% else %}
                    <a href="{{ advert.link }}">
                        <picture>
                            <source media="(max-width: 425px)" srcset="{{ imageUrl(advert, advert.positionName, 'mobile') }}" />
                            <source media="(min-width: 425px)" srcset="{{ imageUrl(advert, advert.positionName, 'web') }}" />
                            <img
                                data-src="{{ imageUrl(advert, advert.positionName, 'web') }}"
                                itemprop="image" class="in-place__img image-noticer-{{advert.positionName}}"
                                loading="lazy"
                            />
                        </picture>
                    </a>
                {% endif %}
            {% endif %}
        {% elseif advert.type == 'code' %}
            {{ advert.code | raw }}
        {% endif %}
    </div>
{% endif %}
