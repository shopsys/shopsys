{% extends 'Front/Layout/layoutWithoutPanel.html.twig' %}

{% block meta_robots -%}
    <meta name="robots" content="noindex, follow">
{% endblock %}

{% block title %}
    {{ 'My orders'|trans }}
{% endblock %}

{% block breadcrumb %}
{% endblock %}

{% block main_content %}
   <div class="web__line web__line--grey web__line--spacing web__line--spacing--big web__line--margin-bottom-up">
        <div class="web__container">
            <h1 class="web__container__heading">{{ 'My orders'|trans }}</h1>
            {{ render(controller('App\\Controller\\Front\\BreadcrumbController:indexAction', { routeName: getRoute(), routeParameters: getRouteParams() } )) }}
            {% if orders|length == 0 %}
                {{ 'No order so far.'|trans }}
            {% else %}
                <div class="in-scroll box-table box-table--orders">
                    <div class="in-scroll__in">
                        <table class="box-table__table">
                            <tr class="box-table__row">
                                <th class="box-table__item box-table__item--order-number box-table__item--heading">{{ 'Order number'|trans }}</th>
                                <th class="box-table__item box-table__item--heading text-right">{{ 'Datum objednávky'|trans }}</th>
                                <th class="box-table__item box-table__item--orders-count box-table__item--heading text-right">{{ 'Number of items'|trans }}</th>
                                <th class="box-table__item box-table__item--heading">{{ 'Shipping'|trans }}</th>
                                <th class="box-table__item box-table__item--payment-name box-table__item--heading">{{ 'Payment'|trans }}</th>
                                <th class="box-table__item box-table__item--heading text-right">{{ 'Total price including VAT'|trans }}</th>
                                <th class="box-table__item box-table__item--heading text-center">&nbsp;</th>
                            </tr>
                            {% for order in orders %}
                                <tr class="box-table__row">
                                    <td class="box-table__item box-table__item--order-number">
                                        <a href="{{ url('front_customer_order_detail_registered', { orderNumber: order.number }) }}">{{ order.number }}</a>
                                    </td>
                                    <td class="box-table__item text-right">{{ order.createdAt|formatDate }}</td>
                                    <td class="box-table__item box-table__item--orders-count text-right">{{ order.productItemsCount }}</td>
                                    <td class="box-table__item box-table__item--transports">
                                        {% for transportItem in order.getTransports %}
                                            {% if imageExists(transportItem) %}
                                                <span class="box-table__item__img box-table__item__img--{{ loop.index }}">
                                                    {{ image(transportItem) }}
                                                </span>
                                            {% endif %}
                                            <span class="box-table__item__transport box-table__item__transport--{{ loop.index }}">{{ transportItem.name }}</span>
                                        {% endfor %}
                                    </td>
                                    <td class="box-table__item box-table__item--payment-name">{{ order.paymentName }}</td>
                                    <td class="box-table__item box-table__item--price text-right">{{ order.totalPriceWithVat|priceWithCurrency(order.currency) }}</td>
                                    <td class="box-table__item box-table__item--detail text-center">
                                        <a href="{{ url('front_customer_order_detail_registered', { orderNumber: order.number }) }}" class="in-icon in-icon--detail">
                                            {{ 'Detail'|trans }}
                                            <i class="box-table__item--detail__icon svg svg-chevron"></i>
                                        </a>
                                    </td>
                                </tr>
                            {% endfor %}
                        </table>
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}

{% block footer %}
    {% include 'Front/Layout/footer.html.twig' with { 'showNewsletter' : false } %}
{% endblock %}
