{% extends 'Front/Layout/layoutWithoutPanel.html.twig' %}

{% import 'Front/Content/Customer/orderItemsTableMacro.html.twig' as orderItemsTableMacro %}

{% block meta_robots -%}
    <meta name="robots" content="noindex, follow">
{% endblock %}

{% block title %}
    {{ 'My orders'|trans }}
{% endblock %}

{% block breadcrumb %}
{% endblock %}

{% block main_content %}
   <div class="web__line web__line--grey web__line--spacing web__line--spacing--big web__line--margin-bottom-up">
        <div class="web__container">
            <h1 class="heading heading--primary heading--primary-subpage">{{ 'Order Nr.'|trans }} {{order.number}}</h1>
            {{ render(controller('App\\Controller\\Front\\BreadcrumbController:indexAction', { routeName: getRoute(), routeParameters: getRouteParams() } )) }}
            <div class="box-order-detail">

                <div class="wrap-box">
                    <div class="wrap-box__in">
                        <div class="wrap-box__in__col">
                            <h2 class="wrap-box__title">{{ 'Basic information'|trans }}</h2>
                            <table class="box-table box-table--fullwidth box-table--vertical box-table--params">
                                <tr class="box-table__row">
                                    <th class="box-table__item box-table__item--heading">{{ 'Creation date'|trans }}: </th>
                                    <td class="box-table__item text-right">{{ order.createdAt|formatDate }}</td>
                                </tr>
                            </table>
                        </div>
                        {% if order.payment.goPay is same as (true) and order.gopayPaid == false %}
                            <div class="wrap-box__in__col wrap-box__in__col--last wrap-box__in__col--payment-repeat">
                                <a class="btn btn--dark btn--inline-block btn--center" href="{{ url('front_order_repeat_gopay_payment', { urlHash: order.urlHash }) }}">
                                    {{ 'Opakovat platbu'|trans }}
                                </a>
                            </div>
                        {% endif %}
                    </div>
                </div>


                <div class="wrap-box">
                    <div class="wrap-box__in">
                        <div class="wrap-box__in__col wrap-box__in__col--first">
                            <h2 class="wrap-box__title">{{ 'Billing address'|trans }}</h2>
                            <table class="box-table box-table--fullwidth box-table--vertical box-table--params">
                                <tr class="box-table__row">
                                    <th class="box-table__item box-table__item--heading">{{ 'First name'|trans }}: </th>
                                    <td class="box-table__item">{{ order.firstName }}</td>
                                </tr>
                                <tr class="box-table__row">
                                    <th class="box-table__item box-table__item--heading">{{ 'Last name'|trans }}: </th>
                                    <td class="box-table__item">{{ order.lastName }}</td>
                                </tr>
                                <tr class="box-table__row">
                                    <th class="box-table__item box-table__item--heading">{{ 'Email'|trans }}: </th>
                                    <td class="box-table__item">{{ order.email }}</td>
                                </tr>
                                <tr class="box-table__row">
                                    <th class="box-table__item box-table__item--heading">{{ 'Telephone'|trans }}: </th>
                                    <td class="box-table__item">{{ order.telephone }}</td>
                                </tr>
                                {% if order.companyName is not null %}
                                    <tr class="box-table__row">
                                        <th class="box-table__item box-table__item--heading">{{ 'Company name'|trans }}: </th>
                                        <td class="box-table__item">{{ order.companyName }}</td>
                                    </tr>
                                {% endif %}
                                {% if order.companyNumber is not null %}
                                    <tr class="box-table__row">
                                        <th class="box-table__item box-table__item--heading">{{ 'Company number'|trans }}: </th>
                                        <td class="box-table__item">{{ order.companyNumber }}</td>
                                    </tr>
                                {% endif %}
                                {% if order.companyTaxNumber is not null %}
                                    <tr class="box-table__row">
                                        <th class="box-table__item box-table__item--heading">{{ 'Tax number'|trans }}: </th>
                                        <td class="box-table__item">{{ order.companyTaxNumber }}</td>
                                    </tr>
                                {% endif %}
                                <tr class="box-table__row">
                                    <th class="box-table__item box-table__item--heading">{{ 'Ulice a č. popisné'|trans }}: </th>
                                    <td class="box-table__item">{{ order.street }}</td>
                                </tr>
                                <tr class="box-table__row">
                                    <th class="box-table__item box-table__item--heading">{{ 'City'|trans }}: </th>
                                    <td class="box-table__item">{{ order.city }}</td>
                                </tr>
                                <tr class="box-table__row">
                                    <th class="box-table__item box-table__item--heading">{{ 'Postcode'|trans }}: </th>
                                    <td class="box-table__item">{{ order.postcode }}</td>
                                </tr>
                            </table>
                        </div>
                        {% if order.deliveryStreet is not null %}
                            <div class="wrap-box__in__col wrap-box__in__col--last">
                                <h2 class="wrap-box__title">{{ 'Delivery address'|trans }}</h2>
                                <table class="box-table box-table--fullwidth box-table--vertical box-table--params">
                                    {% if order.deliveryFirstName is not null %}
                                        <tr class="box-table__row">
                                            <th class="box-table__item box-table__item--heading">{{ 'First name'|trans }}: </th>
                                            <td class="box-table__item">{{ order.deliveryFirstName }}</td>
                                        </tr>
                                    {% endif %}
                                    {% if order.deliveryLastName is not null %}
                                        <tr class="box-table__row">
                                            <th class="box-table__item box-table__item--heading">{{ 'Last name'|trans }}: </th>
                                            <td class="box-table__item">{{ order.deliveryLastName }}</td>
                                        </tr>
                                    {% endif %}
                                    {% if order.deliveryCompanyName is not null %}
                                        <tr class="box-table__row">
                                            <th class="box-table__item box-table__item--heading">{{ 'Company'|trans }}: </th>
                                            <td class="box-table__item">{{ order.deliveryCompanyName }}</td>
                                        </tr>
                                    {% endif %}
                                    {% if order.deliveryTelephone is not null %}
                                        <tr class="box-table__row">
                                            <th class="box-table__item box-table__item--heading">{{ 'Telephone'|trans }}: </th>
                                            <td class="box-table__item">{{ order.deliveryTelephone }}</td>
                                        </tr>
                                    {% endif %}
                                    <tr class="box-table__row">
                                        <th class="box-table__item box-table__item--heading">{{ 'Ulice a č. popisné'|trans }}: </th>
                                        <td class="box-table__item">{{ order.deliveryStreet }}</td>
                                    </tr>
                                    <tr class="box-table__row">
                                        <th class="box-table__item box-table__item--heading">{{ 'City'|trans }}: </th>
                                        <td class="box-table__item">{{ order.deliveryCity }}</td>
                                    </tr>
                                    <tr class="box-table__row">
                                        <th class="box-table__item box-table__item--heading">{{ 'Postcode'|trans }}: </th>
                                        <td class="box-table__item">{{ order.deliveryPostcode }}</td>
                                    </tr>
                                </table>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>

            <h2 class="heading heading--primary heading--secondary-subpage">{{ 'Váš nákup'|trans }}</h2>

            {% set allUsedProductTypes = order.allUsedProductTypes %}
            {% if allUsedProductTypes|length > 1 %}
                {% for productType in allUsedProductTypes %}
                    <div class="wrap-box wrap-box--small-spacing">
                        <div class="wrap-box__in wrap-box__in--no-spacing">
                            <h2 class="wrap-box__title wrap-box__title--spaced">{{ 'Zásilka'|trans }} - {{ productType.name }}</h2>
                            {{ orderItemsTableMacro.table(order.itemsByProductType(productType), orderItemTotalPricesById, order.currency) }}
                        </div>
                    </div>
                {% endfor %}
            {% else %}
                {{ orderItemsTableMacro.table(order.items, orderItemTotalPricesById, order.currency) }}
            {% endif %}
        </div>
    </div>
{% endblock %}

{% block footer %}
    {% include 'Front/Layout/footer.html.twig' with { 'showNewsletter' : false } %}
{% endblock %}
