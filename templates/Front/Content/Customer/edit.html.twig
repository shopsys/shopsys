{% extends 'Front/Layout/layoutWithoutPanel.html.twig' %}

{% block meta_robots -%}
    <meta name="robots" content="noindex, follow">
{% endblock %}

{% block breadcrumb %}
{% endblock %}

{% block main_content %}
    <div class="web__line web__line--spacing--big web__line--margin-bottom-up-big">
        <div class="web__container">
             <h1 class="heading heading--primary heading--primary-subpage">{{ 'Upravit údaje'|trans }}</h1>
            {{ render(controller('App\\Controller\\Front\\BreadcrumbController:indexAction', { routeName: getRoute(), routeParameters: getRouteParams() } )) }}
            {{ form_start(form) }}
                {{ form_errors(form) }}

                <div id="{{ form.customerUserData.vars.id }}">
                    <div class="box-form box-form--registration box-form--small">
                        <div class="box-form__section">
                            <h2 class="in-title">{{ 'Personal data'|trans }}</h2>
                        
                            {{ form_row(form.customerUserData.email, {
                                label: 'Váš e-mail'|trans
                            }) }}

                            <p>
                                {{ 'To prevent the possibility of account theft, the change of the email address must be dealt with individually. If your email address has changed, please contact us.'|trans }}
                            </p>

                            <div class="form-columns">
                                <div class="form-columns__item">
                                    {{ form_row(form.customerUserData.firstName, {
                                        label: 'First name'|trans
                                    }) }}
                                </div>
                                <div class="form-columns__item">
                                    {{ form_row(form.customerUserData.lastName, {
                                        label: 'Last name'|trans
                                    }) }}
                                </div>
                            </div>

                            {{ form_row(form.customerUserData.telephone, {
                                label: 'Telephone'|trans
                            }) }}

                            {{ form_row(form.customerUserData.newsletterSubscription, { label: 'Souhlasím se zasíláním newsletteru'|trans }) }}
                        </div>

                        <div class="box-form__section">
                            <h2 class="in-title">{{ 'Changing password'|trans }}</h2>
                            <div class="form-columns" id="{{ form.customerUserData.password.vars.id }}">
                                <div class="form-columns__item">
                                    {{ form_row(form.customerUserData.password.first, {
                                        label: 'Password'|trans
                                    }) }}
                                </div>
                                <div class="form-columns__item">
                                    {{ form_row(form.customerUserData.password.second, {
                                        label: 'Password again'|trans
                                    }) }}
                                </div>
                            </div>
                        </div>

                        <div class="box-form__section" id="{{ form.billingAddressData.vars.id }}">
                            {% if isCompanyCustomer %}
                                <h2 class="in-title">{{ 'Company data'|trans }}</h2>
                                <div id="js-company-fields">
                                    {{ form_row(form.billingAddressData.companyName, { label: 'Company'|trans}) }}
                                    {{ form_row(form.billingAddressData.companyNumber, { label: 'Company number'|trans}) }}
                                    {{ form_row(form.billingAddressData.companyTaxNumber, { label: 'Tax number'|trans }) }}
                                </div>
                            {% else %}
                                {% do form.billingAddressData.companyName.setRendered() %}
                                {% do form.billingAddressData.companyNumber.setRendered() %}
                                {% do form.billingAddressData.companyTaxNumber.setRendered() %}
                            {% endif %}
                        </div>
                        
                        <div class="box-form__section">
                            <h2 class="in-title">{{ 'Fakturační adresa'|trans }}</h2>
                            {{ form_row(form.billingAddressData.street, {
                                label: 'Ulice a č. popisné'|trans
                            }) }}

                            <div class="form-columns">
                                <div class="form-columns__item">
                                    {{ form_row(form.billingAddressData.city, {
                                        label: 'City'|trans
                                    }) }}
                                </div>
                                <div class="form-columns__item">
                                    {{ form_row(form.billingAddressData.postcode, {
                                        label: 'Postcode'|trans
                                    }) }}
                                </div>
                            </div>

                            {{ form_row(form.billingAddressData.country, {
                                label: 'Country'|trans
                            }) }}
                        </div>

                        <div class="box-form__section box-form__section--without-gap" id="{{ form.deliveryAddressData.vars.id }}" class="box-chooser-check-wrap js-delivery-address-form">
                            {{ form_row(form.customerUserData.defaultDeliveryAddress) }}
                            <div class="box-chooser-check-wrap__in">
                                <div class="box-chooser box-chooser--check box-chooser--check--spaced">
                                    <span class="box-chooser__item">
                                        {{ form_row(form.deliveryAddressData.addressFilled, {
                                            attr: { class: 'js-checkbox-toggle js-delivery-address-address-filled', 'data-checkbox-toggle-container-id': 'js-delivery-address-fields' },
                                            label: 'Přidat dodací adresu'|trans
                                        }) }}
                                        <picture>
                                            <source srcset="{{ asset('public/frontend/images/marker_2x.png') }} 2x, {{ asset('public/frontend/images/marker.png') }} 1x" />
                                            <img class="box-chooser__item__marker" loading="lazy" src="" data-src="{{ asset('public/frontend/images/marker.png') }}" alt="{{ 'Dodací adresa'|trans }}">
                                        </picture>
                                    </span>
                                </div>
                                <div class="box-chooser__item__in" id="js-delivery-address-fields">
                                    {{ form_row(form.deliveryAddressData.companyName, {
                                        label: 'Company'|trans
                                    }) }}
                                    {{ form_row(form.deliveryAddressData.firstName, {
                                        label: 'First name'|trans
                                    }) }}
                                    {{ form_row(form.deliveryAddressData.lastName, {
                                        label: 'Last name'|trans
                                    }) }}
                                    {{ form_row(form.deliveryAddressData.telephone, {
                                        label: 'Telephone'|trans
                                    }) }}
                                    {{ form_row(form.deliveryAddressData.street, {
                                        label: 'Ulice a č. popisné'|trans
                                    }) }}

                                    <div class="form-columns">
                                        <div class="form-columns__item">
                                            {{ form_row(form.deliveryAddressData.city, {
                                                label: 'City'|trans
                                            }) }}
                                        </div>
                                        <div class="form-columns__item">
                                            {{ form_row(form.deliveryAddressData.postcode, {
                                                label: 'Postcode'|trans
                                            }) }}
                                        </div>
                                    </div>

                                    {{ form_row(form.deliveryAddressData.country, {
                                        label: 'Country'|trans
                                    }) }}
                                </div>
                            </div>
                        </div>

                        <div class="box-form__buttons">
                            {{ form_widget(form.save, {
                                label: 'Uložit údaje'|trans,
                                attr: {
                                    class: 'btn btn--no-icon'
                                }
                            }) }}
                            <a href="{{ url('front_homepage') }}" class="btn btn--arrow btn--arrow-prev">
                                <i class="btn__icon svg svg-arrow"></i>
                                {{ 'Zrušit úpravy'|trans }}
                            </a>
                        </div>
                    </div>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
