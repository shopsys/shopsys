<nav class="mobile-sliding-menu-wrap">
    <div id="js-mobile-sliding-menu" class="mobile-sliding-menu">
        <div class="mobile-sliding-menu__container">
            <div id="js-mobile-sliding-menu__draggable" class="mobile-sliding-menu__draggable">
                {% for menuItem in menuItems %}
                    {% if menuItem['id'] is not null %}
                        <a href="{{ url(menuItem['route'], { id: menuItem['id'] }) }}" class="mobile-sliding-menu__link">
                            {{ menuItem['name'] }}
                        </a>
                    {% else %}
                        <a href="{{ url(menuItem['route']) }}" class="mobile-sliding-menu__link">
                            {{ menuItem['name'] }}
                        </a>
                    {% endif %}
                {% endfor %}
            </div>
            <div class="clear"></div>
        </div>
    </div>
</nav>