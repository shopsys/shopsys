
    {% set currentMenuListId = currentMenuListId ?? 0 %}
    {% set parentMenuListId = parentMenuListId ?? 'null' %}

    {% if isFirstLevel %}
        <nav class="in-mobile-dropdown display-none js-mobile-dropdown-container">
            <div class="in-mobile-dropdown__button">
                <div class="in-hamburger in-hamburger--active js-mobile-dropdown-button">
                    <div class="in-hamburger__icon">
                        <span></span>
                        <span></span>
                        <span></span>
                        <span></span>
                    </div>
                    <span class="in-hamburger__text in-hamburger__text--open">{{ 'Menu'|trans }}</span>
                    <span class="in-hamburger__text in-hamburger__text--close">{{ 'Zavřít'|trans }}</span>
                </div>
            </div>
    {% endif %}

    <ul class="mobile-menu
            mobile-menu--level-{{ currentMenuListId }}
            dont-print
            js-mobile-menu-list
            {% if isFirstLevel %}show-position{% endif %}
            "
        id="js-mobile-menu-list-{{ currentMenuListId }}"
        data-parent-menu-id="{{ parentMenuListId }}"
    >
        {% if isFirstLevel == false %}
            <li class="mobile-menu__item mobile-menu__item--head js-mobile-menu-item">
                <span class="mobile-menu__item__back-control js-mobile-menu-collapse-control" data-parent-menu-id="#js-mobile-menu-list-{{ parentMenuListId }}">
                    <i class="mobile-menu__item__back-control__icon svg svg-arrow"></i>
                    {{ 'Zpět'|trans }}
                </span>
                <div class="mobile-menu__item__category">
                    {{ childCategoryName|slice(0,40) }}{% if childCategoryName|length > 40 %}&hellip;{% endif %}
                </div>
            </li>
            <li class="mobile-menu__item mobile-menu__item--current">
                <a
                    href="{{ url('front_product_list', { id: currentMenuListId }) }}"
                    class="mobile-menu__item__link">
                    <span class="mobile-menu__item__link__text">{{ 'Zobrazit všechno'|trans }}</span>
                </a>
            </li>
        {% endif %}

        {% for categoryWithLazyLoadedVisibleChildren in categoriesWithLazyLoadedVisibleChildren %}
            <li class="mobile-menu__item js-mobile-menu-item">
                <a
                    href="{{ url('front_product_list', { id: categoryWithLazyLoadedVisibleChildren.category.id }) }}"
                    class="mobile-menu__item__link{{ categoryWithLazyLoadedVisibleChildren.hasChildren ? ' mobile-menu__item__link--has-children js-mobile-menu-item-link js-mobile-menu-expand-control' }}"
                    {% if categoryWithLazyLoadedVisibleChildren.hasChildren %}
                        data-child-menu-id="#js-mobile-menu-list-{{ categoryWithLazyLoadedVisibleChildren.category.id }}"
                    {% endif %}
                    >
                    <span class="mobile-menu__item__link__text">{{ categoryWithLazyLoadedVisibleChildren.category.name }}</span>
                    {% if categoryWithLazyLoadedVisibleChildren.hasChildren %}
                        <i class="mobile-menu__item__control svg svg-arrow"></i>
                    {% endif %}
                </a>
            </li>
        {% endfor %}

        {% if isFirstLevel %}
            <li class="mobile-menu__item mobile-menu__item--small">
                <a class="mobile-menu__item__link js-not-implemented-yet" href="">
                    {{ "Zákaznický servis"|trans }}
                </a>
            </li>

            <li class="mobile-menu__item mobile-menu__item--small">
                <a class="mobile-menu__item__link js-not-implemented-yet" href="">
                    {{ "Prodejny"|trans }}
                </a>
            </li>

            <li class="mobile-menu__item mobile-menu__item--small">
                <a class="mobile-menu__item__link js-not-implemented-yet" href="">
                    {{ "Přihlásit se"|trans }}
                </a>
            </li>
        {% endif %}
    </ul>

    {% for categoryWithLazyLoadedVisibleChildren in categoriesWithLazyLoadedVisibleChildren %}
        {% set categoriesWithLazyLoadedVisibleChildren = categoryWithLazyLoadedVisibleChildren.children %}

        {% include _self with {
            isFirstLevel: false,
            currentMenuListId: categoryWithLazyLoadedVisibleChildren.category.id,
            parentMenuListId: currentMenuListId,
            childCategoryName: categoryWithLazyLoadedVisibleChildren.category.name
        } %}
    {% endfor %}

    {% if isFirstLevel %}
        </nav>
    {% endif %}
