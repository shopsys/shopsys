{% if categoriesWithLazyLoadedVisibleChildren|length > 0 %}
    {% set currentMenuListId = currentMenuListId ?? 0 %}
    {% set parentMenuListId = parentMenuListId ?? 'null' %}

    {% if isFirstLevel %}
        <nav class="mobile-menu-wrap">
        <div id="js-mobile-menu" class="mobile-menu-wrap__container display-none">
    {% endif %}

    <ul class="mobile-menu
            dont-print
            js-mobile-menu-list
            {% if isFirstLevel %}show-position{% endif %}
            "
        id="js-mobile-menu-list-{{ currentMenuListId }}"
        data-parent-menu-id="{{ parentMenuListId }}"
    >
        {% if isFirstLevel == false %}
        <li class="mobile-menu__item js-mobile-menu-item">
            <span>
                <span class="mobile-menu__item__back-control js-mobile-menu-collapse-control" data-parent-menu-id="#js-mobile-menu-list-{{ parentMenuListId }}">
                    &lt {{ 'zpět'|trans }}
                </span>
                <span class="mobile-menu__item__back">{{ childCategoryName }}</span>
            </span>
        </li>
        {% endif %}
        {% for categoryWithLazyLoadedVisibleChildren in categoriesWithLazyLoadedVisibleChildren %}
            <li class="mobile-menu__item js-mobile-menu-item">
                <a
                    href="{{ url('front_product_list', { id: categoryWithLazyLoadedVisibleChildren.category.id }) }}"
                    class="mobile-menu__item__link">
                    {{ categoryWithLazyLoadedVisibleChildren.category.name }}
                    {% if categoryWithLazyLoadedVisibleChildren.hasChildren %}
                        <span class="mobile-menu__item__control js-mobile-menu-expand-control"
                           data-child-menu-id="#js-mobile-menu-list-{{ categoryWithLazyLoadedVisibleChildren.category.id }}">
                            &gt;
                        </span>
                    {% endif %}
                </a>
            </li>
        {% endfor %}
        {% if isFirstLevel %}
            <li class="mobile-menu__item mobile-menu__item--sale">
                <a
                    href="#"
                    class="mobile-menu__item__link mobile-menu__item__link--sale mobile-menu__item__link--level-1 js-not-implemented-yet">
                    <i class="svg svg-cart"></i> {{ "Výprodej"|trans }}
                </a>
            </li>
            <li class="mobile-menu__item mobile-menu__item--blog">
                <a
                    href="{{ url('front_blogcategory_detail', { id: constant('App\\Model\\Blog\\Category\\BlogCategory::BLOG_MAIN_PAGE_CATEGORY_ID')}) }}"
                    class="mobile-menu__item__link mobile-menu__item__link--blog mobile-menu__item__link--level-1">
                    {{ "Magazín"|trans }}
                </a>
            </li>
        {% endif %}
    </ul>

    {% for categoryWithLazyLoadedVisibleChildren in categoriesWithLazyLoadedVisibleChildren %}
        {% set categoriesWithLazyLoadedVisibleChildren = categoryWithLazyLoadedVisibleChildren.children %}

        {% include _self with {
            isFirstLevel: false,
            currentMenuListId: categoryWithLazyLoadedVisibleChildren.category.id,
            parentMenuListId: currentMenuListId,
            childCategoryName: categoryWithLazyLoadedVisibleChildren.category.name
        } %}
    {% endfor %}

    {% if isFirstLevel %}
        </div>
        </nav>
    {% endif %}

{% endif %}