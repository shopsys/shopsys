<ul class="list-categories js-slider-drawable-list-mobile" data-breakpoint="mobile">
    {% for category in categories %}
        <li class="list-categories__item">
            <a href="{{ url('front_product_list', { id: category.id }) }}" class="list-categories__item__block">
                <div class="list-categories__item__image">
                    {{ image(category, { alt: category.name }) }}
                </div>
                <p class="list-categories__item__name">
                    {{ category.name }}
                    {% if listableProductCountsIndexedByCategoryId is not empty %}
                        <span class="list-categories__item__count">
                            ({{ listableProductCountsIndexedByCategoryId[category.id] }})
                        </span>
                    {% endif %}
                </p>
            </a>
        </li>
    {% endfor %}
</ul>
