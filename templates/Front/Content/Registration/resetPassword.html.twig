{% extends 'Front/Layout/layoutWithoutPanel.html.twig' %}

{% block meta_robots -%}
    <meta name="robots" content="noindex, follow">
{% endblock %}

{% block title %}
    {{ 'Forgotten password'|trans }}
{% endblock %}

{% block breadcrumb %}
{% endblock %}

{% block main_content %}
    <div class="web__line web__line--spacing--big web__line--margin-bottom-up-big">
        <div class="web__container">
            <h1 class="heading heading--primary heading--primary-subpage">{{ 'Forgotten password'|trans }}</h1>
            {{ render(controller('App\\Controller\\Front\\BreadcrumbController:indexAction', { routeName: getRoute(), routeParameters: getRouteParams() } )) }}

            <div class="box-form box-form--forgot-pswd">
                {{ form_errors(form) }}
                {{ form_start(form) }}

                    {{ form_row(form.email, {
                        label: 'Váš e-mail'|trans,
                        rowClass: 'form-line-block js-form-field'
                    }) }}

                    {{ form_widget(form.submit, {
                        label: 'Reset password'|trans,
                        attr: {'class' : 'btn--submit-next'}
                    }) }}

                {{ form_end(form) }}
            </div>
        </div>
    </div>
{% endblock %}
