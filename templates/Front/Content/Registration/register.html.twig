{% extends 'Front/Layout/layoutWithoutPanel.html.twig' %}

{% block title %}
    {{ 'Registration'|trans }}
{% endblock %}

{% block breadcrumb %}
{% endblock %}

{% block main_content %}
    {%  set companyTabActiveClass = form.companyCustomer.vars.data ? "active" : "" %}

    <div class="web__line web__line--spacing--big web__line--margin-bottom-up-big">
        <div class="web__container">
            <h1 class="heading heading--primary heading--primary-subpage">{{ 'Registration'|trans }}</h1>
            {{ render(controller('App\\Controller\\Front\\BreadcrumbController:indexAction', { routeName: getRoute(), routeParameters: getRouteParams() } )) }}
            {{ form_start(form, {attr: {
                'data-email-check-url': url('front_customer_email_check'),
                'data-customer-info': customerInfo|json_encode
            }}) }}
            {{ form_errors(form) }}
            {{ form_widget(form.companyCustomer, { attr: { class: 'display-none'}}) }}
            <div class="box-form box-form--registration box-form--small">
                <div class="box-login box-login--registration">
                    <div class="box-login__profile box-login__profile--standalone">
                        <strong class="box-login__profile__text-strong">{{ 'Nemáte ještě účet? Registrujte se.'|trans }}</strong>
                        <span class="box-login__profile__text-small">{{ 'Budete u nás nakupovat jako:'|trans }}</span>
                        <div class="box-login__profile__icon">
                            <picture>
                                <source srcset="{{ asset('public/frontend/images/qmark2x.png') }} 2x, {{ asset('public/frontend/images/qmark.png') }} 1x" />
                                <img class="box-login__profile__icon__img" loading="lazy" src="" data-src="{{ asset('public/frontend/images/qmark.png') }}" alt="{{ 'Profil'|trans }}">
                            </picture>
                        </div>
                    </div>
                </div>
                {{ form_row(form.email, { label: 'Váš e-mail'|trans, attr: {'data-request-url' : url('front_registration_exists_email') } }) }}
                {{ form_row(form.firstName, { label: 'First name'|trans }) }}
                {{ form_row(form.lastName, { label: 'Last name'|trans }) }}
                {{ form_row(form.telephone, { label: 'Telefon'|trans }) }}
                <div class="js-responsive-tabs js-tabs-only">
                    <div class="dont-print js-registration-form-customer-type-selector">
                        <input type="checkbox" class="css-radio"></input>
                        <label class="css-radio__image js-tabs-button" data-tab-id="common-customer">
                            {{ "Koncový zákazník"|trans }}
                        </label>
                        <input type="checkbox" class="css-radio"></input>
                        <label class="css-radio__image js-tabs-button" data-tab-id="company-customer">
                            {{ "Firma"|trans }}
                        </label>
                    </div>
                    <div class="box-form__item-hidden js-tabs-content {{ companyTabActiveClass }}" data-tab-id="company-customer">
                        <h2>{{ 'Company data'|trans }}</h2>
                        {{ form_row(form.companyName, { label: 'Název společnosti'|trans }) }}
                        {{ form_row(form.companyNumber, { label: 'Company number'|trans }) }}
                        {{ form_row(form.companyTaxNumber, { label: 'Tax number'|trans }) }}
                    </div>
                    <div id="js-registration-form-password-container">
                        <h2>{{ 'Password'|trans }}</h2>
                        {{ form_row(form.password.first, { label: 'Password'|trans }) }}
                        {{ form_row(form.password.second, { label: 'Password again'|trans }) }}
                    </div>
                    <div id="js-registration-form-activation-info">
                        <p>{{ 'Po odeslání formuláře Vám zašleme e-mail s instrukcemi pro dokončení registrace'|trans }}</p>
                    </div>
                    <h2>{{ 'Fakturační adresa'|trans }}</h2>
                    {{ form_row(form.street, { label: 'Ulice a č. popisné'|trans }) }}
                    <div class="form-columns">
                        <div class="form-columns__item">
                            {{ form_row(form.city, { label: 'Město'|trans }) }}
                        </div>
                        <div class="form-columns__item">
                            {{ form_row(form.postcode, { label: 'PSČ'|trans }) }}
                        </div>
                    </div>
                    {{ form_row(form.country, { label: 'Country'|trans }) }}
                    <div class="form-line">
                        <div class="form-choice">
                            {{ form_widget(form.privacyPolicy, { attr: { class: "css-checkbox" } }) }}
                            <label for="{{ form.privacyPolicy.vars.id }}" class="css-checkbox__image">
                                {% if privacyPolicyArticle is not null %}
                                    {% set articleUrl = url('front_article_detail', {'id': privacyPolicyArticle.id}) %}
                                    {{ 'I agree with <a href="%url%" target="_blank">privacy policy</a>.'|trans({'%url%': articleUrl})|raw }}
                                {% else %}
                                    {{ 'I agree with privacy policy.'|trans }}
                                {% endif %}
                                <span class="form-input-required">*</span>
                            </label>
                            <div class="js-validation-errors-list js-validation-error-list-{{ form.privacyPolicy.vars.id }} form-error form-error--choice display-none">
                                <span class="form-error__icon">
                                    <i class="svg svg-cross"></i>
                                </span>
                                <ul class="form-error__list"></ul>
                            </div>
                        </div>
                    </div>
                    {{ form_row(form.newsletterSubscription, { label: 'Souhlasím se zasíláním newsletteru'|trans }) }}

                    <div class="box-form__submit">
                        {{ form_widget(form.save, { label: 'Register'|trans }) }}
                    </div>
                </div>
            </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
