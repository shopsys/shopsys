{{ form_start(companyForm) }}
<div class="form-line-block-section form-line-block-section--no-spacing">
    {{ form_row(companyForm.email, { label: 'Váš e-mail'|trans, rowClass: 'form-line-block js-form-field', attr: {'data-request-url' : url('front_registration_exists_email') } }) }}
    {{ form_row(companyForm.telephone, { label: 'Telefon'|trans, rowClass: 'form-line-block js-form-field' }) }}
</div>
<div class="form-line-block-section">
    {{ form_row(companyForm.companyName, { label: 'Název společnosti'|trans, rowClass: 'form-line-block js-form-field' }) }}
    {{ form_row(companyForm.companyNumber, { label: 'Company number'|trans, rowClass: 'form-line-block js-form-field' }) }}
    {{ form_row(companyForm.companyTaxNumber, { label: 'Tax number'|trans, rowClass: 'form-line-block js-form-field' }) }}
    {% if domain.id == 2 %}
        {{ form_row(companyForm.companyNumberWithVat, { label: 'Tax number with vat'|trans, rowClass: 'form-line-block js-form-field' }) }}
    {% endif %}
</div>
<div class="form-line-block-section">
    <h2 class="form-line-block-section__heading">{{ 'Password'|trans }}</h2>
    {{ form_row(companyForm.password.first, {
        label: 'Password'|trans,
        rowClass: 'form-line-block js-form-field'
    }) }}
    {{ form_row(companyForm.password.second, { label: 'Password again'|trans, rowClass: 'form-line-block js-form-field' }) }}
</div>
<div class="form-line-block-section">
    <h2 class="form-line-block-section__heading">{{ 'Fakturační adresa'|trans }}</h2>
    {{ form_row(companyForm.street, { label: 'Ulice a č. popisné'|trans, rowClass: 'form-line-block js-form-field' }) }}
    <div class="form-line-block-section__grid">
        {{ form_row(companyForm.city, { label: 'Město'|trans, rowClass: 'form-line-block form-line-block--full-width form-line-block--first js-form-field' }) }}
        {{ form_row(companyForm.postcode, { label: 'PSČ'|trans, rowClass: 'form-line-block form-line-block--small-width js-form-field' }) }}
    </div>
</div>
<dl class="form-line-block form-line-block--check">
    <dd>
        <div class="form-choice">
            {{ form_widget(companyForm.privacyPolicy, { attr: { class: "css-checkbox" } }) }}
            <label for="{{ companyForm.privacyPolicy.vars.id }}" class="css-checkbox__image">
                {% if privacyPolicyArticle is not null %}
                    {% set articleUrl = url('front_article_detail', {'id': privacyPolicyArticle.id}) %}
                    {{ 'I agree with <a href="%url%" target="_blank">privacy policy</a>.'|trans({'%url%': articleUrl})|raw }}
                {% else %}
                    {{ 'I agree with privacy policy.'|trans }}
                {% endif %}
                <span class="form-input-required">*</span>
            </label>
            <div class="js-validation-errors-list js-validation-error-list-{{ companyForm.privacyPolicy.vars.id }} form-error form-error--choice display-none">
                <span class="form-error__icon">
                    <i class="svg svg-warning"></i>
                </span>
                <ul class="form-error__list"></ul>
            </div>
        </div>
    </dd>
</dl>
{{ form_widget(companyForm.save, { label: 'Register'|trans, attr: {'class' : 'btn--submit-next btn--registration' } }) }}
{{ form_end(companyForm) }}
