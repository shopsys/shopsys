{{ form_start(form) }}
<div class="form-line-block-section form-line-block-section--no-spacing">
    {{ form_row(form.email, { label: 'Váš e-mail'|trans , rowClass: 'form-line-block js-form-field', attr: {'data-request-url' : url('front_registration_exists_email') } }) }}
    {{ form_row(form.telephone, { label: 'Telefon'|trans, rowClass: 'form-line-block js-form-field' }) }}
</div>
<div class="form-line-block-section">
    {{ form_row(form.gender, { label: 'Oslovení'|trans, rowClass: 'form-line-block form-line-block--three-quarters js-form-field' }) }}
    {{ form_row(form.firstName, { label: 'First name'|trans, rowClass: 'form-line-block js-form-field' }) }}
    {{ form_row(form.lastName, { label: 'Last name'|trans, rowClass: 'form-line-block js-form-field' }) }}
</div>
<div class="form-line-block-section">
    <h2 class="form-line-block-section__heading">{{ 'Password'|trans }}</h2>
    {{ form_row(form.password.first, {
        label: 'Password'|trans,
        rowClass: 'form-line-block js-form-field'
    }) }}
    {{ form_row(form.password.second, { label: 'Password again'|trans, rowClass: 'form-line-block js-form-field' }) }}
</div>
<div class="form-line-block-section">
    <h2 class="form-line-block-section__heading">{{ 'Fakturační adresa'|trans }}</h2>
    {{ form_row(form.street, { label: 'Ulice a č. popisné'|trans, rowClass: 'form-line-block js-form-field' }) }}
    <div class="form-line-block-section__grid">
        {{ form_row(form.city, { label: 'Město'|trans, rowClass: 'form-line-block form-line-block--full-width form-line-block--first js-form-field' }) }}
        {{ form_row(form.postcode, { label: 'PSČ'|trans, rowClass: 'form-line-block form-line-block--small-width js-form-field' }) }}
    </div>
</div>
<dl class="form-line-block form-line-block--check">
    <dd>
        <div class="form-choice">
            {{ form_widget(form.privacyPolicy, { attr: { class: "css-checkbox" } }) }}
            <label for="{{ form.privacyPolicy.vars.id }}" class="css-checkbox__image">
                {% if privacyPolicyArticle is not null %}
                    {% set articleUrl = url('front_article_detail', {'id': privacyPolicyArticle.id}) %}
                    {{ 'I agree with <a href="%url%" target="_blank">privacy policy</a>.'|trans({'%url%': articleUrl})|raw }}
                {% else %}
                    {{ 'I agree with privacy policy.'|trans }}
                {% endif %}
                <span class="form-input-required">*</span>
            </label>
            <span class="js-validation-errors-list js-validation-error-list-{{ form.privacyPolicy.vars.id }} form-error form-error--choice display-none">
                <span class="form-error__icon">
                    <i class="svg svg-warning"></i>
                </span>
                <ul class="form-error__list"></ul>
            </span>
        </div>
    </dd>
</dl>
{{ form_widget(form.save, { label: 'Register'|trans, attr: {'class' : 'btn--submit-next btn--registration'} }) }}
{{ form_end(form) }}
