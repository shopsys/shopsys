{% import 'Front/Content/Product/productListMacro.html.twig' as productList %}
{% set domain = getDomain() %}
<div class="web__line web__line--spacing web__line--margin-bottom web__line--hp">
    <div class="web__container">
        {% if sliderItems is not empty %}
            {% set slidersCount = sliderItems|length %}
            <div class="box-slider{{ slidersCount <= 1 ? ' box-slider--fullwidth' }}">
                <div class="box-slider__wrap">
                    <div
                        {% if slidersCount > 1 %} id="js-slider-homepage"{% endif %}
                        class="box-slider__in gtm-scroll"
                        data-gtm-event="{{ gtmSliderScrollEvent|json_encode() }}"
                    >
                        {% for item in sliderItems|slice(0, 4) %}
                            <div class="box-slider__item">
                                <a href="{{ item.link }}" {{ gtm(item, loop.index) }}>
                                    <picture>
                                        <source
                                                media="(max-width: 360px)"
                                                srcset="{{ imageUrl(item, 'retinaSliderSmall', 'mobile') }} 2x, {{ imageUrl(item, 'sliderSmall', 'mobile') }} 1x"
                                        >
                                        <source
                                                media="(min-width: 361px) and (max-width: 480px)"
                                                srcset="{{ imageUrl(item, 'retinaSlider', 'mobile') }} 2x, {{ imageUrl(item, null, 'mobile') }} 1x"
                                        >
                                        <source
                                                media="(min-width: 481px)"
                                                {% if slidersCount > 1 %}
                                                    srcset="{{ imageUrl(item, 'retinaSlider', 'web') }} 2x, {{ imageUrl(item, null, 'web') }} 1x"
                                                {% else %}
                                                    srcset="{{ imageUrl(item, 'fullwidthSliderRetina', 'web') }} 2x, {{ imageUrl(item, 'fullwidthSlider', 'web') }} 1x"
                                                {% endif %}
                                        >
                                        <img
                                            loading="lazy"
                                            {% if slidersCount > 1 %}
                                                src="{{ imgLazyloadPlaceholder }}"
                                                data-src="{{ imageUrl(item, null, 'web') }}"
                                            {% else %}
                                                src="{{ imgLazyloadPlaceholder }}"
                                                data-src="{{ imageUrl(item, 'fullwidthSlider', 'web') }}"
                                            {% endif %}
                                            itemprop="image" class="image-sliderItem-web"
                                        />
                                    </picture>
                                </a>
                                {% if item.sliderExtendedTextLink and item.sliderExtendedText %}
                                    <a href="{{ item.sliderExtendedTextLink }}" class="box-slider__item__link text-center" target="_blank">
                                        <span class="box-slider__item__link__text">{{ item.sliderExtendedText }}</span>
                                    </a>
                                {% elseif item.sliderExtendedText %}
                                    <span class="box-slider__item__link box-slider__item__link--no-anchor text-center">
                                        <span class="box-slider__item__link__text">{{ item.sliderExtendedText }}</span>
                                    </span>
                                {% endif %}
                            </div>
                        {% endfor %}
                    </div>
                    {% if slidersCount > 1 %}
                        <div class="box-slider__thumbnails">
                            <div class="box-slider__thumbnails__block" id="js-slider-homepage-thumbnails">
                                {% for item in sliderItems|slice(0, 4) %}
                                    <button class="box-slider__thumbnails__item">
                                        <span class="box-slider__thumbnails__item__text">{{ item.name }}</span>
                                    </button>
                                {% endfor %}
                            </div>
                            <a
                                href="{{ domain.id == 1 ? '/akce' : '/akcia' }}"
                                class="btn btn--outline btn--outline--slider btn--block"
                            >
                                {{ 'Všechny akce'|trans }}
                            </a>
                        </div>
                    {% endif %}
                </div>
            </div>
        {% endif %}
        <div class="box-block">
            <div class="box-block__wrap">
                <div class="box-block__item box-block__item--bg box-block__item--half box-block__item--left">
                    <h2 class="box-block__item__heading">{{ 'Aktuální leták'|trans }}</h2>
                    <picture>
                        <source
                                srcset="
                                {{ asset('public/frontend/images/letak2x.png') }} 2x,
                                {{ asset('public/frontend/images/letak.png') }} 1x"
                        />
                        <img
                                class="box-block__item__img box-block__item__img--left"
                                loading="lazy"
                                src="{{ imgLazyloadPlaceholder }}"
                                data-src="{{ asset('public/frontend/images/letak.png') }}"
                                alt="{{ 'Aktuální leták'|trans }}">
                    </picture>
                    <p class="box-block__item__desc">
                        {{ 'Prohlédněte si náš aktuální leták, ve kterém naleznete stylový nábytek pro svůj byt či dům za akční cenu.'|trans }}
                    </p>
                    <a
                        class="btn btn--next btn-no-style"
                        href="{{ url('front_leaflet') }}"
                    >
                        {{ 'Číst dál'|trans }}
                        <i class="btn__icon svg svg-chevron"></i>
                    </a>
                </div>
                <div class="box-block__item box-block__item box-block__item--bg box-block__item--half box-block__item--right">
                    <h2 class="box-block__item__heading">{{ 'Prodejny Sconto'|trans }}</h2>
                    <picture>
                        <source
                                srcset="
                                {{ asset('public/frontend/images/prodejny2x.png') }} 2x,
                                {{ asset('public/frontend/images/prodejny.png') }} 1x"
                        />
                        <img
                                class="box-block__item__img box-block__item__img--right"
                                loading="lazy"
                                src="{{ imgLazyloadPlaceholder }}"
                                data-src="{{ asset('public/frontend/images/prodejny.png') }}"
                                alt="{{ 'Prodejny Sconto'|trans }}">
                    </picture>
                    <p class="box-block__item__desc">{{ 'Další doplňkový sortiment, zákaznické centrum nebo osobní<br>vyzvednutí zboží z e-shopu zdarma na 8 místech v ČR.'|trans|raw }}</p>
                    <a class="btn btn--next btn-no-style" href="{{ url('front_stores') }}">
                        {{ 'Číst dál'|trans }}
                        <i class="btn__icon svg svg-chevron"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
{% if topProducts is not empty %}
    <div class="web__line">
        <div class="web__container">
            <div class="box-products-carousel box-products-carousel--bg box-products-carousel--top-products gtm-scroll" id="top-products" data-gtm-event="{{ gtmTopProductsScrollEvent|json_encode() }}">
                <div class="box-products-carousel__in box-products-carousel__in--bg box-products-carousel__in--top-products">
                    <h2 class="box-products-carousel__heading">{{ 'Top produkty'|trans }}</h2>
                    <div class="list-products-grid list-products-grid--sales js-products-slick-carousel">
                        {{ productList.list(topProducts, null, 'h3', constant('App\\Model\\Gtm\\DataLayer::LIST_NAME_HOME_TOP_PRODUCTS')) }}
                    </div>
                    {% if saleCategory is not null %}
                        <a href="{{ url('front_product_list', { id: saleCategory.id }) }}" class="sale-page-on-hp">
                            {{ "Všechny produkty"|trans }}
                        </a>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
{% endif %}
<div class="web__line">
    <div class="web__container">
        <h2>{{ 'Oblíbené kategorie'|trans }}</h2>
        {{ render(controller('App\\Controller\\Front\\CategoryController:categoryListAction', {categories: categories, showProductsCountByCategory: false})) }}
    </div>
</div>
<div class="web__line">
    <div class="web__container">
        {% include 'Front/Content/Rooms/list.html.twig' %}
    </div>
</div>
{% if homepageArticles is not null %}
    {% set domain = getDomain() %}
    <div class="web__line">
        <div class="web__container web__container--max-width">
            <div class="box-articles">
                <div class="box-articles__wrap">
                    <div class="box-articles__text">
                        <div class="box-articles__text__inner">
                            <h2 class="box-articles__heading">{{ rootCategory.getName(domain.locale)|upper }}</h2>
                            <div class="box-articles__desc">{{ rootCategory.getDescription(domain.locale) }}</div>
                            <a class="btn btn--add dont-print" href="{{ url('front_blogcategory_detail', { id: constant('App\\Model\\Blog\\Category\\BlogCategory::BLOG_MAIN_PAGE_CATEGORY_ID')}) }}">{{ "Všechny články"|trans }}</a>
                        </div>
                    </div>
                    <div class="list-articles list-articles--hp">
                        {% for blogArticle in homepageArticles %}
                            <div class="list-articles__item">
                                <a href="{{ url('front_blogarticle_detail', {'id': blogArticle.id}) }}" class="list-articles__item__link list-articles__item__link--image" title="{{ blogArticle.name }}">
                                    {{ image(blogArticle, { size: 'list', class: 'list-articles__item__image', alt: blogArticle.name, lazy: true }) }}
                                </a>
                                <div class="list-articles__item__tags">
                                    <span class="list-tags__tag">
                                        {{ render(controller('App\\Controller\\Front\\BlogCategoryController::allCategoriesForBlogArticleAction', { blogArticle: blogArticle })) }}
                                    </span>
                                </div>
                                <h3 class="list-articles__item__name">
                                    <a href="{{ url('front_blogarticle_detail', {'id': blogArticle.id}) }}" class="list-articles__item__link" title="{{ blogArticle.name }}">
                                        {{ blogArticle.name}}
                                    </a>
                                </h3>
                                <div class="list-articles__item__desc">
                                    {{ blogArticle.perex|slice(0,165) }}{% if blogArticle.perex|length > 165 %}&hellip;{% endif %}
                                </div>
                                <a href="{{ url('front_blogarticle_detail', {'id': blogArticle.id}) }}" class="btn btn--next btn-no-style dont-print" title="{{ blogArticle.name }}">
                                    {{ "Číst dál"|trans }} <i class="btn__icon svg svg-chevron"></i>
                                </a>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endif %}
{{ render(controller('App\\Controller\\Front\\ProductController:productsInSaleOnHomePageAction')) }}
