{% extends 'Front/Layout/layoutWithoutPanel.html.twig' %}
{% import 'Front/Content/Product/productListMacro.html.twig' as productList %}

{% block breadcrumb %}
{% endblock %}

{% block meta_description %}
    {{- metaDescription -}}
{% endblock %}

{% block title %}
    {{- title -}}
{% endblock %}

{% block logo %}
    <h1 class="logo">
        <img src="{{ asset('public/frontend/images/logo.svg') }}" alt="{{ 'Online shop'|trans }}">
    </h1>
{% endblock %}

{% block main_content %}
    <div class="web__line web__line--grey web__line--spacing web__line--margin-bottom">
        <div class="web__container">
            {% if sliderItems is not empty %}
                <div class="box-slider">
                    <div class="box-slider__wrap">
                        <div id="js-slider-homepage" class="box-slider__in">
                            {% for item in sliderItems|slice(0, 4) %}
                                <div class="box-slider__item">
                                    <a href="{{ item.link }}">
                                        <picture>
                                            <source media="(max-width: 425px)" srcset="{{ imageUrl(item, null, 'mobile') }}" />
                                            <source media="(min-width: 425px)" srcset="{{ imageUrl(item, null, 'web') }}" />
                                            <img data-src="{{ imageUrl(item, null, 'web') }}" itemprop="image" class="image-sliderItem-web" />
                                        </picture>
                                    </a>
                                    {% if item.sliderExtendedTextLink and item.sliderExtendedText %}
                                    <a href="{{ item.sliderExtendedTextLink }}" class="box-slider__item__link text-center" target="_blank">
                                        <span class="box-slider__item__link__text">{{ item.sliderExtendedText }}</span>
                                    </a>
                                    {% elseif item.sliderExtendedText %}
                                    <span class="box-slider__item__link__text">{{ item.sliderExtendedText }}</span>
                                    {% endif %}
                                </div>
                            {% endfor %}
                        </div>
                        <div class="box-slider__thumbnails">
                            <div class="box-slider__thumbnails__block" id="js-slider-homepage-thumbnails">
                                {% for item in sliderItems|slice(0, 4) %}
                                    <button class="box-slider__thumbnails__item">
                                        <span class="box-slider__thumbnails__item__text">{{ item.name }}</span>
                                    </button>
                                {% endfor %}
                            </div>
                            <a href="#" class="btn btn--outline btn--block js-not-implemented-yet">{{ 'Všechny akce'|trans }}</a>
                        </div>
                    </div>
                </div>
            {% endif %}
            <div class="box-block">
                <div class="box-block__wrap">
                    <div class="box-block__item box-block__item--half box-block__item--left">
                        <h2 class="box-block__item__heading">{{ 'Aktuální leták'|trans }}</h2>
                        <img class="box-block__item__img box-block__item__img--left" src="{{ asset('public/frontend/images/letak.png') }}" alt="{{ 'Aktuální leták'|trans }}">
                        <p class="box-block__item__desc">{{ 'Tuny slev, lorem ipsum dolor sit amet,<br> consectur adispic elit.'|trans|raw }}</p>
                        <a class="btn btn--next btn-no-style js-not-implemented-yet" href="#">{{ 'Číst dál'|trans }} <i class="btn__icon svg svg-long-arrow-right"></i></a>
                    </div>
                    <div class="box-block__item box-block__item--half box-block__item--right">
                        <h2 class="box-block__item__heading">{{ 'Prodejny Sconto'|trans }}</h2>
                        <img class="box-block__item__img box-block__item__img--right" src="{{ asset('public/frontend/images/prodejny.png') }}" alt="{{ 'Prodejny Sconto'|trans }}">
                        <p class="box-block__item__desc">{{ 'Další doplňkový sortiment, zákaznické centrum nebo osobní<br>vyzvednutí zboží z e-shopu zdarma na 8 místech v ČR.'|trans|raw }}</p>
                        <a class="btn btn--next btn-no-style js-not-implemented-yet" href="#">{{ 'Číst dál'|trans }} <i class="btn__icon svg svg-long-arrow-right"></i></a>
                    </div>
                </div>
            </div>
            {% if inSaleProducts|length > 0 %}
            <h2>{{ 'Výprodej'|trans }}</h2>
            {{ productList.list(inSaleProducts) }}
            {% endif %}
        </div>
    </div>

    {{ render(controller('App\\Controller\\Front\\CategoryController:topAction')) }}

    {% include 'Front/Content/Category/categoryListGrid.html.twig' %}

    {% if topProducts is not empty %}
        <div class="web__line">
            <div class="web__container">
                <div id="top-products">
                    <h2>{{ 'Special offers'|trans }}</h2>
                    {{ productList.list(topProducts, null, 'h3') }}
                </div>
            </div>
        </div>
    {% endif %}

    {{ render(controller('App\\Controller\\Front\\BlogArticleController:homepageArticlesAction')) }}

    <div class="web__line">
        <div class="web__container">
            <div class="box-media">
                <div class="box-media__wrap">
                    <img class="box-media__img" loading="lazy" src="" data-src="{{ asset('public/frontend/images/kreslo_sconto.png') }}" alt="{{ 'Máme pro vás volné místo'|trans }}">
                    <div class="box-media__text">
                        <h2 class="box-media__heading">{{ 'Máme pro vás volné místo'|trans }}</h2>
                        <p class="box-media__desc">{{ 'SCONTO Nábytek s.r.o. je součástí německého koncernu Höffner, který patří k největším prodejcům nábytku v Evropě již od roku 1990.'|trans }}</p>
                        <a class="btn btn--outline js-not-implemented-yet" href="#">{{ 'Prohlédnout nabídky'|trans }}</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

{% endblock %}
