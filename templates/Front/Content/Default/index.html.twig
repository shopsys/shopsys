{% extends 'Front/Layout/layoutWithoutPanel.html.twig' %}
{% import 'Front/Content/Product/productListMacro.html.twig' as productList %}

{% block breadcrumb %}
{% endblock %}

{% block meta_description %}
    {{- metaDescription -}}
{% endblock %}

{% block title %}
    {{- title -}}
{% endblock %}

{% block logo %}
    <h1 class="logo">
        <img src="{{ asset('assets/frontend/images/logo.svg') }}" alt="{{ 'Online shop'|trans }}">
    </h1>
{% endblock %}

{% block main_content %}
    <div class="web__line web__line--grey web__line--spacing">
        <div class="web__container">
            {% if sliderItems is not empty %}
                <div class="box-slider">
                    <div class="box-slider__wrap">
                        <div id="js-slider-homepage" class="box-slider__in">
                            {% for item in sliderItems|slice(0, 4) %}
                                <div class="box-slider__item">
                                    <a href="{{ item.link }}">{{ image(item, { lazy: false }) }}</a>
                                    {% if item.sliderExtendedTextLink and item.sliderExtendedText %}
                                    <a href="{{ item.sliderExtendedTextLink }}" class="box-slider__item__link text-center" target="_blank">
                                        <span class="box-slider__item__link__text">{{ item.sliderExtendedText }}</span>
                                    </a>
                                    {% elseif item.sliderExtendedText %}
                                    <span class="box-slider__item__link__text">{{ item.sliderExtendedText }}</span>
                                    {% endif %}
                                </div>
                            {% endfor %}
                        </div>
                        <div class="box-slider__thumbnails">
                            <div class="box-slider__thumbnails__block" id="js-slider-homepage-thumbnails">
                                {% for item in sliderItems|slice(0, 4) %}
                                    <button class="box-slider__thumbnails__item">
                                        <span class="box-slider__thumbnails__item__text">{{ item.name }}</span>
                                    </button>
                                {% endfor %}
                            </div>
                            <a href="#" class="btn btn--outline btn--block js-not-implemented-yet">{{ 'Všechny akce'|trans }}</a>
                        </div>
                    </div>
                </div>
            {% endif %}

            <div class="box-block">
                <div class="box-block__wrap">
                    <div class="box-block__item box-block__item--half box-block__item--left">
                        <h2 class="box-block__item__heading">{{ 'Aktuální leták'|trans }}</h2>
                        <img class="box-block__item__img box-block__item__img--left" src="{{ asset('assets/frontend/images/letak.png') }}" alt="{{ 'Aktuální leták'|trans }}">
                        <p class="box-block__item__desc">{{ 'Tuny slev, lorem ipsum dolor sit amet,<br> consectur adispic elit.'|trans|raw }}</p>
                        <a class="btn btn--next btn-no-style js-not-implemented-yet" href="#">{{ 'Číst dál'|trans }} <span class="btn__icon">→</span></a>
                    </div>
                    <div class="box-block__item box-block__item--half box-block__item--right">
                        <h2 class="box-block__item__heading">{{ 'Prodejny Sconto'|trans }}</h2>
                        <img class="box-block__item__img box-block__item__img--right" src="{{ asset('assets/frontend/images/prodejny.png') }}" alt="{{ 'Prodejny Sconto'|trans }}">
                        <p class="box-block__item__desc">{{ 'Další doplňkový sortiment, zákaznické centrum nebo osobní<br>vyzvednutí zboží z e-shopu zdarma na 8 místech v ČR.'|trans|raw }}</p>
                        <a class="btn btn--next btn-no-style js-not-implemented-yet" href="#">{{ 'Číst dál'|trans }} <span class="btn__icon">→</span></a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {{ render(controller('App\\Controller\\Front\\CategoryController:topAction')) }}

    {% set gridImageViewportMobile = "767px" %}
    <div class="web__line">
        <div class="web__container">
            <h2>{{ 'Nakupujte podle místností'|trans }}</h2>
            <div class="list-grid">
                <div class="list-grid__row">
                    <a class="list-grid__item list-grid__item--long list-grid__item--sixth" href="#" title="{{ 'Předsíň'|trans }}">
                        <span class="list-grid__item__name"><span class="btn btn--next btn-no-style">{{ 'Předsíň'|trans }} <i class="btn__icon svg svg-long-arrow-right"></i></span></span>
                        <picture class="list-grid__item__picture">
                            <source media="(max-width: {{ gridImageViewportMobile }})" srcset="{{ asset('assets/frontend/images/rooms/predsin_m.jpg') }}">
                            <img loading="lazy" class="list-grid__item__img" data-src="{{ asset('assets/frontend/images/rooms/predsin.jpg') }}" alt="{{ 'Předsíň'|trans }}">
                        </picture>
                    </a>
                    <a class="list-grid__item list-grid__item--long list-grid__item--third" href="#" title="{{ 'Obývací pokoj'|trans }}">
                        <span class="list-grid__item__name"><span class="btn btn--next btn-no-style">{{ 'Obývací pokoj'|trans }} <i class="btn__icon svg svg-long-arrow-right"></i></span></span>
                        <picture class="list-grid__item__picture">
                            <source media="(max-width: {{ gridImageViewportMobile }})" srcset="{{ asset('assets/frontend/images/rooms/obyvaci_pokoj_m.jpg') }}">
                            <img loading="lazy" class="list-grid__item__img" data-src="{{ asset('assets/frontend/images/rooms/obyvaci_pokoj.jpg') }}" alt="{{ 'Obývací pokoj'|trans }}">
                        </picture>
                    </a>
                    <div class="list-grid__item__in list-grid__item--third">
                        <a class="list-grid__item list-grid__item--half-long" href="#" title="{{ 'Kuchyně'|trans }}">
                            <span class="list-grid__item__name"><span class="btn btn--next btn-no-style">{{ 'Kuchyně'|trans }} <i class="btn__icon svg svg-long-arrow-right"></i></span></span>
                            <picture class="list-grid__item__picture">
                                <source media="(max-width: {{ gridImageViewportMobile }})" srcset="{{ asset('assets/frontend/images/rooms/kuchyne_m.jpg') }}">
                                <img loading="lazy" class="list-grid__item__img" data-src="{{ asset('assets/frontend/images/rooms/kuchyne.jpg') }}" alt="{{ 'Kuchyně'|trans }}">
                            </picture>
                        </a>
                        <a class="list-grid__item list-grid__item--half-long" href="#" title="{{ 'Jídelna'|trans }}">
                            <span class="list-grid__item__name"><span class="btn btn--next btn-no-style">{{ 'Jídelna'|trans }} <i class="btn__icon svg svg-long-arrow-right"></i></span></span>
                            <picture class="list-grid__item__picture">
                                <source media="(max-width: {{ gridImageViewportMobile }})" srcset="{{ asset('assets/frontend/images/rooms/jidelna_m.jpg') }}">
                                <img loading="lazy" class="list-grid__item__img" data-src="{{ asset('assets/frontend/images/rooms/jidelna.jpg') }}" alt="{{ 'Jídelna'|trans }}">
                            </picture>
                        </a>
                    </div>
                    <a class="list-grid__item list-grid__item--long list-grid__item--sixth" href="#" title="{{ 'Pracovna'|trans }}">
                        <span class="list-grid__item__name"><span class="btn btn--next btn-no-style">{{ 'Pracovna'|trans }} <i class="btn__icon svg svg-long-arrow-right"></i></span></span>
                        <picture class="list-grid__item__picture">
                            <source media="(max-width: {{ gridImageViewportMobile }})" srcset="{{ asset('assets/frontend/images/rooms/pracovna_m.jpg') }}">
                            <img loading="lazy" class="list-grid__item__img" data-src="{{ asset('assets/frontend/images/rooms/pracovna.jpg') }}" alt="{{ 'Pracovna'|trans }}">
                        </picture>
                    </a>
                </div>
                 <div class="list-grid__row">
                    <a class="list-grid__item list-grid__item--third" href="#" title="{{ 'Ložnice'|trans }}">
                        <span class="list-grid__item__name"><span class="btn btn--next btn-no-style">{{ 'Ložnice'|trans }} <i class="btn__icon svg svg-long-arrow-right"></i></span></span>
                        <picture class="list-grid__item__picture">
                            <source media="(max-width: {{ gridImageViewportMobile }})" srcset="{{ asset('assets/frontend/images/rooms/loznice_m.jpg') }}">
                            <img loading="lazy" class="list-grid__item__img" data-src="{{ asset('assets/frontend/images/rooms/loznice.jpg') }}" alt="{{ 'Ložnice'|trans }}">
                        </picture>
                    </a>
                    <a class="list-grid__item list-grid__item--third" href="#" title="{{ 'Dětský pokoj'|trans }}">
                        <span class="list-grid__item__name"><span class="btn btn--next btn-no-style">{{ 'Dětský pokoj'|trans }} <i class="btn__icon svg svg-long-arrow-right"></i></span></span>
                        <picture class="list-grid__item__picture">
                            <source media="(max-width: {{ gridImageViewportMobile }})" srcset="{{ asset('assets/frontend/images/rooms/detsky_pokoj_m.jpg') }}">
                            <img loading="lazy" class="list-grid__item__img" data-src="{{ asset('assets/frontend/images/rooms/detsky_pokoj.jpg') }}" alt="{{ 'Dětský pokoj'|trans }}">
                        </picture>
                    </a>
                    <a class="list-grid__item list-grid__item--third" href="#" title="{{ 'Koupelny'|trans }}">
                        <span class="list-grid__item__name"><span class="btn btn--next btn-no-style">{{ 'Koupelny'|trans }} <i class="btn__icon svg svg-long-arrow-right"></i></span></span>
                        <picture class="list-grid__item__picture">
                            <source media="(max-width: {{ gridImageViewportMobile }})" srcset="{{ asset('assets/frontend/images/rooms/koupelny_m.jpg') }}">
                            <img loading="lazy" class="list-grid__item__img" data-src="{{ asset('assets/frontend/images/rooms/koupelny.jpg') }}" alt="{{ 'Koupelny'|trans }}">
                        </picture>
                    </a>
                </div>
            </div>
        </div>
    </div>

    {% if topProducts is not empty %}
        <div class="web__line">
            <div class="web__container">
                <div id="top-products">
                    <h2>{{ 'Special offers'|trans }}</h2>
                    {{ productList.list(topProducts, null, 'h3') }}
                </div>
            </div>
        </div>
    {% endif %}

    {{ render(controller('App\\Controller\\Front\\BlogArticleController:homepageArticlesAction')) }}

    <div class="web__line">
        <div class="web__container">
            <div class="box-media">
                <div class="box-media__wrap">
                    <img class="box-media__img" loading="lazy" src="" data-src="{{ asset('assets/frontend/images/kreslo_sconto.png') }}" alt="{{ 'Máme pro vás volné místo'|trans }}">
                    <div class="box-media__text">
                        <h2 class="box-media__heading">{{ 'Máme pro vás volné místo'|trans }}</h2>
                        <p class="box-media__desc">{{ 'SCONTO Nábytek s.r.o. je součástí německého koncernu Höffner, který patří k největším prodejcům nábytku v Evropě již od roku 1990.'|trans }}</p>
                        <a class="btn btn--outline js-not-implemented-yet" href="#">{{ 'Prohlédnout nabídky'|trans }}</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

{% endblock %}
