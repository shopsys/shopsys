{% extends 'Front/Layout/layoutWithoutPanel.html.twig' %}

{% block breadcrumb %}
{% endblock %}

{% block meta_description %}
    {{- metaDescription -}}
{% endblock %}

{% block title %}
    {{- title -}}
{% endblock %}

{% block main_content %}
    {% cache constant('App\\Twig\\Cache\\TwigCacheFacade::SLIGHTLY_CHANGING_PARTS_ON_HOMEPAGE') {lifetime:60*60*4, domainId:getDomain().id} %}
        {{ render(controller('App\\Controller\\Front\\HomepageController:slightlyChangingPartsOnHomepageAction'))|spaceless }}
    {% endcache %}

    {% set domain = getDomain() %}
    <div class="web__line">
        <div class="web__container">
            <div class="box-media">
                <div class="box-media__wrap">
                    <div class="box-media__picture">
                        <picture>
                            <source srcset="{{ asset('public/frontend/images/kreslo_sconto2x.png') }} 2x, {{ asset('public/frontend/images/kreslo_sconto.png') }} 1x" />
                            <img
                                class="box-media__img"
                                loading="lazy"
                                src="{{ imgLazyloadPlaceholder }}"
                                data-src="{{ asset('public/frontend/images/kreslo_sconto.png') }}"
                                alt="{{ 'Máme pro vás volné místo'|trans }}">
                        </picture>
                    </div>
                    <div class="box-media__text">
                        <h2 class="box-media__heading">{{ 'Máme pro vás volné místo'|trans }}</h2>
                        <p class="box-media__desc">{{ 'SCONTO Nábytek s.r.o. je součástí německého koncernu Höffner, který patří k největším prodejcům nábytku v Evropě již od roku 1990.'|trans }}</p>
                        <a
                            class="btn btn--outline"
                            href="{{ domain.id == 1 ? 'https://sconto.jobs.cz/' : 'https://www.profesia.sk/praca/sconto-nabytok/C62574' }}"
                            target="_blank"
                        >
                            {{ 'Prohlédnout nabídky'|trans }}
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

{% endblock %}
