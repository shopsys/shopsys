{% if blogCategories is not null %}
    {% for blogCategory in blogCategories %}
        <a href="{{ url('front_blogcategory_detail', { id: blogCategory.id }) }}" class="box-blog__categories__item btn btn--tag
            {% if currentBlogCategoryId == blogCategory.id %}current-blog-category{% endif %}
        ">
            {{ blogCategory.name }}
        </a>
    {% endfor %}
{% endif %}
