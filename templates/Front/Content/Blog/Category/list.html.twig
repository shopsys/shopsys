{% if blogCategories|length > 0 %}
    <div class="box-blog__categories">
        {% for blogCategory in blogCategories %}
            <a href="{{ url('front_blogcategory_detail', { id: blogCategory.id }) }}"
               class="box-blog__categories__item btn btn--tag btn--tag--category level-{{ blogCategory.level }}
               {% if blogCategory.id == currentBlogCategory.id %} selected{% endif %}
                "
            >
                {{ blogCategory.name }}
            </a>
        {% endfor %}
    </div>
{% endif %}
