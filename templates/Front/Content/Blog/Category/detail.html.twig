{% extends 'Front/Layout/layoutWithoutPanel.html.twig' %}
{% import 'Front/Inline/Paginator/paginator.html.twig' as paginator %}

{% set domain = getDomain() %}

{% block title %}
    {{- blogCategory.getSeoTitle(domain.id)|default(blogCategory.name) -}}
{% endblock %}

{% block meta_description %}
    {{- blogCategory.getSeoMetaDescription(domain.id)|default(getSeoMetaDescription()) -}}
{% endblock %}

{% block breadcrumb %}
{% endblock %}

{% block main_content %}
    {% set entityName = 'blogArticles'|trans %}
    <div class="web__line">
        <div class="web__container">
            <div class="box-blog">
                <h1 class="box-blog__title">
                    {{ blogCategory.getSeoH1(domain.id) ?? blogCategory.name}}
                </h1>
                <div class="box-blog__breadcrumb">
                    {{ render(controller('App\\Controller\\Front\\BreadcrumbController:indexAction', { routeName: getRoute(), routeParameters: getRouteParams() } )) }}
                </div>
                {% if imageExists(blogCategory) %}
                    <div class="box-blog__img">
                        {{ image(blogCategory, { itemprop: 'image', lazy: true }) }}
                    </div>
                {% endif %}
                <div class="box-blog__desc">
                    {{ blogCategory.description|raw }}
                </div>
                <div class="box-blog__panel">
                    <div class="box-blog__section">
                        {{ render(controller('App\\Controller\\Front\\BlogCategoryController::listAction', { currentBlogCategory: blogCategory })) }}
                    </div>
                </div>
                <div class="box-blog__content">
                    <div class="box-blog__list">
                        {% if blogArticlePaginationResult.results|length > 0 %}
                            <div class="js-blog-list-with-paginator">
                                {% include 'Front/Content/Article/list.html.twig' with { blogArticles: blogArticlePaginationResult.results } %}

                                <div class="box-blog__pagination">
                                    {{ paginator.loadMoreButton(blogArticlePaginationResult) }}
                                </div>

                            </div>
                        {% else %}
                            <div class="in-message in-message--info margin-bottom-20">
                                {{ 'Tato rubrika neobsahuje žádné články.'|trans }}
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
