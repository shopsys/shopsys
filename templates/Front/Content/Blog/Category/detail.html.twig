{% extends 'Front/Layout/layoutWithoutPanel.html.twig' %}
{% import 'Front/Inline/Paginator/paginator.html.twig' as paginator %}

{% set domain = getDomain() %}

{% block title %}
    {{- blogCategory.getSeoTitle(domain.id)|default(blogCategory.name) -}}
{% endblock %}

{% block meta_description %}
    {{- blogCategory.getSeoMetaDescription(domain.id)|default(getSeoMetaDescription()) -}}
{% endblock %}

{% block breadcrumb %}
{% endblock %}

{% block main_content %}
    {% set entityName = 'blogArticles'|trans %}
    <div class="web__line">
        <div class="web__container web__container--no-padding">
            <div class="box-blog">
                <h1 class="box-blog__title">
                    {{ blogCategory.getSeoH1(domain.id) ?? blogCategory.name}}
                </h1>
                <div class="box-blog__breadcrumb">
                    {{ render(controller('App\\Controller\\Front\\BreadcrumbController:indexAction', { routeName: getRoute(), routeParameters: getRouteParams() } )) }}
                </div>
                {% if imageExists(blogCategory) %}
                    <div class="box-blog__img">
                        {{ image(blogCategory, { itemprop: 'image', lazy: true }) }}
                    </div>
                {% endif %}
                <div class="box-blog__desc">
                    {{ blogCategory.description|raw }}
                </div>
                <div class="box-blog__panel">
                    <div class="box-blog__section">
                        {{ render(controller('App\\Controller\\Front\\BlogCategoryController::listAction', { currentBlogCategory: blogCategory })) }}
                    </div>
                </div>
                <div class="box-blog__content">
                    <div class="box-blog__list">
                        {% if blogArticlePaginationResult.results|length > 0 %}
                            <div class="js-blog-list-with-paginator">
                                <ul class="list-articles list-articles--grid js-list">
                                    {% for blogArticle in blogArticlePaginationResult.results %}
                                        <li class="list-articles__item list-articles__item--grid">
                                            <a href="{{ url('front_blogarticle_detail', {'id': blogArticle.id}) }}" class="list-articles__item__link list-articles__item__link--image" title="{{ blogArticle.name }}">
                                                {{ image(blogArticle, { size: 'listGrid', alt: blogArticle.name, class: "list-articles__item__image", lazy: true }) }}
                                            </a>
                                            <div class="list-articles__item__content">
                                                <div class="list-tags">
                                                    <span class="list-tags__tag">
                                                        {{ render(controller('App\\Controller\\Front\\BlogCategoryController::allCategoriesForBlogArticleAction', { blogArticle: blogArticle, currentBlogCategory: blogCategory })) }}
                                                    </span>
                                                </div>
                                                <h3 class="list-articles__item__name">
                                                    <a href="{{ url('front_blogarticle_detail', {'id': blogArticle.id}) }}" class="list-articles__item__image__link" title="{{ blogArticle.name }}" class="list-articles__item__content__title underline">
                                                        {{ blogArticle.name }}
                                                    </a>
                                                </h3>
                                                <div class="list-articles__item__desc">
                                                    {{ blogArticle.perex|slice(0,200) }}{% if blogArticle.perex|length > 200 %}&hellip;{% endif %}
                                                </div>
                                                <div class="list-articles__item__content__text">
                                                    <a href="{{ url('front_blogarticle_detail', {'id': blogArticle.id}) }}" class="btn btn--next btn-no-style dont-print" title="{{ blogArticle.name }}">
                                                        {{ "Číst dál"|trans }} <i class="btn__icon svg svg-long-arrow-right"></i>
                                                    </a>
                                                </div>

                                            </div>
                                        </li>
                                    {% endfor %}
                                </ul>

                                <div class="box-blog__pagination">
                                    {{ paginator.loadMoreButton(blogArticlePaginationResult) }}
                                </div>

                            </div>
                        {% else %}
                            <div class="in-message in-message--info margin-bottom-20">
                                {{ 'Tato rubrika neobsahuje žádné články.'|trans }}
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
