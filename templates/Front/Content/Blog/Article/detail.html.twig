{% extends 'Front/Layout/layoutWithoutPanel.html.twig' %}

{% block title %}
    {{- blogArticle.getSeoTitle(domainId)|default(blogArticle.name) -}}
{% endblock %}

{% block meta_description %}
    {{- blogArticle.getSeoMetaDescription(domainId)|default(getSeoMetaDescription()) -}}
{% endblock %}

{% block breadcrumb %}
{% endblock %}

{% block main_content %}
<div class="web__line">
    <div class="web__container">
        <div class="box-blog box-blog--detail">
            <div class="box-blog__content box-blog__content--with-mobile-gap">
                <div class="box-blog__figure{{ imageExists(blogArticle) ? ' box-blog__figure--has-image' }}">
                    {% if imageExists(blogArticle) %}
                        {{ image(blogArticle, { itemprop: 'image', lazy:true }) }}
                    {% endif %}
                    <h1 class="box-blog__title">
                        {% if blogArticle.getSeoH1(domainId) is not null %}
                            {{ blogArticle.getSeoH1(domainId) }}
                        {% else %}
                            {{ blogArticle.name }}
                        {% endif %}
                    </h1>
                </div>
                <div class="box-blog__top-panel">
                    <div class="box-blog__breadcrumb">
                        {{ render(controller('App\\Controller\\Front\\BreadcrumbController:indexAction', { routeName: getRoute(), routeParameters: getRouteParams() } )) }}
                    </div>
                    <div class="box-blog__panel">
                        {{ render(controller('App\\Controller\\Front\\BlogCategoryController:listAction', { currentBlogCategory: blogCategory })) }}
                        <a class="btn btn--next btn-no-style" href="{{ url('front_blogcategory_detail', { id: constant('App\\Model\\Blog\\Category\\BlogCategory::BLOG_MAIN_PAGE_CATEGORY_ID')}) }}">
                            {{ "Všechny články"|trans }}
                            <i class="btn__icon svg svg-long-arrow-right"></i>
                        </a>
                    </div>
                </div>
                <div class="box-blog__content__wrap">
                    <div class="in-user-text in-user-text--blog">
                        {% if blogArticle.perex is not empty %}
                            <div class="in-user-text__perex">
                                {{ blogArticle.perex }}
                            </div>
                        {% endif %}
                        {{ blogArticle.description|placeholders|raw }}
                    </div>
                </div>
            </div>
        </div>
        <div class="box-blog-articles">
            {{ render(controller('App\\Controller\\Front\\BlogArticleController:homepageArticlesAction')) }}
        </div>
    </div>
</div>
{% endblock %}
