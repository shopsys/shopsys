{% if homepageArticles is not null %}
    {% set domain = getDomain() %}
    <div class="web__line web__line--blog">
        <div class="web__container">
             <div class="box-articles">
                <div class="box-articles__heading">
                    <h2 class="box-articles__heading__title">
                        {{ 'Shopsys magazín'|trans }}
                    </h2>
                    <a class="box-articles__heading__link" href="{{ url('front_blogcategory_detail', { id: constant('App\\Model\\Blog\\Category\\BlogCategory::BLOG_MAIN_PAGE_CATEGORY_ID')}) }}">
                        <span class="box-articles__heading__link__text">{{ "Zobrazit všechny"|trans }}</span>
                        <i class="svg svg-arrow-right"></i>
                    </a>
                </div>

                {% include 'Front/Content/Article/list.html.twig' with { blogArticles: homepageArticles } %}
            </div>
        </div>
    </div>
{% endif %}
