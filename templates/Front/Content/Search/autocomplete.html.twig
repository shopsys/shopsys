<ul class="search__hint" id="js-search-autocomplete-list">
    {% for category in categoriesPaginationResult.results %}
        <li class="search__hint__item">
            <a href="{{ url('front_product_list', { id: category.id }) }}" class="search__hint__item__link">
                <span class="search__hint__image">
                    <img
                        class="search__hint__image__icon"
                        src="{{ asset('public/frontend/images/category_icon.png') }}" alt="{{ category.name }}">
                </span>
                <span class="search__hint__name js-search-autocomplete-item-label">{{ category.name }}</span>
            </a>
        </li>
    {% endfor %}

    {% for productView in productsPaginationResult.results %}
        <li class="search__hint__item">
            <a href="
                {% if productView.variantUrl is null %}
                    {{ productView.action.detailUrl }}
                {% else %}
                    {{ productView.variantUrl }}
                {% endif %}
                "
                class="search__hint__item__link">
                <span class="search__hint__image">
                     {% if productView.variantImageUrl is null %}
                         {{ image(productView.image, { size: 'thumbnailSearch', alt: productView.name, lazy: false }) }}
                     {% else %}
                         <picture>
                            <img
                                src="{{ productView.variantImageUrl }}"
                                alt="{{ productView.fullName }}"
                                title="{{ productView.fullName }}"
                                width="30"
                            />
                         </picture>
                     {% endif %}
                </span>
                <span class="search__hint__name js-search-autocomplete-item-label">
                    {{ productView.fullName }}
                </span>
            </a>
        </li>
    {% endfor %}

    {% if productsPaginationResult.totalCount <= 0 and categoriesPaginationResult.totalCount <= 0 %}
        <li class="search__hint__item">
            <span class="search__hint__item__link">
                <picture class="search__hint__image search__hint__image--no-result">
                    <source
                        srcset="
                            {{ asset('public/frontend/images/warning2x.png') }} 2x,
                            {{ asset('public/frontend/images/warning.png') }} 1x"
                    />
                    <img
                        src="{{ asset('public/frontend/images/warning.png') }}"
                        alt="{{ 'Žádné výsledky vyhledávání'|trans }}"
                    >
                </picture>
                <span class="search__hint__name search__hint__name--no-results">
                    {{ 'Pro tento výraz jsme bohužel nenašli žádné výsledky.'|trans }}
                </span>
            </span>
        </li>
    {% endif %}

    {% if productsPaginationResult.totalCount > 0 %}
        <li class="search__hint__item search__hint__item--info">
            {% transchoice productsPaginationResult.totalCount with {'%totalProductCount%': productsPaginationResult.totalCount} %}
                {0} Nenalezen žádný produkt
                | {1} Nalezen <strong class="search__hint__item__strong">1</strong> produkt
                | [2,Inf] Celkem nalezeno <strong class="search__hint__item__strong">%totalProductCount%</strong> produktů
            {% endtranschoice %}
        </li>
    {% endif %}

    {% if categoriesPaginationResult.totalCount > 0 or productsPaginationResult.totalCount > 0 %}
        <li class="search__hint__item search__hint__item--show-results">
            <a class="btn btn--show-results" href="{{ searchUrl }}">
                {{ 'View all results'|trans }}
            </a>
        </li>
    {% endif %}
</ul>
