{% import 'Front/Content/Product/productListMacro.html.twig' as productList %}
{% import 'Front/Inline/Paginator/paginator.html.twig' as paginator %}

{% if paginationResult.results|length > 0 %}
    <div class="js-product-list-with-paginator">
        {% set entityName = 'products'|trans %}

        {{ productList.list(paginationResult.results) }}

        <div class="list-pagination">
            <div class="list-pagination__item">
                {{ paginator.loadMoreButton(paginationResult) }}
            </div>
            <div class="list-pagination__item">
                {{ paginator.paginatorNavigation(paginationResult, entityName) }}
            </div>
        </div>
    </div>
{% else %}
    <div class="in-message in-message--default">
        {% if (filterFormSubmitted) %}
            <strong class="in-message__heading">{{ 'No results matching filter'|trans }}</strong>
            <p class="in-message__text">
                {{ 'Pro vaše přesné vyhledávání momentálně nemáme žádné výsledky.<br>
                Zkuste být více specifičtí, nebo se podívejte, jestli jste nevyfiltrovali neexistující údaje.'|transHtml }}
            </p>
        {% elseif searchText is defined %}
            <strong class="in-message__heading">{{ 'Search didn\'t find any products.'|trans }}</strong>
        {% elseif category is defined %}
            <strong class="in-message__heading">{{ 'This category contains no products.'|trans }}</strong>
        {% else %}
            <strong class="in-message__heading">{{ 'No products found for this brand'|trans }}</strong>
        {% endif %}
    </div>
{% endif %}
