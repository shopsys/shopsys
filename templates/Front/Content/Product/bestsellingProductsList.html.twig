{% if products|length > 0 %}
    <div class="box-list__section">
        <h3 class="box-list__subtitle">{{ 'Nejprodávanější produkty'|trans }}</h3>

        <div class="list-products-line js-bestselling-products">
            <ul class="list-products-line__list js-slider-drawable-list-mobile" data-breakpoint="mobile">
                {% for product in products %}
                    <li class="list-products-line__item js-bestselling-product{% if (loop.index > maxShownProducts )%} display-none{% endif %}">
                        <a href="{{ url('front_product_detail', {'id': product.id}) }}" class="list-products-line__item__block">
                            <div class="list-products-line__item__position">
                                {{ loop.index }}.
                            </div>
                            <div class="list-products-line__item__image">
                                {{ image(product, { size: 'thumbnail', alt: product.fullname }) }}
                            </div>
                            <div class="list-products-line__item__content">
                                <h3 class="list-products-line__item__title">
                                    <span class="underline-text">{{ product.name }}</span>
                                </h3>
                            </div>

                            {% set sellingPriceWithVat = getProductSellingPrice(product).priceWithVat %}
                            <div class="list-products-line__item__price">
                                <strong class="list-products-line__item__price__item list-products-line__item__price__item--main">
                                    {{ sellingPriceWithVat|price }}
                                </strong>
                            </div>
                        </a>
                    </li>
                {% endfor %}
            </ul>
            {% if products|length > maxShownProducts %}
                <div class="list-products-line__more js-bestselling-products-load-more-container">
                    <span class="btn btn--small btn-with-icon btn-with-icon--right js-bestselling-products-load-more">
                        {% transchoice products|length with {'%count%': products|length} %}
                            {4} Zobrazit %count% nejprodávanější
                            | [5,Inf] Zobrazit %count% nejprodávanějších
                        {% endtranschoice %}
                    </span>
                </div>
            {% endif %}
        </div>
    </div>
{% endif %}
