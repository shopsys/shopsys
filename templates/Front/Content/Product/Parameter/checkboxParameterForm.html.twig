<div class="box-filter__choice js-product-filter-parameter js-product-filter-box{% if filterCollapsedParameters[parameterId] is defined %} js-product-filter-close-parameter{% endif %}"
     data-product-filter-box-id="{{ parameterForm.vars.id }}">
    <span class="box-filter__choice__title active js-product-filter-box-label js-product-filter-parameter-label">
        {{ parameterForm.vars.label }}
        <i class="svg svg-arrow cursor-pointer js-product-filter-box-arrow"></i>
    </span>
    <div id="{{ parameterForm.vars.id }}" class="box-filter__choice__inputs">
        {% for parameterValueForm in parameterForm %}
            <div class="form-choice js-form-choice box-filter__choice__input js-product-filter-parameter-value
                {{ loop.index > paramsVisibleCount and not parameterValueForm.vars.checked ? ' js-form-choice--collapsing display-none' }}
                ">
                {{ form_widget(parameterValueForm, { attr: { class: 'css-checkbox'} }) }}
                <label class="css-checkbox__image form-choice__label" for="{{ parameterValueForm.vars.id }}">
                    {{ parameterValueForm.vars.label }}
                    {% if productFilterCountData is not null %}
                        <span
                            class="js-product-filter-count"
                            data-form-id="{{ parameterValueForm.vars.id }}"
                        >
                            {% if not parameterValueForm.vars.checked %}
                                (
                                {%- if parameterForm.vars.data is not empty and productFilterCountData.countByParameterIdAndValueId[parameterId][parameterValueForm.vars.value] ?? false %}+{% endif -%}
                                {{- productFilterCountData.countByParameterIdAndValueId[parameterId][parameterValueForm.vars.value]|default(0) -}}
                                )
                            {% endif %}
                        </span>
                    {% endif %}
                </label>
            </div>
        {% endfor %}
        {% if parameterForm|length > paramsVisibleCount %}
            <a class="box-filter__more btn btn-no-style js-product-filter-show-more-less"
                data-text-more="{{ 'Zobrazit více'|trans }}"
                data-text-less="{{ 'Zobrazit méně'|trans }}"
                href="#">
                {{ 'Zobrazit více'|trans }}
            </a>
        {% endif %}
    </div>
</div>