
<div class="box-filter__choice js-product-filter-parameter js-product-filter-box{% if filterCollapsedParameters[parameterId] is defined %} js-product-filter-close-parameter{% endif %}"
     data-product-filter-box-id="{{ parameterForm.vars.id }}">
    <h3 class="box-filter__choice__title active js-product-filter-box-label cursor-pointer js-product-filter-parameter-label js-product-filter-box-arrow">
        {{ parameterForm.vars.label }}
        <i class="svg svg-arrow"></i>
    </h3>
    <div class="box-filter__choice__content" id="{{ parameterForm.vars.id }}">
        {% for parameterValueForm in parameterForm %}

            {% set parameterValueChecked = parameterValueForm.vars.checked %}
            {% set parameterId = parameterValueForm.parent.vars.name %}
            {% set parameterValueId = parameterValueForm.vars.value %}

            <div class="form-choice{% if loop.last %} form-choice--without-margin{% endif %} js-form-choice js-product-filter-parameter-value
                {{ loop.index > paramsVisibleCount and not parameterValueForm.vars.checked ? ' js-form-choice--collapsing display-none' }}
                ">
                {{ form_widget(parameterValueForm, { attr: { class: 'css-checkbox', 'data-filter-name-with-entity-id': filterForm.parameters.vars.id ~ '_' ~ parameterId ~ '_' ~ parameterValueForm.vars.value } }) }}
                <label class="css-checkbox__image" for="{{ parameterValueForm.vars.id }}">
                    <a href="{{ getUrlByParameterValue(productFilterSetup, parameterId, parameterValueId, parameterValueChecked) }}"
                       class="js-product-filter-links"
                       data-link-id="parameter-{{ parameterId }}-{{ parameterValueId }}"
                    >
                    {{ parameterValueForm.vars.label }}
                    {% if productFilterCountData is not null %}
                        <span
                            class="js-product-filter-count"
                            data-form-id="{{ parameterValueForm.vars.id }}"
                        >
                            {% if not parameterValueForm.vars.checked %}
                                {% set parameterValueCount = productFilterCountData.countByParameterIdAndValueId[parameterId][parameterValueForm.vars.value]|default(0) %}
                                (
                                {%- if parameterForm.vars.data is not empty
                                    and parameterValueCount > 0
                                    and parameterForm.vars.attr.canShowPlus
                                %}+{% endif -%}
                                {{- parameterValueCount -}}
                                )
                            {% endif %}
                        </span>
                    {% endif %}
                    </a>
                </label>
            </div>
        {% endfor %}
        {% if parameterForm|length > paramsVisibleCount %}
            <a class="box-filter__choice__more js-product-filter-show-more-less"
                data-text-more="{{ 'Zobrazit více'|trans }}"
                data-text-less="{{ 'Zobrazit méně'|trans }}"
                href="#">
                {{ 'Zobrazit více'|trans }}
            </a>
        {% endif %}
    </div>
</div>
