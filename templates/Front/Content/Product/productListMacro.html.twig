{% macro list(productViews, listCssClass, productHeadingTagName, gtmList) %}
    {% import 'Front/Inline/Product/productDiscountMacro.html.twig' as discount %}

    <div class="list-products js-list js-product-list {{ listCssClass|default('') }}">
        {% for productView in productViews %}
            <div class="list-products__item js-list-products-item">
                <div class="list-products__item__in">
                    <a href="
                        {% if productView.variantUrl is null %}
                            {{ productView.action.detailUrl }}
                        {% else %}
                            {{ productView.variantUrl }}
                        {% endif %}
                    " class="list-products__item__block" {{ gtm(productView, loop.index, { 'list': gtmList }) }}>
                        <div class="list-products__item__image dont-print">
                            {% if productView.variantImageUrl is null %}
                                {{ image(productView.image, { size: 'list', alt: productView.name }) }}
                            {% else %}
                                <picture>
                                    <img
                                            src="{{ productView.variantImageUrl }}"
                                            data-src="{{ productView.variantImageUrl }}"
                                            alt="{{ productView.name }}"
                                            title="{{ productView.name }}"
                                            class="image-product-list loaded"
                                            itemprop="image"
                                            loading="lazy"
                                    />
                                </picture>
                            {% endif %}
                            {{ renderFlagsByIds(productView.flagIds, 'in-flag--in-list') }}
                        </div>

                        {% if productView.nonSellingPrice.priceWithVat.isPositive and not productView.hasScontoFlag %}
                            {{ discount.circle(productView.sellingPrice.priceWithVat, productView.nonSellingPrice.priceWithVat) }}
                        {% endif %}

                        <{{ productHeadingTagName|default('h2') }} class="list-products__item__title js-list-products-item-title">
                            {% if productView.namePrefix is not empty %}
                                <span class="list-products__item__title__prefix">{{ productView.namePrefix }}</span>
                            {% endif %}
                            <span>
                                {{ productView.name }}{{ productView.nameSufix is not empty ? ',' }}
                            </span>
                            {% if productView.nameSufix is not empty %}
                                <span class="list-products__item__title__suffix"> {{ productView.nameSufix }}</span>
                            {% endif %}
                        </{{ productHeadingTagName|default('h2') }}>
                        <div class="list-products__item__info dont-print">
                            {% if productView.countColorsInVariants > 0 or productView.countDifferentVariants > 0 %}
                                <div
                                    class="list-products__item__variants
                                    {{ productView.countColorsInVariants > 0 and productView.countDifferentVariants > 0 ? ' list-products__item__variants--multiple' }}">
                                    {% if productView.countColorsInVariants > 0 %}
                                        <div class="list-products__item__variants__item list-products__item__variants__item--color">
                                            <img
                                                class="list-products__item__variants__item__icon list-products__item__variants__item__icon--color"
                                                loading="lazy"
                                                data-src="{{ asset('public/frontend/images/variant-icon-color.svg') }}"
                                                alt="{{ 'Barva'|trans }}"
                                            >
                                            {% transchoice productView.countColorsInVariants with { '%itemsCount%': productView.countColorsInVariants } %}
                                                {1} 1 barva
                                                |{2, 3, 4} %itemsCount% barvy
                                                |]4,Inf[ %itemsCount% barev
                                            {% endtranschoice %}
                                        </div>
                                    {% endif %}
                                    {% if productView.countDifferentVariants > 0 %}
                                        <div class="list-products__item__variants__item list-products__item__variants__item--variant">
                                            <img
                                                class="list-products__item__variants__item__icon list-products__item__variants__item__icon--variant"
                                                loading="lazy"
                                                data-src="{{ asset('public/frontend/images/variant-icon.svg') }}"
                                                alt="{{ 'Varianty'|trans }}"
                                            >
                                            {% transchoice productView.countDifferentVariants with { '%itemsCount%': productView.countDifferentVariants } %}
                                                {1} 1 varianta
                                                |{2, 3, 4} %itemsCount% varianty
                                                |]4,Inf[ %itemsCount% variant
                                            {% endtranschoice %}
                                        </div>
                                    {% endif %}
                                </div>
                            {% endif %}
                            <div class="list-products__item__info__availability">
                                <strong class="list-products__item__info__availability__text list-products__item__info__availability__text--primary">{{ productView.availability }}</strong>
                                {% if productView.productAvailableStocksCountInformation is not empty %}
                                    <span class="list-products__item__info__availability__text list-products__item__info__availability__text--secondary">{{ productView.productAvailableStocksCountInformation|raw }}</span>
                                {% endif %}
                                {% if productView.productCountExposedInStores is not empty %}
                                    <span class="list-products__item__info__availability__text list-products__item__info__availability__text--secondary">{{ productView.productCountExposedInStores|raw }}</span>
                                {% endif %}
                            </div>
                            {% if productView.sellingPrice is not null %}
                                <div class="list-products__item__info__price">
                                    <div class="list-products__item__info__price__item list-products__item__info__price__item--main">
                                        {% if productView.sellingPrice.priceFrom %}
                                            {{ 'from %price%'|trans({'%price%': productView.sellingPrice.priceWithVat|price}) }}
                                        {% else %}
                                            {{ productView.sellingPrice.priceWithVat|price }}
                                        {% endif %}
                                        {{ renderAsterisk(productView.flagIds, 'sellingPrice') }}
                                    </div>
                                    {% if productView.nonSellingPrice.priceWithVat.isGreaterThan(productView.sellingPrice.priceWithVat) %}
                                        <div class="list-products__item__info__price__item list-products__item__info__price__item--high-price">
                                            {{ productView.nonSellingPrice.priceWithVat|price }}
                                            {{ renderAsterisk(productView.flagIds, 'nonSellingPrice') }}
                                        </div>
                                    {% endif %}
                                </div>
                            {% endif %}
                        </div>
                    </a>
                    <div class="list-products__item__action">
                        {{ render(controller('App\\Controller\\Front\\CartController:productActionAction', { productActionView: productView.action } )) }}
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
{% endmacro %}
