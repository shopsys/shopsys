{% if product.mountingState(domain.id) != null
    or product.embeddedAccessories(domain.id) != null
    or product.packageNotIncluded(domain.id) != null
    or product.packagingUnit(domain.id) != null
    or product.countPackages(domain.id) != null
    or product.totalPackageWeight(domain.id) != null
%}
    <div class="box-accordion js-accordion">
        <a class="box-accordion__header js-accordion-header" href="#">
            <strong class="box-accordion__heading" id="package-basic-information">{{ 'Informace o balení'|trans }}</strong>
            <span class="box-accordion__header__toggle">
                <span
                    class="box-accordion__header__toggle__text js-accordion-toggle-text"
                    data-text-more="{{ 'Zobrazit víc'|trans }}"
                    data-text-less="{{ 'Skrýt'|trans }}"
                >
                    {{ 'Zobrazit víc'|trans }}
                </span>
                <i class="box-accordion__header__toggle__icon svg svg-arrow"></i>
            </span>
        </a>
        <div class="box-accordion__body box-accordion__body--cols box-accordion__body--packages js-accordion-body">
            <ul class="box-detail-list box-detail-list--package">
                <li class="box-detail-list__item box-detail-list__item--heading">
                    <h2>{{ 'Detailní informace o balení'|trans }}</h2>
                </li>
                {% if product.mountingState(domain.id) != null %}
                    <li class="box-detail-list__item">
                        {{ 'Stav montáže'|trans }}:
                        {{ product.mountingState(domain.id) ? 'smontováno'|trans : 'demontováno'|trans }}
                    </li>
                {% endif %}

                {% if product.embeddedAccessories(domain.id) != null %}
                    <li class="box-detail-list__item">
                        {{ 'Dodávané příslušenství'|trans }}:
                        {{ product.embeddedAccessories(domain.id) }}
                    </li>
                {% endif %}

                {% if product.packageNotIncluded(domain.id) != null %}
                    <li class="box-detail-list__item">
                        {{ 'Neobsaženo v balení'|trans }}:
                        {{ product.packageNotIncluded(domain.id) }}
                    </li>
                {% endif %}

                {% if product.packagingUnit(domain.id) != null %}
                    <li class="box-detail-list__item">
                        {{ 'Počet produktů v balení'|trans }}:
                        {{ product.packagingUnit(domain.id) }}
                    </li>
                {% endif %}

                {% if product.countPackages(domain.id) != null %}
                    <li class="box-detail-list__item">
                        {{ 'Počet balíků'|trans }}:
                        {{ product.countPackages(domain.id) }}
                    </li>
                {% endif %}

                {% if product.totalPackageWeight(domain.id) != null %}
                    <li class="box-detail-list__item">
                        {{ 'Celková váha produktu'|trans }}:
                        {{ product.totalPackageWeight(domain.id) }} {{ 'Kg'|trans }}
                    </li>
                {% endif %}
            </ul>

            {% if productPackages|length > 0 %}
                {% for productPackage in productPackages %}
                    {% if productPackage.width != null
                        or productPackage.length != null
                        or productPackage.height != null
                        or productPackage.weight != null
                    %}
                    <ul class="box-detail-list box-detail-list--package">
                        <li class="box-detail-list__item box-detail-list__item--heading">
                            <h2>{{ 'Balík č.'|trans }} {{ productPackage.position }}</h2>
                        </li>
                        {% if productPackage.width != null %}
                            <li class="box-detail-list__item">{{ 'Šířka'|trans }} {{ productPackage.width }} {{ 'cm'|trans }}</li>
                        {% endif %}

                        {% if productPackage.length != null %}
                            <li class="box-detail-list__item">{{ 'Délka'|trans }} {{ productPackage.length }} {{ 'cm'|trans }}</li>
                        {% endif %}

                        {% if productPackage.height != null %}
                            <li class="box-detail-list__item">{{ 'Výška'|trans }} {{ productPackage.height }} {{ 'cm'|trans }}</li>
                        {% endif %}

                        {% if productPackage.weight != null %}
                            <li class="box-detail-list__item">{{ 'Hmotnost balíku'|trans }} {{ productPackage.weight }} {{ 'Kg'|trans }}</li>
                        {% endif %}
                    </ul>
                    {% endif %}
                {% endfor %}
            {% endif %}
        </div>
    </div>
{% endif %}
