{% if product.mountingState(domain.id) != null
    or product.embeddedAccessories(domain.id) != null
    or product.packageNotIncluded(domain.id) != null
    or product.packagingUnit(domain.id) != null
    or product.countPackages(domain.id) != null
    or product.totalPackageWeight(domain.id) != null
%}
    <div class="h3" id="package-basic-information">{{ 'Informace o balení'|trans }}</div>
    <div class="box-detail package-basic-information">
        <table class="table-grid margin-top-20">
            <tbody>
            {% if product.mountingState(domain.id) != null %}
            <tr>
                <th>
                    {{ 'Stav montáže'|trans }}
                </th>
                <td>
                    {{ product.mountingState(domain.id) ? 'smontováno'|trans : 'demontováno'|trans }}
                </td>
            </tr>
            {% endif %}

            {% if product.embeddedAccessories(domain.id) != null %}
            <tr>
                <th>
                    {{ 'Dodávané příslušenství'|trans }}
                </th>
                <td>
                    {{ product.embeddedAccessories(domain.id) }}
                </td>
            </tr>
            {% endif %}

            {% if product.packageNotIncluded(domain.id) != null %}
            <tr>
                <th>
                    {{ 'Neobsaženo v balení'|trans }}
                </th>
                <td>
                    {{ product.packageNotIncluded(domain.id) }}
                </td>
            </tr>
            {% endif %}

            {% if product.packagingUnit(domain.id) != null %}
            <tr>
                <th>
                    {{ 'Počet produktů v balení'|trans }}
                </th>
                <td>
                    {{ product.packagingUnit(domain.id) }}
                </td>
            </tr>
            {% endif %}

            {% if product.countPackages(domain.id) != null %}
            <tr>
                <th>
                    {{ 'Počet balíků'|trans }}
                </th>
                <td>
                    {{ product.countPackages(domain.id) }}
                </td>
            </tr>
            {% endif %}

            {% if product.totalPackageWeight(domain.id) != null %}
            <tr>
                <th>
                    {{ 'Celková váha produktu'|trans }}
                </th>
                <td>
                    {{ product.totalPackageWeight(domain.id) }} {{ 'Kg'|trans }}
                </td>
            </tr>
            {% endif %}

            </tbody>
        </table>
    </div>
{% endif %}

{% if productPackages|length > 0 %}
    <div class="h3" id="package-detail-information">{{ 'Detailní informace o balení'|trans }}</div>
    <div class="box-detail package-detail-information">
        {% for productPackage in productPackages %}
            {% if productPackage.width != null
                or productPackage.length != null
                or productPackage.height != null
                or productPackage.weight != null
            %}
            <div class="box-package">
                <div class="h4">{{ 'Balík č.'|trans }} {{ productPackage.position }}</div>
                <ul>
                    {% if productPackage.width != null %}
                        <li>{{ 'Šířka'|trans }} {{ productPackage.width }} {{ 'cm'|trans }}</li>
                    {% endif %}

                    {% if productPackage.length != null %}
                        <li>{{ 'Délka'|trans }} {{ productPackage.length }} {{ 'cm'|trans }}</li>
                    {% endif %}

                    {% if productPackage.height != null %}
                        <li>{{ 'Výška'|trans }} {{ productPackage.height }} {{ 'cm'|trans }}</li>
                    {% endif %}

                    {% if productPackage.weight != null %}
                        <li>{{ 'Hmotnost balíku'|trans }} {{ productPackage.weight }} {{ 'Kg'|trans }}</li>
                    {% endif %}
                </ul>
            </div>
            {% endif %}
        {% endfor %}
    </div>
{% endif %}
