{% extends 'Front/Layout/layoutWithoutPanel.html.twig' %}
{% import 'Front/Inline/Product/productFlagsMacro.html.twig' as productFlags %}
{% import 'Front/Inline/Product/productFlagAsteriskMacro.html.twig' as asterisk %}
{% import 'Front/Content/Product/productListMacro.html.twig' as productList %}

{% set domain = getDomain() %}
{% set descriptionHeadline = 'Product information'|trans %}
{% set parametersHeadline = 'Technical parameters'|trans %}
{% set accessoriesHeadline = 'Accessories'|trans %}
{% set sellingPriceWithVat = getProductSellingPrice(product).priceWithVat %}
{% set nonSellingPriceWithVat = getProductNonSellingPrice(product).priceWithVat %}

{% block meta_description %}
    {{- product.getSeoMetaDescription(domain.id)|default(getSeoMetaDescription()) -}}
{% endblock %}

{% block title %}
    {{ product.getSeoTitle(domain.id)|default(product.fullname) }}
{% endblock %}

{% block main_content %}
    <div itemscope itemtype="http://schema.org/Product">
        <div class="web__line">
            <div class="web__container">
                <div class="box-detail box-detail--primary">
                    <div class="box-detail__image">
                        {% set galleryImages = getImages(product) %}
                        {% set showGallery = galleryImages|length > 1 %}
                        <div class="box-detail__image__main">
                            {% if imageExists(product) %}
                                <a data-fancybox="products-gallery" data-caption="{{ product.name }}" href="{{ imageUrl(product, 'original') }}" class="box-detail__image__main__link {{ showGallery ? 'js-gallery-main-image' }}">
                                    {{ image(product, { itemprop: 'image', alt: product.fullname }) }}
                                </a>
                            {% else %}
                                {{ noimage({ alt: product.fullname }) }}
                            {% endif %}
                        </div>
                        {{ productFlags.list(product.getFlagsForDomain(domain.id)) }}

                        {% if showGallery %}
                            <div class="box-gallery dont-print js-gallery">
                                <div class="box-gallery__in">
                                    {% for galleryImage in galleryImages %}
                                        {% if loop.index != 1 %}
                                            <div class="box-gallery__item js-gallery-item">
                                                <a data-fancybox="products-gallery" data-caption="{{ product.name }}" href="{{ imageUrl(galleryImage, 'original') }}" class="box-gallery__item__link">
                                                    {{ image(galleryImage, {size: 'galleryThumbnail', lazy: false, alt: product.fullname ~ ' ' ~ loop.index}) }}
                                                </a>
                                            </div>
                                        {% endif %}
                                    {% endfor %}
                                </div>
                            </div>
                        {% endif %}
                    </div>
                    <div class="box-detail__info">
                        <h1 class="box-detail__heading" itemprop="name">
                            <span class="box-detail__heading__prefix">{{ product.nameFirstLine }}</span>
                            {{ product.nameSecondLine }}
                        </h1>

                        {% apply spaceless %}
                            <dl class="box-detail__info__params">
                                {% if not product.isMainVariant %}
                                    {% if product.catnum %}
                                        <dt>
                                            {{ 'Číslo produktu'|trans }}
                                        </dt>
                                        <dd>
                                            {{ product.catnum }}
                                        </dd>
                                    {% endif %}

                                    {% if product.partno %}
                                        <dt>
                                            {{ 'Serial number'|trans }}
                                        </dt>
                                        <dd>
                                            {{ product.partno }}
                                        </dd>
                                    {% endif %}

                                    {% if product.ean %}
                                        <dt>
                                            {{ 'EAN'|trans }}
                                        </dt>
                                        <dd>
                                            {{ product.ean }}
                                        </dd>
                                    {% endif %}
                                {% endif %}
                                {% if product.brand %}
                                    <dt>
                                        {{ 'Brand'|trans }}
                                    </dt>
                                    <dd>
                                        <a href="{{ url('front_brand_detail', { id: product.brand.id }) }}">
                                            <span itemprop="brand">{{ product.brand.name }}</span>
                                        </a>
                                    </dd>
                                {% endif %}
                            </dl>
                        {% endapply %}

                        <div class="box-detail__info__desc js-not-implemented-yet">
                            <ul class="box-detail-list box-detail-list--columns">
                                <li class="box-detail-list__item">Rozkládání do lůžka</li>
                                <li class="box-detail-list__item">Levé nebo pravé provedení</li>
                                <li class="box-detail-list__item">Odolný materiál</li>
                                <li class="box-detail-list__item">Polohovatelné opěrky hlavy</li>
                                <li class="box-detail-list__item">Potažená záda</li>
                                <li class="box-detail-list__item box-detail-list__item--anchor">
                                    <a class="box-detail__info__anchor" href="#product-desc">{{ 'Celý popis'|trans }}</a>
                                </li>
                            </ul>
                        </div>

                        <div class="box-detail__info__availability">
                            <div class="box-detail__info__availability__value js-not-implemented-yet">
                                <span class="box-detail__avail box-detail__avail--in-stock">{{ productAvailabilityInformation }}</span>
                                <span class="box-detail__avail__text">{{ 'Můžete mít ihned na <span class="box-detail__avail__text__strong">8</span> prodejnách'|transHtml }}</span>
                                <span class="box-detail__avail__text">{{ 'Můžete si prohlédnout na <span class="box-detail__avail__text__strong">3</span> prodejnách'|transHtml }}</span>
                                <span class="box-detail__avail__icon box-detail__avail__icon--in-stock">
                                    <img class="box-detail__avail__icon__image" loading="lazy" data-src="{{ asset('public/frontend/images/package-icon-stock.svg') }}" alt="{{ 'Skladem'|trans }}">
                                </span>
                            </div>
                            <div class="box-detail__info__availability__anchor">
                                <a class="box-detail__info__anchor" href="#stocks-availabilities">{{ 'Dostupnost'|trans }}</a>
                            </div>
                        </div>

                        {% if not product.isMainVariant %}
                            <div class="js-product-detail-main-add-to-cart-wrapper box-detail-add">
                                {% if not product.calculatedSellingDenied %}
                                    <div class="box-detail-add__info">
                                        <div itemprop="offers"
                                            itemscope
                                            itemtype="http://schema.org/Offer"
                                            class="box-detail-add__prices">
                                            {% if nonSellingPriceWithVat.isGreaterThan(sellingPriceWithVat) %}
                                                {% set productDiscount = (sellingPriceWithVat|moneyFormat / nonSellingPriceWithVat|moneyFormat) * 100 %}
                                                <span class="box-detail-add__discount">
                                                    -{{ productDiscount|round }}
                                                    <span class="box-detail-add__discount__perc">%</span>
                                                </span>
                                                <div class="box-detail-add__prices__wrap">
                                                    <div class="box-detail-add__prices__item box-detail-add__prices__item--high-price">
                                                        {{ nonSellingPriceWithVat|price }}
                                                        {{ asterisk.nonSellingPrice(product.getFlagsForDomain(domain.id)) }}**
                                                    </div>
                                                    <div class="box-detail-add__prices__item box-detail-add__prices__item--main">
                                                        {{ sellingPriceWithVat|price }}
                                                        {{ asterisk.sellingPrice(product.getFlagsForDomain(domain.id)) }}
                                                    </div>
                                                </div>
                                            {% else %}
                                                <div class="box-detail-add__prices__item box-detail-add__prices__item--main">
                                                    {{ sellingPriceWithVat|price }}
                                                    {{ asterisk.sellingPrice(product.getFlagsForDomain(domain.id)) }}
                                                </div>
                                            {% endif %}
                                            <meta itemprop="priceCurrency"
                                                content="{{ currencyCode(domain.id) }}"
                                            >
                                            <meta itemprop="price"
                                                content="{{ getProductSellingPrice(product).priceWithVat|moneyFormat }}"
                                            >
                                            <link itemprop="availability"
                                                href="{{ product.calculatedSellingDenied ? 'http://schema.org/OutOfStock' : 'http://schema.org/InStock' }}"
                                            >
                                        </div>
                                        {{ render(controller('App\\Controller\\Front\\CartController:addProductFormAction', {product: product, type: 'large'})) }}
                                    </div>
                                {% else %}
                                    <div>
                                        {{ 'This product is no longer available for purchase. Have a look at similar products <a href="%url%">here</a>.'|transHtml({"%url%": url('front_product_list', { id: productMainCategory.id })}) }}
                                    </div>
                                {% endif %}
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
        <div class="web__line web__line--bg-color web__line--spacing--large">
            <div class="web__container">
                {% if product.isMainVariant and not product.calculatedSellingDenied %}
                    <table {% if getProductSellingPrice(product) is not null %}itemprop="offers"
                        itemscope
                        itemtype="http://schema.org/AggregateOffer" {% endif %}
                        class="table-variants"
                    >
                        <thead>
                            <tr class="table-variants__row">
                                <th class="table-variants__cell table-variants__cell--image"></th>
                                <th class="table-variants__cell table-variants__cell--name">{{ 'Name'|trans }}</th>
                                <th class="table-variants__cell table-variants__cell--price">
                                    {{ 'Price including VAT'|trans }}
                                    {% if getProductSellingPrice(product) is not null %}
                                        <meta itemprop="priceCurrency"
                                            content="{{ currencyCode(domain.id) }}"
                                        >
                                        <meta itemprop="lowPrice"
                                            content="{{ getProductSellingPrice(product).priceWithVat|moneyFormat }}"
                                        >
                                        <link itemprop="availability"
                                            href="{{ product.calculatedSellingDenied ? 'http://schema.org/OutOfStock' : 'http://schema.org/InStock' }}"
                                        >
                                    {% endif %}
                                </th>
                                <th class="table-variants__cell table-variants__cell--action"></th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for variant in variants %}
                                <tr class="table-variants__row">
                                    <td class="table-variants__cell table-variants__cell--image">
                                        <div class="table-variants__cell__image">
                                            {% if imageExists(variant) %}
                                                <a href="{{ imageUrl(variant, 'original') }}" class="js-popup-image">
                                                    {{ image(variant, { size: 'thumbnail' }) }}
                                                </a>
                                            {% else %}
                                                {{ noimage() }}
                                            {% endif %}
                                        </div>
                                    </td>
                                    <td class="table-variants__cell table-variants__cell--name">
                                        {% if variant.variantAlias is not null %}
                                            {{ variant.variantAlias }}
                                        {% else %}
                                            {{ variant.name }}
                                        {% endif %}
                                    </td>
                                    <td class="table-variants__cell table-variants__cell--price">
                                        {{ getProductSellingPrice(variant).priceWithVat|price }}
                                    </td>
                                    <td class="table-variants__cell table-variants__cell--action">
                                        {{ render(controller('App\\Controller\\Front\\CartController:addProductFormAction', {product: variant})) }}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                {% endif %}

                {% set productParameterValues = getProductParameterValues(product) %}

                {% if product.getDescription(domain.id)%}
                    <div class="box-accordion js-accordion is-opened">
                        <a class="box-accordion__header js-accordion-header" href="#">
                            <strong class="box-accordion__heading">{{ 'Popis a parametry'|trans }}</strong>
                            <span class="box-accordion__header__toggle">
                                <span class="box-accordion__header__toggle__text">{{ 'Zobrazit víc'|trans }}</span>
                                <i class="box-accordion__header__toggle__icon svg svg-arrow"></i>
                            </span>
                        </a>
                        <div class="box-accordion__body{% if productParameterValues > 0 %} box-accordion__body--cols{% endif %} js-accordion-body">
                            <div class="box-accordion__body__content box-accordion__body__content--desc">
                                {{ product.getDescription(domain.id)|raw }}
                            </div>
                            {% if productParameterValues > 0 %}
                                <div class="box-accordion__body__content box-accordion__body__content--params">
                                    {% set lastProductParameterGroup = null %}
                                    {% for productParameterValue in productParameterValues %}
                                        {% set productParameterGroup = productParameterValue.parameter.group %}
                                        {% if productParameterGroup != lastProductParameterGroup and productParameterGroup.name|default('') is not empty %}
                                            {% if not loop.first %}
                                                </ul>
                                                <ul class="box-detail-list box-detail-list--params">
                                            {% else %}
                                                <ul class="box-detail-list box-detail-list--params">
                                            {% endif %}
                                            <li class="box-detail-list__item box-detail-list__item--heading">
                                                <h2>{{ productParameterGroup.name|default('') }}</h2>
                                            </li>
                                        {% endif %}
                                        {% if loop.first and productParameterGroup == lastProductParameterGroup %}
                                            <ul class="box-detail-list box-detail-list--params">
                                        {% endif %}
                                            <li class="box-detail-list__item">
                                                {{ productParameterValue.parameter.name }}:
                                                {{ productParameterValue.value.text }}
                                                {{ productParameterValue.parameter.parameterUnit != null ? productParameterValue.parameter.parameterUnit.name : '' }}
                                            </li>
                                        {% set lastProductParameterGroup = productParameterValue.parameter.group %}
                                        {% if loop.last %}
                                            </ul>
                                        {% endif %}
                                    {% endfor %}
                                </div>
                            {% endif %}
                        </div>
                    </div>
                {% endif %}

                <div class="box-accordion js-accordion js-not-implemented-yet">
                    <a class="box-accordion__header js-accordion-header" href="#">
                        <strong class="box-accordion__heading">{{ 'Rozměry'|trans }}</strong>
                        <span class="box-accordion__header__toggle">
                            <span class="box-accordion__header__toggle__text">{{ 'Zobrazit víc'|trans }}</span>
                            <i class="box-accordion__header__toggle__icon svg svg-arrow"></i>
                        </span>
                    </a>
                    <div class="box-accordion__body js-accordion-body">
                    </div>
                </div>

                {% include 'Front/Content/Product/productPackageInformation.html.twig' with {product: product, productPackages: productPackages, doamin: domain } %}

                {% if downloadFiles|length > 0 %}
                    <div class="box-detail download_files">
                        <div class="h3" id="download_files">{{ 'Ke stažení'|trans }}</div>
                        <ul>
                            {% for downloadFile in downloadFiles %}
                                <li>
                                    <a href="{{ downloadFile['url'] }}" download>{{ downloadFile['anchor_text']|trans }}</a>
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                {% endif %}

                {% if productSeriesList|length > 0 %}
                    <div class="h3">{{ 'Nábytkové programy'|trans }}</div>

                    <div id="productSeriesList">
                        {% for productSeries in productSeriesList %}
                            <div class="box">
                                <div class="series">
                                    {{ productSeries.getSeoH1(domain.id)|default(productSeries.name) }}

                                    <div class="box-detail__image__main">
                                        {% if imageExists(productSeries) %}
                                            <a data-fancybox="products-gallery" data-caption="{{ productSeries.name }}" href="{{ imageUrl(productSeries, 'original') }}" class="{{ showGallery ? 'js-gallery-main-image' }}">
                                                {{ image(productSeries, { itemprop: 'image', size: 'preview' }) }}
                                            </a>
                                        {% else %}
                                            {{ noimage({ alt: productSeries.name }) }}
                                        {% endif %}
                                    </div>

                                    {{ productList.list(productSeriesProductsIndexedByProductSeries[productSeries.id]) }}
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}

                {% cache 'products_similar_id_'~product.getId() {lifetime:60*60, domainId:getDomain().id} %}
                    {% if paginatedSimilarProducts.results|length > 0 %}
                        <div class="box-detail similar-products">
                            <div class="h3" id="similar-products">{{ 'Podobné produkty'|trans }}</div>
                            {% include 'Front/Content/Product/similarProducts.html.twig' with {paginationResult: paginatedSimilarProducts} %}
                        </div>
                    {% endif %}
                {% endcache %}

                {% if productStocksAvailabilitiesInformation|length > 0 %}
                    <div class="box-accordion js-accordion">
                        <a class="box-accordion__header js-accordion-header" href="#">
                            <strong class="box-accordion__heading" id="stocks-availabilities">{{ 'Dostupnost'|trans }}</strong>
                            <span class="box-accordion__header__toggle">
                                <span class="box-accordion__header__toggle__text">{{ 'Zobrazit víc'|trans }}</span>
                                <i class="box-accordion__header__toggle__icon svg svg-arrow"></i>
                            </span>
                        </a>
                        <div class="box-accordion__body box-accordion__body--no-spacing js-accordion-body">
                            <table class="box-accordion__grid-table">
                                <tbody class="box-accordion__grid-table__body">
                                {% for productStockAvailabilityInformation in productStocksAvailabilitiesInformation %}
                                    <tr class="box-accordion__grid-table__row">
                                        <th class="box-accordion__grid-table__col">
                                            <strong class="box-accordion__grid-table__title">{{ productStockAvailabilityInformation.stockName }}</strong>
                                        </th>
                                        <td class="box-accordion__grid-table__col">
                                            {{ productStockAvailabilityInformation.availabilityInformation|raw }}
                                        </td>
                                        <td class="box-accordion__grid-table__col">
                                            {{ productStockAvailabilityInformation.exposedProduct ? "ANO"|trans : "NE"|trans }}
                                        </td>
                                        <td class="box-accordion__grid-table__col js-not-implemented-yet">
                                            <a class="box-detail__info__anchor" href="#product-desc">{{ 'Detail prodejny'|trans }}</a>
                                        </td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                {% endif %}

                {% if accessories|length > 0 %}
                    <div class="box-detail">
                        <div class="h3">{{ 'Accessories'|trans }}</div>
                        <div>
                            {{ productList.list(accessories) }}
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>

        {% if categoryList %}
            <div class="web__line web__line--spacing--big">
                <div class="web__container">
                    <h2 class="h3">{{ 'Podobné kategorie'|trans }}</h2>
                    <div class="box-detail-cats">
                        {% for category in categoryList %}
                            <a class="box-detail-cats__item" href="{{ url('front_product_list', { id: category.id }) }}">
                                {{ category.name }}
                            </a>
                        {% endfor %}
                    </div>
                </div>
            </div>
        {% endif %}
    </div>
{% endblock %}
