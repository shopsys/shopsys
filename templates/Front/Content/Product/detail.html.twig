{% extends 'Front/Layout/layoutWithoutPanel.html.twig' %}
{% import 'Front/Content/Product/productListMacro.html.twig' as productList %}

{% set domain = getDomain() %}
{% set descriptionHeadline = 'Product information'|trans %}
{% set parametersHeadline = 'Technical parameters'|trans %}
{% set accessoriesHeadline = 'Accessories'|trans %}
{% set sellingPriceWithVat = productView.sellingPrice.priceWithVat %}

{% block meta_description %}
    {{- productView.seoMetaDescription -}}
{% endblock %}

{% block title %}
    {{ productView.seoPageTitle }}
{% endblock %}

{% block breadcrumb %}
{% endblock %}

{% block main_content %}
    {{ render(controller('App\\Controller\\Front\\BreadcrumbController:indexAction', { routeName: getRoute(), routeParameters: getRouteParams() } )) }}

    <div itemscope itemtype="http://schema.org/Product">
        <div class="web__line">
            <div class="web__container">
                {% set showGallery = productView.galleryImageViews|length > 1 %}
                <div class="box-detail">
                    <div class="box-detail__image">
                        {% if showGallery %}
                            <div class="box-detail__image__gallery">
                                {% set galleryImagesCount = productView.galleryImageViews|length %}
                                <div class="box-gallery dont-print js-gallery js-image-carousel">
                                    {% for galleryImage in productView.galleryImageViews %}
                                        <a class="box-gallery__item js-gallery-slide-link" href="{{ imageUrl(galleryImage, 'original') }}">
                                            <div class="box-gallery__item__in">
                                                {{ image(galleryImage, {size: 'galleryThumbnail', lazy: false, alt: productView.fullname ~ ' ' ~ loop.index}) }}
                                            </div>
                                        </a>
                                    {% endfor %}
                                </div>
                            </div>
                        {% endif %}

                        <div class="box-detail__image__main{{ showGallery ? '' : ' box-detail__image__main--mobile-visible' }}">
                            {% for galleryImage in productView.galleryImageViews|slice(0, 1) %}
                                <div class="box-detail__image__main__item">
                                    {% if productView.mainImageView %}
                                        <a
                                            href="{{ imageUrl(galleryImage, 'original') }}"
                                            class="box-detail__image__main__item__link {{ showGallery ? 'js-gallery-main-image' : 'js-popup-image' }}"
                                        >
                                            {{ image(galleryImage, {lazy: false, alt: productView.fullname ~ ' ' ~ loop.index}) }}
                                        </a>
                                    {% else %}
                                        {{ noimage({ alt: productView.fullname }) }}
                                    {% endif %}
                                </div>
                            {% endfor %}
                        </div>
                        
                        {{ renderFlagsByIds(productView.flagIds, 'in-flag--in-detail') }}
                    </div>
                    <div class="box-detail__info">
                        <h1 class="box-detail__heading" itemprop="name">
                            <div class="box-detail__heading__prefix">{{ productView.nameFirstLine }}</div>
                            {{ productView.nameSecondLine }}
                        </h1>

                        {% if not productView.isMainVariant %}
                            {% if productView.catnum %}
                                <div class="box-detail__info__code">
                                    {{ 'Code'|trans }}: {{ productView.catnum }}
                                </div>
                            {% endif %}
                        {% endif %}

                        {% if productView.usps|length > 0 %}
                            <ul class="list-simple list-simple--multiple-columns margin-bottom-20">
                                {% for usp in productView.usps %}
                                    <li class="list-simple__item">{{ usp }}</li>
                                {% endfor %}
                            </ul>
                        {% endif %}

                        <div class="box-detail__info__description js-not-implemented-yet">
                            Moderní elektrokolo se spolehlivým motorem Bafang M 500 se středovým pohonem s výkonem až 250 w.
                            {% if productView.description %}
                                <a class="js-smooth-scroll-anchor" href="#product-desc">
                                    {{ 'Celý popis'|trans }}
                                </a>
                            {% endif %}
                        </div>

                        {% if not productView.isMainVariant %}
                            <div class="js-product-detail-main-add-to-cart-wrapper box-detail-add">
                                {% if productView.inStock %}
                                    <div itemprop="offers"
                                        itemscope
                                        itemtype="http://schema.org/Offer"
                                        class="box-detail-add__price">
                                        {{ sellingPriceWithVat|price }}
                                        <meta itemprop="priceCurrency"
                                            content="{{ currencyCode(domain.id) }}"
                                        >
                                        <meta itemprop="price"
                                            content="{{ productView.sellingPrice.priceWithVat|moneyFormat }}"
                                        >
                                        <link itemprop="availability"
                                            href="{{ productView.isInStock ? 'http://schema.org/InStock' : 'http://schema.org/OutOfStock' }}"
                                        >
                                    </div>
                                    {{ render(controller('App\\Controller\\Front\\CartController:productActionAction', { productActionView: productView.actionView, type: 'large'} )) }}
                                {% else %}
                                    {{ 'This product is no longer available for purchase. Have a look at similar products <a href="%url%">here</a>.'|transHtml({"%url%": url('front_product_list', { id: productView.mainCategoryId })}) }}
                                {% endif %}
                            </div>
                        {% endif %}

                        <div class="box-detail__info__availability">
                            <div class="box-detail__info__availability__value">
                                {% if productView.availabilityStatus != "out-of-stock" %}
                                    <a href="#stocks-availabilities" class="box-detail__info__availability__text box-detail__info__availability__text--{{ productView.availabilityStatus }} js-smooth-scroll-anchor">
                                        {{ productView.availability }}
                                        <i class="svg svg-arrow"></i>
                                    </a>
                                {% else %}
                                    <span class="box-detail__info__availability__text box-detail__info__availability__text--{{ productView.availabilityStatus }}">
                                        {{ productView.availability }}
                                    </span>
                                {% endif %}

                                {% if productView.availabilityStatus == "in-stock" %}
                                    {% if productView.availableStoresCountInformation is not empty %}
                                        <span class="box-detail__info__availability__info">{{ productView.availableStoresCountInformation|raw }}</span>
                                    {% endif %}
                                    {% if productView.countExposedInStores is not empty %}
                                        <span class="box-detail__info__availability__info">{{ productView.countExposedInStores|raw }}</span>
                                    {% endif %}
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="web__line">
            <div class="web__container">
                {% if productView.isMainVariant and not productView.isSellingDenied %}
                    <table {% if productView.sellingPrice is not null %}itemprop="offers"
                        itemscope
                        itemtype="http://schema.org/AggregateOffer" {% endif %}
                        class="table-variants"
                    >
                        <thead>
                            <tr class="table-variants__row">
                                <th class="table-variants__cell table-variants__cell--image"></th>
                                <th class="table-variants__cell table-variants__cell--name">{{ 'Name'|trans }}</th>
                                <th class="table-variants__cell">{{ 'Availability'|trans }}</th>
                                <th class="table-variants__cell table-variants__cell--price">
                                    {{ 'Price including VAT'|trans }}
                                    {% if productView.sellingPrice is not null %}
                                        <meta itemprop="priceCurrency"
                                            content="{{ currencyCode(domain.id) }}"
                                        >
                                        <meta itemprop="lowPrice"
                                            content="{{ productView.sellingPrice.priceWithVat|moneyFormat }}"
                                        >
                                        <link itemprop="availability"
                                            href="{{ productView.isSellingDenied ? 'http://schema.org/OutOfStock' : 'http://schema.org/InStock' }}"
                                        >
                                    {% endif %}
                                </th>
                                <th class="table-variants__cell table-variants__cell--action"></th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for variant in productView.variants %}
                                <tr class="table-variants__row">
                                    <td class="table-variants__cell table-variants__cell--image">
                                        <div class="table-variants__cell__image">
                                            {% if variant.image %}
                                                <a href="{{ imageUrl(variant.image, 'original') }}" class="js-popup-image">
                                                    {{ image(variant.image, { size: 'thumbnail' }) }}
                                                </a>
                                            {% else %}
                                                {{ noimage() }}
                                            {% endif %}
                                        </div>
                                    </td>
                                    <td class="table-variants__cell table-variants__cell--name">
                                        {{ variant.name }}
                                    </td>
                                    <td class="table-variants__cell">
                                        <span class="js-not-implemented-yet">
                                            {# TODO - Availability si modified and probably it will be reverted. It has to be resolve after revert of availability. Original template: #}
                                            {#% if variant.calculatedAvailability %}
                                                {{ variant.calculatedAvailability.name }}
                                            {% endif %#}
                                            {{ 'Skladem'|trans }}
                                        </span>
                                    </td>
                                    <td class="table-variants__cell table-variants__cell--price">
                                        {{ variant.sellingPrice.priceWithVat|price }}
                                    </td>
                                    <td class="table-variants__cell table-variants__cell--action">
                                        {{ render(controller('App\\Controller\\Front\\CartController:productActionAction', {productActionView: variant.action})) }}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                {% endif %}

                {% set parameterValuesViewsData = productView.nonDimensionParameterViews %}

                {% if productView.description %}
                    <div class="box-accordion js-accordion js-accordion-closed-on-mobile is-opened" id="product-desc">
                        <a class="box-accordion__header js-accordion-header" href="#">
                            <strong class="box-accordion__heading">{{ 'Popis a parametry'|trans }}</strong>
                            <span class="box-accordion__header__toggle">
                                <span
                                    class="box-accordion__header__toggle__text js-accordion-toggle-text"
                                    data-text-more="{{ 'Zobrazit víc'|trans }}"
                                    data-text-less="{{ 'Skrýt'|trans }}"
                                >
                                    {{ 'Skrýt'|trans }}
                                </span>
                                <i class="box-accordion__header__toggle__icon svg svg-arrow"></i>
                            </span>
                        </a>
                        <div class="box-accordion__body{% if parameterValuesViewsData > 0 %} box-accordion__body--cols{% endif %} js-accordion-body">
                            <div class="box-accordion__body__content box-accordion__body__content--desc">
                                {{ productView.description|raw }}
                            </div>
                            {% if parameterValuesViewsData > 0 %}
                                <div class="box-accordion__body__content box-accordion__body__content--params">
                                    <ul>
                                        {% for parameterValuesViewData in parameterValuesViewsData %}
                                            <li>
                                                {{ parameterValuesViewData.parameterName }}:
                                                {{ parameterValuesViewData.valueTextsWithUnit|join(', ') }}
                                            </li>
                                        {% endfor %}
                                    </ul>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                {% endif %}

                {% set dimensionParameterValuesViewsData = productView.dimensionParameterViews %}
                {% if existProductImageByIdAndAkeneoType(productView.id, 'image_dimensions') or dimensionParameterValuesViewsData|length > 0 %}
                    <div class="box-accordion js-accordion">
                        <a class="box-accordion__header js-accordion-header" href="#">
                            <strong class="box-accordion__heading">{{ 'Rozměry'|trans }}</strong>
                            <span class="box-accordion__header__toggle">
                                <span
                                    class="box-accordion__header__toggle__text js-accordion-toggle-text"
                                    data-text-more="{{ 'Zobrazit víc'|trans }}"
                                    data-text-less="{{ 'Skrýt'|trans }}"
                                >
                                    {{ 'Zobrazit víc'|trans }}
                                </span>
                                <i class="box-accordion__header__toggle__icon svg svg-arrow"></i>
                            </span>
                        </a>
                        <div class="box-accordion__body box-accordion__body--cols box-accordion__body--measures js-accordion-body">
                            <div class="box-accordion__body__content box-accordion__body__content--measures">
                                <table class="table table--params">
                                    <thead>
                                        <tr>
                                            <th colspan="2">{{ 'Rozměry'|trans }}</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for parameterValuesViewData in dimensionParameterValuesViewsData %}
                                            <tr>
                                                <td>{{ parameterValuesViewData.parameterName }}</td>
                                                <td>{{ parameterValuesViewData.valueTextsWithUnit|join(', ') }}</td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                            <div class="box-accordion__body__content box-accordion__body__content--img">{{ productImageByIdAndAkeneoType(productView.id, 'image_dimensions', { itemprop: 'image', alt: 'Rozměry'|trans }) }}</div>
                        </div>
                    </div>
                {% endif %}

                {% if productView.productFileViews|length > 0 %}
                    <div class="box-accordion js-accordion">
                        <a class="box-accordion__header js-accordion-header" href="#">
                            <strong class="box-accordion__heading">{{ 'Ke stažení'|trans }}</strong>
                            <span class="box-accordion__header__toggle">
                                <span
                                    class="box-accordion__header__toggle__text js-accordion-toggle-text"
                                    data-text-more="{{ 'Zobrazit víc'|trans }}"
                                    data-text-less="{{ 'Skrýt'|trans }}"
                                >
                                    {{ 'Zobrazit víc'|trans }}
                                </span>
                                <i class="box-accordion__header__toggle__icon svg svg-arrow"></i>
                            </span>
                        </a>
                        <div class="box-accordion__body box-accordion__body--cols js-accordion-body">
                            <ul class="list-simple">
                                {% for productFileView in productView.productFileViews %}
                                    <li class="list-simple__item">
                                        <a target="_blank" href="{{ productFileView.url }}">
                                            {{ productFileView.anchorText|trans }}
                                        </a>
                                    </li>
                                {% endfor %}
                            </ul>
                        </div>
                    </div>
                {% endif %}

                {% if productView.storeAvailabilitiesInformation|length > 0 %}
                    <div class="box-accordion box-accordion--opened js-accordion js-accordion-mobile" id="stocks-availabilities">
                        <div class="box-accordion__header box-accordion__header--with-desc">
                            <strong class="box-accordion__heading">{{ 'Dostupnost na prodejnách'|trans }}</strong>
                            <p class="box-accordion__header__desc">
                                {{ 'Vyberte prodejnu ze seznamu'|trans }}
                            </p>
                        </div>
                        <div class="box-accordion__body box-accordion__body--no-spacing">
                            <div class="box-accordion__grid-table box-accordion__grid-table--mobile-accords">
                                <div class="box-accordion__grid-table__body">
                                {% for productStockAvailabilityInformation in productView.storeAvailabilitiesInformation %}
                                    <div class="box-accordion__grid-table__row">
                                        <div class="box-accordion__grid-table__col box-accordion__grid-table__col--mobile-accord-header js-accordion-mobile-header">
                                            <strong class="box-accordion__grid-table__title">{{ productStockAvailabilityInformation.storeName }}</strong>
                                            <i class="box-accordion__grid-table__col__toggle svg svg-arrow"></i>
                                        </div>
                                        <div class="box-accordion__grid-table__col box-accordion__grid-table__col--mobile-accord-content js-accordion-mobile-section">
                                            {{ productStockAvailabilityInformation.availabilityInformation|raw }}
                                        </div>
                                        <div class="box-accordion__grid-table__col box-accordion__grid-table__col--expose box-accordion__grid-table__col--mobile-accord-content js-accordion-mobile-section">
                                            {% if productStockAvailabilityInformation.exposedProduct %}
                                                <img
                                                    class="box-accordion__grid-table__col__icon"
                                                    loading="lazy"
                                                    src="{{ imgLazyloadPlaceholder }}"
                                                    data-src="{{ asset('public/frontend/images/vystaveno.svg') }}"
                                                    alt="{{ 'Vystaveno'|trans }}"
                                                >
                                                {{ '<strong class="box-accordion__grid-table__col__expose">Vystaveno</strong> na prodejně'|transHtml }}
                                            {% else %}
                                                <img
                                                    class="box-accordion__grid-table__col__icon"
                                                    loading="lazy"
                                                    src="{{ imgLazyloadPlaceholder }}"
                                                    data-src="{{ asset('public/frontend/images/nevystaveno.svg') }}"
                                                    alt="{{ 'Není vystaveno'|trans }}"
                                                >
                                                {{ '<strong class="box-accordion__grid-table__col__expose">Není vystaveno</strong> na prodejně'|transHtml }}
                                            {% endif %}
                                        </div>
                                    </div>
                                {% endfor %}
                                </div>
                            </div>
                        </div>
                    </div>
                {% endif %}

                {% if productView.accessories|length > 0 %}
                    <div class="box-detail gtm-scroll" data-gtm-event="{{ gtmAccessoriesScrollEvent|json_encode() }}">
                        <h2>{{ 'Můžete si dokoupit'|trans }}</h2>
                        {{ productList.sliderList(productView.accessories, 'accessories-products', constant('App\\Model\\Gtm\\DataLayer::LIST_NAME_PRODUCT_ACCESSORIES')) }}
                    </div>
                {% endif %}

                {% cache 'products_similar_id_' ~ productView.id {lifetime:getCacheLifetimeByHours(1), domainId:getDomain().id} %}
                    {{ render(controller('App\\Controller\\Front\\ProductController:similarProductsAction', {id: productView.id} ))|spaceless }}
                {% endcache %}
            </div>
        </div>

        {% if productView.categoryViews %}
            <div class="web__line">
                <div class="web__container">
                    <h2>{{ 'Zařazeno v kategoriích:'|trans }}</h2>
                    <ul class="list-simple">
                        {% for categoryView in productView.categoryViews %}
                            <li class="list-simple__item">
                                <a href="{{ categoryView.url }}">
                                    <img loading="lazy" data-src="{{ asset('public/frontend/images/category_icon.svg') }}" alt="{{ categoryView.name }}">
                                    {{ categoryView.name }}
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            </div>
        {% endif %}
    </div>
{% endblock %}
