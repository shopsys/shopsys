{% extends 'Front/Layout/layoutWithoutPanel.html.twig' %}
{% import 'Front/Inline/Product/productFlagsMacro.html.twig' as productFlags %}
{% import 'Front/Content/Product/productListMacro.html.twig' as productList %}

{% set domain = getDomain() %}
{% set descriptionHeadline = 'Product information'|trans %}
{% set parametersHeadline = 'Technical parameters'|trans %}
{% set accessoriesHeadline = 'Accessories'|trans %}
{% set showGalleryMaxCount = 4 %}

{% block meta_description %}
    {{- product.getSeoMetaDescription(domain.id)|default(getSeoMetaDescription()) -}}
{% endblock %}

{% block title %}
    {{ product.getSeoTitle(domain.id)|default(product.fullname) }}
{% endblock %}

{% block main_content %}
    <link rel="stylesheet" type="text/css" href="{{ asset('assets/frontend/styles/fancybox/jquery.fancybox.min-' ~ getCssVersion() ~ '.css') }}">
    <div class="web__line">
        <div class="web__container">
            <div itemscope itemtype="http://schema.org/Product">
                <div class="box-detail">
                    <div class="box-detail__image">
                        {% set galleryImages = getImages(product) %}
                        {% set showGallery = galleryImages|length > 1 %}
                        <div class="box-detail__image__main">
                            {% if imageExists(product) %}
                                <a data-fancybox="products-gallery" data-caption="{{ product.name }}" href="{{ imageUrl(product, 'original') }}" class="{{ showGallery ? 'js-gallery-main-image' }}">
                                    {{ image(product, { itemprop: 'image' }) }}
                                </a>
                            {% else %}
                                {{ noimage({ alt: product.fullname }) }}
                            {% endif %}
                        </div>
                        {{ productFlags.list(product) }}

                        {% if showGallery %}
                            <div class="box-gallery dont-print js-gallery">
                                <div class="box-gallery__in">
                                    {% for galleryImage in galleryImages %}
                                        {% if loop.index != 1 %}
                                            <div class="box-gallery__item js-gallery-item {% if loop.index > showGalleryMaxCount %}display-none{% endif %}">
                                                <a data-fancybox="products-gallery" data-caption="{{ product.name }}" href="{{ imageUrl(galleryImage, 'original') }}" class="box-gallery__item__link">
                                                    {{ image(galleryImage, {size: 'galleryThumbnail', lazy: false}) }}
                                                </a>
                                            </div>
                                        {% endif %}
                                    {% endfor %}
                                </div>
                                {% if galleryImages|length > showGalleryMaxCount %}
                                    <div class="box-gallery__item js-gallery-item-more">
                                        <a href="#" class="box-gallery__item__link underline">
                                            {{ 'Další'|trans }} ({{ galleryImages|length - showGalleryMaxCount }})
                                        </a>
                                    </div>
                                {% endif %}
                            </div>
                        {% endif %}
                    </div>
                    <div class="box-detail__info">
                        <h1 itemprop="name">
                            {{ product.nameFirstLine }}
                            <br>
                            {{ product.nameSecondLine }}
                        </h1>

                        <div class="box-detail__info__availability">
                            {{ productAvailabilityInformation }}
                            <div>
                                <a href="#stocks-availabilities">{{ 'Dostupnost na pobočkách'|trans }}</a>
                            </div>
                        </div>

                        {% if not product.isMainVariant %}
                            <div class="js-product-detail-main-add-to-cart-wrapper box-detail-add">
                                {% if not product.calculatedSellingDenied %}
                                    <div itemprop="offers"
                                        itemscope
                                        itemtype="http://schema.org/Offer"
                                        class="box-detail-add__prices">
                                        <div class="box-detail-add__prices__item box-detail-add__prices__item--main">
                                            {{ getProductSellingPrice(product).priceWithVat|price }}
                                        </div>
                                        <div class="box-detail-add__prices__item box-detail-add__prices__item--high-price">
                                            {{ getProductNonSellingPrice(product).priceWithVat|price }}
                                        </div>
                                        <meta itemprop="priceCurrency"
                                            content="{{ currencyCode(domain.id) }}"
                                        >
                                        <meta itemprop="price"
                                            content="{{ getProductSellingPrice(product).priceWithVat|moneyFormat }}"
                                        >
                                        <link itemprop="availability"
                                            href="{{ product.calculatedSellingDenied ? 'http://schema.org/OutOfStock' : 'http://schema.org/InStock' }}"
                                        >
                                    </div>
                                    {{ render(controller('App\\Controller\\Front\\CartController:addProductFormAction', {product: product, type: 'large'})) }}
                                {% else %}
                                    <div>
                                        {{ 'This product is no longer available for purchase. Have a look at similar products <a href="%url%">here</a>.'|transHtml({"%url%": url('front_product_list', { id: productMainCategory })}) }}
                                    </div>
                                {% endif %}
                            </div>
                        {% endif %}

                        {% spaceless %}
                            <dl class="box-detail__info__params">
                                {% if product.brand %}
                                    <dt>
                                        {{ 'Brand'|trans }}:
                                    </dt>
                                    <dd>
                                        <a href="{{ url('front_brand_detail', { id: product.brand.id }) }}">
                                            <span itemprop="brand">{{ product.brand.name }}</span>
                                        </a>
                                    </dd>
                                {% endif %}

                                {% if not product.isMainVariant %}
                                    {% if product.catnum %}
                                        <dt>
                                            {{ 'Catalogue number'|trans }}:
                                        </dt>
                                        <dd>
                                            {{ product.catnum }}
                                        </dd>
                                    {% endif %}

                                    {% if product.partno %}
                                        <dt>
                                            {{ 'Serial number'|trans }}:
                                        </dt>
                                        <dd>
                                            {{ product.partno }}
                                        </dd>
                                    {% endif %}

                                    {% if product.ean %}
                                        <dt>
                                            {{ 'EAN'|trans }}:
                                        </dt>
                                        <dd>
                                            {{ product.ean }}
                                        </dd>
                                    {% endif %}
                                {% endif %}
                            </dl>
                        {% endspaceless %}
                    </div>
                </div>

                {% if product.isMainVariant and not product.calculatedSellingDenied %}
                    <table {% if getProductSellingPrice(product) is not null %}itemprop="offers"
                        itemscope
                        itemtype="http://schema.org/AggregateOffer" {% endif %}
                        class="table-variants"
                    >
                        <thead>
                            <tr class="table-variants__row">
                                <th class="table-variants__cell table-variants__cell--image"></th>
                                <th class="table-variants__cell table-variants__cell--name">{{ 'Name'|trans }}</th>
                                <th class="table-variants__cell table-variants__cell--price">
                                    {{ 'Price including VAT'|trans }}
                                    {% if getProductSellingPrice(product) is not null %}
                                        <meta itemprop="priceCurrency"
                                            content="{{ currencyCode(domain.id) }}"
                                        >
                                        <meta itemprop="lowPrice"
                                            content="{{ getProductSellingPrice(product).priceWithVat|moneyFormat }}"
                                        >
                                        <link itemprop="availability"
                                            href="{{ product.calculatedSellingDenied ? 'http://schema.org/OutOfStock' : 'http://schema.org/InStock' }}"
                                        >
                                    {% endif %}
                                </th>
                                <th class="table-variants__cell table-variants__cell--action"></th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for variant in variants %}
                                <tr class="table-variants__row">
                                    <td class="table-variants__cell table-variants__cell--image">
                                        <div class="table-variants__cell__image">
                                            {% if imageExists(variant) %}
                                                <a href="{{ imageUrl(variant, 'original') }}" class="js-popup-image">
                                                    {{ image(variant, { size: 'thumbnail' }) }}
                                                </a>
                                            {% else %}
                                                {{ noimage() }}
                                            {% endif %}
                                        </div>
                                    </td>
                                    <td class="table-variants__cell table-variants__cell--name">
                                        {% if variant.variantAlias is not null %}
                                            {{ variant.variantAlias }}
                                        {% else %}
                                            {{ variant.name }}
                                        {% endif %}
                                    </td>
                                    <td class="table-variants__cell table-variants__cell--price">
                                        {{ getProductSellingPrice(variant).priceWithVat|price }}
                                    </td>
                                    <td class="table-variants__cell table-variants__cell--action">
                                        {{ render(controller('App\\Controller\\Front\\CartController:addProductFormAction', {product: variant})) }}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                {% endif %}

                {% set productParameterValues = getProductParameterValues(product) %}

                {% if product.getDescription(domain.id)%}
                    <div class="box-detail">
                        <div class="h3">
                            {{ 'Product information'|trans }}
                        </div>
                        <div>
                            {% if product.getDescription(domain.id) %}
                                <p>
                                    {{ product.getDescription(domain.id)|raw }}
                                </p>
                            {% endif %}
                        </div>
                    </div>
                {% endif %}

                {% if categoryList %}
                    <div class="box-detail">
                        <div class="h3">{{ 'Kategorie'|trans }}</div>
                        <div>
                            {% for category in categoryList %}
                                <a href="{{ url('front_product_list', { id: category.id }) }}">
                                    {{ category.name }}
                                </a><br>
                            {% endfor %}
                        </div>
                    </div>
                {% endif %}

                {% if accessories|length > 0 %}
                    <div class="box-detail">
                        <div class="h3">{{ 'Accessories'|trans }}</div>
                        <div>
                            {{ productList.list(accessories) }}
                        </div>
                    </div>
                {% endif %}
                {% if productParameterValues > 0 %}
                    <div class="box-detail">
                        <div class="h3">{{ 'Technical parameters'|trans }}</div>
                        <table class="table-params{% if product.getDescription(domain.id) %} margin-top-20{% endif %}">
                            <tbody>
                            {% for productParameterValue in productParameterValues %}
                                <tr>
                                    <th>
                                        {{ productParameterValue.parameter.name }}
                                    </th>
                                    <td>
                                        {{ productParameterValue.value.text }}
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}

                {% if paginatedSimilarProducts.results|length > 0 %}
                    <div class="box-detail similar-products">
                        <div class="h3" id="similar-products">{{ 'Podobné produkty'|trans }}</div>
                        {% include 'Front/Content/Product/similarProducts.html.twig' with {paginationResult: paginatedSimilarProducts} %}
                    </div>
                {% endif %}

                {% if productStocksAvailabilitiesInformation|length > 0 %}
                    <div class="box-detail stocks-availabilities">
                        <div class="h3" id="stocks-availabilities">{{ 'Skladové zásoby'|trans }}</div>
                        <table class="table-grid margin-top-20">
                            <thead>
                                <tr>
                                    <th>
                                        {{ 'Sklad'|trans }}
                                    </th>
                                    <th>
                                        {{ 'Dostupnost'|trans }}
                                    </th>
                                    <th>
                                        {{ 'Vystaveno'|trans }}
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                            {% for productStockAvailabilityInformation in productStocksAvailabilitiesInformation %}
                                <tr>
                                    <th>
                                        {{ productStockAvailabilityInformation.stockName }}
                                    </th>
                                    <td>
                                        {{ productStockAvailabilityInformation.availabilityInformation }}
                                    </td>
                                    <td>
                                        {{ productStockAvailabilityInformation.exposedProduct ? "ANO"|trans : "NE"|trans }}
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}

                {% if downloadFiles|length > 0 %}
                    <div class="box-detail download_files">
                        <div class="h3" id="download_files">{{ 'Ke stažení'|trans }}</div>
                        <ul>
                            {% for downloadFile in downloadFiles %}
                                <li>
                                    <a href="{{ downloadFile['url'] }}" download>{{ downloadFile['anchor_text']|trans }}</a>
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                {% endif %}

            </div>
        </div>
    </div>
{% endblock %}
