{% extends 'Front/Layout/layoutWithoutPanel.html.twig' %}
{% import 'Front/Inline/Product/productFlagsMacro.html.twig' as productFlags %}
{% import 'Front/Inline/Product/productFlagAsteriskMacro.html.twig' as asterisk %}
{% import 'Front/Content/Product/productListMacro.html.twig' as productList %}
{% import 'Front/Inline/Product/productDiscountMacro.html.twig' as discount %}

{% set domain = getDomain() %}
{% set descriptionHeadline = 'Product information'|trans %}
{% set parametersHeadline = 'Technical parameters'|trans %}
{% set accessoriesHeadline = 'Accessories'|trans %}
{% set sellingPriceWithVat = getProductSellingPrice(product).priceWithVat %}
{% set nonSellingPriceWithVat = getProductNonSellingPrice(product).priceWithVat %}

{% block meta_description %}
    {{- product.getSeoMetaDescription(domain.id)|default(getSeoMetaDescription()) -}}
{% endblock %}

{% block title %}
    {{ product.getSeoTitle(domain.id)|default(product.fullname) }}
{% endblock %}

{% block breadcrumb %}
{% endblock %}

{% block main_content %}
    <div class="box-detail-breadcrumb">
        {{ render(controller('App\\Controller\\Front\\BreadcrumbController:indexAction', { routeName: getRoute(), routeParameters: getRouteParams() } )) }}
    </div>
    <div itemscope itemtype="http://schema.org/Product">
        <div class="web__line">
            <div class="web__container">
                {% set galleryImages = getImages(product) %}
                {% set showGallery = galleryImages|length > 1 %}
                <div class="box-detail box-detail--primary{{ showGallery ? '' : ' box-detail--no-gallery' }}">
                    <h1 class="box-detail__heading" itemprop="name">
                        <span class="box-detail__heading__prefix">{{ product.nameFirstLine }}</span>
                        {{ product.nameSecondLine }}
                    </h1>
                    <div class="box-detail__wrap">
                        <div class="box-detail__image">
                            <div class="box-detail__image__main">
                                {% if imageExists(product) %}
                                    <a data-fancybox="products-gallery" data-caption="{{ product.name }}" href="{{ imageUrl(product, 'original') }}" class="box-detail__image__main__link {{ showGallery ? 'js-gallery-main-image' }}">
                                        {{ image(product, { itemprop: 'image', alt: product.fullname }) }}
                                    </a>
                                {% else %}
                                    {{ noimage({ alt: product.fullname }) }}
                                {% endif %}
                            </div>
                            {{ productFlags.list(product.getFlagsForDomain(domain.id)) }}

                            {% if showGallery %}
                                {% set galleryImagesCount = galleryImages|length %}
                                <div class="box-gallery dont-print js-gallery{{ galleryImagesCount > 5 ? ' js-gallery-slick-carousel' }}">
                                    <div class="box-gallery__in js-gallery-wrap">
                                        {% for galleryImage in galleryImages %}
                                            {% if loop.index != 1 %}
                                                <div class="box-gallery__item js-gallery-item">
                                                    <a
                                                        data-fancybox="products-gallery"
                                                        data-caption="{{ product.name }}"
                                                        href="{{ imageUrl(galleryImage, 'original') }}"
                                                        class="box-gallery__item__link">
                                                        {{ image(galleryImage, {size: 'galleryThumbnail', lazy: false, alt: product.fullname ~ ' ' ~ loop.index}) }}
                                                    </a>
                                                </div>
                                            {% endif %}
                                        {% endfor %}
                                    </div>
                                </div>
                            {% endif %}
                        </div>
                        <div class="box-detail__info">
                            {% apply spaceless %}
                                <dl class="box-detail__info__params">
                                    {% if not product.isMainVariant %}
                                        {% if product.catnum %}
                                            <dt>
                                                {{ 'č. produktu:'|trans }}
                                            </dt>
                                            <dd>
                                                {{ product.catnum }}
                                            </dd>
                                        {% endif %}
                                    {% endif %}
                                </dl>
                            {% endapply %}

                            <div class="box-detail__info__desc">
                                <ul class="box-detail-list box-detail-list--columns">
                                    {% for usp in 1..5 %}
                                        {% set uspMethod = 'shortDescriptionUsp'~usp %}
                                        {% set uspValue = attribute(product, uspMethod, [domain.id]) %}
                                        {% if uspValue is not empty %}
                                            <li class="box-detail-list__item">{{ uspValue }}</li>
                                        {% endif %}
                                    {% endfor %}
                                    {% if product.getDescription(domain.id)%}
                                        <li class="box-detail-list__item box-detail-list__item--anchor">
                                            <a class="box-detail__info__anchor js-smooth-scroll-anchor" href="#product-desc">
                                                <span class="box-detail__info__anchor__underline">{{ 'Celý popis'|trans }}</span>
                                            </a>
                                        </li>
                                    {% endif %}
                                </ul>
                            </div>

                            {% if not product.isMainVariant %}
                                {{ render(controller('App\\Controller\\Front\\ProductController:variantParametersAction', {product: product} )) }}
                            {% endif %}

                            <div class="box-detail__info__availability box-detail__info__availability--{{ productAvailabilityStatus }}">
                                <div class="box-detail__info__availability__value">
                                    <span class="box-detail__avail box-detail__avail--{{ productAvailabilityStatus }}">{{ productAvailabilityInformation }}</span>
                                    {% if productAvailabilityStatus == "in-stock" %}
                                        {% if productAvailableStocksCountInformation is not empty %}
                                            <span class="box-detail__avail__text">{{ productAvailableStocksCountInformation|raw }}</span>
                                        {% endif %}
                                        {% if productCountExposedInStores is not empty %}
                                            <span class="box-detail__avail__text">{{ productCountExposedInStores|raw }}</span>
                                        {% endif %}
                                    {% endif %}
                                    <span class="box-detail__avail__icon box-detail__avail__icon--{{ productAvailabilityStatus }}">
                                        {% if productAvailabilityStatus == "in-stock" %}
                                            <picture>
                                                <source
                                                    srcset="{{ asset('public/frontend/images/package-in-stock2x.png') }} 2x, {{ asset('public/frontend/images/package-in-stock.png') }} 1x"
                                                >
                                                <img
                                                    class="box-detail__avail__icon__image"
                                                    loading="lazy"
                                                    data-src="{{ asset('public/frontend/images/package-in-stock.png') }}"
                                                    alt="{{ 'Skladem'|trans }}"
                                                >
                                            </picture>
                                        {% else %}
                                            <picture>
                                                <source
                                                    srcset="{{ asset('public/frontend/images/package-in-stock2x.png') }} 2x, {{ asset('public/frontend/images/package-in-stock.png') }} 1x"
                                                >
                                                <img
                                                    class="box-detail__avail__icon__image"
                                                    loading="lazy"
                                                    data-src="{{ asset('public/frontend/images/package-in-stock.png') }}"
                                                    alt="{{ 'Není skladem'|trans }}"
                                                >
                                            </picture>
                                        {% endif %}
                                    </span>
                                </div>
                                {% if productAvailabilityStatus != "out-of-stock" %}
                                    <div class="box-detail__info__availability__anchor">
                                        <a class="box-detail__info__anchor js-smooth-scroll-anchor" href="#stocks-availabilities">
                                            {{ 'Dostupnost'|trans }}
                                            <i class="box-detail__info__anchor__icon svg svg-chevron"></i>
                                        </a>
                                    </div>
                                {% endif %}
                            </div>

                            {% if not product.isMainVariant %}
                                <div class="js-product-detail-main-add-to-cart-wrapper box-detail-add">
                                     {% if not product.calculatedSaleExclusion(domain.id) %}
                                        <div class="box-detail-add__info">
                                            <div itemprop="offers"
                                                itemscope
                                                itemtype="http://schema.org/Offer"
                                                class="box-detail-add__prices">
                                                {% if nonSellingPriceWithVat.isGreaterThan(sellingPriceWithVat) %}
                                                    {{ discount.circle(sellingPriceWithVat, nonSellingPriceWithVat) }}
                                                    <div class="box-detail-add__prices__wrap">
                                                        <div class="box-detail-add__prices__item box-detail-add__prices__item--high-price">
                                                            {{ nonSellingPriceWithVat|price }}
                                                            {{ asterisk.nonSellingPrice(product.getFlagsForDomain(domain.id)) }}
                                                        </div>
                                                        <div class="box-detail-add__prices__item box-detail-add__prices__item--main">
                                                            {{ sellingPriceWithVat|price }}
                                                            {{ asterisk.sellingPrice(product.getFlagsForDomain(domain.id)) }}
                                                        </div>
                                                    </div>
                                                {% else %}
                                                    <div class="box-detail-add__prices__item box-detail-add__prices__item--main">
                                                        {{ sellingPriceWithVat|price }}
                                                        {{ asterisk.sellingPrice(product.getFlagsForDomain(domain.id)) }}
                                                    </div>
                                                {% endif %}
                                                <meta itemprop="priceCurrency"
                                                    content="{{ currencyCode(domain.id) }}"
                                                >
                                                <meta itemprop="price"
                                                    content="{{ getProductSellingPrice(product).priceWithVat|moneyFormat }}"
                                                >
                                                <link itemprop="availability"
                                                    href="{{ product.calculatedSaleExclusion(domain.id) ? 'http://schema.org/OutOfStock' : 'http://schema.org/InStock' }}"
                                                >
                                            </div>
                                            {{ render(controller('App\\Controller\\Front\\CartController:addProductFormAction', {product: product, type: 'large'})) }}
                                        </div>
                                    {% else %}
                                        <div>
                                            {{ 'This product is no longer available for purchase. Have a look at similar products <a href="%url%">here</a>.'|transHtml({"%url%": url('front_product_list', { id: productMainCategory.id })}) }}
                                        </div>
                                    {% endif %}
                                </div>
                            {% endif %}

                            {% if productSeriesList|length > 0 %}
                                {% for productSeries in productSeriesList %}
                                    <div class="box-series box-series--standalone box-series--standalone--mini">
                                        <div class="box-series__in">
                                            {% if imageExists(productSeries) %}
                                                <span class="box-series__img">
                                                    {{ image(productSeries, { itemprop: 'image', size: 'previewDetailSmall' }) }}
                                                </span>
                                            {% else %}
                                                <span class="box-series__img">
                                                    {{ noimage({ alt: productSeries.name }) }}
                                                </span>
                                            {% endif %}
                                            <span class="box-series__content">
                                                <p class="box-series__content__text">
                                                    {{ 'Prohlédněte si další zboží ze série'|trans }}
                                                    {{ productSeries.getSeoH1(domain.id)|default(productSeries.name) }}
                                                    {{ ' a slaďte svůj domov'|trans }}
                                                </p>
                                                <a
                                                    class="box-series__content__link box-detail__info__anchor js-smooth-scroll-anchor"
                                                    href="#series-{{ productSeries.name }}">
                                                    {{ productSeries.getSeoH1(domain.id)|default(productSeries.name) }}
                                                    <i class="box-detail__info__anchor__icon svg svg-chevron"></i>
                                                </a>
                                            </span>
                                        </div>
                                    </div>
                                {% endfor %}
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="web__line">
            <div class="web__container">
                {% if product.isMainVariant and not product.calculatedSellingDenied %}
                    <table {% if getProductSellingPrice(product) is not null %}itemprop="offers"
                        itemscope
                        itemtype="http://schema.org/AggregateOffer" {% endif %}
                        class="table-variants"
                    >
                        <thead>
                            <tr class="table-variants__row">
                                <th class="table-variants__cell table-variants__cell--image"></th>
                                <th class="table-variants__cell table-variants__cell--name">{{ 'Name'|trans }}</th>
                                <th class="table-variants__cell">{{ 'Availability'|trans }}</th>
                                <th class="table-variants__cell table-variants__cell--price">
                                    {{ 'Price including VAT'|trans }}
                                    {% if getProductSellingPrice(product) is not null %}
                                        <meta itemprop="priceCurrency"
                                            content="{{ currencyCode(domain.id) }}"
                                        >
                                        <meta itemprop="lowPrice"
                                            content="{{ getProductSellingPrice(product).priceWithVat|moneyFormat }}"
                                        >
                                        <link itemprop="availability"
                                            href="{{ product.calculatedSellingDenied ? 'http://schema.org/OutOfStock' : 'http://schema.org/InStock' }}"
                                        >
                                    {% endif %}
                                </th>
                                <th class="table-variants__cell table-variants__cell--action"></th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for variant in variants %}
                                <tr class="table-variants__row">
                                    <td class="table-variants__cell table-variants__cell--image">
                                        <div class="table-variants__cell__image">
                                            {% if imageExists(variant) %}
                                                <a href="{{ imageUrl(variant, 'original') }}" class="js-popup-image">
                                                    {{ image(variant, { size: 'thumbnail' }) }}
                                                </a>
                                            {% else %}
                                                {{ noimage() }}
                                            {% endif %}
                                        </div>
                                    </td>
                                    <td class="table-variants__cell table-variants__cell--name">
                                        {% if variant.variantAlias is not null %}
                                            {{ variant.variantAlias }}
                                        {% else %}
                                            {{ variant.name }}
                                        {% endif %}
                                    </td>
                                    <td class="table-variants__cell">
                                        {% if variant.calculatedAvailability %}
                                            {{ variant.calculatedAvailability.name }}
                                        {% endif %}
                                    </td>
                                    <td class="table-variants__cell table-variants__cell--price">
                                        {{ getProductSellingPrice(variant).priceWithVat|price }}
                                    </td>
                                    <td class="table-variants__cell table-variants__cell--action">
                                        {{ render(controller('App\\Controller\\Front\\CartController:addProductFormAction', {product: variant})) }}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                {% endif %}

                {% set parameterValuesViewsData = getProductNonDimensionParameterValuesViewsData(product) %}

                {% if product.getDescription(domain.id)%}
                    <div class="box-accordion js-accordion js-accordion-closed-on-mobile is-opened" id="product-desc">
                        <a class="box-accordion__header js-accordion-header" href="#">
                            <strong class="box-accordion__heading">{{ 'Popis a parametry'|trans }}</strong>
                            <span class="box-accordion__header__toggle">
                                <span
                                    class="box-accordion__header__toggle__text js-accordion-toggle-text"
                                    data-text-more="{{ 'Zobrazit víc'|trans }}"
                                    data-text-less="{{ 'Skrýt'|trans }}"
                                >
                                    {{ 'Skrýt'|trans }}
                                </span>
                                <i class="box-accordion__header__toggle__icon svg svg-arrow"></i>
                            </span>
                        </a>
                        <div class="box-accordion__body{% if parameterValuesViewsData > 0 %} box-accordion__body--cols{% endif %} js-accordion-body">
                            <div class="box-accordion__body__content box-accordion__body__content--desc">
                                {{ product.getDescription(domain.id)|raw }}
                            </div>
                            {% if parameterValuesViewsData > 0 %}
                                <div class="box-accordion__body__content box-accordion__body__content--params">
                                    {% set lastParameterGroupName = null %}
                                    {% for parameterValuesViewData in parameterValuesViewsData %}
                                        {% set parameterGroupName = parameterValuesViewData.parameterGroupName %}
                                        {% if parameterGroupName != lastParameterGroupName and parameterGroupName is not empty %}
                                            {% if not loop.first %}
                                                </ul>
                                                <ul class="box-detail-list box-detail-list--params">
                                            {% else %}
                                                <ul class="box-detail-list box-detail-list--params">
                                            {% endif %}
                                            <li class="box-detail-list__item box-detail-list__item--heading">
                                                <h2>{{ parameterGroupName }}</h2>
                                            </li>
                                        {% endif %}
                                        {% if loop.first and parameterGroupName == lastParameterGroupName %}
                                            <ul class="box-detail-list box-detail-list--params">
                                        {% endif %}
                                            <li class="box-detail-list__item">
                                                {{ parameterValuesViewData.parameterName }}:
                                                {{ parameterValuesViewData.valueTextsWithUnit|join(', ') }}
                                            </li>
                                        {% set lastParameterGroupName = parameterGroupName %}
                                        {% if loop.last %}
                                            </ul>
                                        {% endif %}
                                    {% endfor %}
                                </div>
                            {% endif %}
                        </div>
                    </div>
                {% endif %}

                {% set dimensionParameterValuesViewsData = getProductDimensionParameterValuesViewsData(product) %}
                {% if existProductImageByAkeneoType(product, 'image_dimensions') or dimensionParameterValuesViewsData|length > 0 %}
                    <div class="box-accordion js-accordion">
                        <a class="box-accordion__header js-accordion-header" href="#">
                            <strong class="box-accordion__heading">{{ 'Rozměry'|trans }}</strong>
                            <span class="box-accordion__header__toggle">
                                <span
                                    class="box-accordion__header__toggle__text js-accordion-toggle-text"
                                    data-text-more="{{ 'Zobrazit víc'|trans }}"
                                    data-text-less="{{ 'Skrýt'|trans }}"
                                >
                                    {{ 'Zobrazit víc'|trans }}
                                </span>
                                <i class="box-accordion__header__toggle__icon svg svg-arrow"></i>
                            </span>
                        </a>
                        <div class="box-accordion__body box-accordion__body--cols js-accordion-body">
                            <div class="box-accordion__body__content box-accordion__body__content--measures">
                                <table class="table table--params">
                                    <tbody>
                                        {% for parameterValuesViewData in dimensionParameterValuesViewsData %}
                                            <tr>
                                                <td>{{ parameterValuesViewData.parameterName }}</td>
                                                <td>{{ parameterValuesViewData.valueTextsWithUnit|join(', ') }}</td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                            <div class="box-accordion__body__content box-accordion__body__content--img">{{ productImageByAkeneoType(product, 'image_dimensions', { itemprop: 'image', alt: 'Rozměry'|trans }) }}</div>
                        </div>
                    </div>
                {% endif %}

                {% include 'Front/Content/Product/productPackageInformation.html.twig' with {product: product, productPackages: productPackages, doamin: domain } %}

                {% if downloadFiles|length > 0 %}
                    <div class="box-accordion js-accordion">
                        <a class="box-accordion__header js-accordion-header" href="#">
                            <strong class="box-accordion__heading">{{ 'Ke stažení'|trans }}</strong>
                            <span class="box-accordion__header__toggle">
                                <span
                                    class="box-accordion__header__toggle__text js-accordion-toggle-text"
                                    data-text-more="{{ 'Zobrazit víc'|trans }}"
                                    data-text-less="{{ 'Skrýt'|trans }}"
                                >
                                    {{ 'Zobrazit víc'|trans }}
                                </span>
                                <i class="box-accordion__header__toggle__icon svg svg-arrow"></i>
                            </span>
                        </a>
                        <div class="box-accordion__body box-accordion__body--cols js-accordion-body">
                            <div class="box-detail-files">
                                {% for downloadFile in downloadFiles %}
                                    <a target="_blank" class="box-detail-files__item" href="{{ downloadFile['url'] }}">
                                        <span class="box-detail-files__item__name">{{ downloadFile['anchor_text']|trans }}</span>
                                        <span class="box-detail-files__item__download">
                                            {{ 'Stáhnout'|trans }}
                                            <i class="box-detail-files__item__download__icon svg svg-download"></i>
                                        </span>
                                    </a>
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                {% endif %}

                {% if productStocksAvailabilitiesInformation|length > 0 %}
                    <div class="box-accordion box-accordion--opened-on-mobile is-opened js-accordion" id="stocks-availabilities">
                        <a class="box-accordion__header js-accordion-header" href="#">
                            <strong class="box-accordion__heading">{{ 'Dostupnost'|trans }}</strong>
                            <span class="box-accordion__header__toggle">
                                <span
                                    class="box-accordion__header__toggle__text js-accordion-toggle-text"
                                    data-text-more="{{ 'Zobrazit víc'|trans }}"
                                    data-text-less="{{ 'Skrýt'|trans }}"
                                >
                                    {{ 'Skrýt'|trans }}
                                </span>
                                <i class="box-accordion__header__toggle__icon svg svg-arrow"></i>
                            </span>
                        </a>
                        <div class="box-accordion__body box-accordion__body--no-spacing js-accordion-body">
                            <table class="box-accordion__grid-table">
                                <tbody class="box-accordion__grid-table__body">
                                {% for productStockAvailabilityInformation in productStocksAvailabilitiesInformation %}
                                    <tr class="box-accordion__grid-table__row">
                                        <th class="box-accordion__grid-table__col">
                                            <strong class="box-accordion__grid-table__title">{{ productStockAvailabilityInformation.stockName }}</strong>
                                        </th>
                                        <td class="box-accordion__grid-table__col">
                                            {% if productStockAvailabilityInformation.availabilityStatus == "in-stock" %}
                                                <picture>
                                                    <source
                                                        srcset="{{ asset('public/frontend/images/package-in-stock2x.png') }} 2x, {{ asset('public/frontend/images/package-in-stock.png') }} 1x"
                                                    >
                                                    <img
                                                        class="box-accordion__grid-table__col__icon"
                                                        loading="lazy"
                                                        data-src="{{ asset('public/frontend/images/package-in-stock.png') }}"
                                                        alt="{{ 'Skladem'|trans }}"
                                                    >
                                                </picture>
                                            {% else %}
                                                <picture>
                                                    <source
                                                        srcset="{{ asset('public/frontend/images/package-in-stock2x.png') }} 2x, {{ asset('public/frontend/images/package-in-stock.png') }} 1x"
                                                    >
                                                    <img
                                                        class="box-accordion__grid-table__col__icon box-accordion__grid-table__col__icon--out-of-stock"
                                                        loading="lazy"
                                                        data-src="{{ asset('public/frontend/images/package-in-stock.png') }}"
                                                        alt="{{ 'Není skladem'|trans }}"
                                                    >
                                                </picture>
                                            {% endif %}
                                            {{ productStockAvailabilityInformation.availabilityInformation|raw }}
                                        </td>
                                        <td class="box-accordion__grid-table__col box-accordion__grid-table__col--expose">
                                            {% if productStockAvailabilityInformation.exposedProduct %}
                                                <img class="box-accordion__grid-table__col__icon" loading="lazy" data-src="{{ asset('public/frontend/images/vystaveno.png') }}" alt="{{ 'Vystaveno'|trans }}">
                                                {{ '<strong class="box-accordion__grid-table__col__expose">Vystaveno</strong> na prodejně'|transHtml }}
                                            {% else %}
                                                <img class="box-accordion__grid-table__col__icon" loading="lazy" data-src="{{ asset('public/frontend/images/nevystaveno.png') }}" alt="{{ 'Není vystaveno'|trans }}">
                                                {{ '<strong class="box-accordion__grid-table__col__expose">Není vystaveno</strong> na prodejně'|transHtml }}
                                            {% endif %}
                                        </td>
                                        <td class="box-accordion__grid-table__col box-accordion__grid-table__col--showrooms">
                                            <a class="box-detail__info__anchor" href="{{ url('front_stores_detail', { id: productStockAvailabilityInformation.stockId }) }}">
                                                {{ 'Detail prodejny'|trans }}
                                                <i class="box-detail__info__anchor__icon box-detail__info__anchor__icon--spaced svg svg-chevron"></i>
                                            </a>
                                        </td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                {% endif %}

                {% if accessories|length > 0 %}
                    <div class="box-detail box-detail--accessories gtm-scroll" data-gtm-event="{{ gtmAccessoriesScrollEvent|json_encode() }}">
                        <h2 class="box-detail__title">{{ 'Accessories'|trans }}</h2>
                        <div class="box-products-accessories js-products-slick-carousel-cols">
                            {{ productList.list(accessories, null, null, constant('App\\Model\\Gtm\\DataLayer::LIST_NAME_PRODUCT_ACCESSORIES')) }}
                        </div>
                    </div>
                {% endif %}

                {% if productSeriesList|length > 0 %}
                    <div class="box-detail-series">
                        {% for productSeries in productSeriesList %}
                            <div class="box-series box-series--standalone box-series--standalone--large" id="series-{{ productSeries.name }}">
                                <div class="box-series__in">
                                    {% if imageExists(productSeries) %}
                                        <span class="box-series__img">
                                            {{ image(productSeries, { itemprop: 'image', size: 'previewDetail' }) }}
                                        </span>
                                    {% else %}
                                        <span class="box-series__img">
                                            {{ noimage({ alt: productSeries.name }) }}
                                        </span>
                                    {% endif %}
                                    <div class="box-series__content">
                                        <h2 class="box-series__heading">{{ productSeries.getSeoH1(domain.id)|default(productSeries.name) }}</h2>
                                        <p class="box-series__content__text">{{ productSeries.getDescription }}</p>
                                        <a class="box-series__content__link box-detail__info__anchor" href="{{ url('front_productseries_detail', { id: productSeries.id }) }}">
                                            {{ 'Zobrazit celý program'|trans }}
                                            <i class="box-detail__info__anchor__icon svg svg-chevron"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                            <div
                                class="box-products-carousel box-products-carousel--detail gtm-scroll"
                                data-gtm-event="{{ gtmProductSeriesScrollEvent[productSeries.id]|json_encode() }}"
                            >
                                <div class="box-products-carousel__in box-products-carousel__in--detail">
                                    <div class="list-products-grid js-products-slick-carousel">
                                        {{ productList.list(productSeriesProductsIndexedByProductSeries[productSeries.id], null, null, constant('App\\Model\\Gtm\\DataLayer::LIST_NAME_PRODUCT_PROGRAM')) }}
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}

                {% cache 'products_similar_id_'~productMainVariantId {lifetime:60*60, domainId:getDomain().id} %}
                    {{ render(controller('App\\Controller\\Front\\ProductController:similarProductsAction', {id: productMainVariantId} ))|spaceless }}
                {% endcache %}
            </div>
        </div>

        {% if categoryList %}
            <div class="web__line web__line--spacing--big">
                <div class="web__container">
                    <div class="box-detail-cats">
                        <h2 class="box-detail-cats__heading">{{ 'Podobné kategorie'|trans }}</h2>
                        <div class="box-detail-cats__wrap">
                            {% for category in categoryList %}
                                <a class="box-detail-cats__item" href="{{ url('front_product_list', { id: category.id }) }}">
                                    <img class="box-detail-cats__item__icon" loading="lazy" data-src="{{ asset('public/frontend/images/category_icon.png') }}" alt="{{ category.name }}">
                                    {{ category.name }}
                                </a>
                            {% endfor %}
                        </div>
                    </div>
                </div>
            </div>
        {% endif %}
    </div>
{% endblock %}
