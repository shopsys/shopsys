{% extends 'Front/Layout/layoutWithoutPanel.html.twig' %}
{% import 'Front/Inline/Paginator/paginator.html.twig' as paginator %}
{% import 'Front/Content/Product/filterFormMacro.html.twig' as productFilterForm %}

{% set domain = getDomain() %}

{% block meta_robots %}
    {{ paginator.metaRobots(paginationResult, disableIndexingBySeznamBot) }}
{% endblock %}

{% block prev_next_links %}
    {% if paginationResult.previousPage is not null%}
        <link href="{{ url('front_product_list', { id: category.id }) }}?page={{ paginationResult.previousPage }}" rel="prev">
    {% endif %}
    {% if paginationResult.nextPage is not null%}
        <link href="{{ url('front_product_list', { id: category.id }) }}?page={{ paginationResult.nextPage }}" rel="next">
    {% endif %}
{% endblock %}

{% block meta_description %}{{ seoMetaDescription }}{% endblock %}

{% block title %}{{ seoTitle }}{% endblock %}

{% block breadcrumb %}
{% endblock %}

{% block main_content %}
    <div class="web__line">
        <div class="web__container">
            {{ render(controller('App\\Controller\\Front\\AdvertController:boxAction',{'positionName' : 'productList'})) }}
            <div class="box-list__description box-list__description--top">
                <h1 class="box-list__description__heading js-ready-category-seo-mix-product-list-h1">{{ seoH1 }}</h1>
                {{ render(controller('App\\Controller\\Front\\BreadcrumbController:indexAction', { routeName: getRoute(), routeParameters: getRouteParams() } )) }}
                {% if paginationResult.page == 1 and shortDescription is not null %}
                    <div class="box-list__description__text box-list__description__text--top">
                        <div class="js-ready-category-seo-mix-product-list-short-description">{{ shortDescription|raw }}</div>
                        {% if description is not null %}
                            <a class="btn btn--next btn-no-style" href="#description">
                                {{ 'Číst dál'|trans }}
                                <i class="btn__icon svg svg-long-arrow-right"></i>
                            </a>
                        {% endif %}
                    </div>
                {% endif %}
            </div>
            {% if visibleChildren is not empty %}
                {{ render(controller('App\\Controller\\Front\\CategoryController:categoryListAction', {categories: visibleChildren})) }}
            {% endif %}
            {{ render(controller('App\\Controller\\Front\\BestsellingProductController:listAction', { category: category })) }}
            {% if categoryProductSeries is not empty %}
                <div class="box-series">
                    <div class="box-series__left">
                        <h2 class="box-series__heading">{{ category.getProductSeriesListTitle(domain.id) }}</h2>
                        <div class="box-series__desc">{{ category.getProductSeriesListDescription(domain.id) }}</div>
                        {% if category.getProductSeriesListLink(domain.id) %}
                            <a class="btn btn--outline dont-print" href="{{ category.getProductSeriesListLink(domain.id) }}">{{ 'Zobrazit všechny'|trans }}</a>
                        {% endif %}
                    </div>
                    <div class="box-series__right">
                        <div class="box-series__grid">
                            {% for productSeries in categoryProductSeries %}
                                <div class="box-series__grid__item">
                                    <a class="box-series__grid__item__link" href="{{ url('front_productseries_detail', { id: productSeries.id }) }}">
                                        {% if imageExists(productSeries) %}
                                            {{ image(productSeries, { itemprop: 'image', size: 'preview', class: 'box-series__grid__item__image' }) }}
                                        {% else %}
                                            {{ noimage({ alt: productSeries.getName(domain.locale) }) }}
                                        {% endif %}
                                        <strong class="box-series__grid__item__name btn btn--next btn-no-style dont-print">
                                            {{ productSeries.getName(domain.locale) }}
                                            <i class="btn__icon svg svg-long-arrow-right"></i>
                                        </strong>
                                    </a>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                </div>
            {% endif %}
            {{ render(controller('App\\Controller\\Front\\AdvertController:categoryBoxAction',{'positionName' : constant('App\\Model\\Advert\\AdvertPositionRegistry::CATEGORIES_ABOVE_PRODUCT_LIST'), category: category})) }}
        </div>
    </div>
    <div class="web__line web__line--product-list web__line--bg-color">
        <div class="web__container web__container--full-width web__container--no-padding">
            <div class="box-list js-product-list-with-filter">
                <div class="box-filter__opener">
                    <button type="button" class="btn btn-no-style box-filter__opener__btn js-product-filter-open-button">
                        <i class="box-filter__opener__btn__icon svg svg-filter"></i>
                        <span class="box-filter__opener__btn__text">
                            {{ 'Filtr'|trans }}
                            <span class="box-filter__opener__btn__info box-filter__opener__btn__info--count js-product-filter-open-button-placeolder"></span>
                        </span>
                    </button>
                    <button type="button" class="btn btn-no-style box-filter__opener__btn js-product-sort-open-button">
                        <i class="box-filter__opener__btn__icon svg svg-sort"></i>
                        <span class="box-filter__opener__btn__text">
                            {{ 'Seřadit'|trans }}
                            <span class="box-filter__opener__btn__info box-filter__opener__btn__info--sort js-product-sort-open-button-placeholder">{{ orderModeName }}</span>
                        </span>
                    </button>
                </div>
                <div class="box-list__body">
                    {% if paginationResult.results|length > 0 or filterFormSubmitted %}
                        <div class="box-list__panel">
                            <div class="box-filter js-product-filter">
                                {{ productFilterForm.filterForm(
                                    filterForm,
                                    url('front_product_list', { id: category.id }),
                                    url('front_product_list', { id: category.id }),
                                    null,
                                    'product_list',
                                    productFilterCountData,
                                    priceRange,
                                    filterCollapsedParameters,
                                    allParameterValuesImagesIndexedById,
                                    productFilterSetup
                                ) }}
                            </div>
                        </div>
                    {% endif %}
                    <div class="box-list__content">
                        <div class="js-product-list-ajax-filter-products-with-controls">
                            <div class="box-list__top js-product-sort">
                                <div class="box-list__top__wrap">
                                    {{ render(controller('App\\Controller\\Front\\ProductController:selectOrderingModeForListAction', { readyCategorySeoMixId: readyCategorySeoMixId })) }}
                                    <div class="box-list__top__info">
                                        {% include 'Front/Content/Product/productSortCount.html.twig' with {paginationResult: paginationResult} %}
                                    </div>
                                </div>
                            </div>
                            {% include 'Front/Content/Product/productsWithControls.html.twig' with {paginationResult: paginationResult, filterFormSubmitted: filterFormSubmitted} %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="box-list__description">
        <a id="description"></a>
        <div class="box-list__description__text in-user-text js-category-description js-ready-category-seo-mix-product-list-description">
            {% if paginationResult.page == 1 %}
                {{ description|raw }}
            {% endif %}
        </div>
        <div class="box-list__description__more">
            <span class="link-style box-list__description__more__btn js-category-description-load-more">
                {{ 'View more'|trans }}
            </span>
        </div>
    </div>
{% endblock %}
