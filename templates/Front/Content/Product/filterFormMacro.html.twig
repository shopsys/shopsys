{% macro filterForm(filterForm, actionUrl, resetUrl, searchText, page, productFilterCountData, priceRange, filterCollapsedParameters, allParameterValuesImagesIndexedById, productFilterSetup) %}
    {{ form_start(filterForm, { action: actionUrl }) }}
        {% form_theme filterForm 'Front/Content/Product/filterFormTheme.html.twig' %}

        {% set isSearch = page == 'search' %}
        {% set paramsVisibleCount = 5 %}

        {% if isSearch %}
            <input
                type="hidden"
                name="{{ constant('App\\Controller\\Front\\ProductController::SEARCH_TEXT_PARAMETER') }}"
                value="{{ searchText|escape('html_attr') }}"
            />
        {% endif %}

        <div class="box-filter__header">
            <h2 class="box-filter__heading">{{ 'Filtr'|trans }}</h2>
            <a class="box-filter__reset btn btn-no-style js-product-filter-reset-button" href="{{ resetUrl }}">
                <span class="box-filter__reset__text">{{ 'Zrušit filtry'|trans }}</span>
                <i class="box-filter__reset__icon svg svg-remove"></i>
            </a>
        </div>

        {% if filterForm.flags is empty %}
            {% do filterForm.flags.setRendered %}
        {% else %}
            <div class="box-filter__choice js-product-filter-box" data-product-filter-box-id="{{ filterForm.flags.vars.id }}">
                <div id="{{ filterForm.flags.vars.id }}" class="box-filter__choice__inputs">
                    {% for flagForm in filterForm.flags %}

                        {% set flagChecked = flagForm.vars.checked %}
                        {% set flagId = flagForm.vars.value %}

                        <div class="form-choice box-filter__choice__input">
                            {{ form_widget(flagForm, { attr: { class: "css-checkbox" } }) }}
                            <label class="css-checkbox__image form-choice__label" for="{{ flagForm.vars.id }}">
                                <a href="{{ getUrlByFlagValue(productFilterSetup, flagId, flagChecked) }}"
                                   class="js-product-filter-links"
                                   data-link-id="flag-{{ flagId }}"
                                >
                                {{ flagForm.vars.label }}
                                {% if productFilterCountData is not null %}
                                    <span
                                        class="js-product-filter-count"
                                        data-form-id="{{ flagForm.vars.id }}"
                                    >
                                        {% if not flagForm.vars.checked %}
                                            ({% if filterForm.flags.vars.data is not empty %}+{% endif %}{{ productFilterCountData.countByFlagId[flagForm.vars.value]|default(0) }})
                                        {% endif %}
                                    </span>
                                {% endif %}
                                </a>
                            </label>
                        </div>
                    {% endfor %}
                </div>
            </div>
        {% endif %}

        <div class="box-filter__content js-product-filter-box" data-product-filter-box-id="product_filter_box_price">
            <span class="box-filter__choice__title active cursor-pointer js-product-filter-box-label js-product-filter-box-arrow">
                {{ 'Price'|trans }}
                <i class="svg svg-arrow"></i>
            </span>
            <div id="product_filter_box_price" class="box-filter__slider__wrap">
                <div class="ui-slider-wrap">
                    <div
                        class="box-filter__slider__wrap__range js-range-slider"
                        data-minimum-input-id="{{ filterForm.minimalPrice.vars.id }}"
                        data-minimal-value="{{ priceRange.minimalPrice|moneyFormat }}"
                        data-maximum-input-id="{{ filterForm.maximalPrice.vars.id }}"
                        data-maximal-value="{{ priceRange.maximalPrice|moneyFormat }}"
                        data-decimals="{{ decimalsByDomainId(getDomain().id) }}"
                    ></div>
                </div>
                <div class="box-filter__content__item__wrap">
                    <div class="box-filter__content__item">
                        {{ form_widget(filterForm.minimalPrice, {
                            attr: { class: 'js-product-filter-call-change-after-reset', placeholder: priceRange.minimalPrice|priceWithoutCurrency }
                        }) }} {{ currencySymbolByDomainId(getDomain().id) }}
                    </div>
                    <div class="box-filter__content__item box-filter__content__item--right">
                        {{ form_widget(filterForm.maximalPrice, {
                            attr: { class: 'js-product-filter-call-change-after-reset', placeholder: priceRange.maximalPrice|priceWithoutCurrency }
                        }) }} {{ currencySymbolByDomainId(getDomain().id) }}
                    </div>
                </div>
            </div>
        </div>

        {% if productFilterCountData is not null %}

            <div class="box-filter__choice js-product-filter-box" data-product-filter-box-id="product_filter_box_availability">
                <span class="box-filter__choice__title active cursor-pointer js-product-filter-box-label js-product-filter-box-arrow">
                    {{ 'Availability'|trans }}
                    <i class="svg svg-arrow"></i>
                </span>
                <div id="product_filter_box_availability" class="box-filter__choice__inputs">
                    <div class="form-choice box-filter__choice__input">
                        {{ form_widget(filterForm.inStock, { attr: { class: "css-checkbox" } }) }}

                        {% set inStockChecked = filterForm.inStock.vars.checked %}
                        {% set stockId = filterForm.inStock.vars.value %}

                        <label class="css-checkbox__image form-choice__label" for="{{ filterForm.inStock.vars.id }}">
                            <a href="{{ getUrlByAvailabilityValue(productFilterSetup, inStockChecked) }}"
                               class="js-product-filter-links"
                               data-link-id="inStock-{{ stockId }}"
                            >
                                {{ 'Products in stock only'|trans }}

                                    <span
                                        class="js-product-filter-count"
                                        data-form-id="{{ filterForm.inStock.vars.id }}"
                                    >
                                        ({{ productFilterCountData.countInStock|default() }})
                                    </span>
                            </a>
                        </label>
                    </div>
                </div>
            </div>
        {% else %}
            {% do filterForm.inStock.setRendered %}
        {% endif %}

        {% if filterForm.brands is empty %}
            {% do filterForm.brands.setRendered %}
        {% else %}
            <div class="box-filter__choice js-product-filter-box" data-product-filter-box-id="{{ filterForm.brands.vars.id }}">
                <span class="box-filter__choice__title active cursor-pointer js-product-filter-box-label js-product-filter-box-arrow">
                    {{ 'Brand'|trans }}
                    <i class="svg svg-arrow"></i>
                </span>
                <div id="{{ filterForm.brands.vars.id }}" class="box-filter__choice__inputs">

                    {% for brandForm in filterForm.brands %}

                        {% set brandChecked = brandForm.vars.checked %}
                        {% set brandId = brandForm.vars.value %}

                        <div class="form-choice js-form-choice box-filter__choice__input
                            {{ loop.index > paramsVisibleCount and not brandForm.vars.checked ? ' js-form-choice--collapsing display-none' }}
                        ">
                            {{ form_widget(brandForm, { attr: { class: 'css-checkbox'} }) }}
                            <label class="css-checkbox__image form-choice__label" for="{{ brandForm.vars.id }}">
                                <a href="{{ getUrlByBrandValue(productFilterSetup, brandId, brandChecked) }}"
                                   class="js-product-filter-links"
                                   data-link-id="brand-{{ brandId }}"
                                >
                                {{ brandForm.vars.label }}
                                {% if productFilterCountData is not null %}
                                    <span
                                        class="js-product-filter-count"
                                        data-form-id="{{ brandForm.vars.id }}"
                                    >
                                        {% set brandCount = productFilterCountData.countByBrandId[brandForm.vars.value]|default(0) %}
                                        {% if not brandForm.vars.checked %}
                                            ({% if filterForm.brands.vars.data is not empty and brandCount > 0 %}+{% endif %}{{ brandCount }})
                                        {% endif %}
                                    </span>
                                {% endif %}
                                </a>
                            </label>
                        </div>
                    {% endfor %}
                    {% if filterForm.brands|length > paramsVisibleCount %}
                        <a
                            class="box-filter__more btn btn-no-style js-product-filter-show-more-less"
                            data-text-more="{{ 'Zobrazit více'|trans }}"
                            data-text-less="{{ 'Zobrazit méně'|trans }}"
                            href="#">
                                {{ 'Zobrazit více'|trans }}
                        </a>
                    {% endif %}
                </div>
            </div>
        {% endif %}

        {% if isSearch or filterForm.parameters is empty %}
            {% do filterForm.parameters.setRendered %}
        {% else %}
            <div class="box-filter__parameters">
                <div id="{{ filterForm.parameters.vars.id }}">
                    {% for parameterId, parameterForm in filterForm.parameters %}
                        {% if parameterForm.vars.attr.parameterType == constant('App\\Model\\Product\\Parameter\\Parameter::PARAMETER_TYPE_COLOR') %}
                            {% include 'Front/Content/Product/Parameter/colorParameterForm.html.twig' with {parameterForm: parameterForm, allParameterValuesImagesIndexedById: allParameterValuesImagesIndexedById, productFilterSetup: productFilterSetup} %}
                        {% elseif parameterForm.vars.attr.parameterType == constant('App\\Model\\Product\\Parameter\\Parameter::PARAMETER_TYPE_SLIDER') %}
                            {% include 'Front/Content/Product/Parameter/sliderParameterForm.html.twig' with {parameterForm: parameterForm} %}
                        {% else %}
                            {% include 'Front/Content/Product/Parameter/checkboxParameterForm.html.twig' with {parameterForm: parameterForm, productFilterSetup: productFilterSetup} %}
                        {% endif %}
                    {% endfor %}
                </div>
            </div>
        {% endif %}

        <div class="box-filter__action">
            {{ form_widget(filterForm.search, { label: 'View results'|trans, attr: {class: 'js-product-filter-show-result-button btn--primary' } }) }}
        </div>

    {{ form_end(filterForm) }}
{% endmacro %}
