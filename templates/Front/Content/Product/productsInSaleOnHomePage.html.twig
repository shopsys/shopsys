{% import 'Front/Content/Product/productListMacro.html.twig' as productList %}

{% if paginationResult.results|length > 0 %}
    <div class="web__line">
        <div class="web__container">
            <div class="box-products-carousel gtm-scroll" id="products-in-sales" data-gtm-event="{{ gtmSaleProductsScrollEvent|json_encode() }}">
                <div class="box-products-carousel__title">
                    <h2 class="in-title">
                        <span class="in-title__separator in-title__separator--without-separator">
                            {{ 'Výprodej'|trans }}
                        </span>
                    </h2>
                </div>
                {{ productList.sliderList(paginationResult.results, 'in-sales', gtmList) }}
            </div>
        </div>
    </div>
{% endif %}
