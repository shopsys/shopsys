{% import 'Front/Content/Product/productListMacro.html.twig' as productList %}

{% if paginationResult.results|length > 0 %}
    <div class="web__line">
        <div class="web__container">
            <div class="box-products-carousel box-products-carousel--bg" id="products-in-sales" >
                <div class="box-products-carousel__in box-products-carousel__in--bg box-products-carousel__in--sales gtm-scroll" data-gtm-event="{{ gtmSaleProductsScrollEvent|json_encode() }}">
                    <h2 class="box-products-carousel__heading">{{ 'Výprodej'|trans }}</h2>
                    <div class="list-products-grid list-products-grid--sales js-sale-products-slick-carousel"
                         data-sale-products-url="{{ url('front_products_in_sale_on_home_page') }}"
                         data-page-items-count="{{ pageItemsCount }}">
                        {{ productList.list(paginationResult.results, null, null, gtmList) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endif %}
