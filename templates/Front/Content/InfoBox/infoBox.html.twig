{% set shopInfoEmail = getShopInfoEmail() %}
{% set shopInfoPhoneNumber = getShopInfoPhoneNumber() %}
{% set shopInfoPhoneHours = getShopInfoPhoneHours() %}

<div class="box-info {{ cssClass }}">
    {% set inofoboxIcon = 'potrebujete_poradit' %}
    {% set inofoboxIcon2x = 'potrebujete_poradit2x' %}
    {% if inHeader is defined and inHeader == true %}
        {% set inofoboxIcon = 'potrebujete_poradit-light' %}
        {% set inofoboxIcon2x = 'potrebujete_poradit-light2x' %}
    {% endif %}
    <picture>
        <source
            srcset="
            {{ asset("public/frontend/images/#{inofoboxIcon2x}.png") }} 2x,
            {{ asset("public/frontend/images/#{inofoboxIcon}.png") }} 1x"
        >
        <img
            class="box-info__img"
            loading="lazy"
            src="{{ imgLazyloadPlaceholder }}"
            data-src="{{ asset("public/frontend/images/#{inofoboxIcon}.png") }}"
            alt="{{ 'Potřebujete poradit?'|trans }}"
        >
    </picture>
    <div class="box-info__content">
        <div class="box-info__text">
            <h2 class="box-info__title">{{ 'Potřebujete poradit?'|trans }}</h2>
            <span class="box-info__hours">{{ shopInfoPhoneHours }}</span>
        </div>
        <div class="box-info__contacts">
            <a href="tel:{{ shopInfoPhoneNumber }}" class="box-info__contacts__link">
                <i class="box-info__contacts__icon box-info__contacts__icon--phone svg svg-phone"></i>
                <span class="box-info__contacts__text">{{ shopInfoPhoneNumber }}</span>
            </a>
            <a href="#" class="box-info__contacts__btn btn btn--dark js-not-implemented-yet">
                <span class="box-info__contacts__btn__text">{{ 'Napište nám'|trans }}</span>
                <i class="box-info__contacts__icon svg svg-email"></i>
            </a>
        </div>
    </div>
</div>
