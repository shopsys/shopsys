{% set shopInfoEmail = getShopInfoEmail() %}
{% set shopInfoPhoneNumber = getShopInfoPhoneNumber() %}
{% set shopInfoPhoneHours = getShopInfoPhoneHours() %}

<div class="box-info">
    {% set inofoboxIcon = 'potrebujete_poradit' %}
    {% set inofoboxIcon2x = 'potrebujete_poradit2x' %}
    <picture>
        <source
            srcset="
            {{ asset("public/frontend/images/#{inofoboxIcon2x}.png") }} 2x,
            {{ asset("public/frontend/images/#{inofoboxIcon}.png") }} 1x"
        >
        <img
            class="box-info__img"
            loading="lazy"
            src="{{ imgLazyloadPlaceholder }}"
            data-src="{{ asset("public/frontend/images/#{inofoboxIcon}.png") }}"
            alt="{{ 'Potřebujete poradit?'|trans }}"
        >
    </picture>
    <div class="box-info__content">
        <h2 class="box-info__title">{{ 'Potřebujete poradit?'|trans }}</h2>

        <div class="box-info__contacts">
            <i class="svg svg-phone"></i>
            <a class="box-info__contacts__phone" href="tel:{{ shopInfoPhoneNumber }}">{{ shopInfoPhoneNumber }}</a>
            <p class="box-info__contacts__hours">{{ shopInfoPhoneHours }}</p>
        </div>

        <a href="{{ url('front_contacts') }}" class="position-relative btn btn--secondary">
            {{ 'Napište nám'|trans }}
        </a>
    </div>
</div>
