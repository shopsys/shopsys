<div class="list-articles">
    {% set isMainArticles = true %}
    
    {% for blogArticle in homepageArticles %}
        {% if loop.first %}
            <div class="list-articles__main">
        {% elseif loop.index == 3 %}
            {% set isMainArticles = false %}
            <div class="list-articles__aside">
        {% endif %}
        
        <div class="list-articles__item">
            <div class="list-articles__item__image">   
                <a class="list-articles__item__image__link" href="{{ url('front_blogarticle_detail', {'id': blogArticle.id}) }}" title="{{ blogArticle.name }}">
                    {% if isMainArticles %}
                        {{ image(blogArticle, { size: 'list', alt: blogArticle.name, lazy: true }) }}
                    {% else %}
                        {{ image(blogArticle, { size: 'listAside', alt: blogArticle.name, lazy: true }) }}
                    {% endif %}
                </a>
            </div>
            <div class="list-articles__item__content">
                {{ render(controller('App\\Controller\\Front\\BlogCategoryController::allCategoriesForBlogArticleAction', { blogArticle: blogArticle })) }}
                <a class="list-articles__item__name" href="{{ url('front_blogarticle_detail', {'id': blogArticle.id}) }}" title="{{ blogArticle.name }}">
                    {{ blogArticle.name}}
                </a>
                {% if isMainArticles %}
                    <div class="list-articles__item__desc">
                        {{ blogArticle.perex|slice(0,165) }}{% if blogArticle.perex|length > 165 %}&hellip;{% endif %}
                    </div>
                {% endif %}
            </div>
        </div>

        {% if loop.last or loop.index == 2 %}
            </div>
        {% endif %}
    {% endfor %}
</div>
