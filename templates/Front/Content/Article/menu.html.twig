<ul class="menu dont-print">
    {% if title is defined %}
        <h6>{{ title }}</h6>
    {% endif %}
    {% for article in articles %}
        <li class="menu__item">
            <a class="menu__item__link" 
                href="{{ article.isSiteType() ? url('front_article_detail', { id: article.id }) : article.getUrl() }}"
                {{ article.external ? 'target="_blank"' : '' }}
            >
                {{ article.name }}
            </a>
        </li>
    {% endfor %}
</ul>
