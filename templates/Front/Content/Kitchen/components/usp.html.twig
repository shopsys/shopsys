{% from 'Front/Macros/picture.html.twig' import picture as picture %}

<div class="box-furniture-usp-wrap">
    <h2 class="box-furniture-usp__heading theme-kitchen-color-secondary">{{ 'Pomůžeme vám'|trans }}</h2>
    <div class="box-furniture-usp-list">
        <div class="box-furniture-usp">
            <div class="box-furniture-usp__image">
                <span class="box-furniture-label">{{ 'Zdarma'|trans }}</span>
                    {{ picture(
                        'kitchen/usp/vizualizace_2x.jpg',
                        'kitchen/usp/vizualizace.jpg',
                        'Vizualizace',
                        'box-furniture-usp__img'
                    ) }}
            </div>
            <div class="box-furniture-usp__content">
                <strong class="box-furniture-usp__title theme-kitchen-color-secondary">
                    {{ 'Zpracujeme 3D<br>vizualizace kuchyně'|transHtml }}
                </strong>
                <p class="box-furniture-usp__desc theme-kitchen-color">
                    {{ 'Ihned uvidíte jak bude Vaše budoucí kuchyň vypadat.'|trans }}
                </p>
            </div>
        </div>
        <div class="box-furniture-usp">
            <div class="box-furniture-usp__image">
                <span class="box-furniture-label">{{ 'Zdarma'|trans }}</span>
                {{ picture(
                    'kitchen/usp/mereni_2x.jpg',
                    'kitchen/usp/mereni.jpg',
                    'Měření',
                    'box-furniture-usp__img'
                ) }}
            </div>
            <div class="box-furniture-usp__content">
                <strong class="box-furniture-usp__title theme-kitchen-color-secondary">
                    {{ 'Zaměříme kuchyň<br>u vás doma'|transHtml }}
                </strong>
                <p class="box-furniture-usp__desc theme-kitchen-color">
                    {{ 'Přijde k Vám náš odborný pracovník.'|trans }}
                </p>
            </div>
        </div>
        <div class="box-furniture-usp">
            <div class="box-furniture-usp__image">
                <span class="box-furniture-label">{{ 'Zdarma'|trans }}</span>
                {{ picture(
                    'kitchen/usp/instalace_2x.jpg',
                    'kitchen/usp/instalace.jpg',
                    'Instalace',
                    'box-furniture-usp__img'
                ) }}
            </div>
            <div class="box-furniture-usp__content">
                <strong class="box-furniture-usp__title theme-kitchen-color-secondary">
                    {{ 'Zpracujeme<br>instalační plán'|transHtml }}
                </strong>
                <p class="box-furniture-usp__desc theme-kitchen-color">
                    {{ 'Pro přesné umístění veškerých rozvodů.'|trans }}
                </p>
            </div>
        </div>
        <div class="box-furniture-usp">
            <div class="box-furniture-usp__image">
                {{ picture(
                    'kitchen/usp/doprava_2x.jpg',
                    'kitchen/usp/doprava.jpg',
                    'Doprava',
                    'box-furniture-usp__img'
                ) }}
            </div>
            <div class="box-furniture-usp__content">
                <strong class="box-furniture-usp__title theme-kitchen-color-secondary">
                    {{ 'Doprava<br>až k vám domů'|transHtml }}
                </strong>
                <p class="box-furniture-usp__desc theme-kitchen-color">
                    {{ 'Kuchyň vám doručíme v dohodnutém termínu.'|trans }}
                </p>
            </div>
        </div>
        <div class="box-furniture-usp">
            <div class="box-furniture-usp__image">
                {{ picture(
                    'kitchen/usp/montaz_2x.jpg',
                    'kitchen/usp/montaz.jpg',
                    'Montáž',
                    'box-furniture-usp__img'
                ) }}
            </div>
            <div class="box-furniture-usp__content">
                <strong class="box-furniture-usp__title theme-kitchen-color-secondary">
                    {{ 'Zajistíme<br>profesionální montáž'|transHtml }}
                </strong>
                <p class="box-furniture-usp__desc theme-kitchen-color">
                    {{ 'Kuchyň vám namontuje náš vyškolený personál.'|trans }}
                </p>
            </div>
        </div>
        <div class="box-furniture-usp">
            <div class="box-furniture-usp__image">
                {{ picture(
                    'kitchen/usp/vizualizace_2x.jpg',
                    'kitchen/usp/vizualizace.jpg',
                    'Funkce',
                    'box-furniture-usp__img'
                ) }}
            </div>
            <div class="box-furniture-usp__content">
                <strong class="box-furniture-usp__title theme-kitchen-color-secondary">
                    {{ 'Seznámíme vás<br>s funkcemi'|transHtml }}
                </strong>
                <p class="box-furniture-usp__desc theme-kitchen-color">
                    {{ 'Odborníci vás po instalaci seznámí s funkcemi vaší kuchyně.'|trans }}
                </p>
