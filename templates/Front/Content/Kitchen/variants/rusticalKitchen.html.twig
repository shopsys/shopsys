{% extends 'Front/Layout/layoutWithoutPanel.html.twig' %}
{% from 'Front/Macros/pagination.html.twig' import pagination as pagination %}

{% block breadcrumb %}
{% endblock %}

{% block title %}
    {{- 'Rustikální kuchyně'|trans -}}
{% endblock %}

{% block main_content %}
    <div class="web__line web__line--spacing--big">
        <div class="web__container">
            {# Heading, breadcrumb, description #}
            <div class="box-list__description box-list__description--furniture box-list__description--top box-list__description--top--no-spacing">
                {# Heading #}
                <h1 class="box-list__description__heading theme-kitchen-color-secondary">
                    {{ "Rustikální kuchyně"|trans }}
                </h1>
                {# Breadcrumb - not implemented yet #}
                <div class="web__container web__container--fullwidth web__container--max-width web__container--no-spacing js-not-implemented-yet">
                    <div class="box-breadcrumb">
                        <div class="box-breadcrumb">
                            <a href="{{ url('front_homepage') }}" class="box-breadcrumb__item box-breadcrumb__item--icon">
                                <i class="box-breadcrumb__item__icon svg svg-home"></i>
                                <span>{{ 'Domů'|trans }}</span>
                            </a>
                            <span class="box-breadcrumb__item box-breadcrumb__item--separator">/</span>
                            <a href="{{ url('front_kitchen_list') }}" class="box-breadcrumb__item">{{ 'Kuchyně na míru'|trans }}</a>
                            <span class="box-breadcrumb__item box-breadcrumb__item--separator">/</span>
                            <a href="{{ url('front_kitchen_list_rustical') }}" class="box-breadcrumb__item">{{ 'Rustikální kuchyně'|trans }}</a>
                        </div>
                    </div>
                </div>
                {# Short description #}
                <p class="box-list__description__text box-list__description__text--centered box-list__description__text--top box-list__description__text--wider theme-kitchen-color">
                    {{ 'Dřevo, porcelán, krb, vůně bylinek a tlumené barvy. Pociťujete potřebu utéct od všednosti a ruchu velkoměsta?
                    Nechte se inspirovat a vytvořte si příjemnou atmosféru ve svém bytě či domku. Záleží jen na vaši fantazii.
                    Buďte přirození, buďte nenároční a pamatujte – méně je někdy více. Z barev převažuje bílá.
                    Je nadčasová, příjemná a skvěle doplní tlumené barvy. V kombinaci se dřevem, kamenem nebo cihlami,
                    vytváří nezapomenutelný dojem. Doplňky volte z přírodních materiálů.
                    Bavlna, len, keramika a proutěné koše. To vše do vaší kuchyně patří.
                    Zkuste se podívat na půdu, zde najdete ty pravé poklady pro vaši rustikální domácnost.'|trans }}
                </p>
            </div>
            {# Grid #}
            {% include 'Front/Content/Kitchen/components/rusticalKitchen.html.twig' with { 'inDetail': true } %}
            {# Pagination #}
            {{ pagination(
                'front_kitchen_list_classic',
                'front_kitchen_list_modern',
                'Klasické',
                'Moderní'
            ) }}
            {# USP #}
            {% include 'Front/Content/Kitchen/components/usp.html.twig' %}
            {# Offers #}
            {% include 'Front/Content/Kitchen/components/offers.html.twig' %}
        </div>
    </div>
{% endblock %}
