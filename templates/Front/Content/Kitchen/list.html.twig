{% extends 'Front/Layout/layoutWithoutPanel.html.twig' %}

{% block breadcrumb %}
{% endblock %}

{% block title %}
    {{- 'Kuchyně na míru'|trans -}}
{% endblock %}

{% block main_content %}
    {% from 'Front/Macros/picture.html.twig' import picture as picture %}
    <div class="web__line web__line--spacing--big">
        <div class="web__container">
            {# Heading, breadcrumb, description #}
            <div class="box-list__description box-list__description--furniture box-list__description--top box-list__description--top--no-spacing">
                {# Heading #}
                <h1 class="box-list__description__heading theme-kitchen-color-secondary">
                    {{ "Kuchyně na míru"|trans }}
                </h1>
                {# Breadcrumb - not implemented yet #}
                <div class="web__container web__container--fullwidth web__container--max-width web__container--no-spacing js-not-implemented-yet">
                    <div class="box-breadcrumb">
                        <div class="box-breadcrumb">
                            <a href="{{ url('front_homepage') }}" class="box-breadcrumb__item box-breadcrumb__item--icon">
                                <i class="box-breadcrumb__item__icon svg svg-home"></i>
                                <span>{{ 'Domů'|trans }}</span>
                            </a>
                            <span class="box-breadcrumb__item box-breadcrumb__item--separator">/</span>
                            <a href="{{ url('front_kitchen') }}" class="box-breadcrumb__item">{{ 'Kuchyně'|trans }}</a>
                            <span class="box-breadcrumb__item box-breadcrumb__item--separator">/</span>
                            <a href="{{ url('front_kitchen_list') }}" class="box-breadcrumb__item">{{ 'Kuchyně na míru'|trans }}</a>
                        </div>
                    </div>
                </div>
                {# Short description #}
                <p class="box-list__description__text box-list__description__text--centered box-list__description__text--top box-list__description__text--wider theme-kitchen-color">
                    {{ 'Povězte nám, jak má vaše vysněná kuchyně vypadat a my zařídíme vše ostatní.
                    Sestavíme kuchyni tak, aby odpovídala vašim přáním a potřebám.
                    V závislosti na prostoru plánujeme kuchyně různých tvarů a velikostí. Mezi nejoblíbenější tvary patří rohová kuchyně,
                    kuchyně do U nebo kuchyně s ostrůvkem. Pohodlí a dlouhou výdrž pak zajistí kvalitní materiál a nejmodernější technologie.'|trans }}
                </p>
            </div>
            {# Categories #}
            <div class="box-furniture-cat-wrap">
                <div class="box-furniture-cat">
                    <div class="box-furniture-cat__image js-furniture-cats-carousel">
                        {{ picture(
                            'kitchen/category/moderni_kuchyne_2x.jpg',
                            'kitchen/category/moderni_kuchyne.jpg',
                            'Moderní kuchyně',
                            'box-furniture-cat__image'
                        ) }}
                        {{ picture(
                            'kitchen/category/moderni_kuchyne_2x.jpg',
                            'kitchen/category/moderni_kuchyne.jpg',
                            'Moderní kuchyně',
                            'box-furniture-cat__image'
                        ) }}
                        {{ picture(
                            'kitchen/category/moderni_kuchyne_2x.jpg',
                            'kitchen/category/moderni_kuchyne.jpg',
                            'Moderní kuchyně',
                            'box-furniture-cat__image'
                        ) }}
                    </div>
                    <div class="box-furniture-cat__content">
                        <a class="box-furniture-cat__link" href="{{ url('front_kitchen_list_modern') }}">
                            <h2 class="box-furniture-cat__title theme-kitchen-color-secondary">{{ 'Moderní kuchyně' }}</h2>
                            <p class="box-furniture-cat__desc theme-kitchen-color">
                                {{ 'Hledáte kuchyni, která odpovídá aktuálním moderním trendům,
                                nebo naopak toužíte po nadčasovém a nestárnoucím designu?
                                Umíme splnit všechna vaše očekávání. Naše rozsáhlá škála barev
                                vám umožní experimentovat a vytvářet tak vlastní kombinace.'|trans }}
                            </p>
                            <span class="btn btn--next btn-no-style theme-kitchen-color-secondary">
                                {{ 'Moderní kuchyně'|trans }}
                                <i class="btn__icon svg svg-chevron theme-kitchen-color-secondary svg-fw-bold"></i>
                            </span>
                        </a>
                    </div>
                </div>
                <div class="box-furniture-cat box-furniture-cat--reverse">
                    <div class="box-furniture-cat__image js-furniture-cats-carousel">
                        {{ picture(
                            'kitchen/category/rustikalni_kuchyne_2x.jpg',
                            'kitchen/category/rustikalni_kuchyne.jpg',
                            'Rustikální kuchyně',
                            'box-furniture-cat__image'
                        ) }}
                        {{ picture(
                            'kitchen/category/rustikalni_kuchyne_2x.jpg',
                            'kitchen/category/rustikalni_kuchyne.jpg',
                            'Rustikální kuchyně',
                            'box-furniture-cat__image'
                        ) }}
                        {{ picture(
                            'kitchen/category/rustikalni_kuchyne_2x.jpg',
                            'kitchen/category/rustikalni_kuchyne.jpg',
                            'Rustikální kuchyně',
                            'box-furniture-cat__image'
                        ) }}
                    </div>
                    <div class="box-furniture-cat__content">
                        <a class="box-furniture-cat__link" href="{{ url('front_kitchen_list_rustical') }}">
                            <h2 class="box-furniture-cat__title theme-kitchen-color-secondary">{{ 'Rustikální kuchyně' }}</h2>
                            <p class="box-furniture-cat__desc theme-kitchen-color">
                                {{ 'Lehce noblesní a s nádechem minulosti. V kombinaci se dřevem, kamenem nebo cihlami
                                vytváří nezapomenutelný dojem. Doplňky volte z přírodních materiálů, kterými jsou bavlna,
                                len, keramika a proutěné koše. To vše do vaší venkovské kuchyně patří.'|trans }}
                            </p>
                            <span class="btn btn--next btn-no-style theme-kitchen-color-secondary">
                                {{ 'Rustikální kuchyně'|trans }}
                                <i class="btn__icon svg svg-chevron theme-kitchen-color-secondary svg-fw-bold"></i>
                            </span>
                        </a>
                    </div>
                </div>
                <div class="box-furniture-cat">
                    <div class="box-furniture-cat__image js-furniture-cats-carousel">
                        {{ picture(
                            'kitchen/category/klasicke_kuchyne_2x.jpg',
                            'kitchen/category/klasicke_kuchyne.jpg',
                            'Klasické kuchyně',
                            'box-furniture-cat__image'
                        ) }}
                        {{ picture(
                            'kitchen/category/klasicke_kuchyne_2x.jpg',
                            'kitchen/category/klasicke_kuchyne.jpg',
                            'Klasické kuchyně',
                            'box-furniture-cat__image'
                        ) }}
                        {{ picture(
                            'kitchen/category/klasicke_kuchyne_2x.jpg',
                            'kitchen/category/klasicke_kuchyne.jpg',
                            'Klasické kuchyně',
                            'box-furniture-cat__image'
                        ) }}
                    </div>
                    <div class="box-furniture-cat__content">
                        <a class="box-furniture-cat__link" href="{{ url('front_kitchen_list_classic') }}">
                            <h2 class="box-furniture-cat__title theme-kitchen-color-secondary">{{ 'Klasické kuchyně' }}</h2>
                            <p class="box-furniture-cat__desc theme-kitchen-color">
                                {{ 'Klasické kuchyně se vyznačují přizpůsobivostí.
                                Místo sledování nejnovějších trendů je důraz těchto kuchyní kladen na jednoduchou eleganci.
                                Tak lze klasický design přizpůsobit správným příslušenstvím.'|trans }}
                            </p>
                            <span class="btn btn--next btn-no-style theme-kitchen-color-secondary">
                                {{ 'Klasické kuchyně'|trans }}
                                <i class="btn__icon svg svg-chevron theme-kitchen-color-secondary svg-fw-bold"></i>
                            </span>
                        </a>
                    </div>
                </div>
            </div>
            {# Banner #}
            <div class="box-furniture-banner box-furniture-banner--brand theme-kitchen-bg">
                <div class="box-furniture-banner__content">
                    <span class="box-furniture-tag">
                        <img
                            class="box-furniture-tag__img"
                            loading="lazy"
                            data-src="{{ asset('public/frontend/images/flags/de.svg') }}"
                            alt="{{ 'Německá kvalita' }}">
                        <span class="box-furniture-tag__text">{{ 'Německá kvalita'|trans }}</span>
                    </span>
                    <h2 class="box-furniture-banner__title theme-kitchen-color-secondary">{{ 'Kuchyně nobilia'|trans }}</h2>
                    <p class="box-furniture-banner__desc theme-kitchen-color">
                    {{ 'Nejmodernější kuchyně s německou kvalitou zpracování.
                    Exkluzivní design a precizní provedení doplňují nejnovější technologie.'|trans }}
                    </p>
                    <a class="btn btn--next btn-no-style theme-kitchen-color-secondary js-not-implemented-yet" href="#">
                        {{ 'Víc o značce'|trans }}
                        <i class="btn__icon svg svg-chevron theme-kitchen-color-secondary svg-fw-bold"></i>
                    </a>
                </div>
                <div class="box-furniture-banner__image">
                    {{ picture(
                        'kitchen/nobilia_bg_2x.jpg',
                        'kitchen/nobilia_bg.jpg',
                        'Nobilia kuchyně',
                        'box-furniture-banner__img'
                    ) }}
                </div>
            </div>
            {# USP #}
            {% include 'Front/Content/Kitchen/components/usp.html.twig' %}
            {# Offers #}
            {% include 'Front/Content/Kitchen/components/offers.html.twig' %}
            {# Grid #}
            {% include 'Front/Content/Kitchen/components/modernKitchen.html.twig' with { 'inDetail': false } %}
        </div>
    </div>
{% endblock %}
