                <div class="box-furniture-grid-gallery__item box-furniture-grid-gallery__item--vertical">
                    <picture>
                        <source
                            srcset="
                            {{ asset('public/frontend/images/kitchen/gallery/kuchyne_galerie_3_2x.jpg') }} 2x,
                            {{ asset('public/frontend/images/kitchen/gallery/kuchyne_galerie_3.jpg') }} 1x"
                        >
                        <img
                            alt="{{ 'Kuchyně na míru'|trans }}"
                            class="box-furniture-grid-gallery__img"
                            title="{{ 'Kuchyně na míru'|trans }}"
                            loading="lazy"
                            data-src="{{ asset('public/frontend/images/kitchen/gallery/kuchyne_galerie_3.jpg') }}"
                            itemprop="image"
                        >
                    </picture>
                    <picture>
                        <source
                            srcset="
                            {{ asset('public/frontend/images/kitchen/gallery/kuchyne_galerie_4_2x.jpg') }} 2x,
                            {{ asset('public/frontend/images/kitchen/gallery/kuchyne_galerie_4.jpg') }} 1x"
                        >
                        <img
                            alt="{{ 'Kuchyně na míru'|trans }}"
                            class="box-furniture-grid-gallery__img"
                            title="{{ 'Kuchyně na míru'|trans }}"
                            loading="lazy"
                            data-src="{{ asset('public/frontend/images/kitchen/gallery/kuchyne_galerie_4.jpg') }}"
                            itemprop="image"
                        >
                    </picture>
