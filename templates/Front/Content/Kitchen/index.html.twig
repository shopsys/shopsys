{% extends 'Front/Layout/layoutWithoutPanel.html.twig' %}

{% block breadcrumb %}
{% endblock %}

{% block title %}
    {{- 'Kuchyně'|trans -}}
{% endblock %}

{% block main_content %}
    <div class="web__line web__line--spacing--big">
        <div class="web__container">
            <div class="box-list__description box-list__description--furniture box-list__description--top box-list__description--top--no-spacing">
                <h1 class="box-list__description__heading theme-kitchen-color-secondary">
                    {{ "Když pro kuchyni, tak do Sconta"|trans }}
                </h1>
                <div class="web__container web__container--fullwidth web__container--max-width web__container--no-spacing js-not-implemented-yet">
                    <div class="box-breadcrumb">
                        <div class="box-breadcrumb">
                            <a href="{{ url('front_homepage') }}" class="box-breadcrumb__item box-breadcrumb__item--icon">
                                <i class="box-breadcrumb__item__icon svg svg-home"></i>
                                <span>{{ 'Domů'|trans }}</span>
                            </a>
                            <span class="box-breadcrumb__item box-breadcrumb__item--separator">/</span>
                            <a href="{{ url('front_kitchen') }}" class="box-breadcrumb__item">{{ 'Kuchyně'|trans }}</a>
                        </div>
                    </div>
                </div>
                <p class="box-list__description__text box-list__description__text--centered box-list__description__text--top theme-kitchen-color">
                    {{ 'V každém z 8 kuchyňských studií si můžete vybrat z více než 40 vystavených kuchyní různých stylů a barevných provedení.
                    Naši pečlivě proškolení odborníci vám pomohou přeměnit sny ve skutečnost.'|trans }}
                </p>
            </div>
            <div class="list-categories-wrap list-categories-wrap--centered">
                <ul class="list-categories box-furniture-categories">
                    <li class="list-categories__item list-categories__item--special">
                        <a href="{{ url('front_kitchen_list') }}" class="list-categories__item__block">
                            <span class="list-categories__item__image__wrap">
                                <picture>
                                    <source
                                        srcset="
                                        {{ asset('public/frontend/images/kitchen/kuchyne_na_miru2x.png') }} 2x,
                                        {{ asset('public/frontend/images/kitchen/kuchyne_na_miru.png') }} 1x"
                                    >
                                    <img
                                        alt="{{ 'Kuchyně na míru'|trans }}"
                                        class="list-categories__item__image image-category"
                                        title="{{ 'Kuchyně na míru'|trans }}"
                                        loading="lazy"
                                        data-src="{{ asset('public/frontend/images/kitchen/kuchyne_na_miru.png') }}"
                                        itemprop="image"
                                    >
                                </picture>
                            </span>
                            <h3 class="list-categories__item__title">{{ 'Kuchyně na míru'|trans }}</h3>
                        </a>
                    </li>
                    <li class="list-categories__item js-not-implemented-yet">
                        <a href="#" class="list-categories__item__block">
                            <span class="list-categories__item__image__wrap">
                                <picture>
                                    <source
