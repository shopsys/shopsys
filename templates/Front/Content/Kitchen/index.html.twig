                        <a href="#" class="list-categories__item__block">
                            <span class="list-categories__item__image__wrap">
                                <picture>
                                    <source
                                        srcset="
                                        {{ asset('public/frontend/images/kitchen/jidelni_sety2x.png') }} 2x,
                                        {{ asset('public/frontend/images/kitchen/jidelni_sety.png') }} 1x"
                                    >
                                    <img
                                        alt="{{ 'Jídelní sety'|trans }}"
                                        class="list-categories__item__image image-category"
                                        title="{{ 'Jídelní sety'|trans }}"
                                        loading="lazy"
