{% extends 'Front/Layout/layoutWithoutPanel.html.twig' %}
{% import 'Front/Content/Cart/cartItemsTableMacro.html.twig' as cartItemsTableMacro %}
{% import 'Front/Content/Cart/cartFreeTransportMacro.html.twig' as cartFreeTransportMacro %}

{% block meta_robots -%}
    <meta name="robots" content="noindex, follow">
{% endblock %}

{% block title %}
    {{ 'Cart'|trans }}
{% endblock %}

{% block breadcrumb %}
{% endblock %}

{% block header %}
    {% if cart is not null %}
        {% include 'Front/Layout/headerCart.html.twig' %}
    {% else %}
        {% include 'Front/Layout/header.html.twig' %}
    {% endif %}
{% endblock %}

{% block main_content %}

    {% set shopInfoEmail = getShopInfoEmail() %}
    {% set shopInfoPhoneNumber = getShopInfoPhoneNumber() %}
    {% set shopInfoPhoneHours = getShopInfoPhoneHours() %}

    {% block mainMenu %}
    {% endblock %}

    {% if cart is not null %}

        {% block mobileMenu %}
        {% endblock %}

        {% include 'Front/Inline/OrderProgress/index.html.twig' with {step: 1} only %}
        <div class="web__line web__line--bg-color web__line--cart">
            <div class="web__container">
                {{ form_start(form, { attr: { class: 'js-no-validate js-cart-form box-cart' }}) }}
                    {{ form_errors(form) }}
                    <div class="box-cart__buttons box-cart__buttons--mobile">
                        <button
                            type="submit"
                            name="cart_form[submit]"
                            class="btn btn--dark btn--checkout-step js-no-validate-button">
                            {{ 'Další krok'|trans }}
                        </button>
                    </div>
                    {% if splitOrderPreview.morePreviews %}
                        <div class="box-cart-message-box">
                            <img class="box-cart-message-box__img" loading="lazy" data-src="{{ asset('public/frontend/images/wide_delivery.svg') }}" alt="{{ 'Doprava zdarma'|trans }}">
                            <div class="box-cart-message-box__content">
                                <strong class="box-cart-message-box__title">{{ 'V košíku máte nadrozměrnou položku'|trans }}</strong>
                                <p class="box-cart-message-box__desc">{{ 'Tohle zboží má kvůli svým rozměrům a náročnosti manipulace jiné požadavky na dopravu. Proto jsme váš nákup rozdělili na víc zásilek.'|trans }}</p>
                            </div>
                        </div>
                    {% endif %}
                    <div class="box-cart__col box-cart__col--info">
                        {% set previewNumber = 0 %}
                        {% for orderPreview in splitOrderPreview.orderPreviews %}
                            {% set previewNumber = previewNumber + 1 %}
                            {% if loop.first and not splitOrderPreview.morePreviews %}
                                <div class="box-cart-card box-cart-card--info">
                                    <div class="box-cart-card__top">
                                        <h1 class="box-cart-card__title box-cart-card__title--no-margin">{{ 'Váš košík'|trans }}</h1>
                                        {{ cartFreeTransportMacro.progressBar(orderPreview) }}
                                    </div>
                                    {{ cartItemsTableMacro.table(form, orderPreview, maximumOrderQuantity) }}
                                </div>
                            {% endif %}
                            {% if splitOrderPreview.morePreviews %}
                                <div class="box-cart-card box-cart-card--info box-cart-card--{{ previewNumber }}">
                                    <div class="box-cart-card__top">
                                        <h2 class="box-cart-card__title box-cart-card__title--no-margin">
                                            {{ 'Zásilka č. %number%'|trans({ '%number%': previewNumber }) }}
                                            -
                                            {{ orderPreview.productType.name }}
                                        </h2>
                                            {{ cartFreeTransportMacro.progressBar(orderPreview, loop) }}
                                    </div>
                                    {{ cartItemsTableMacro.table(form, orderPreview, maximumOrderQuantity) }}
                                </div>
                            {% endif %}
                        {% endfor %}

                        <div class="box-cart__buttons">
                            <div class="box-cart__buttons__back">
                                <a href="{{ url('front_homepage') }}" class="btn btn--prev btn-no-style btn--arrow btn--arrow-prev">
                                    <i class="btn__icon svg svg-chevron"></i>
                                    {{ 'Zpět do obchodu'|trans }}
                                </a>
                            </div>
                            {% if cart.itemsCount > 0 %}
                                <div class="box-cart__buttons__next">
                                    {{ form_row(form.submit, { label: 'Další krok'|trans, attr: { class: 'btn btn--dark btn--checkout-step'}}) }}
                                </div>
                            {% endif %}
                        </div>
                    </div>
                    <div class="box-cart__col box-cart__col--preview">
                        <div class="box-cart-card box-cart-card--preview">
                            <div id="js-order-preview" data-url="{{ url('front_order_preview') }}">
                                {{ render(controller('App\\Controller\\Front\\OrderController:previewAction', {
                                    transportIdsByProductTypeId: splitOrderPreview.transportIdsIndexedByProductTypeId,
                                    paymentId: splitOrderPreview.hasPayment() ? splitOrderPreview.payment.id : null,
                                    showProducts: true,
                                    showAdvert: true,
                                    showPromo: true
                                })) }}
                            </div>
                        </div>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    {% else %}

        <div class="web__line">
            <div class="web__container web__container--full-width web__container--no-padding">
                {{ render(controller('App\\Controller\\Front\\HorizontalMenuController:menuAction')) }}
            </div>
        </div>
        <div class="web__line">
            <div class="web__container">
                <div class="box-cart-empty">
                    <div class="box-cart-empty__text">
                        <h1 class="box-cart-empty__heading">{{ 'Váš nákupní košík je prázdný.'|trans }}</h1>
                        <a href="{{ url('front_homepage') }}" class="box-cart-empty__btn btn btn--outline">
                            {{ 'Přejít do e-shopu'|trans }}
                        </a>
                    </div>
                    <div class="box-cart-empty__figure">
                        <picture>
                            <source srcset="{{ asset('public/frontend/images/empty-cart2x.png') }} 2x, {{ asset('public/frontend/images/empty-cart.png') }} 1x" />
                            <img class="box-cart-empty__image" loading="lazy" data-src="{{ asset('public/frontend/images/empty-cart.png') }}" alt="{{ 'Empty cart'|trans }}">
                        </picture>
                    </div>
                </div>
                {% include 'Front/Content/InfoBox/infoBox.html.twig' with { 'cssClass' : 'box-info--in-cart' } %}
            </div>
        </div>
    {% endif %}
{% endblock %}

{% block footer %}
    {% if cart is not null %}
        {% include 'Front/Layout/copyright.html.twig' with { 'cssClass' : 'footer__bottom--cart' } %}
    {% else %}
        {% embed 'Front/Layout/footer.html.twig' with { 'showNewsletter' : true } %}{% endembed %}
    {% endif %}
{% endblock %}
