{% extends 'Front/Layout/layoutWithoutPanel.html.twig' %}
{% import 'Front/Content/Cart/cartItemsTableMacro.html.twig' as cartItemsTableMacro %}

{% block meta_robots -%}
    <meta name="robots" content="noindex, follow">
{% endblock %}

{% block title %}
    {{ 'Cart'|trans }}
{% endblock %}

{% block breadcrumb %}
{% endblock %}

{% block main_content %}

    {% set shopInfoEmail = getShopInfoEmail() %}
    {% set shopInfoPhoneNumber = getShopInfoPhoneNumber() %}
    {% set shopInfoPhoneHours = getShopInfoPhoneHours() %}

    <div class="web__line">
        <div class="web__container">

            {% if cart is not null %}
                {% include 'Front/Inline/OrderProgress/index.html.twig' with {step: 1} only %}

                <h1>{{ 'Your cart'|trans }}</h1>

                {{ form_start(form, { attr: { class: 'js-no-validate js-cart-form' }}) }}
                    {{ form_errors(form) }}

                    <div class="box-cart-info">
                        {% if showOversizedMsg %}
                            <div class="box-cart-info__oversized">
                                <h6>{{ 'Oversized product in cart'|trans }}</h6>
                                <p>
                                    {{ 'These goods have different transport requirements'|trans|raw }}
                                </p>
                            </div>
                        {% endif %}

                        {% set previewNumber = 0 %}
                    {% for orderPreview in splitOrderPreview.orderPreviews %}
                        {% set previewNumber = previewNumber + 1 %}
                        {% if splitOrderPreview.morePreviews %}
                            <h2>
                                {{ 'Zásilka č. %number%'|trans({ '%number%': previewNumber }) }}
                                -
                                {{ orderPreview.productType.name }}
                            </h2>
                        {% endif %}
                        {{ cartItemsTableMacro.table(form, orderPreview) }}
                    {% endfor %}

                    {% if splitOrderPreview.morePreviews %}
                        <table class="table-cart">
                            <tfoot>
                                <tr class="table-cart__row">
                                    <td class="table-cart__cell table-cart__cell--total-price js-cart-total-price">
                                        <h3>
                                            {{ 'Total price including VAT'|trans }}:
                                            <span>
                                                {{ splitOrderPreview.totalPrice.priceWithVat|price }}
                                            </span>
                                        </h3>
                                    </td>
                                </tr>
                                <tr class="table-cart__row">
                                    <td class="table-cart__cell table-cart__cell--total-price js-cart-total-price">
                                        {{ 'Total price excluding VAT'|trans }}:
                                        <span>
                                            {{ splitOrderPreview.totalPrice.priceWithoutVat|price }}
                                        </span>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    {% endif %}
                    </div>

                    <div class="box-cart__preview">
                        <div class="box-cart__promo">
                            {{ render(controller('App\\Controller\\Front\\PromoCodeController:indexAction')) }}
                        </div>

                        <div id="js-order-preview" data-url="{{ url('front_order_preview') }}">
                            {{ render(controller('App\\Controller\\Front\\OrderController:previewAction', {
                                transportIdsByProductTypeId: splitOrderPreview.transportIdsIndexedByProductTypeId,
                                paymentId: splitOrderPreview.hasPayment() ? splitOrderPreview.payment.id : null,
                                showProducts: false
                            })) }}
                        </div>
                        <div class="in-action">
                            {% if cart.itemsCount > 0 %}
                                <div class="in-action__right">
                                    {{ form_row(form.submit, { label: 'Order [verb]'|trans, attr: { class: 'btn btn--success in-action__btn in-action__btn--big'}}) }}
                                </div>
                            {% endif %}

                            <div class="in-action__left">
                                <a href="{{ url('front_homepage') }}" class="btn in-action__btn">
                                    {{ 'Back to buying'|trans }}
                                </a>
                            </div>
                        </div>
                    </div>


                    <div class="box-cart-bottom">
                        <div class="box-cart-bottom__info">
                            {% if isFreeTransportAndPaymentActive %}
                                {% if isPaymentAndTransportFree %}
                                    <div class="box-free-transport box-free-transport--done">
                                        {% trans %}
                                            Shipping and payment <strong>for free!</strong>
                                        {% endtrans %}
                                    </div>
                                {% else %}
                                    <div class="box-free-transport">
                                        {% trans with {'%price%': remainingPriceWithVat|price} %}
                                            You still have to purchase products for <strong> %price% </strong> for <strong> free </strong> shipping and payment.
                                        {% endtrans %}
                                    </div>
                                {% endif %}
                            {% endif %}
                        </div>
                    </div>


                {{ form_end(form) }}
            {% else %}
                <div class="box-cart-empty">
                    <div class="box-cart-empty__text">
                        <h1 class="box-cart-empty__heading">{{ 'Váš nákupní košík je prázdný.'|trans }}</h1>
                        <a href="{{ url('front_homepage') }}" class="box-cart-empty__btn btn btn--outline">
                            {{ 'Přejít do e-shopu'|trans }}
                        </a>
                    </div>
                    <div class="box-cart-empty__figure">
                        <img class="box-cart-empty__image" loading="lazy" data-src="{{ asset('public/frontend/images/empty-cart.png') }}" alt="{{ 'Empty cart'|trans }}">
                    </div>
                </div>
                <div class="box-info box-info--in-cart">
                    <picture>
                        <source srcset="{{ asset('public/frontend/images/potrebujete_poradit2x.png') }} 2x" />
                        <img class="box-info__img" loading="lazy" src="" data-src="{{ asset('public/frontend/images/potrebujete_poradit.png') }}" alt="{{ 'Potřebujete poradit?'|trans }}">
                    </picture>
                    <div class="box-info__content">
                        <div class="box-info__text">
                            <h2 class="box-info__title">{{ 'Potřebujete poradit?'|trans }}</h2>
                            <span class="box-info__hours">{{ shopInfoPhoneHours }}</span>
                        </div>
                        <div class="box-info__contacts">
                            <a href="tel:{{ shopInfoPhoneNumber }}" class="box-info__contacts__link">
                                <i class="box-info__contacts__icon box-info__contacts__icon--phone svg svg-phone"></i>
                                <span class="box-info__contacts__text">{{ shopInfoPhoneNumber }}</span>
                            </a>
                            <a href="mailto:{{ shopInfoEmail }}" class="box-info__contacts__link">
                                <i class="box-info__contacts__icon svg svg-email"></i>
                                <span class="box-info__contacts__text">{{ shopInfoEmail }}</span>
                            </a>
                        </div>
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}
