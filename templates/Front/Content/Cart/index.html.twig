{% extends 'Front/Layout/layoutWithoutPanel.html.twig' %}
{% import 'Front/Content/Cart/cartItemsTableMacro.html.twig' as cartItemsTableMacro %}
{% import 'Front/Content/Cart/cartFreeTransportMacro.html.twig' as cartFreeTransportMacro %}

{% block meta_robots -%}
    <meta name="robots" content="noindex, follow">
{% endblock %}

{% block title %}
    {{ 'Cart'|trans }}
{% endblock %}

{% block breadcrumb %}
{% endblock %}

{% block main_content %}

    {% set shopInfoEmail = getShopInfoEmail() %}
    {% set shopInfoPhoneNumber = getShopInfoPhoneNumber() %}
    {% set shopInfoPhoneHours = getShopInfoPhoneHours() %}

    {% block mainMenu %}
    {% endblock %}

    {% if cart is not null %}

        {% include 'Front/Inline/OrderProgress/index.html.twig' with {step: 1} only %}
        <div class="web__line">
            <div class="web__container">
                {{ form_start(form, { attr: { class: 'box-cart js-no-validate js-cart-form' }}) }}
                    {{ form_errors(form) }}
                    <div class="box-cart__top">
                        {{ cartItemsTableMacro.table(form, orderPreview, maximumOrderQuantity) }}
                        {{ cartFreeTransportMacro.progressBar(orderPreview) }}
                    </div>
                    <div class="box-cart__bottom">
                        <div id="js-order-preview" data-url="{{ url('front_order_preview') }}">
                            {{ render(controller('App\\Controller\\Front\\OrderController:previewAction', {
                                paymentId: orderPreview.payment is null ? null : orderPreview.payment.id,
                                showProducts: false,
                                showAdvert: true,
                                showPromo: true
                            })) }}
                        </div>
                        <div class="in-action">
                            <div class="in-action__left">
                                <a href="{{ url('front_homepage') }}" class="btn btn-no-style btn--arrow btn--arrow-prev">
                                    <i class="btn__icon svg svg-arrow"></i>
                                    {{ 'Zpět do obchodu'|trans }}
                                </a>
                            </div>
                            {% if cart.itemsCount > 0 %}
                                <div class="in-action__right">
                                    {{ form_row(form.submit, { label: 'Doprava a platba'|trans, attr: { class: 'btn'}}) }}
                                </div>
                            {% endif %}
                        </div>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    {% else %}
        <div class="web__line">
            <div class="web__container">
                {{ render(controller('App\\Controller\\Front\\NavigationController:menuAction')) }}
            </div>
        </div>
        <div class="web__line">
            <div class="web__container">
                <div class="box-cart-empty">
                    <div class="box-cart-empty__text">
                        <h1 class="box-cart-empty__heading">{{ 'Váš nákupní košík je prázdný.'|trans }}</h1>
                        <a href="{{ url('front_homepage') }}" class="box-cart-empty__btn btn">
                            {{ 'Přejít do e-shopu'|trans }}
                        </a>
                    </div>
                    <div class="box-cart-empty__figure">
                        <picture>
                            <source srcset="{{ asset('public/frontend/images/empty-cart2x.png') }} 2x, {{ asset('public/frontend/images/empty-cart.png') }} 1x" />
                            <img class="box-cart-empty__image" loading="lazy" data-src="{{ asset('public/frontend/images/empty-cart.png') }}" alt="{{ 'Empty cart'|trans }}">
                        </picture>
                    </div>
                </div>
                {% include 'Front/Content/InfoBox/infoBox.html.twig' %}
            </div>
        </div>
    {% endif %}
    {% if gtmEvent is defined %}
        <div class="gtm-info" data-gtm-event="{{ gtmEvent|json_encode() }}"></div>
    {% endif %}
{% endblock %}
