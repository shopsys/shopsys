{% macro table(form, orderPreview, maximumOrderQuantity) %}
    <table class="table-cart js-cart">
        <thead>
            <tr class="table-cart__row table-cart__row--head">
                <th class="table-cart__cell table-cart__cell--head table-cart__cell--image">{{ 'Vaše produkty'|trans }}</th>
                <th class="table-cart__cell table-cart__cell--head table-cart__cell--name">
                    <span class="visibility-hidden">{{ 'Name'|trans }}</span>
                </th>
                <th class="table-cart__cell table-cart__cell--head table-cart__cell--avail">{{ 'Dostupnost'|trans }}</th>
                <th class="table-cart__cell table-cart__cell--head table-cart__cell--price">{{ 'Cena za kus'|trans }}</th>
                <th class="table-cart__cell table-cart__cell--head table-cart__cell--amount">{{ 'Počet kusů'|trans }}</th>
                <th class="table-cart__cell table-cart__cell--head table-cart__cell--price-final">{{ 'Zaplatíte'|trans }}</th>
                <th class="table-cart__cell table-cart__cell--head table-cart__cell--action">&nbsp;</th>
            </tr>
        </thead>
        <tbody>
        {% set cartItemPrices = orderPreview.quantifiedItemsPrices %}
        {% set cartItemDiscounts = orderPreview.quantifiedItemsDiscounts %}
        {% set cartItemDiscountPrices = orderPreview.quantifiedItemsDiscountPrices %}
        {% set isDiscountInOrderPreview = false %}
        {% for index, quantifiedProduct in orderPreview.quantifiedProducts %}
            {% set cartItemPrice = cartItemPrices[index] %}
            {% set cartItemDiscount = cartItemDiscounts[index] %}
            {% set cartItemDiscountPrice = cartItemDiscountPrices[index] %}
            {% set product = quantifiedProduct.product %}
            {% if cartItemDiscount is not null %}
                {% set isDiscountInOrderPreview = true %}
            {% endif %}
            {% set dataSpinboxMax = null %}
            {% if product.id in maximumOrderQuantity|keys %}
                {% set dataSpinboxMax = maximumOrderQuantity[product.id] %}
            {% endif %}
            {% set priceFlag = null %}
            {% if (product.hasFlagByAkeneoCodeForDomain(constant('App\\Model\\Product\\Flag\\Flag::AKENEO_CODE_SALE'), getDomain().id)) %}
                {% set priceFlag = 'cart-price--sale' %}
            {% else %}
                {% if (product.hasFlagByAkeneoCodeForDomain(constant('App\\Model\\Product\\Flag\\Flag::AKENEO_CODE_ACTION'), getDomain().id)) %}
                    {% set priceFlag = 'cart-price--action' %}
                {% endif %}
            {% endif %}
            <tr class="table-cart__row table-cart__row--content js-cart-item">
                <td class="table-cart__cell table-cart__cell--image">
                    <a href="{{ url('front_product_detail', {id: product.id}) }}" title="{{ product.fullname }}" class="table-cart__cell__image">
                        {{ image(product, { size: 'thumbnail' }) }}
                    </a>
                </td>

                <td class="table-cart__cell table-cart__cell--name js-cart-item-name">
                    <a class="table-cart__cell__product-name" href="{{ url('front_product_detail', {id: product.id}) }}">
                        {% if product.namePrefix is not empty %}
                            <span class="table-cart__cell__product-name__prefix">{{ product.namePrefix }}</span>
                        {% endif %}
                        {{ product.name }}
                    </a>
                    <div class="table-cart__cell__price-mobile">
                        {{ cartItemPrice.totalPrice.priceWithVat|price }}
                        {% if cartItemDiscount is not null %}
                            <div>
                                {{ 'Discount'|trans }}:
                                {{ cartItemDiscount.priceWithVat|price }}
                            </div>
                        {% endif %}
                    </div>
                    <div class="table-cart__product-sku">
                        {{ 'č. produktu: ' }}{{ product.catnum }}
                    </div>
                </td>

                <td class="table-cart__cell table-cart__cell--avail">
                    <strong class="table-cart__cell__avail">
                        {{ orderPreview.productsAvailability[product.id] }}
                    </strong>
                </td>

                <td class="table-cart__cell table-cart__cell--price js-cart-item-price">
                    {% if orderPreview.hasAnyProductCommonPrice(getDomain().id) %}
                        {% if product.getHighPriceWithVat(getDomain().id).isGreaterThan(cartItemPrice.unitPrice.priceWithVat) %}
                            <span class="line-through">
                                {{ product.getHighPriceWithVat(getDomain().id)|price }} {{ renderAsterisk(product.getFlagsIdsForDomain(getDomain().id), 'nonSellingPrice') }}
                            </span>
                        {% endif %}
                    {% endif %}
                    <strong class="cart-price cart-price--secondary {{ priceFlag }}">
                        {{ cartItemPrice.unitPrice.priceWithVat|price }} {{ renderAsterisk(product.getFlagsIdsForDomain(getDomain().id), 'sellingPrice') }}
                    </strong>
                </td>

                <td class="table-cart__cell table-cart__cell--amount">
                    <span class="form-input-spinbox form-input-spinbox--light form-input-spinbox--mini js-spinbox">
                        {{ form_widget(form.quantities[index], { attr: { class: 'form-input-spinbox__input input-no-style js-spinbox-input', 'data-spinbox-min': 1, 'data-spinbox-max': dataSpinboxMax}}) }}
                        <button type="button" class="btn-no-style form-input-spinbox__btn form-input-spinbox__btn--plus js-spinbox-plus">
                            <i class="form-input-spinbox__btn__icon form-input-spinbox__btn__icon--plus svg svg-arrow"></i>
                        </button>
                        <button type="button" class="btn-no-style form-input-spinbox__btn form-input-spinbox__btn--minus js-spinbox-minus">
                            <i class="form-input-spinbox__btn__icon svg svg-arrow"></i>
                        </button>
                    </span>
                </td>

                <td class="table-cart__cell table-cart__cell--price-final js-cart-item-total-price">
                    {% set canShowNonSellingPrice = true %}
                    {% if (product.hasFlagByAkeneoCodeForDomain(constant('App\\Model\\Product\\Flag\\Flag::AKENEO_CODE_ACTION'), getDomain().id)) %}
                        {% set canShowNonSellingPrice = false %}
                    {% endif %}
                    {% if (product.hasFlagByAkeneoCodeForDomain(constant('App\\Model\\Product\\Flag\\Flag::AKENEO_CODE_SALE'), getDomain().id)) %}
                        {% set canShowNonSellingPrice = false %}
                    {% endif %}
                    {% if (product.hasFlagByAkeneoCodeForDomain(constant('App\\Model\\Product\\Flag\\Flag::AKENEO_CODE_HIT'), getDomain().id)) %}
                        {% set canShowNonSellingPrice = false %}
                    {% endif %}
                    {% if canShowNonSellingPrice and product.getHighPriceWithVat(getDomain().id).isGreaterThan(cartItemPrice.unitPrice.priceWithVat) %}
                        <span class="line-through">
                            {{ product.getHighPriceWithVat(getDomain().id).multiply(quantifiedProduct.quantity)|price }} {{ renderAsterisk(product.getFlagsIdsForDomain(getDomain().id), 'nonSellingPrice') }}
                        </span>
                    {% endif %}
                    {% if cartItemDiscount is not null %}
                        <strong class="cart-price cart-price--primary cart-price--promo">{{ cartItemDiscountPrice.priceWithVat|price }}</strong>
                        <strong class="cart-tag cart-tag--promo">{{ orderPreview.promoCodeCode }}</strong>
                    {% else %}
                        <strong class="cart-price cart-price--primary {{ priceFlag }}">
                            {{ cartItemPrice.totalPrice.priceWithVat|price }} {{ renderAsterisk(product.getFlagsIdsForDomain(getDomain().id), 'sellingPrice') }}
                        </strong>
                    {% endif %}
                    <div class="in-flag in-flag--in-checkout">
                        {% if (product.hasFlagByAkeneoCodeForDomain(constant('App\\Model\\Product\\Flag\\Flag::AKENEO_CODE_ACTION'), getDomain().id)) %}
                            <div class="in-flag__item in-flag__item--small flag__product_action">
                                <span class="in-flag__item__name">{{ "Akční cena"|trans }}</span>
                            </div>
                        {% endif %}
                        {% if (product.hasFlagByAkeneoCodeForDomain(constant('App\\Model\\Product\\Flag\\Flag::AKENEO_CODE_SALE'), getDomain().id)) %}
                            <div class="in-flag__item in-flag__item--small flag__product_sale">
                                <span class="in-flag__item__name">{{ "Výprodej"|trans }}</span>
                            </div>
                        {% endif %}
                        {% if (product.hasFlagByAkeneoCodeForDomain(constant('App\\Model\\Product\\Flag\\Flag::AKENEO_CODE_HIT'), getDomain().id)) %}
                            <div class="in-flag__item in-flag__item--small flag__product_hit">
                                <span class="in-flag__item__name">{{ "Cenový hit"|trans }}</span>
                            </div>
                        {% endif %}
                    </div>
                </td>

                <td class="table-cart__cell table-cart__cell--action">
                    <a
                        href="{{ url('front_cart_delete', { cartItemId: index, _token: csrf_token('front_cart_delete_' ~ index) }) }}"
                        class="js-cart-item-remove-button"
                    >
                        <i class="table-cart__cell__remove svg svg-remove"></i>
                    </a>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endmacro %}
