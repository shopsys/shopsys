{% macro table(form, orderPreview, maximumOrderQuantity) %}
    <div class="table-cart js-cart">
        {% set cartItemPrices = orderPreview.quantifiedItemsPrices %}
        {% set cartItemDiscounts = orderPreview.quantifiedItemsDiscounts %}
        {% set cartItemDiscountPrices = orderPreview.quantifiedItemsDiscountPrices %}
        {% set isDiscountInOrderPreview = false %}
        {% for index, quantifiedProduct in orderPreview.quantifiedProducts %}
            {% set cartItemPrice = cartItemPrices[index] %}
            {% set cartItemDiscount = cartItemDiscounts[index] %}
            {% set cartItemDiscountPrice = cartItemDiscountPrices[index] %}
            {% set product = quantifiedProduct.product %}
            {% if cartItemDiscount is not null %}
                {% set isDiscountInOrderPreview = true %}
            {% endif %}
            {% set dataSpinboxMax = null %}
            {% if product.id in maximumOrderQuantity|keys %}
                {% set dataSpinboxMax = maximumOrderQuantity[product.id] %}
            {% endif %}
            {% set priceFlag = null %}
            {% if (product.hasFlagByAkeneoCodeForDomain(constant('App\\Model\\Product\\Flag\\Flag::AKENEO_CODE_SALE'), getDomain().id)) %}
                {% set priceFlag = 'table-cart__cell__price--sale' %}
            {% else %}
                {% if (product.hasFlagByAkeneoCodeForDomain(constant('App\\Model\\Product\\Flag\\Flag::AKENEO_CODE_ACTION'), getDomain().id)) %}
                    {% set priceFlag = 'table-cart__cell__price--action' %}
                {% endif %}
            {% endif %}
            <div class="table-cart__row js-cart-item">
                <div class="table-cart__cell table-cart__cell--image">
                    <a href="{{ url('front_product_detail', {id: product.id}) }}" title="{{ product.fullname }}" class="table-cart__cell__image">
                        {{ image(product, { size: 'thumbnail' }) }}
                    </a>
                </div>

                <div class="table-cart__cell table-cart__cell--info js-cart-item-name">
                    <div class="table-cart__cell__name">
                        <a class="table-cart__cell__name__title" href="{{ url('front_product_detail', {id: product.id}) }}">
                            {% if product.namePrefix is not empty %}
                                <span>{{ product.namePrefix }}</span>
                            {% endif %}

                            <span class="js-cart-item-name-text">
                                {{ product.name }}
                            </span>

                            <div class="in-flag in-flag--in-checkout">
                                {% if (product.hasFlagByAkeneoCodeForDomain(constant('App\\Model\\Product\\Flag\\Flag::AKENEO_CODE_ACTION'), getDomain().id)) %}
                                    <div class="in-flag__item flag__product_action">
                                        {{ "Akční cena"|trans }}
                                    </div>
                                {% endif %}
                                {% if (product.hasFlagByAkeneoCodeForDomain(constant('App\\Model\\Product\\Flag\\Flag::AKENEO_CODE_SALE'), getDomain().id)) %}
                                    <div class="in-flag__item flag__product_sale">
                                        {{ "Výprodej"|trans }}
                                    </div>
                                {% endif %}
                                {% if (product.hasFlagByAkeneoCodeForDomain(constant('App\\Model\\Product\\Flag\\Flag::AKENEO_CODE_HIT'), getDomain().id)) %}
                                    <div class="in-flag__item flag__product_hit">
                                        {{ "Cenový hit"|trans }}
                                    </div>
                                {% endif %}
                            </div>
                        </a>
                        <div class="table-cart__cell__name__catnum">
                            {{ 'Kód:'|trans }} {{ product.catnum }}
                        </div>
                    </div>
                    <div class="table-cart__cell__availability">
                        {{ orderPreview.productsAvailability[product.id] }}
                        <span class="table-cart__cell__availability__text js-not-implemented-yet">nebo ihned na 2 prodejnách</span>
                    </div>
                </div>

                <div class="table-cart__cell table-cart__cell--spinbox">
                    <span class="form-input-spinbox js-spinbox">
                        <button type="button" class="btn-no-style form-input-spinbox__btn js-spinbox-minus">
                            <i class="svg svg-minus"></i>
                        </button>
                        {{ form_widget(form.quantities[index], { attr: { class: 'form-input-spinbox__input input-no-style js-spinbox-input', 'data-spinbox-min': 1, 'data-spinbox-max': dataSpinboxMax}}) }}
                        <button type="button" class="btn-no-style form-input-spinbox__btn js-spinbox-plus">
                            <i class="svg svg-plus"></i>
                        </button>
                    </span>
                </div>

                <div class="table-cart__cell table-cart__cell--price-unit js-cart-item-price">
                    <span class="table-cart__cell__price {{ priceFlag }}">
                        {{ cartItemPrice.unitPrice.priceWithVat|price }} / {{ '%unit%' |trans({ '%unit%': product.unit.name }) }}
                    </span>
                </div>

                <div class="table-cart__cell table-cart__cell--price js-cart-item-total-price">
                    <strong class="table-cart__cell__price table-cart__cell__price--main {{ priceFlag }}">
                        {{ cartItemPrice.totalPrice.priceWithVat|price }}
                    </strong>
                </div>

                <div class="table-cart__cell table-cart__cell--action">
                    <a
                        href="{{ url('front_cart_delete', { cartItemId: index, _token: csrf_token('front_cart_delete_' ~ index) }) }}"
                        class="table-cart__cell__remove js-cart-item-remove-button"
                    >
                        <i class="svg svg-remove-bold"></i>
                    </a>
                </div>
            </div>
        {% endfor %}
    </div>
{% endmacro %}
