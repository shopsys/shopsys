{% macro progressBar(orderPreview, loop) %}
    {% if orderPreview.productType.isFreeTransport(getDomain().id) %}
        {% set restForFreeTransportPriceAmount = orderPreview.getRestToFreeTransportPrice().getAmount() %}
        {% set restForFreeTransportPrice = orderPreview.getRestToFreeTransportPrice()|price %}
        {% set percentageOfFreeTransport = orderPreview.getPercentageOfFreeTransport() %}
        <div class="box-free-transport">
            <div class="box-free-transport__icon">
                {% if loop is not null and loop.first %}
                    <img class="box-free-transport__icon__image" loading="lazy" data-src="{{ asset('public/frontend/images/wide_delivery.png') }}" alt="{{ 'Doprava zdarma'|trans }}">
                {% else %}
                    <img class="box-free-transport__icon__image" loading="lazy" data-src="{{ asset('public/frontend/images/package-icon-delivery.svg') }}" alt="{{ 'Doprava zdarma'|trans }}">
                {% endif %}
            </div>
            <div class="box-free-transport__content">
                {% if restForFreeTransportPriceAmount > 0 %}
                    <div class="box-free-transport__desc">
                        {{ 'Nakupte ještě za <strong class="box-free-transport__desc__strong">%price%</strong> a získáte doručení <strong class="box-free-transport__desc__strong">Zdarma</strong>'|trans({ '%price%': restForFreeTransportPrice })|raw }}
                    </div>
                    <div class="box-free-transport__progress">
                        <div class="box-free-transport__progress__bar" style="width: {{ percentageOfFreeTransport }}%;"></div>
                    </div>
                {% else %}
                    <div class="box-free-transport__desc">
                        {{ 'Získali jste doručení <strong>Zdarma</strong>'|trans|raw }}
                    </div>
                {% endif %}
            </div>
        </div>
    {% endif %}
{% endmacro %}
