{% block header %}

    {% set shopInfoPhoneNumber = getShopInfoPhoneNumber() %}
    {% set shopInfoPhoneHours = getShopInfoPhoneHours() %}
    {% set shopInfoEmail = getShopInfoEmail() %}
    {% set domain = getDomain() %}
    {% set logoName = domain.id == 1 ? 'logo' : 'logo_sk' %}

    <header class="header">
        <div class="header__logo">
            {% block logo %}
                <a class="logo" href="{{ url('front_homepage') }}">
                    <img
                        src="{{ asset("public/frontend/images/#{logoName}.svg") }}"
                        alt="{{ 'Online shop'|trans }}"
                    >
                </a>
            {% endblock %}
        </div>

        <div class="header__middle dont-print">
            {{ render(controller('App\\Controller\\Front\\SearchController:boxAction')) }}
        </div>

        <div class="header__mobile-button header__mobile-button--login">
            {% if is_granted('ROLE_LOGGED_CUSTOMER') %}
                <span class="header__mobile-button__in js-responsive-toggle" data-element="js-user-menu" data-hide-on-click-out="true">
                    <i class="svg svg-user"></i>
                </span>
            {% else %}
                <a
                    href="{{ url('front_login') }}"
                    data-url="{{ url('front_login_window_form') }}"
                    class="header__mobile-button__in js-login-button"
                >
                    <i class="svg svg-user"></i>
                </a>
            {% endif %}
            <div class="header__mobile-button__menu" id="js-user-menu">
                {% if is_granted('ROLE_LOGGED_CUSTOMER') %}
                    <a href="{{ url('front_customer_edit') }}">
                        {{ 'Personal data'|trans }}
                    </a>
                    <a href="{{ url('front_customer_orders') }}">
                        {{ 'Orders'|trans }}
                    </a>
                    <a href="{{ url('front_logout', { _csrf_token: csrf_token('frontend_logout')}) }}">
                        {{ 'Log out'|trans }}
                    </a>
                {% endif %}
            </div>
        </div>

        <div class="header__mobile-button header__mobile-button--menu">
            <span class="header__mobile-button__in js-responsive-toggle js-mobile-menu-button" data-element="js-mobile-menu">
                <div class="in-hamburger-icon">
                    <span></span>
                    <span></span>
                    <span></span>
                    <span></span>
                </div>
                <span class="header__mobile-button__text header__mobile-button__text--open">{{ 'Menu'|trans }}</span>
                <span class="header__mobile-button__text header__mobile-button__text--close">{{ 'Zavřít'|trans }}</span>
            </span>
        </div>

        <div class="header__links dont-print">
            <ul class="menu-iconic">
                <li class="menu-iconic__item">
                    <a href="{{ url('front_contacts') }}" class="menu-iconic__item__link">
                        <i class="menu-iconic__item__icon svg svg-chat"></i>
                        <span class="menu-iconic__item__text">{{ 'Zákaznický servis'|trans }}</span>
                    </a>
                </li>
                <li class="menu-iconic__item">
                    <a href="{{ url('front_stores') }}" class="menu-iconic__item__link">
                        <i class="menu-iconic__item__icon svg svg-marker"></i>
                        <span class="menu-iconic__item__text">{{ 'Prodejny'|trans }}</span>
                    </a>
                </li>
                {% if is_granted('ROLE_LOGGED_CUSTOMER') %}
                    <li class="menu-iconic__item menu-iconic__item--sub">
                        <button class="menu-iconic__item__link menu-iconic__item__link--button">
                            <i class="menu-iconic__item__icon svg svg-user"></i>
                            <span class="menu-iconic__item__text">{{ 'Můj účet'|trans }}</span>
                        </button>
                        <ul class="menu-iconic__sub">
                            <li class="menu-iconic__sub__item">
                                <a href="{{ url('front_customer_orders') }}" class="menu-iconic__sub__item__link">{{ 'My orders'|trans }}</a>
                            </li>
                            <li class="menu-iconic__sub__item">
                                <a href="{{ url('front_customer_edit') }}" class="menu-iconic__sub__item__link">{{ 'Upravit údaje'|trans }}</a>
                            </li>
                            <li class="menu-iconic__sub__item">
                                <a href="{{ url('front_logout', { _csrf_token: csrf_token('frontend_logout')}) }}" class="js-logout-link-desktop menu-iconic__sub__item__link">
                                    {{ 'Odhlásit'|trans }}
                                </a>
                            </li>
                        </ul>
                    </li>
                {% else %}
                    <li class="menu-iconic__item">
                        <a
                            href="{{ url('front_login') }}"
                            data-url="{{ url('front_login_window_form') }}"
                            class="js-login-link-desktop js-login-button menu-iconic__item__link"
                        >
                            <i class="menu-iconic__item__icon svg svg-user"></i>
                            <span class="menu-iconic__item__text">{{ 'Log in'|trans }}</span>
                        </a>
                    </li>
                {% endif %}
            </ul>
        </div>
        <div class="header__cart dont-print">
            {{ render(controller('App\\Controller\\Front\\CartController:boxAction')) }}
        </div>
    </header>

    {{ render(controller('App\\Controller\\Front\\AdvertController:boxAction',{'positionName' : 'header'})) }}
{% endblock %}
