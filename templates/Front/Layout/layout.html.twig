{% extends 'Front/Layout/base.html.twig' %}
{% use 'Front/Layout/header.html.twig' %}

{% block html_body %}
    {% set adminLoggedAsCustomer = app.session.has(constant('Shopsys\\FrameworkBundle\\Model\\Security\\LoginAsUserFacade::SESSION_LOGIN_AS')) %}
    {% if adminLoggedAsCustomer or isMailerSettingUnusual() %}
        <div class="window-bar dont-print">
            {% if adminLoggedAsCustomer %}
                <div class="window-bar__item">
                    {{ 'Attention! You are administrator logged in as the customer.'|trans }}
                    <a href="{{ url('front_logout', { _csrf_token: csrf_token('frontend_logout')}) }}">{{ 'Log out'|trans }}</a>
                </div>
            {% endif %}
            {% if isMailerSettingUnusual() %}
                <div class="window-bar__item">
                    {{ getMailerSettingInfo() }}
                </div>
            {% endif %}
        </div>
    {% endif %}
    {% if getRoute() != 'front_cart' and getRoute() != 'front_order_index' %}
        {{ render(controller('App\\Controller\\Front\\NotificationBarController:infoAction')) }}
    {% endif %}
    <div class="web__in">
        <div class="web__header">
            <div class="web__line">
                <div class="web__container">
                    {{ block('header') }}
                </div>
            </div>
        </div>
        {% block mainMenu %}
            {% cache constant('App\\Component\\Cache\\TwigCachedMenuFacade::HORIZONTAL_PANEL_MENU') {lifetime:60*60*24, domainId:getDomain().id} %}
                <div class="web__line">
                    <div class="web__container web__container--full-width web__container--no-padding">
                        {{ render(controller('App\\Controller\\Front\\HorizontalMenuController:menuAction')) }}
                    </div>
                </div>
            {% endcache %}
        {% endblock %}

        {% block content %}{% endblock %}

        {% block footer %}
            {% embed 'Front/Layout/footer.html.twig' %}{% endembed %}
        {% endblock %}
    </div>
    {% if not isCookiesConsentGiven() %}
        {% set cookiesArticle = findCookiesArticleByDomainId(getDomain().id) %}
        <div class="box-cookies dont-print js-eu-cookies">
            <div class="box-cookies__in">
                <div class="box-cookies__text">
                    <picture>
                        <source srcset="{{ asset('public/frontend/images/cookie-panel-icon2x.png') }} 2x, {{ asset('public/frontend/images/cookie-panel-icon.png') }} 1x" />
                        <img class="box-cookies__text__icon" loading="lazy" src="" data-src="{{ asset('public/frontend/images/cookie-panel-icon.png') }}" alt="{{ 'Cookies'|trans }}">
                    </picture>
                    <span class="box-cookies__text__in">
                        {{ 'This site uses cookies. By staying on the site you agree with that.'|trans }}
                        {% if cookiesArticle is not null %}
                            <a class="box-cookies__link" href="{{ url('front_article_detail', { id: cookiesArticle.id }) }}" target="_blank">
                                {{- 'More information'|trans -}}
                            </a>
                        {% endif %}
                    </span>
                </div>
                <div class="box-cookies__btn">
                    <button class="btn btn--cookies js-eu-cookies-consent-button" type="button">{{ 'I understand'|trans }}</button>
                </div>
            </div>
        </div>
    {% endif %}
{% endblock %}
