{% set shopInfoPhoneNumber = getShopInfoPhoneNumber() %}
{% set shopInfoPhoneHours = getShopInfoPhoneHours() %}
{% set shopInfoEmail = getShopInfoEmail() %}
{% set domain = getDomain() %}

<header class="header header--cart">
    <div class="header__logo">
        {% block logo %}
            <a class="logo" href="{{ url('front_homepage') }}">
                <img class="logo__img" src="{{ asset("public/frontend/images/logo.svg") }}" alt="{{ 'Online shop'|trans }}">
            </a>
        {% endblock %}
    </div>
    <div class="header__info-box">
        {% include 'Front/Content/InfoBox/infoBox.html.twig' with { 'header' : true, cssClassModification: 'box-info--header' } %}
    </div>
</header>
