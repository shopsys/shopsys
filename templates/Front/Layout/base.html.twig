<!DOCTYPE html>
<html lang="{{ app.request.locale }}" class="no-js">
    <head>
        {{ render(controller('App\\Controller\\Front\\GtmController:headAction')) }}

        <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
        <meta name="description" content="{% block meta_description %}{% endblock %}">
        <meta http-equiv="X-UA-Compatible" content="IE=edge" />
        <!-- Value for robots during development -->
        <meta name="robots" content="noindex,nofollow" />
        <!--
        Prepared value for robots in production environment
        {% block meta_robots %}{% endblock %}
        -->
        {% block prev_next_links %}{% endblock %}

        {% set entryDirectory = 'frontend-style-' ~ getDomain().currentDomainConfig.stylesDirectory %}
        {{ encore_entry_link_tags( entryDirectory ) }}
        {% set entryDirectoryPrint = 'frontend-print-style-' ~ getDomain().currentDomainConfig.stylesDirectory %}
        {{ encore_entry_link_tags( entryDirectoryPrint ) }}

        {{ render(controller('App\\Controller\\Front\\HeurekaController:embedWidgetAction')) }}
        {{ render(controller('App\\Controller\\Front\\SelfCanonicalController:getSelfCanonicalLink')) }}
        {% block javascripts %}{% endblock %}

        <title>{% block title %}Shopsys Framework{% endblock %} {{ getSeoTitleAddOn() }}</title>

        {# Favicons #}
        <link rel="icon" type="image/png" sizes="16x16" href="{{ asset('public/frontend/images/favicons/favicon-16x16.png') }}">
        <link rel="icon" type="image/png" sizes="32x32" href="{{ asset('public/frontend/images/favicons/favicon-32x32.png') }}">
        <link rel="icon" type="image/png" sizes="96x96" href="{{ asset('public/frontend/images/favicons/favicon-96x96.png') }}">

        <link rel="icon" type="image/png" sizes="36x36" href="{{ asset('public/frontend/images/favicons/android-icon-36x36.png') }}">
        <link rel="icon" type="image/png" sizes="48x48" href="{{ asset('public/frontend/images/favicons/android-icon-48x48.png') }}">
        <link rel="icon" type="image/png" sizes="72x72" href="{{ asset('public/frontend/images/favicons/android-icon-72x72.png') }}">
        <link rel="icon" type="image/png" sizes="96x96" href="{{ asset('public/frontend/images/favicons/android-icon-96x96.png') }}">
        <link rel="icon" type="image/png" sizes="144x144" href="{{ asset('public/frontend/images/favicons/android-icon-144x144.png') }}">
        <link rel="icon" type="image/png" sizes="192x192" href="{{ asset('public/frontend/images/favicons/android-icon-192x192.png') }}">

        <link rel="apple-touch-icon" sizes="57x57" href="{{ asset('public/frontend/images/favicons/apple-icon-57x57.png') }}">
        <link rel="apple-touch-icon" sizes="60x60" href="{{ asset('public/frontend/images/favicons/apple-icon-60x60.png') }}">
        <link rel="apple-touch-icon" sizes="72x72" href="{{ asset('public/frontend/images/favicons/apple-icon-72x72.png') }}">
        <link rel="apple-touch-icon" sizes="76x76" href="{{ asset('public/frontend/images/favicons/apple-icon-76x76.png') }}">
        <link rel="apple-touch-icon" sizes="114x114" href="{{ asset('public/frontend/images/favicons/apple-icon-114x114.png') }}">
        <link rel="apple-touch-icon" sizes="120x120" href="{{ asset('public/frontend/images/favicons/apple-icon-120x120.png') }}">
        <link rel="apple-touch-icon" sizes="144x144" href="{{ asset('public/frontend/images/favicons/apple-icon-144x144.png') }}">
        <link rel="apple-touch-icon" sizes="152x152" href="{{ asset('public/frontend/images/favicons/apple-icon-152x152.png') }}">
        <link rel="apple-touch-icon" sizes="180x180" href="{{ asset('public/frontend/images/favicons/apple-icon-180x180.png') }}">

        <meta name="msapplication-TileColor" content="#ffb900">
        <meta name="msapplication-TileImage" content="{{ asset('public/frontend/images/favicons/ms-tile-144x144.png') }}">

        <link rel="shortcut icon" href="{{ asset('public/frontend/images/favicons/favicon.ico') }}">

        <link rel="manifest" href="{{ asset('public/frontend/images/favicons/manifest.json') }}">
        <link rel="mask-icon" href="{{ asset('public/frontend/images/favicons/safari-pinned-tab.svg') }}" color="#202330">

        {# Mobile theme color #}
        <meta name="theme-color" content="#ffb900">
    </head>

    <body class="web">
        {{ render(controller('App\\Controller\\Front\\GtmController:bodyAction')) }}

        {{ render(controller('App\\Controller\\Front\\ScriptController:embedAllPagesScriptsAction')) }}
        {{ render(controller('App\\Controller\\Front\\ScriptController:embedAllPagesGoogleAnalyticsScriptAction')) }}

        {% block html_body %}{% endblock %}

        {% block javascripts_bottom %}{% endblock %}

        {{ encore_entry_script_tags('frontend') }}
        {{ js_validator_config() }}
        {{ init_js_validation() }}

        {% if app.environment is same as('dev') %}
            <script async src="//localhost:35729/livereload.js"></script>
        {% endif %}
    </body>
</html>
