{% extends 'Front/Layout/layout.html.twig' %}

{% block content %}
    <div class="display-none display-block-tablet">
        {% cache constant('App\\Component\\Cache\\TwigCachedMenuFacade::MOBILE_SLIDING_MENU') {lifetime:60*60*24, domainId:getDomain().id} %}
            {{ render(controller('App\\Controller\\Front\\CategoryController:mobileSlidingMenuAction')) }}
        {% endcache %}
    </div>
    <div class="web__main">
        <div class="web__main__content js-main-content">
            {% block breadcrumb %}
                {{ render(controller('App\\Controller\\Front\\BreadcrumbController:indexAction', { routeName: getRoute(), routeParameters: getRouteParams() } )) }}
            {% endblock %}

            <div class="web__line">
                <div class="web__container">
                    {{ render(controller('App\\Controller\\Front\\FlashMessageController:indexAction')) }}
                </div>
            </div>

            {% block main_content %}{% endblock %}
        </div>
    </div>

    <div class="display-none display-block-tablet">
        {% cache constant('App\\Component\\Cache\\TwigCachedMenuFacade::MOBILE_PANEL_MENU') {lifetime:60*60*24, domainId:getDomain().id} %}
            {{ render(controller('App\\Controller\\Front\\CategoryController:mobilePanelMenuAction')) }}
        {% endcache %}
    </div>
{% endblock %}
