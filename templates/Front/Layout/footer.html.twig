<div class="footer">
    {# TODO: Domluvit s programmerem a s PO, aby se vracel obecný priznak - tj. ze jsem v pokladne a podle toho to opodminkovat #}
    {# PO informovan v ukole SD-376 #}
    {% if (cart is not defined) and (payments is not defined) %}
        <div class="web__line clearfix dont-print">
            <div class="web__container">
                {{ render(controller('App\\Controller\\Front\\NewsletterController:subscriptionAction')) }}
            </div>
        </div>
        <div class="web__line">
            <div class="web__container">
                <div class="box-info">
                    <picture>
                        <source srcset="{{ asset('assets/frontend/images/potrebujete_poradit2x.png') }} 2x" />
                        <img class="box-info__img" src="{{ asset('assets/frontend/images/potrebujete_poradit.png') }}" alt="{{ 'Potřebujete poradit?'|trans }}">
                    </picture>
                    <div class="box-info__content">
                        <div class="box-info__text">
                            <h2 class="box-info__title">{{ 'Potřebujete poradit?'|trans }}</h2>
                            <span class="box-info__hours">{{ 'Po-Pá 8-19h  |  So-Ne 8-16h'|trans }}</span>
                        </div>
                        <div class="box-info__contacts">
                            <a href="tel:257 893 893" class="box-info__contacts__link">
                                <i class="box-info__contacts__icon box-info__contacts__icon--phone svg svg-phone"></i>
                                <span class="box-info__contacts__text">{{ '257 893 893'|trans }}</span>
                            </a>
                            <a href="mailto:info@sconto.cz" class="box-info__contacts__link">
                                <i class="box-info__contacts__icon svg svg-email"></i>
                                <span class="box-info__contacts__text">{{ 'info@sconto.cz'|trans }}</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}
    <div class="web__line web__line--grey web__line--grey-bottom-border clearfix dont-print">
        <div class="web__container footer__wrap">
            <div class="footer__block">
                <div class="footer__block__contact">
                     <div class="footer__block__menu__item padding-0">
                        <img class="footer__block__img footer__block__img--logo" loading="lazy" data-src="{{ asset('assets/frontend/images/logo_footer.svg') }}" alt="{{ 'SCONTO'|trans }}">
                        <p class="footer__block__paragraph">{{ 'SCONTO Nábytek s.r.o. je součástí německého<br>koncernu Höffner, který patří k největším<br>producentům nábytku v Evropě již od roku 1990.'|trans|raw }}</p>
                        <div class="footer__block__langs">
                            <a href="#" class="footer__block__langs__link no-hover-decoration js-not-implemented-yet">
                                <img class="footer__block__img footer__block__img--lang" loading="lazy" data-src="{{ asset('assets/frontend/images/flags/cz.svg') }}" alt="{{ 'Česká republika'|trans }}">
                                <span class="footer__block__label">{{ 'Česká republika'|trans }}</span>
                            </a>
                            <a href="#" class="footer__block__langs__link no-hover-decoration js-not-implemented-yet">
                                <img class="footer__block__img footer__block__img--lang" loading="lazy" data-src="{{ asset('assets/frontend/images/flags/sk.svg') }}" alt="{{ 'Slovensko'|trans }}">
                                <span class="footer__block__label">{{ 'Slovensko'|trans }}</span>
                            </a>
                        </div>
                        <h2 class="footer__block__heading footer__block__heading--inline-xs">{{ 'Sledujte nás'|trans }}</h2>
                        <a class="no-hover-decoration js-not-implemented-yet" href="https://www.facebook.com/scontonabytekcz/" target="_blank">
                            <img class="footer__block__img footer__block__img--social" loading="lazy" data-src="{{ asset('assets/frontend/images/social/facebook.svg') }}" alt="{{ 'Facebook'|trans }}">
                        </a>
                        <a class="no-hover-decoration js-not-implemented-yet" href="https://www.instagram.com/sconto_nabytek/" target="_blank">
                            <img class="footer__block__img footer__block__img--social" loading="lazy" data-src="{{ asset('assets/frontend/images/social/instagram.svg') }}" alt="{{ 'Instagram'|trans }}">
                        </a>
                    </div>
                </div>
                <div class="footer__block__menu">
                    <div class="footer__block__menu__item">
                        {{ render(controller('App\\Controller\\Front\\ArticleController:footerAction', {'id': 1, 'title': 'O Scontu'|trans, 'icon': 'svg-arrow'})) }}
                    </div>
                    <div class="footer__block__menu__item">
                        {{ render(controller('App\\Controller\\Front\\ArticleController:footerAction', {'id': 2, 'title': 'O nákupu'|trans, 'icon': 'svg-arrow'})) }}
                    </div>
                    <div class="footer__block__menu__item">
                        {{ render(controller('App\\Controller\\Front\\ArticleController:footerAction', {'id': 3, 'title': 'E-shop'|trans, 'icon': 'svg-arrow'})) }}
                        <h2 class="footer__block__heading footer__block__heading--inner footer__block__heading--toggle js-responsive-toggle footer__block__list--top-spacing" data-element="js-footer-menu-5">
                            {{ 'Možnosti platby'|trans }} <i class="svg svg-arrow"></i>
                        </h2>
                        <div class="footer__block__toggle" id="js-footer-menu-5">
                            <img class="footer__block__img footer__block__img--payment" loading="lazy" data-src="{{ asset('assets/frontend/images/payments/mastercard.svg') }}" alt="{{ 'Mastercard'|trans }}">
                            <img class="footer__block__img footer__block__img--payment" loading="lazy" data-src="{{ asset('assets/frontend/images/payments/visa.svg') }}" alt="{{ 'VISA'|trans }}">
                        </div>
                    </div>
                    <div class="footer__block__menu__item margin-0">
                        {{ render(controller('App\\Controller\\Front\\ArticleController:footerAction', {'id': 4, 'title': 'Prodejny'|trans, 'icon': 'svg-arrow'})) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
