{% set shopInfoEmail = getShopInfoEmail() %}
{% set shopInfoPhoneNumber = getShopInfoPhoneNumber() %}
{% set shopInfoPhoneHours = getShopInfoPhoneHours() %}
{% set domain = getDomain() %}
{% set logoName = domain.id == 1 ? 'logo_footer' : 'logo_footer_sk' %}

<div class="footer">
    {% if getRoute() != 'front_cart' and getRoute() != 'front_order_index'  %}
        {% if showNewsletter %}
            <div class="web__line clearfix dont-print">
                <div class="web__container">
                    {% cache "newsletter_form" {lifetime:60*60*24, domainId:getDomain().id} %}
                        {{ render(controller('App\\Controller\\Front\\NewsletterController:subscriptionAction')) }}
                    {% endcache %}
                </div>
            </div>
        {% endif %}
        <div class="web__line">
            <div class="web__container">
                {% include 'Front/Content/InfoBox/infoBox.html.twig' with { 'cssClass' : null } %}
            </div>
        </div>
    {% endif %}
    {% if getRoute() != 'front_order_index' %}
        <div class="web__line web__line--grey web__line--grey-bottom-border clearfix dont-print">
            <div class="web__container footer__wrap">
                <div class="footer__block">
                    <div class="footer__block__contact">
                        <div class="footer__block__menu__item padding-0">
                            <img
                                class="footer__block__img footer__block__img--logo"
                                loading="lazy"
                                data-src="{{ asset("public/frontend/images/#{logoName}.svg") }}"
                                alt="{{ 'SCONTO'|trans }}"
                            >
                            <p class="footer__block__paragraph">{{ 'SCONTO Nábytek s.r.o. je součástí německého<br>koncernu Höffner, který patří k největším<br>producentům nábytku v Evropě již od roku 1990.'|trans|raw }}</p>
                            <div class="footer__block__langs">
                                <a href="#" class="footer__block__langs__link no-hover-decoration js-not-implemented-yet">
                                    <img class="footer__block__img footer__block__img--lang" loading="lazy" data-src="{{ asset('public/frontend/images/flags/cz.svg') }}" alt="{{ 'Česká republika'|trans }}">
                                    <span class="footer__block__label">{{ 'Česká republika'|trans }}</span>
                                </a>
                                <a href="#" class="footer__block__langs__link no-hover-decoration js-not-implemented-yet">
                                    <img class="footer__block__img footer__block__img--lang" loading="lazy" data-src="{{ asset('public/frontend/images/flags/sk.svg') }}" alt="{{ 'Slovensko'|trans }}">
                                    <span class="footer__block__label">{{ 'Slovensko'|trans }}</span>
                                </a>
                            </div>
                            <h2 class="footer__block__heading footer__block__heading--inline-xs">{{ 'Sledujte nás'|trans }}</h2>
                            <a class="no-hover-decoration js-not-implemented-yet" href="https://www.facebook.com/scontonabytekcz/" target="_blank">
                                <img class="footer__block__img footer__block__img--social" loading="lazy" data-src="{{ asset('public/frontend/images/social/facebook.svg') }}" alt="{{ 'Facebook'|trans }}">
                            </a>
                            <a class="no-hover-decoration js-not-implemented-yet" href="https://www.instagram.com/sconto_nabytek/" target="_blank">
                                <img class="footer__block__img footer__block__img--social" loading="lazy" data-src="{{ asset('public/frontend/images/social/instagram.svg') }}" alt="{{ 'Instagram'|trans }}">
                            </a>
                        </div>
                    </div>
                    <div class="footer__block__menu">
                        <div class="footer__block__menu__item">
                            {% cache constant('App\\Model\\Article\\Article::PLACEMENT_FOOTER_1') {lifetime:60*60*24, domainId:getDomain().id} %}
                                {{ render(controller('App\\Controller\\Front\\ArticleController:footerAction', {'id': 1, 'title': 'O Scontu'|trans, 'icon': 'svg-arrow'})) }}
                            {% endcache %}
                        </div>
                        <div class="footer__block__menu__item">
                            {% cache constant('App\\Model\\Article\\Article::PLACEMENT_FOOTER_2') {lifetime:60*60*24, domainId:getDomain().id} %}
                                {{ render(controller('App\\Controller\\Front\\ArticleController:footerAction', {'id': 2, 'title': 'O nákupu'|trans, 'icon': 'svg-arrow'})) }}
                            {% endcache %}
                        </div>
                        <div class="footer__block__menu__item">
                            {% cache constant('App\\Model\\Article\\Article::PLACEMENT_FOOTER_3') {lifetime:60*60*24, domainId:getDomain().id} %}
                                {{ render(controller('App\\Controller\\Front\\ArticleController:footerAction', {'id': 3, 'title': 'E-shop'|trans, 'icon': 'svg-arrow'})) }}
                            {% endcache %}
                            <h2 class="footer__block__heading footer__block__heading--inner footer__block__heading--toggle js-responsive-toggle footer__block__list--top-spacing" data-element="js-footer-menu-5">
                                {{ 'Možnosti platby'|trans }} <i class="svg svg-arrow"></i>
                            </h2>
                            <div class="footer__block__toggle" id="js-footer-menu-5">
                                <img class="footer__block__img footer__block__img--payment" loading="lazy" data-src="{{ asset('public/frontend/images/payments/mastercard.svg') }}" alt="{{ 'Mastercard'|trans }}">
                                <img class="footer__block__img footer__block__img--payment" loading="lazy" data-src="{{ asset('public/frontend/images/payments/visa.svg') }}" alt="{{ 'VISA'|trans }}">
                            </div>
                        </div>
                        <div class="footer__block__menu__item margin-0">
                            {% cache constant('App\\Model\\Article\\Article::PLACEMENT_FOOTER_4') {lifetime:60*60*24, domainId:getDomain().id} %}
                                {{ render(controller('App\\Controller\\Front\\ArticleController:footerAction', {'id': 4, 'title': 'Prodejny'|trans, 'icon': 'svg-arrow'})) }}
                            {% endcache %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}
    {% include 'Front/Layout/copyright.html.twig' with { 'cssClass' : '' } %}
</div>

