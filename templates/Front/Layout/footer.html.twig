{% set shopInfoEmail = getShopInfoEmail() %}
{% set shopInfoPhoneNumber = getShopInfoPhoneNumber() %}
{% set shopInfoPhoneHours = getShopInfoPhoneHours() %}
{% set domain = getDomain() %}

<footer class="footer">
    {% if getRoute() not in ['front_cart', 'front_order_step_transport_payment', 'front_order_step_personal_info', 'front_order_not_paid'] %}
        {% if showNewsletter %}
            <div class="web__line web__line--colored">
                <div class="web__container web__container--lines">
                    {% cache "newsletter_form" {lifetime:getCacheLifetimeByHours(24), domainId:getDomain().id} %}
                        {{ render(controller('App\\Controller\\Front\\NewsletterController:subscriptionAction'))|spaceless }}
                    {% endcache %}
                </div>
            </div>
        {% endif %}
    {% endif %}

    <div class="web__line web__line--dark">
        <div class="web__container">
            <div class="footer__bottom">
                {% if getRoute() not in ['front_cart', 'front_order_step_transport_payment', 'front_order_step_personal_info', 'front_order_not_paid'] %}
                    {% include 'Front/Content/InfoBox/infoBox.html.twig' %}
                {% endif %}

                {% if getRoute() not in ['front_cart', 'front_order_step_transport_payment', 'front_order_step_personal_info', 'front_order_not_paid'] %}
                    <div class="footer__block">
                        {% cache constant('App\\Controller\\Front\\ArticleController::FOOTER_MENU_TWIG_CACHE_KEY') {lifetime:getCacheLifetimeByHours(24), domainId:getDomain().id} %}
                            {{ render(controller('App\\Controller\\Front\\ArticleController:footerMenuAction'))|spaceless }}
                        {% endcache %}

                        <div class="footer__block__contact">
                            <h4 class="footer__block__heading footer__block__heading--socials">
                                {{ 'Sledujte nás'|trans }}
                            </h4>

                            <div class="footer__block__socials">
                                <a class="footer__block__socials__item" href="https://www.instagram.com/shopsyscz/" target="_blank">
                                    <img
                                        loading="lazy"
                                        src="{{ imgLazyloadPlaceholder }}"
                                        data-src="{{ asset('public/frontend/images/instagram.svg') }}"
                                        alt="{{ 'Instagram'|trans }}"
                                    >
                                </a>
                                <a class="footer__block__socials__item" href="https://www.facebook.com/shopsyscz/" target="_blank">
                                    <img
                                        loading="lazy"
                                        src="{{ imgLazyloadPlaceholder }}"
                                        data-src="{{ asset('public/frontend/images/facebook.svg') }}"
                                        alt="{{ 'Facebook'|trans }}"
                                    >
                                </a>
                                <a class="footer__block__socials__item" href="https://www.youtube.com/user/netdevelo" target="_blank">
                                    <img
                                        loading="lazy"
                                        src="{{ imgLazyloadPlaceholder }}"
                                        data-src="{{ asset('public/frontend/images/youtube.svg') }}"
                                        alt="{{ 'Youtube'|trans }}"
                                    >
                                </a>
                            </div>

                            <div class="footer__block__langs">
                                <a
                                    href="{{ domain.id == 1 ? '/' : 'https://www.shopsys.cz/' }}"
                                    class="footer__block__langs__link"
                                    {% if domain.id == 2 %}target="_blank"{% endif %}
                                >
                                    <img
                                        loading="lazy"
                                        src="{{ imgLazyloadPlaceholder }}"
                                        data-src="{{ asset('public/frontend/images/cz.svg') }}"
                                        alt="{{ 'Česko'|trans }}"
                                    >
                                    <span class="footer__block__langs__text">{{ 'Česko'|trans }}</span>
                                </a>
                                <a
                                    href="{{ domain.id ==  2 ? '/' : 'https://www.shopsys.sk/' }}"
                                    class="footer__block__langs__link"
                                    {% if domain.id == 1 %}target="_blank"{% endif %}
                                >
                                    <img
                                        loading="lazy"
                                        src="{{ imgLazyloadPlaceholder }}"
                                        data-src="{{ asset('public/frontend/images/sk.svg') }}"
                                        alt="{{ 'Slovensko'|trans }}"
                                    >
                                    <span class="footer__block__langs__text">{{ 'Slovensko'|trans }}</span>
                                </a>
                            </div>
                        </div>
                    </div>
                {% endif %}
                {% include 'Front/Layout/copyright.html.twig' %}
            </div>
        </div>
    </div>
</footer>
