{% if not maxStockAmountAlreadyReached %}
    {{ render(controller('App\\Controller\\Front\\GtmController:pushesAction')) }}

    {% import 'Front/Inline/Product/productFlagAsteriskMacro.html.twig' as asterisk %}
    <div>
        <h2 class="window-popup__heading window-popup__heading--cart">
            <svg class="window-popup__checkmark" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 52 52">
                <circle class="window-popup__checkmark__circle" cx="26" cy="26" r="25" fill="none"/>
                <path class="window-popup__checkmark__check" fill="none" d="M14.1 27.2l7.1 7.2 16.7-16.8"/>
            </svg>
            {{ 'Skvělá volba! Vaše zboží jsme přidali do košíku'|trans }}
        </h2>
        {% if isAddedQuantityOverLimit %}
            {{ 'Přidali jste velké množství zboží. Limit je %quantity% ks, proto budete mít speciální typ objednávky'|trans({'%quantity%': overLimitQuantity}) }}
        {% endif %}
        <div class="window-popup__cart">
            <div class="window-popup__cart__img">
                {% if imageExists(product) %}
                    {{ image(product, {size: 'modal', lazy: false}) }}
                {% else %}
                    {{ noimage({size: 'galleryThumbnail', alt: product.fullname}) }}
                {% endif %}
            </div>
            <div class="window-popup__cart__content">
                <div class="window-popup__cart__content__info">
                    <strong class="window-popup__cart__content__name">
                        <span class="window-popup__cart__content__name__prefix">
                            {{
                                '%quantity%x - %productNamePrefix%'|trans({'%quantity%': addedQuantity,
                                '%productNamePrefix%': product.nameFirstLine})
                            }}
                        </span>
                        {{ product.nameSecondLine }}
                    </strong>
                    <span class="window-popup__cart__content__catnum">{{ product.catnum }}</span>
                </div>
                {% set sellingPriceWithVat = getProductSellingPrice(product).priceWithVat %}
                {% set nonSellingPriceWithVat = getProductNonSellingPrice(product).priceWithVat %}
                <div class="window-popup__cart__content__prices">
                    {% if nonSellingPriceWithVat.isGreaterThan(sellingPriceWithVat) %}
                        <span class="window-popup__cart__content__price window-popup__cart__content__price--legacy">
                            {{ nonSellingPriceWithVat.multiply(addedQuantity)|price }}
                            {{ asterisk.nonSellingPrice(product.getFlagsForDomain(domain.id)) }}
                        </span>
                    {% endif %}
                    <strong class="window-popup__cart__content__price window-popup__cart__content__price--main">
                        {{ sellingPriceWithVat.multiply(addedQuantity)|price }}
                        {{ asterisk.sellingPrice(product.getFlagsForDomain(domain.id)) }}
                    </strong>
                </div>
            </div>
        </div>
    </div>
{% else %}
    {{ render(controller('App\\Controller\\Front\\FlashMessageController:indexAction')) }}
{% endif %}

<span class="js-add-product-url-cart" data-url="{{ url('front_cart') }}"></span>

{% import 'Front/Content/Product/productListMacro.html.twig' as productList %}

{% if isModuleEnabled(constant('Shopsys\\FrameworkBundle\\Model\\Module\\ModuleList::ACCESSORIES_ON_BUY')) %}
    {% if accessories|length > 0 %}
        <div class="wrap-box margin-top-20 margin-bottom-0">
            <h3 class="wrap-box__title">
                {{ 'Our customers who bought this bought also'|trans }}
            </h3>
            <div class="wrap-box__in">
                {{ productList.list(accessories, 'list-products--in-window') }}
            </div>
        </div>
        <span class="js-add-product-wide-window" data-wide="true"></span>
    {% endif %}
{% endif %}
