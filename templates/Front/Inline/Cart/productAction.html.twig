{% set buttonSizeClass = (type == 'large' ? ' btn--larger ' : ' ') %}

{% if productActionView.mainVariant %}
    <a href="{{ productActionView.detailUrl }}" class="btn btn--success {{ buttonSizeClass }}">
        {{- 'Choose variant'|trans -}}
    </a>
{% elseif productActionView.sellingDenied %}
    <a href="{{ productActionView.detailUrl }}" class="btn {{ buttonSizeClass }}">
        {{- 'Product no longer on sale'|trans -}}
    </a>
{% else %}
    {{ form_start(form, {attr: {class: 'js-add-product dont-print', 'data-ajax-url': url('front_cart_add_product_ajax'), 'multipleForm': true}}) }}
    <span class="form-input-spinbox js-spinbox {% if productAvailable == false %}disabled{% endif %}">
        {{ form_widget(form.quantity, { attr: { class: 'form-input-spinbox__input input-no-style js-spinbox-input', 'data-spinbox-min': 1, 'data-spinbox-max': productActionView.stockQuantity}}) }}
        <button type="button" class="btn-no-style form-input-spinbox__btn js-spinbox-plus">+</button>
        <button type="button" class="btn-no-style form-input-spinbox__btn form-input-spinbox__btn--minus js-spinbox-minus">-</button>
    </span>
    {{ form_widget(form.add, {label: 'Přidat do košíku'|trans, attr: { class: 'btn--success btn--success--cart btn--success--cart--small' ~ buttonSizeClass }}) }}
    {{ form_end(form) }}
{% endif %}
