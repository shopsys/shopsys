{% set isLarge = false %}
{% if type is defined and type == 'large' %}
    {% set isLarge = true %}
{% endif %}

{% if productActionView.mainVariant %}
    <a href="{{ productActionView.detailUrl }}" class="btn">
        {{- 'Choose variant'|trans -}}
    </a>
{% elseif productActionView.sellingDenied %}
    <a href="{{ productActionView.detailUrl }}" class="btn">
        {{- 'Product no longer on sale'|trans -}}
    </a>
{% else %}
    {{ form_start(form, {attr: {class: 'js-add-product dont-print', 'data-ajax-url': url('front_cart_add_product_ajax'), 'multipleForm': true}}) }}
    <div class="in-add-to-cart{% if isLarge %} in-add-to-cart--large{% endif %}">
        <span class="form-input-spinbox{% if not isLarge %} form-input-spinbox--small{% endif %} js-spinbox {% if productActionView.isProductAvailable == false %}disabled{% endif %}">
            <button type="button" class="btn-no-style form-input-spinbox__btn js-spinbox-minus">
                <i class="svg svg-minus"></i>
            </button>
            {{ form_widget(form.quantity, { attr: { class: 'form-input-spinbox__input input-no-style js-spinbox-input', 'data-spinbox-min': 1, 'data-spinbox-max': availableAddQuantity}}) }}
            <button type="button" class="btn-no-style form-input-spinbox__btn js-spinbox-plus">
                <i class="svg svg-plus"></i>
            </button>
        </span>
        <div class="in-add-to-cart__spinbox">
            {% set buttonClass = 'btn btn--small' %}
            {% if isLarge %}
                {% set buttonClass = 'btn btn--primary btn--big-radius full-width' %}
            {% endif %}

            {% if productActionView.isProductAvailable == true %}
                {{ form_widget(form.add, { label: 'Do košíku'|trans, attr: { class: buttonClass }} )}}
            {% else %}
                {{ form_widget(form.add, { label: 'Temporarily sold out'|trans, disabled: 'disabled'} )}}
            {% endif %}
        </div>
    </div>
    {{ form_end(form) }}
{% endif %}
