{{ form_start(form, {attr: {class: 'js-add-product dont-print', 'data-ajax-url': url('front_cart_add_product_ajax'), 'multipleForm': true}}) }}
    <span class="form-input-spinbox js-spinbox {% if productAvailable == false %}disabled{% endif %}">
        {{ form_widget(form.quantity, { attr: { class: 'form-input-spinbox__input input-no-style js-spinbox-input', 'data-spinbox-min': 1}}) }}
        <button type="button" class="btn-no-style form-input-spinbox__btn js-spinbox-plus">+</button>
        <button type="button" class="btn-no-style form-input-spinbox__btn form-input-spinbox__btn--minus js-spinbox-minus">-</button>
    </span>
    {% if type == 'large' %}
        {% if productAvailable == true %}
            {{ form_widget(form.add, {label: 'Add to cart'|trans, attr: {class: 'btn--success btn--large'}}) }}
        {% else %}
            {{ form_widget(form.add, {label: 'Temporarily sold out'|trans, attr: {class: 'btn--disabled btn--large'}, disabled: 'disabled'}) }}
        {% endif %}
    {% else %}
        {% if productAvailable == true %}
            {{ form_widget(form.add, {label: 'Add to cart'|trans, attr: {class: 'btn--success'}}) }}
        {% else %}
            {{ form_widget(form.add, {label: 'Temporarily sold out'|trans, attr: {class: 'btn--disabled'}, disabled: 'disabled'}) }}
        {% endif %}
    {% endif %}
{{ form_end(form) }}
