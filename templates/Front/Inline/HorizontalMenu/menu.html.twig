<ul class="menu-horizontal js-menuHorizontal dont-print" data-hovered="false">
	{% for itemDetail in itemDetails %}
		{% set hasChildren = itemDetail.categoryDetailsByColumnNumber is not empty %}
		
		<li class="menu-horizontal__item js-menu-horizontal-item">
			{% if itemDetail.horizontalMenuItem.url %}
				<a href="{{ itemDetail.horizontalMenuItem.url }}" class="menu-horizontal__item__link">
					{{ itemDetail.horizontalMenuItem.name }}
					{% if hasChildren %}
						<i class="menu-horizontal__item__arrow svg svg-arrow"></i>
					{% endif %}
				</a>
			{% else %}
				<span class="menu-horizontal__item__link">
					{{ itemDetail.horizontalMenuItem.name }}
				</span>
			{% endif %}
			{% if hasChildren %}
				<div class="menu-horizontal__sub js-menu-horizontal-item-content">
					<ul class="menu-horizontal__sub__list js-menu-horizontal-sub-columns">
						{% for categories in itemDetail.categoryDetailsByColumnNumber %}
							<li class="menu-horizontal__sub__list__item js-menu-horizontal-item-container">
								<ul class="js-menu-horizontal-items">
									{% for category in categories %}
										<li>
											<a href="{{ url('front_product_list', { id: category.id }) }}" class="menu-horizontal__sub__columns__column__title">
												<div class="menu-horizontal__sub__columns__column__image">
													{{ image(category) }}
												</div>
												<span class="menu-horizontal__sub__columns__column__title">
													{{ category.name }}
												</span>
											</a>
											{% set subCategories = getCategoriesLookingLikeChildren(category) %}
											{% if subCategories|length > 0 %}
												<ul class="menu-horizontal__sub__columns__children js-menu-horizontal-ul js-menu-horizontal-items">
													{% for childCategory in subCategories %}
														<li class="menu-horizontal__sub__columns__children__item">
															<a class="menu-horizontal__sub__columns__children__item__link" href="{{ url('front_product_list', { id: childCategory.id }) }}">
																<span>{{ childCategory.name }}</span>
															</a>
														</li>
													{% endfor %}
												</ul>
											{% endif %}
										</li>
									{% endfor %}
								</ul>
							</li>
						{% endfor %}
					</ul>
				</div>
			{% endif %}
		</li>
	{% endfor %}
	{% if saleCategory is not null %}
		<li class="menu-horizontal__item menu-horizontal__item--sale">
			<a
				href="{{ url('front_product_list', { id: saleCategory.id }) }}"
				class="menu-horizontal__item__link menu-horizontal__item__link--sale">
				<span class="menu-horizontal__item__link__text">{{ "Výprodej"|trans }}</span>
			</a>
		</li>
	{% endif %}
	<li class="menu-horizontal__item menu-horizontal__item--blog">
		<a
			href="{{ url('front_blogcategory_detail', { id: constant('App\\Model\\Blog\\Category\\BlogCategory::BLOG_MAIN_PAGE_CATEGORY_ID')}) }}"
			class="menu-horizontal__item__link menu-horizontal__item__link--blog">
			{{ "Magazín"|trans }}
		</a>
	</li>
</ul>
