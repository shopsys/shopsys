<div class="web__line">
    <div class="web__container">
        <ul class="box-progress">
            <li class="box-progress__item{% if step == 1 %} box-progress__item--active{% endif %}">
                {% if step == 1 %}
                    <span class="box-progress__item__title">1. {{ 'Nákupní košík'|trans }}</span>
                {% else %}
                    <a
                        class="box-progress__item__title"
                        href="{{ url('front_cart') }}"
                    >
                        {{ 'Nákupní košík'|trans }}
                    </a>
                {% endif %}
            </li>

            <li class="box-progress__item{% if step == 2 %} box-progress__item--active{% endif %}">
                {% if step == 3 %}
                    <a
                        class="box-progress__item__title"
                        href="{{ url('front_order_step_transport_payment') }}"
                    >
                        2. {{ 'Shipping and payment'|trans }}
                    </a>
                {% else %}
                    <span class="box-progress__item__title">2. {{ 'Shipping and payment'|trans }}</span>
                {% endif %}
            </li>

            <li class="box-progress__item{% if step == 3 %} box-progress__item--active{% endif %}">
                <span class="box-progress__item__title">3. {{ 'Dodací údaje'|trans }}</span>
            </li>
        </ul>
    </div>
</div>
