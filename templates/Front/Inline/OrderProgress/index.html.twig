<div class="web__line">
    <div class="web__container">
        <ul class="box-progress">
            <li class="box-progress__item{% if step == 1 %} box-progress__item--active{% endif %}">
                {% if step == 1 %}
                    <span class="box-progress__item__title">1.&nbsp;{{ 'Nákupní<br> košík'|trans|raw }}</span>
                {% else %}
                    <a
                        class="box-progress__item__title"
                        href="{{ url('front_cart') }}"
                    >
                        1.&nbsp;{{ 'Nákupní<br> košík'|trans|raw }}
                    </a>
                {% endif %}
            </li>

            <li class="box-progress__item{% if step == 2 %} box-progress__item--active{% endif %}">
                {% if step == 3 %}
                    <a
                        class="box-progress__item__title"
                        href="{{ url('front_order_step_transport_payment') }}"
                    >
                        2.&nbsp;{{ 'Shipping<br> and payment'|trans|raw }}
                    </a>
                {% else %}
                    <span class="box-progress__item__title">2.&nbsp;{{ 'Shipping<br> and payment'|trans|raw }}</span>
                {% endif %}
            </li>

            <li class="box-progress__item{% if step == 3 %} box-progress__item--active{% endif %}">
                <span class="box-progress__item__title">3.&nbsp;{{ 'Dodací<br> údaje'|trans|raw }}</span>
            </li>
        </ul>
    </div>
</div>
