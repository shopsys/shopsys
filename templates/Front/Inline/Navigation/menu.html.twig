<ul class="navigation dont-print" data-hovered="false">
	{% for itemDetail in itemDetails %}
		{% set hasChildren = itemDetail.categoryDetailsByColumnNumber is not empty %}

		<li class="navigation__item js-hover-intent" data-hover-intent-interval="50">
			{% if itemDetail.navigationItem.url %}
				<a href="{{ itemDetail.navigationItem.url }}" class="navigation__item__link">
					{{ itemDetail.navigationItem.name }}
					{% if hasChildren %}
						<i class="navigation__item__arrow svg svg-arrow"></i>
					{% endif %}
				</a>
			{% else %}
				<span class="navigation__item__link">
					{{ itemDetail.navigationItem.name }}
				</span>
			{% endif %}
			{% if hasChildren %}
				<div class="navigation__sub">
					<ul class="navigation__sub__list">
						{% for categories in itemDetail.categoryDetailsByColumnNumber %}
							{% for category in categories %}
								<li class="navigation__sub__list__item">
									<a class="navigation__sub__list__item__image" href="{{ url('front_product_list', { id: category.id }) }}">
										{{ image(category) }}
									</a>
									<a class="navigation__sub__list__item__link" href="{{ url('front_product_list', { id: category.id }) }}">
										{{ category.name }}
									</a>
									{% set subCategories = getCategoriesLookingLikeChildren(category) %}
									{% if subCategories|length > 0 %}
										<ul class="navigation__sub__list navigation__sub__list--children">
											{% for childCategory in subCategories %}
												<li class="navigation__sub__list__item">
													<a class="navigation__sub__list__item__link" href="{{ url('front_product_list', { id: childCategory.id }) }}">
														{{ childCategory.name }}
													</a>
												</li>
											{% endfor %}
										</ul>
									{% endif %}
								</li>
							{% endfor %}
						{% endfor %}
					</ul>
				</div>
			{% endif %}
		</li>
	{% endfor %}
	{% if saleCategory is not null %}
		<li class="navigation__item js-hover-intent" data-hover-intent-interval="50">
			<a class="navigation__item__link" href="{{ url('front_product_list', { id: saleCategory.id }) }}">
				<span class="navigation__item__link__text">{{ "Výprodej"|trans }}</span>
			</a>
		</li>
	{% endif %}
	<li class="navigation__item navigation__item--blog js-hover-intent" data-hover-intent-interval="50">
		<a
			href="{{ url('front_blogcategory_detail', { id: constant('App\\Model\\Blog\\Category\\BlogCategory::BLOG_MAIN_PAGE_CATEGORY_ID')}) }}"
			class="navigation__item__link navigation__item__link--blog">
			{{ "Magazín"|trans }}
		</a>
	</li>
</ul>
