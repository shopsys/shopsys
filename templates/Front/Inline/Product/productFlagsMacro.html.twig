{% macro list(flags, classAddition) %}

    {% if flags %}
        <div class="in-flag dont-print {{ classAddition }}">
            {% for productFlag in flags %}
                {% if productFlag.visible %}
                    <span class="in-flag__item {{ productFlag.akeneoCode }}">
                        <span class="in-flag__item__name">
                            {{ productFlag.name }}
                        </span>
                    </span>
                {% endif %}
            {% endfor %}
        </div>
    {% endif %}

{% endmacro %}
