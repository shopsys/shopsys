{% macro list(flags, classAddition) %}

    {% if flags %}
        <div class="in-flag dont-print {{ classAddition }}">
            {% for productFlag in flags %}
                {% if productFlag.visible %}
                    <span class="in-flag__item" style="background-color: {{ productFlag.rgbColor }};">
                        {{ productFlag.name }}
                    </span>
                {% endif %}
            {% endfor %}
        </div>
    {% endif %}

{% endmacro %}
