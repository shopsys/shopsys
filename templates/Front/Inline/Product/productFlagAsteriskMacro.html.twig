{% macro sellingPrice(flags) %}

    {% set break = false %}
    {% for productFlag in flags if not break %}
        {% if productFlag.noticeLowPrice %}
            {{ productFlag.noticeLowPrice }}
            {% set break = true %}
        {% endif %}
    {% endfor %}

{% endmacro %}

{% macro nonSellingPrice(flags) %}

    {% set break = false %}
    {% for productFlag in flags if not break %}
        {% if productFlag.noticeHighPrice %}
            {{ productFlag.noticeHighPrice }}
            {% set break = true %}
        {% endif %}
    {% endfor %}

{% endmacro %}
