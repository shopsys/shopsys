{% macro paginatorNavigation(paginationResult, entityName, pageQueryParameter = 'page') %}
    <div class="in-paging">
        {% set route = getRoute() %}
        {% set routeParams = getAllRequestParams() %}
        {% set pageCount = paginationResult.pageCount %}
        {% set lastButOne = '' %}
        {% if paginationResult.page == pageCount %}
            {% set lastButOne = 'in-paging__control__item--show-everytime' %}
        {% endif %}

        <div class="in-paging__control">
            {% if pageCount > 1 %}
                {% if paginationResult.page > 1 %}
                    {% set page = paginationResult.page - 1 %}
                    {% if page == 1 %}
                        {% set page = null %}
                    {% endif %}
                    {% set routeParams = routeParams|merge({(pageQueryParameter): page}) %}
                    <a class="in-paging__control__item in-paging__control__item--prev" href="{{ path(route, routeParams) }}" rel ="prev">
                        <i class="svg svg-arrow"></i>
                    </a>

                    {% set routeParams = routeParams|merge({(pageQueryParameter): null}) %}
                    {% if paginationResult.page == 2 %}
                        <a class="in-paging__control__item {{ lastButOne }}" href="{{ path(route, routeParams) }}" rel="prev">1</a>
                    {% else %}
                        <a class="in-paging__control__item" href="{{ path(route, routeParams) }}">1</a>
                    {% endif %}
                {% else %}
                    <span class="in-paging__control__item in-paging__control__item--prev in-paging__control__item--inactive">
                        <i class="svg svg-arrow"></i>
                    </span>
                {% endif %}

                {% set pagerExpand = 2 %}

                {% if paginationResult.page > pagerExpand + 2 %}
                    <span class="in-paging__control__item in-paging__control__item--separate">
                        <span class="in-paging__control__item__separate">...</span>
                    </span>
                {% endif %}

                {% for page in (paginationResult.page - pagerExpand)..(paginationResult.page) if page > 1 and page < paginationResult.page %}
                    {% set routeParams = routeParams|merge({(pageQueryParameter): page}) %}
                    {% if page == (paginationResult.page - 1) %}
                        <a class='in-paging__control__item {{ lastButOne }}' href="{{ path(route, routeParams) }}" rel="prev">{{ page }}</a>
                    {% else %}
                        <a class='in-paging__control__item' href="{{ path(route, routeParams) }}">{{ page }}</a>
                    {% endif %}
                {% endfor %}

                <span class="in-paging__control__item in-paging__control__item--active">{{ paginationResult.page }}</span>

                {% for page in (paginationResult.page + 1)..(paginationResult.page + pagerExpand) if page > paginationResult.page and page < pageCount %}
                    {% set routeParams = routeParams|merge({(pageQueryParameter): page}) %}
                    {% if page == (paginationResult.page + 1) %}
                        <a class="in-paging__control__item" href="{{ path(route, routeParams) }}" rel="next">{{ page }}</a>
                    {% else %}
                        <a class="in-paging__control__item" href="{{ path(route, routeParams) }}">{{ page }}</a>
                    {% endif %}
                {% endfor %}

                {% if paginationResult.page <= pageCount - pagerExpand - 2 %}
                    <span class="in-paging__control__item in-paging__control__item--separate">
                        <span class="in-paging__control__item__separate">...</span>
                    </span>
                {% endif %}

                {% if paginationResult.page < pageCount %}
                    {% set routeParams = routeParams|merge({(pageQueryParameter): pageCount}) %}
                    {% if paginationResult.page == (pageCount - 1) %}
                        <a class="in-paging__control__item" href="{{ path(route, routeParams) }}" rel="next">{{ pageCount }}</a>
                    {% else %}
                        <a class="in-paging__control__item" href="{{ path(route, routeParams) }}">{{ pageCount }}</a>
                    {% endif %}

                    {% set routeParams = routeParams|merge({(pageQueryParameter): paginationResult.page + 1}) %}
                    <a class="in-paging__control__item in-paging__control__item in-paging__control__item--next" href="{{ path(route, routeParams) }}" rel="next">
                        <i class="svg svg-arrow"></i>
                    </a>
                {% else %}
                    <span class="in-paging__control__item in-paging__control__item--next in-paging__control__item--inactive">
                        <i class="svg svg-arrow"></i>
                    </span>
                {% endif %}
            {% endif %}
        </div>
    </div>
{% endmacro %}

{% macro metaRobots(paginationResult, disableIndexingBySeznamBot) %}
    {% if paginationResult.page != 1 and disableIndexingBySeznamBot %}
        <meta name="robots" content="noindex, follow">
    {% elseif paginationResult.page != 1 %}
        <meta name="robots" content="index, follow">
    {% endif %}
{% endmacro %}

{% macro loadMoreButton(paginationResult, url = '', pageQueryParameter = 'page') %}
    <input type="button" class="btn js-load-more-button btn"
           data-page="{{ paginationResult.page }}"
           data-page-size="{{ paginationResult.pageSize }}"
           data-pagination-to-item="{{ paginationResult.toItem }}"
           data-total-count="{{ paginationResult.totalCount }}"
           data-url="{{ url }}"
           data-page-query-parameter="{{ pageQueryParameter }}"
           value="{{ 'Načíst další'|trans }}"
    />
{% endmacro %}
