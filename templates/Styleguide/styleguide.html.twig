{% extends 'Front/Layout/base.html.twig' %}

{% block title %}Shopsys Framework styleguide{% endblock %}

{% block pageStyles %}
    {{ encore_entry_link_tags('styleguide-style') }}
    {{ parent() }}
{% endblock %}

{% block html_body %}
    <main class="container">
        <header class="styleguide-header">
            <div class="styleguide-header__welcome left"> Styleguide</div>
            <nav class="styleguide-header__breakpoints float-right">
                <ul class="styleguide-list--unstyled styleguide-list--float">
                    <li class="styleguide-header__breakpoints__item">
                        <a id="small" data-size="420px" data-size-label="small"
                           class="styleguide-header__breakpoints__item__link"><span>Small</span></a>
                    </li>
                    <li class="styleguide-header__breakpoints__item">
                        <a id="medium" data-size="720px" data-size-label="medium"
                           class="styleguide-header__breakpoints__item__link"><span>Medium</span></a>
                    </li>
                    <li class="styleguide-header__breakpoints__item">
                        <a id="large" data-size="1280px" data-size-label="large"
                           class="styleguide-header__breakpoints__item__link"><span>Large</span></a>
                    </li>
                    <li class="styleguide-header__breakpoints__item">
                        <a id="full" data-size="100%" data-size-label="full"
                           class="styleguide-header__breakpoints__item__link"><span>Full</span></a>
                    </li>
                </ul>
            </nav>
        </header>
