                    <section id="forms" class="styleguide-module anchor clearfix">
                        <h2 class="styleguide-module__title">Forms</h2>

                        <form class="snippet">
                            <fieldset>
                                <h2 class="in-title">Section title</h2>

                                <div class="form-columns">
                                    <div class="form-columns__item">
                                        <div class="form-line">
                                            <div class="form-line__input ">
                                                <input type="name" id="registration_form_name" name="registration_form[name]" required="required" placeholder="Váše jméno" class="input">
                                                <label for="registration_form_name" class="input-label required">
                                                    Jméno
                                                    <span class="form-input-required">*</span>
                                                </label>
                                            </div>
                                            <div class="form-line__error"></div>
                                        </div>
                                    </div>
                                    <div class="form-columns__item">
                                        <div class="form-line">
                                            <div class="form-line__input ">
                                                <input type="name" id="registration_form_name2" name="registration_form[name]" required="required" placeholder="Váše jméno" class="input">
                                                <label for="registration_form_name2" class="input-label required">
                                                    Jméno
                                                    <span class="form-input-required">*</span>
                                                </label>
                                            </div>
                                            <div class="form-line__error"></div>
                                        </div>
                                    </div>
                                </div>

                                <div class="form-line">
                                    <div class="form-line__input">
