{
    "name": "shopsys/category-feed-luigis-box",
    "type": "library",
    "description": "Shopsys Platform plugin interface for Luigi's Box XML category feed generation",
    "keywords": [
        "Luigis Box",
        "category feed",
        "XML feed",
        "plugin",
        "Shopsys Platform",
        "SSFW",
        "SSP"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Shopsys",
            "homepage": "https://www.shopsys.com/"
        }
    ],
    "autoload": {
        "psr-4": {
            "Shopsys\\CategoryFeed\\LuigisBoxBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\CategoryFeed\\LuigisBoxBundle\\": "tests/"
        }
    },
    "require": {
        "php": "^8.5",
        "ext-json": "*",
        "ext-pdo": "*",
        "doctrine/dbal": "^4.4",
        "doctrine/doctrine-bundle": "^3.2",
        "doctrine/orm": "^3.6",
        "doctrine/persistence": "^4.1",
        "shopsys/form-types-bundle": "19.0.0",
        "shopsys/framework": "19.0.0",
        "shopsys/migrations": "19.0.0",
        "shopsys/plugin-interface": "19.0.0",
        "symfony/config": "^7.4",
        "symfony/dependency-injection": "^7.4",
        "symfony/form": "^7.4",
        "symfony/http-kernel": "^7.4",
        "symfony/translation": "^7.4",
        "twig/twig": "^3.14.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "config": {
        "allow-plugins": {
            "symfony/flex": true
        }
    }
}
