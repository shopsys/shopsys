{
    "name": "shopsys/mcp-attributes",
    "type": "library",
    "description": "Shared MCP exposure attributes for Shopsys Platform",
    "keywords": [
        "Shopsys Platform",
        "SSFW",
        "MCP"
    ],
    "license": "proprietary",
    "authors": [
        {
            "name": "Shopsys",
            "homepage": "https://www.shopsys.com/"
        }
    ],
    "autoload": {
        "psr-4": {
            "Shopsys\\McpAttributes\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\McpAttributes\\": "tests/"
        }
    },
    "require": {
        "php": "^8.5"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1.16",
        "phpstan/phpstan-phpunit": "^2.0.6",
        "phpunit/phpunit": "^12.5",
        "shopsys/coding-standards": "dev-rc-19-0-0 as 19.0.0"
    },
    "config": {
        "allow-plugins": {
            "symfony/flex": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
