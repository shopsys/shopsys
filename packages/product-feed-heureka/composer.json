{
    "name": "shopsys/product-feed-heureka",
    "type": "library",
    "description": "Shopsys Platform plugin interface for Heureka XML product feed generation",
    "keywords": [
        "Heureka",
        "product feed",
        "XML feed",
        "plugin",
        "Shopsys Platform",
        "SSFW"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Shopsys",
            "homepage": "https://www.shopsys.com/"
        }
    ],
    "autoload": {
        "psr-4": {
            "Shopsys\\ProductFeed\\HeurekaBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\ProductFeed\\HeurekaBundle\\": "tests/"
        }
    },
    "require": {
        "php": "^8.5",
        "ext-json": "*",
        "ext-libxml": "*",
        "ext-pdo": "*",
        "ext-simplexml": "*",
        "doctrine/collections": "^2.6",
        "doctrine/dbal": "^4.4",
        "doctrine/doctrine-bundle": "^3.2",
        "doctrine/orm": "^3.6",
        "doctrine/persistence": "^4.1",
        "shopsys/form-types-bundle": "20.0.x-dev",
        "shopsys/framework": "20.0.x-dev",
        "shopsys/mcp-attributes": "20.0.x-dev",
        "shopsys/migrations": "20.0.x-dev",
        "shopsys/plugin-interface": "20.0.x-dev",
        "symfony/config": "^8.1",
        "symfony/dependency-injection": "^8.1",
        "symfony/form": "^8.1",
        "symfony/http-kernel": "^8.1",
        "symfony/service-contracts": "^3.5",
        "symfony/translation": "^8.1",
        "twig/twig": "^3.14.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "symfony/flex": true
        }
    }
}
