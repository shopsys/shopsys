{
    "name": "shopsys/article-feed-luigis-box",
    "type": "library",
    "description": "Shopsys Platform plugin interface for Luigis Box XML article feed generation",
    "keywords": [
        "Luigis Box",
        "article feed",
        "XML feed",
        "plugin",
        "Shopsys Platform",
        "SSFW",
        "SSP"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Shopsys",
            "homepage": "https://www.shopsys.com/"
        }
    ],
    "autoload": {
        "psr-4": {
            "Shopsys\\ArticleFeed\\LuigisBoxBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\ArticleFeed\\LuigisBoxBundle\\": "tests/"
        }
    },
    "require": {
        "php": "^8.5",
        "ext-json": "*",
        "ext-pdo": "*",
        "doctrine/dbal": "^4.4",
        "doctrine/doctrine-bundle": "^3.2",
        "doctrine/orm": "^3.6",
        "doctrine/persistence": "^4.1",
        "shopsys/framework": "20.0.x-dev",
        "shopsys/migrations": "20.0.x-dev",
        "symfony/config": "^8.1",
        "symfony/dependency-injection": "^8.1",
        "symfony/form": "^8.1",
        "symfony/http-kernel": "^8.1",
        "symfony/translation": "^8.1",
        "twig/twig": "^3.14.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "symfony/flex": true
        }
    }
}
