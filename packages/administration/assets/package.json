{
    "name": "@shopsys/administration",
    "description": "Shopsys Administration assets",
    "repository": "https://github.com/shopsys/shopsys",
    "author": "Shopsys",
    "license": "proprietary",
    "private": "true",
    "symfony": {
        "controllers": {
            "hello": {
                "main": "dist/hello/Controller.js",
                "fetch": "eager",
                "enabled": true
            },
            "searchMenu": {
                "main": "dist/SearchMenu/Controller.js",
                "fetch": "eager",
                "enabled": true
            }
        },
        "importmap": {
            "@hotwired/stimulus": "^3.2.2"
        }
    },
    "peerDependencies": {
        "@hotwired/stimulus": "^3.2.2"
    },
    "devDependencies": {
        "@babel/cli": "^7.23.9",
        "@babel/core": "^7.24.0",
        "@babel/plugin-transform-class-properties": "^7.23.3",
        "@babel/preset-env": "^7.24.0",
        "@babel/preset-typescript": "^7.23.3",
        "@hotwired/stimulus": "^3.2.2",
        "@symfony/stimulus-bridge": "^3.2.3",
        "typescript": "^5.7.3"
    },
    "scripts": {
        "build": "babel src --delete-dir-on-start --extensions .ts -d dist",
        "lint": "eslint src test",
        "watch": "babel src --delete-dir-on-start --extensions .ts -d dist --watch",
        "postinstall": "npm run build"
    },
    "dependencies": {
        "stimulus-use": "^0.52.3"
    }
}
