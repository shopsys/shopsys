{% set pinned = item.extra('pinned', false) %}
<button class="nav-link-pin-button btn-link ms-auto cursor-pointer text-muted"
      data-js-nav-pinned
      data-route-name="{{ item.extra('route_name') }}"
      data-pinned="{{ pinned ? 'true' : 'false' }}"
      data-title-pinned="{{ 'Unpin'|trans }}"
      data-title-unpinned="{{ 'Pin'|trans }}"
      data-toggle-url="{{ url('admin_pinnedmenuitem_toggle') }}"
      data-bs-toggle="tooltip"
      title="{{ pinned ? 'Unpin'|trans : 'Pin'|trans }}"
>
    {{ ux_icon(pinned ? 'pinned' : 'pin', {class: 'icon icon-sm'}) }}
</button>
