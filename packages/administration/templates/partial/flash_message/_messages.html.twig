{% if messages %}
    <div class="alert alert-{{ type }} alert-dismissible" role="alert">
        <div>
            {{ ux_icon(icon, {class: 'icon alert-icon'}) }}
        </div>
        <div>
            {% for message in messages %}
                <div>{{ message|raw }}</div>
            {% endfor %}
        </div>
        <a class="btn-close" data-bs-dismiss="alert" aria-label="{{ 'Close'|trans }}" title="{{ 'Close'|trans }}"></a>
    </div>
{% endif %}
