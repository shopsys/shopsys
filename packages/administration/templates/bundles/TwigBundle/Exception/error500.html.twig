{% extends '@ShopsysAdministration/layout/layout_error.html.twig' %}

{% block error_content %}
    <div class="empty-header">500</div>

    <p class="empty-title">{{ 'Oops! Error occurred.'|trans }}</p>

    <p class="empty-subtitle text-secondary">
        {{ 'Uh-oh, uh-oh. And specially <strong>"%status_code% %status_text%"</strong>, as if it was on purpose!'|transHtml({ '%status_code%': status_code, '%status_text%': status_text }) }}
    </p>

    <p class="empty-subtitle text-secondary">
        {{ 'Please excuse this error, we are working on fixing it. If needed, contact us on e-mail or by phone.'|trans }}
    </p>

    <p class="empty-subtitle text-secondary">
        Error ID: <span id="js-error-id">{{ error_id() }}</span>
    </p>
{% endblock %}
