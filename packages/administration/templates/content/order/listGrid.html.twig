{% extends '@ShopsysAdministration/datagrid/grid.html.twig' %}

{% block grid_value_cell_id_number %}
    <a href="{{ url('admin_order_edit', { id: row.id }) }}" class="mr-2">{{ value }}</a>
    <span class="d-none d-md-inline-block cursor-help"
          data-bs-toggle="popover"
          data-bs-trigger="hover"
          data-bs-html="true"
          data-bs-content="Loading..."
          data-bs-container="body"
          data-content-url="{{ url('admin_order_preview', {id: row.id}) }}">
        {{ ux_icon('list-search') }}
    </span>
{% endblock %}

{% block grid_value_cell_id_status_name %}
    <span class="status status-{{ row.statusType|order_status_color }}">
        {{ value }}
    </span>
{% endblock %}

{% block grid_value_cell_id_paid %}
    {% if value %}
        <span class="status status-green">
            {{ 'Paid'|trans }}
        </span>
    {% else %}
        <span class="status status-yellow">
            {{ 'Unpaid'|trans }}
        </span>
    {% endif %}
{% endblock %}

{% block grid_value_cell_id_total_price %}
    {{ value|priceWithCurrencyByOrder(row.order) }}
{% endblock %}

{% block grid_value_cell_id_created_at %}
    {{ value|formatDateTime }}
{% endblock %}

{% block grid_no_data %}
    {{ 'No order found.'|trans }}
{% endblock %}

{% block grid_pager_totalcount %}
    {% set entityName = 'orders'|trans %}
    {{ parent() }}
{% endblock %}
