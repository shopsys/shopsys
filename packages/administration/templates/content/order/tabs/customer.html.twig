<div class="card mb-3">
    <div class="card-header">
        <h3 class="card-title d-flex align-items-center gap-2">
            <i class="ti ti-map-pin"></i>
            {{ 'Billing & Delivery'|trans }}
        </h3>
        {% if canEdit %}
            <div class="card-actions">
                <a href="#" class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#billingEditModal">
                    <i class="ti ti-pencil"></i>
                    {{ 'Edit billing'|trans }}
                </a>
                <a href="#" class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#deliveryEditModal">
                    <i class="ti ti-truck"></i>
                    {{ 'Edit delivery'|trans }}
                </a>
            </div>
        {% endif %}
    </div>
    <div class="card-body" id="js-addresses-view">
        {% include '@ShopsysAdministration/content/order/partials/addresses_view.html.twig' %}
    </div>
</div>
