{% macro orderItem(orderItemForm, orderItemId, productItem, inputPriceType, canRemoveItem) %}
    {% import _self as self %}
    {% set setPricesManually = orderItemForm.vars.data is not null ? orderItemForm.setPricesManually.vars.data : false %}
    {% set isCalculatedPriceReadonly = not setPricesManually %}

    <tr class="js-order-item js-order-item-any" id="{{ orderItemForm.vars.id }}" data-index="{{ orderItemId }}">
        <td>
            <div class="d-flex align-items-center gap-2">
                {% if productItem and productItem.product %}
                    {{ image(productItem.product, { width: 36, height: 36 }) }}
                {% endif %}
                <div class="flex-grow-1">
                    <div class="input-group input-group-flat">
                        {{ form_widget(orderItemForm.name, { attr: { class: 'js-order-item-name' } }) }}
                        {% set errors = form_errors(orderItemForm.name) %}
                        {% set isNewItem = orderItemId starts with constant('Shopsys\\FrameworkBundle\\Model\\Order\\OrderData::NEW_ITEM_PREFIX') %}
                        {% if productItem and productItem.product %}
                            <span class="input-group-text">
                                <a href="{{ path('admin_product_edit', { id: productItem.product.id }) }}" class="input-group-link" target="_blank" rel="noopener">
                                    {{ ux_icon('forward-page') }}
                                </a>
                            </span>
                        {% elseif productItem and not productItem.product and not errors and not isNewItem %}
                            <span class="input-group-text">
                                {{ info_icon('Product not in e-shop.'|trans) }}
                            </span>
                        {% endif %}
                    </div>
                    {% if errors %}
                        {{ errors|raw }}
                    {% endif %}
                    <input type="hidden" name="{{ orderItemForm.product.vars.full_name }}" value="{{ orderItemForm.product.vars.value }}">
                </div>
            </div>
        </td>
        <td class="text-end">
            {{ form_widget(orderItemForm.catnum) }}
            {{ form_errors(orderItemForm.catnum) }}
        </td>
        <td class="text-end">
            {{ self.smallInputWidget(orderItemForm.quantity) }}
        </td>
        <td class="text-end">
            {{ self.smallInputWidget(orderItemForm.unitName) }}
        </td>
        {% if inputPriceType is same as(constant('Shopsys\\FrameworkBundle\\Model\\Pricing\\PricingSetting::PRICE_TYPE_WITH_VAT')) %}
            <td class="text-end">{{ self.calculablePriceWidget(orderItemForm.unitPriceWithoutVat, isCalculatedPriceReadonly) }}</td>
            <td class="text-end">{{ self.smallInputWidget(orderItemForm.vatPercent) }}</td>
            <td class="text-end">{{ self.inputPriceWidget(orderItemForm.unitPriceWithVat) }}</td>
        {% elseif inputPriceType is same as(constant('Shopsys\\FrameworkBundle\\Model\\Pricing\\PricingSetting::PRICE_TYPE_WITHOUT_VAT')) %}
            <td class="text-end">{{ self.inputPriceWidget(orderItemForm.unitPriceWithoutVat) }}</td>
            <td class="text-end">{{ self.smallInputWidget(orderItemForm.vatPercent) }}</td>
            <td class="text-end">{{ self.calculablePriceWidget(orderItemForm.unitPriceWithVat, isCalculatedPriceReadonly) }}</td>
        {% endif %}
        <td class="text-end">{{ self.calculablePriceWidget(orderItemForm.totalPriceWithoutVat, isCalculatedPriceReadonly) }}</td>
        <td class="text-end">{{ self.calculablePriceWidget(orderItemForm.totalPriceWithVat, isCalculatedPriceReadonly) }}</td>
        <td class="align-middle">
            <div class="d-flex align-items-center justify-content-center gap-1">
                {{ form_widget(orderItemForm.setPricesManually, { attr: { class: 'js-set-prices-manually' }, checked: setPricesManually }) }}
                <span class="js-setting-prices-manually-warning cursor-help{% if not setPricesManually %} d-none{% endif %}"
                      title="{{ 'Using price calculation has been disabled, don\'t forget to edit all prices.'|trans }}"
                      data-bs-toggle="tooltip"
                >
                    {{ ux_icon('warning', { class: 'pe-none' }) }}
                </span>
            </div>
        </td>
        <td class="align-middle">
            <a href="#"
               class="js-order-item-remove text-secondary{% if not canRemoveItem %} link-disabled{% endif %}"
               data-order-item-index="{{ orderItemId }}"
               data-loading="addClass(disabled)"
            >
                {{ ux_icon('trash', { class: 'icon icon-sm' }) }}
            </a>
        </td>
    </tr>
{% endmacro %}

{% macro orderTransport(orderTransportForm, transportPricesWithVatByTransportId, transportVatPercentsByTransportId, inputPriceType) %}
    {% import _self as self %}
    {% set setPricesManually = orderTransportForm.setPricesManually.vars.data %}
    {% set isCalculatedPriceReadonly = not setPricesManually %}

    <tr class="js-order-transport-row js-order-item-any"
