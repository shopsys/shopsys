{% macro orderItem(orderItemForm, orderItemId, productItem, inputPriceType) %}
    {% import _self as self %}
    <tr class="js-order-item js-order-item-any" id="{{ orderItemForm.vars.id }}" data-index="{{ orderItemId }}">
        <td>
            <div class="input-group input-group-flat">
                {{ form_widget(orderItemForm.name, {attr: { class: 'js-order-item-name'}}) }}
                {{ form_errors(orderItemForm.name) }}
                <span class="input-group-text">
                    {% if productItem and productItem.product %}
                        <a href="{{ path('admin_product_edit', { id: productItem.product.id }) }}" class="input-group-link" target="_blank">
                            {{ ux_icon('forward-page') }}
                        </a>
                    {% elseif productItem and not productItem.product %}
                        {{ info_icon('Product not in e-shop.'|trans) }}
                    {% endif %}
                </span>
            </div>
        </td>
        <td class="text-end">
            {{ form_widget(orderItemForm.catnum) }}
            {{ form_errors(orderItemForm.catnum) }}
        </td>

        {% if inputPriceType is same as(constant('Shopsys\\FrameworkBundle\\Model\\Pricing\\PricingSetting::PRICE_TYPE_WITH_VAT')) %}
            <td class="text-end">
                {{ self.inputPriceWidget(orderItemForm.unitPriceWithVat) }}
            </td>
            <td class="text-end">{{ self.calculablePriceWidget(orderItemForm.unitPriceWithoutVat) }}</td>
        {% elseif inputPriceType is same as(constant('Shopsys\\FrameworkBundle\\Model\\Pricing\\PricingSetting::PRICE_TYPE_WITHOUT_VAT')) %}
            <td class="text-end">
                {{ self.calculablePriceWidget(orderItemForm.unitPriceWithVat) }}
            </td>
            <td class="text-end">{{ self.inputPriceWidget(orderItemForm.unitPriceWithoutVat) }}</td>
        {% endif %}

        <td class="text-end">
            {{ form_widget(orderItemForm.quantity, {attr: {class: 'text-end'}}) }}
            {{ form_errors(orderItemForm.quantity) }}
        </td>
        <td class="text-end">
            {{ form_widget(orderItemForm.unitName, {attr: {class: 'text-end'}}) }}
            {{ form_errors(orderItemForm.unitName) }}
        </td>
        <td class="text-end">
            {{ form_widget(orderItemForm.vatPercent, {attr: {class: 'text-end'}}) }}
            {{ form_errors(orderItemForm.vatPercent) }}
        </td>
        {% set uncheckedByDefault = orderItemForm.vars.data is not null ? orderItemForm.setPricesManually.vars.data : false %}
        <td class="align-middle">{{ form_widget(orderItemForm.setPricesManually, {attr: { class: 'js-set-prices-manually'}, checked: uncheckedByDefault}) }}</td>
        <td class="text-end">{{ self.calculablePriceWidget(orderItemForm.totalPriceWithVat) }}</td>
        <td class="text-end">{{ self.calculablePriceWidget(orderItemForm.totalPriceWithoutVat) }}</td>
        <td class="align-middle">
            <a href="#" class="js-order-item-remove">{{ ux_icon('trash') }}</a>
        </td>
    </tr>
{% endmacro %}

{% macro orderTransport(orderTransportForm, transportPricesWithVatByTransportId, transportVatPercentsByTransportId, inputPriceType) %}
    {% import _self as self %}
    <tr class="js-order-transport-row js-order-item-any"
        data-transport-prices-with-vat-by-transport-id="{{ transportPricesWithVatByTransportId|json_encode() }}"
        data-transport-vat-percents-by-transport-id="{{ transportVatPercentsByTransportId|json_encode() }}"
    >
        <td>
            {{ form_widget(orderTransportForm.transport) }}
            {{ form_errors(orderTransportForm.transport) }}
        </td>
        <td class="text-end">-</td>

        {% if inputPriceType is same as(constant('Shopsys\\FrameworkBundle\\Model\\Pricing\\PricingSetting::PRICE_TYPE_WITH_VAT')) %}
            <td class="text-end">
                {{ self.inputPriceWidget(orderTransportForm.unitPriceWithVat) }}
            </td>
            <td class="text-end">{{ self.calculablePriceWidget(orderTransportForm.unitPriceWithoutVat) }}</td>
        {% elseif inputPriceType is same as(constant('Shopsys\\FrameworkBundle\\Model\\Pricing\\PricingSetting::PRICE_TYPE_WITHOUT_VAT')) %}
            <td class="text-end">
                {{ self.calculablePriceWidget(orderTransportForm.unitPriceWithVat) }}
            </td>
            <td class="text-end">{{ self.inputPriceWidget(orderTransportForm.unitPriceWithoutVat) }}</td>
        {% endif %}

        <td class="text-end">1</td>
        <td></td>
        <td class="text-end">
            {{ form_widget(orderTransportForm.vatPercent, {attr: { class: 'text-end'}}) }}
            {{ form_errors(orderTransportForm.vatPercent) }}
        </td>
        <td class="text-center">
            {{ form_widget(orderTransportForm.setPricesManually, {attr: { class: 'js-set-prices-manually'}}) }}
        </td>
        <td colspan="3"></td>
    </tr>
{% endmacro %}

{% macro orderPayment(orderPaymentForm, paymentPricesWithVatByPaymentId, paymentVatPercentsByPaymentId, inputPriceType) %}
    {% import _self as self %}
    <tr
            class="js-order-payment-row js-order-item-any"
            data-payment-prices-with-vat-by-payment-id="{{ paymentPricesWithVatByPaymentId|json_encode() }}"
            data-payment-vat-percents-by-payment-id="{{ paymentVatPercentsByPaymentId|json_encode() }}"
    >
        <td>
            <div class="relative padding-left-10">
                {{ form_widget(orderPaymentForm.payment) }}
                {{ form_errors(orderPaymentForm.payment) }}
            </div>
        </td>
        <td class="text-end">-</td>

        {% if inputPriceType is same as(constant('Shopsys\\FrameworkBundle\\Model\\Pricing\\PricingSetting::PRICE_TYPE_WITH_VAT')) %}
            <td class="text-end">
                {{ self.inputPriceWidget(orderPaymentForm.unitPriceWithVat) }}
            </td>
            <td class="text-end">{{ self.calculablePriceWidget(orderPaymentForm.unitPriceWithoutVat) }}</td>
        {% elseif inputPriceType is same as(constant('Shopsys\\FrameworkBundle\\Model\\Pricing\\PricingSetting::PRICE_TYPE_WITHOUT_VAT')) %}
            <td class="text-end">
                {{ self.calculablePriceWidget(orderPaymentForm.unitPriceWithVat) }}
            </td>
            <td class="text-end">{{ self.inputPriceWidget(orderPaymentForm.unitPriceWithoutVat) }}</td>
        {% endif %}

        <td class="text-end">1</td>
        <td></td>
        <td class="text-end">
            {{ form_widget(orderPaymentForm.vatPercent, {attr: { class: 'text-end'}}) }}
            {{ form_errors(orderPaymentForm.vatPercent) }}
        </td>
        <td class="align-middle text-center">
            {{ form_widget(orderPaymentForm.setPricesManually, {attr: { class: 'js-set-prices-manually'}}) }}
        </td>
        <td colspan="3"></td>
    </tr>
{% endmacro %}

{% macro inputPriceWidget(priceForm) %}
    <div class="input-group input-group-flat" style="min-width: 10em">
        <span class="input-group-text">
            {{ ux_icon('warning', {
                class: 'js-setting-prices-manually-warning cursor-help',
                'title': 'Using price calculation has been disabled, don\'t forget to edit all prices.'|trans,
                'data-bs-toggle': 'tooltip'
            }) }}
        </span>
        {{ form_widget(priceForm, {attr: { class: 'text-end' }}) }}
    </div>
    {{ form_errors(priceForm) }}
{% endmacro %}

{% macro calculablePriceWidget(calculablePriceForm) %}
    <span class="text-no-wrap">
        {{ form_widget(calculablePriceForm, {attr: { class: 'text-end js-calculable-price'}}) }}
        {{ form_errors(calculablePriceForm) }}
    </span>
{% endmacro %}
