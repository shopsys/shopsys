{% macro inputPriceWidget(priceForm) %}
    <div class="input-group input-group-flat" style="min-width: 6em">
        {{ form_widget(priceForm, {attr: { class: 'text-end' }}) }}
    </div>
    {{ form_errors(priceForm) }}
{% endmacro %}

{% macro calculablePriceWidget(calculablePriceForm) %}
    <div class="input-group input-group-flat" style="min-width: 6em">
        {{ form_widget(calculablePriceForm, {attr: { class: 'text-end js-calculable-price'}}) }}
    </div>
    {{ form_errors(calculablePriceForm) }}
{% endmacro %}

{% macro smallInputWidget(form) %}
    <div class="input-group input-group-flat" style="min-width: 4em">
        {{ form_widget(form, {attr: { class: 'text-end' }}) }}
    </div>
    {{ form_errors(form) }}
{% endmacro %}
