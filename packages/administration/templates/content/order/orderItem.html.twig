        <td class="text-end">-</td>
        <td class="text-end">1</td>
        <td></td>
        {% if inputPriceType is same as(constant('Shopsys\\FrameworkBundle\\Model\\Pricing\\PricingSetting::PRICE_TYPE_WITH_VAT')) %}
            <td class="text-end">{{ self.calculablePriceWidget(orderTransportForm.unitPriceWithoutVat, isCalculatedPriceReadonly) }}</td>
            <td class="text-end">{{ self.smallInputWidget(orderTransportForm.vatPercent) }}</td>
            <td class="text-end">{{ self.inputPriceWidget(orderTransportForm.unitPriceWithVat) }}</td>
        {% elseif inputPriceType is same as(constant('Shopsys\\FrameworkBundle\\Model\\Pricing\\PricingSetting::PRICE_TYPE_WITHOUT_VAT')) %}
            <td class="text-end">{{ self.inputPriceWidget(orderTransportForm.unitPriceWithoutVat) }}</td>
            <td class="text-end">{{ self.smallInputWidget(orderTransportForm.vatPercent) }}</td>
            <td class="text-end">{{ self.calculablePriceWidget(orderTransportForm.unitPriceWithVat, isCalculatedPriceReadonly) }}</td>
        {% endif %}
        <td></td>
        <td></td>
        <td>
            <div class="d-flex align-items-center justify-content-center">
                {{ form_widget(orderTransportForm.setPricesManually, { attr: { class: 'js-set-prices-manually' } }) }}
            </div>
        </td>
        <td></td>
    </tr>
{% endmacro %}

