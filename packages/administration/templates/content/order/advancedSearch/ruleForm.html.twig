{% extends '@ShopsysAdministration/content/advancedSearch/ruleForm.html.twig' %}

{% block advanced_search_rule_value %}
    <div class="col-md mb-2">
        <div class="js-advanced-search-rule-value test-advanced-search-rule-value">
            {% if ruleForm.subject.vars.value == 'orderTotalPriceWithVat' %}
                {{ form_widget(ruleForm.value, { rawSymbolAfterInput: info_icon('Searching in all currencies'|trans) }) }}
            {% else %}
                {{ form_widget(ruleForm.value) }}
            {% endif %}
        </div>
    </div>
{% endblock %}
