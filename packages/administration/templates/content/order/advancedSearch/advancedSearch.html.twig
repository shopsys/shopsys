{{ form_start(advancedSearchForm) }}
    <div id="js-advanced-search-rules-box">
        <div id="js-advanced-search-rules-container" data-rule-form-url="{{ url('admin_order_getruleform') }}">
            {% include '@ShopsysAdministration/content/order/advancedSearch/ruleForm.html.twig' with {rulesForm: advancedSearchForm} %}
        </div>

        <div class="row">
            <div class="col">
                <button type="button" class="btn btn-sm btn-secondary" id="js-advanced-search-add-rule-button">
                    {{ ux_icon('circle-plus') }} {{ 'Add requirement'|trans }}
                </button>

                {% set RULES_FORM_NAME = constant('Shopsys\\FrameworkBundle\\Model\\Order\\AdvancedSearch\\OrderAdvancedSearchFacade::RULES_FORM_NAME') %}
                {% set routeParams =  getRouteParams()|merge({ (RULES_FORM_NAME): true }) %}
                <a href="{{ url(getRoute(), routeParams) }}" class="btn btn-sm">
                    {{ ux_icon('circle-cross') }}
                    {{ 'Reset filter'|trans }}
                </a>
            </div>
            <div class="col-auto">
                <input type="submit" value="{{ 'Search [verb]'|trans }}" class="btn btn-primary">
            </div>
        </div>
    </div>
{{ form_end(advancedSearchForm) }}
