<div class="row gx-4">
    <div class="col-md-6 mb-3 mb-md-0 d-flex flex-column gap-1">
        <div class="d-flex justify-content-between align-items-center mb-1">
            <h4 class="mb-0">{{ 'Billing address'|trans }}</h4>
            {% if canEdit|default(false) %}
                <a href="#"
                   class="text-secondary d-inline-flex align-items-center"
                   data-bs-toggle="modal"
                   data-bs-target="#billingEditModal"
                   onclick="if (window.bootstrap) { const modalElement = document.getElementById('billingEditModal'); if (modalElement) { window.bootstrap.Modal.getOrCreateInstance(modalElement).show(); } return false; }"
                   aria-label="{{ 'Edit billing details'|trans }}">
                    <span class="d-inline-flex" data-bs-toggle="tooltip" data-bs-title="{{ 'Edit billing details'|trans }}">
                        {{ ux_icon('pencil', { class: 'icon icon-sm' }) }}
                    </span>
                </a>
            {% endif %}
        </div>
        {% if order.companyName %}
            <div class="order-address-row">
                <span class="order-address-row__icon text-secondary">
                    {{ ux_icon('tabler:building', { class: 'icon icon-sm' }) }}
                </span>
                <span class="order-address-row__content">{{ order.companyName }}</span>
            </div>
        {% endif %}
        {% if order.companyNumber %}
            <div>{{ 'IČO'|trans }}: {{ order.companyNumber }}</div>
        {% endif %}
        {% if order.companyTaxNumber %}
            <div>{{ 'DIČ'|trans }}: {{ order.companyTaxNumber }}</div>
        {% endif %}
        <div class="order-address-row order-address-row--multiline">
            <span class="order-address-row__icon text-secondary">
                {{ ux_icon('tabler:home', { class: 'icon icon-sm' }) }}
            </span>
            <div class="order-address-row__content order-address-row__content--multiline">
                <div>{{ order.street }}</div>
                <div>{{ order.postcode }} {{ order.city }}</div>
                <div>{{ order.country.name }}</div>
            </div>
        </div>
    </div>
    <div class="col-md-6 d-flex flex-column gap-1">
        <div class="d-flex justify-content-between align-items-center mb-1">
            <h4 class="mb-0">{{ 'Delivery address'|trans }}</h4>
            {% if canEdit|default(false) %}
                <a href="#"
                   class="text-secondary d-inline-flex align-items-center"
                   data-bs-toggle="modal"
                   data-bs-target="#deliveryEditModal"
                   onclick="if (window.bootstrap) { const modalElement = document.getElementById('deliveryEditModal'); if (modalElement) { window.bootstrap.Modal.getOrCreateInstance(modalElement).show(); } return false; }"
                   aria-label="{{ 'Edit delivery address'|trans }}">
                    <span class="d-inline-flex" data-bs-toggle="tooltip" data-bs-title="{{ 'Edit delivery address'|trans }}">
                        {{ ux_icon('pencil', { class: 'icon icon-sm' }) }}
                    </span>
                </a>
            {% endif %}
        </div>
        {% if order.deliveryAddressSameAsBillingAddress %}
            <span class="badge bg-blue-lt align-self-start">{{ 'Same as billing address'|trans }}</span>
        {% else %}
            {% if order.deliveryCompanyName %}
                <div class="order-address-row">
                    <span class="order-address-row__icon text-secondary">
                        {{ ux_icon('tabler:building', { class: 'icon icon-sm' }) }}
                    </span>
                    <span class="order-address-row__content">{{ order.deliveryCompanyName }}</span>
                </div>
            {% endif %}
            {% if order.deliveryFirstName or order.deliveryLastName %}
                <div class="order-address-row">
                    <span class="order-address-row__icon text-secondary">
                        {{ ux_icon('tabler:user', { class: 'icon icon-sm' }) }}
                    </span>
                    <span class="order-address-row__content">{{ order.deliveryFirstName }} {{ order.deliveryLastName }}</span>
                </div>
            {% endif %}
            {% if order.deliveryTelephone %}
                <div class="order-address-row">
                    <span class="order-address-row__icon text-secondary">
                        {{ ux_icon('phone', { class: 'icon icon-sm' }) }}
                    </span>
                    <a href="tel:{{ order.deliveryTelephone }}" class="order-address-row__content">{{ order.deliveryTelephone }}</a>
                </div>
            {% endif %}
            <div class="order-address-row order-address-row--multiline">
                <span class="order-address-row__icon text-secondary">
                    {{ ux_icon('tabler:home', { class: 'icon icon-sm' }) }}
                </span>
                <div class="order-address-row__content order-address-row__content--multiline">
                    <div>{{ order.deliveryStreet }}</div>
                    <div>{{ order.deliveryPostcode }} {{ order.deliveryCity }}</div>
                    <div>{{ order.deliveryCountry.name }}</div>
                </div>
            </div>
        {% endif %}
    </div>
</div>
