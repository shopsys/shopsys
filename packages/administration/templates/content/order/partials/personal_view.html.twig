<div class="datagrid">
    <div class="datagrid-item">
        <div class="datagrid-title">{{ 'First name'|trans }}</div>
        <div class="datagrid-content">{{ order.firstName }}</div>
    </div>
    <div class="datagrid-item">
        <div class="datagrid-title">{{ 'Last name'|trans }}</div>
        <div class="datagrid-content">{{ order.lastName }}</div>
    </div>
    <div class="datagrid-item">
        <div class="datagrid-title">{{ 'Email'|trans }}</div>
        <div class="datagrid-content">{{ order.email }}</div>
    </div>
    <div class="datagrid-item">
        <div class="datagrid-title">{{ 'Telephone'|trans }}</div>
        <div class="datagrid-content">{{ order.telephone }}</div>
    </div>
</div>
