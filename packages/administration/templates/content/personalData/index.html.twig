{% extends '@ShopsysAdministration/layout/layout_with_panel.html.twig' %}

{% block title %} - {{ 'Display personal information settings'|trans }}{% endblock %}

{% block pre_title %}{{ 'Settings'|trans }}{% endblock %}
{% block h1 %}{{ 'Display personal information'|trans }}{% endblock %}

{% block main_content %}
    {{ render(controller('Shopsys\\FrameworkBundle\\Controller\\Admin\\DomainController::domainTabsAction')) }}

    {{ form_start(form) }}
    <div class="card mb-3">
        <div class="card-header">
            <h3 class="card-title">{{ 'Personal information overview'|trans }}</h3>
            <div class="card-actions">
                {{ 'Storefront URL:'|trans }}
                <a href="{{ findUrlByDomainId('front_personal_data', {}, domainId) }}" target="_blank" rel="noopener">
                    {{ findUrlByDomainId('front_personal_data', {}, domainId) }}
                </a>
            </div>
        </div>
        <div class="card-body">
            {{ form_widget(form.personalDataDisplaySiteContent) }}
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h3 class="card-title">{{ 'Personal information export'|trans }}</h3>
            <div class="card-actions">
                {{ 'Storefront URL:'|trans }}
                <a href="{{ findUrlByDomainId('front_personal_data_export', {}, domainId) }}" target="_blank" rel="noopener">
                    {{ findUrlByDomainId('front_personal_data_export', {}, domainId) }}
                </a>
            </div>
        </div>
        <div class="card-body">
            {{ form_widget(form.personalDataExportSiteContent ) }}
        </div>
    </div>
    {{ form_end(form) }}
{% endblock %}
