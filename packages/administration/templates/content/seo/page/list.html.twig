{% extends '@ShopsysAdministration/layout/layout_with_panel.html.twig' %}

{% block title %}- {{ 'SEO pages'|trans }}{% endblock %}

{% block pre_title %}{{ 'Overview'|trans }}{% endblock %}
{% block h1 %}{{ 'SEO pages'|trans }}{% endblock %}

{% block btn %}
    <a href="{{ url('admin_seopage_new') }}" class="btn btn-primary">
        {{ ux_icon('plus') }}
        {{ 'Create SEO page'|trans }}
    </a>
{% endblock %}

{% block main_content %}
    {{ include('@ShopsysAdministration/partial/message.html.twig', {
        level: 'info',
        message: 'SEO pages apply only to static storefront pages (e.g. cart, search or customer section). To set up SEO of a particular entity, e.g. an article, use the SEO settings in the administration of that entity. SEO pages also set the title, description and image shown when the page is shared on social networks. Without an Open Graph image, the Organization logo from <a href="%seoSettingsUrl%">SEO attributes</a> is used.'|trans({'%seoSettingsUrl%': url('admin_seo_index')}),
    }) }}

    {{ gridView.render() }}
{% endblock %}
