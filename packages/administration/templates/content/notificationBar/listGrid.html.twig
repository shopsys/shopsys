{% extends '@ShopsysAdministration/datagrid/grid.html.twig' %}

{% block grid_no_data %}
    {{ 'No page found.'|trans }}
{% endblock %}

{% block grid_value_cell_id_text %}
    {{ value|sanitize_html('shopsys.ckeditor_preview') }}
{% endblock %}

{% block grid_value_cell_id_validityFrom %}
    {% if value is not null %}
        {{ value|formatDateTime }}
    {% else %}
        {{ 'Unlimited'|trans }}
    {% endif %}
{% endblock %}

{% block grid_value_cell_id_validityTo %}
    {% if value is not null %}
        {{ value|formatDateTime }}
    {% else %}
        {{ 'Unlimited'|trans }}
    {% endif %}
{% endblock %}
