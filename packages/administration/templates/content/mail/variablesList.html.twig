{% macro applicableVariables(heading, variables, requiredVariables, labeledVariables) %}
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">{{ heading }}</h3>
        </div>
        <div class="card-body">
            <table class="table table-sm table-striped">
                <tbody>
                    {% for key in variables %}
                        <tr>
                            <th class="w-25">
                                {{ key }}
                                {% if key in requiredVariables %}
                                    <span class="text-danger">*</span>
                                {% endif %}
                            </th>
                            <td>{{ labeledVariables[key] }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endmacro %}
