<div class="card mb-3">
    <div class="card-header">
        <h3 class="card-title">{{ 'Basic information'|trans }}</h3>
    </div>

    <div class="card-body d-flex justify-content-between gap-3 flex-wrap">
        <div>
            <div class="subheader mb-1">{{ 'Reviewed product'|trans }}</div>
            <div class="fw-medium">
                {% if productReview.product is not null %}
                    <a href="{{ url('admin_product_edit', { id: productReview.product.id }) }}">
                        {{ productReview.productName }}
                        {{ ux_icon('forward-page', { class: 'icon-sm' }) }}
                    </a>
                {% else %}
                    {{ productReview.productName }}
                {% endif %}
                <span class="text-secondary">&middot; {{ productReview.catnum }}</span>
            </div>

            {% if productReview.product is null %}
                <div class="small text-secondary mt-1">
                    {{ ux_icon('info-outlined', { class: 'icon-sm' }) }}
                    {{ 'The product is no longer in the catalogue.'|trans }}
                </div>
            {% endif %}
        </div>

        <div class="text-end">
            {{ include('@ShopsysAdministration/content/productReview/_rating.html.twig', { rating: productReview.rating }) }}
            <div class="mt-1">
                {{ include('@ShopsysAdministration/content/productReview/_statusBadge.html.twig', { status: productReview.status }) }}
            </div>
        </div>
    </div>

    <div class="card-body d-flex align-items-center gap-3 flex-wrap">
        <span class="avatar rounded-circle">
            {%- if productReview.isAnonymous -%}
                {{ ux_icon('person-man') }}
            {%- else -%}
                {{ productReview.firstName|first|upper }}
            {%- endif -%}
        </span>

        <div class="flex-fill d-flex align-items-center gap-3 flex-wrap">
            <div>
                <div class="fw-medium">{{ productReview.fullName }}</div>
                <div class="small text-secondary">{{ productReview.email }}</div>
            </div>

            {% if productReview.customerUser is not null %}
                <div class="vr"></div>

                <a href="{{ url('admin_customer_edit', { id: productReview.customerUser.id }) }}">
                    {{ productReview.customerUser.fullName }}
                    {{ ux_icon('forward-page', { class: 'icon-sm' }) }}
                </a>
            {% endif %}
        </div>

        <div class="d-flex gap-2 flex-wrap">
            {% if productReview.verifiedPurchase %}
                <span class="badge bg-green-lt text-green-lt-fg">
                    {{ ux_icon('checked-circle', { class: 'icon-sm' }) }}
                    {{ 'Verified purchase'|trans }}
                </span>
            {% endif %}

            {% if productReview.isAnonymous %}
                <span class="badge bg-secondary-lt">
                    {{ ux_icon('invisible', { class: 'icon-sm' }) }}
                    {{ 'Anonymous'|trans }}
                </span>
            {% endif %}

            {% if productReview.customerUser is null %}
                <span class="badge bg-secondary-lt">
                    {{ ux_icon('person-man', { class: 'icon-sm' }) }}
                    {{ 'Unregistered'|trans }}
                </span>
            {% endif %}
        </div>
    </div>

    <div class="card-body">
        <div class="datagrid">
            <div class="datagrid-item">
                <div class="datagrid-title">{{ 'Order'|trans }}</div>
                <div class="datagrid-content">
                    {% if productReview.orderItem is not null %}
                        <a href="{{ url('admin_order_edit', { id: productReview.orderItem.order.id }) }}">
                            {{ productReview.orderItem.order.number }}
                            {{ ux_icon('forward-page', { class: 'icon-sm' }) }}
                        </a>
                    {% else %}
                        <span class="text-secondary">-</span>
                    {% endif %}
                </div>
            </div>

            <div class="datagrid-item">
                <div class="datagrid-title">{{ 'Date of creation'|trans }}</div>
                <div class="datagrid-content">{{ productReview.createdAt|formatDateTime }}</div>
            </div>

            {% if isMultidomain() %}
                <div class="datagrid-item">
                    <div class="datagrid-title">{{ 'Domain'|trans }}</div>
                    <div class="datagrid-content">
                        {{ domain_icon(productReview.domainId) }}
                        {{ getDomainName(productReview.domainId) }}
                    </div>
                </div>
            {% endif %}

            <div class="datagrid-item">
                <div class="datagrid-title">{{ 'IP address'|trans }}</div>
                <div class="datagrid-content font-monospace text-secondary">{{ productReview.ipAddress }}</div>
            </div>
        </div>
    </div>
</div>
