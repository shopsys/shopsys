{% extends '@ShopsysAdministration/datagrid/grid.html.twig' %}

{% block grid_action_cell_type_delete %}
    {% if row is not empty and row.isGiftVoucherPayment is defined and row.isGiftVoucherPayment %}
        {{ info_icon('Payment of type Gift voucher cannot be deleted, exactly one must always exist.'|trans) }}
    {% else %}
        {{ gridView.renderBlock('grid_action_cell', {actionColumn: actionColumn, row: row}) }}
    {% endif %}
{% endblock %}

{% block grid_value_cell_id_name %}
    <a href="{{ url('admin_payment_edit', { id: row.p.id }) }}">{{ value|nameWithFallbackOnEmpty }}</a>
{% endblock %}

{% block grid_value_cell_id_price %}
    <span class="status">
        {{ value|priceWithCurrencyByDomainId(row.domainId) }}
    </span>
{% endblock %}

{% block grid_no_data %}
    {{ 'No payments created so far.'|trans }}
{% endblock %}
