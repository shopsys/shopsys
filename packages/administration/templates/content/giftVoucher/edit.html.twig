{% extends '@ShopsysAdministration/content/giftVoucher/detail.html.twig' %}

{% block title %}- {{ 'Editing gift voucher'|trans }} - {{ giftVoucher.code }}{% endblock %}

{% block pre_title %}{{ 'Editing gift voucher'|trans }}{% endblock %}
{% block h1 %}{{ giftVoucher.code }}{% endblock %}

{% block links_after_title %}
    {% include '@ShopsysAdministration/content/giftVoucher/statusBadge.html.twig' with { status: giftVoucher.status, isExpired: isExpired } only %}
    {{ parent() }}
{% endblock %}

{% block btn %}
    <a href="{{ url('admin_giftvoucher_downloadpdf', { id: giftVoucher.id }) }}" class="btn">
        {{ ux_icon('download') }}
        {{ 'Download PDF'|trans }}
    </a>
{% endblock %}

{% block main_content %}
    {{ form(form) }}

    <div class="card mt-3">
        <div class="card-header">
            <h3 class="card-title">{{ 'Change log'|trans }}</h3>
        </div>
        <div class="card-body">
            {{ component('Admin:EntityLogTimeline', {
                entityName: entityLogEntityName,
                entityId: giftVoucher.id,
            }) }}
        </div>
    </div>
{% endblock %}
