{% extends '@ShopsysAdministration/datagrid/grid.html.twig' %}

{% block grid_action_cell_type_delete %}
    {% if row.cs.statusType is same as(constant('STATUS_TYPE_NEW', complaintStatusTypeEnum)) %}
        <span title="{{ 'This status can\'t be deleted. This is automatically assigned status to all new complaints.'|trans }}"
              class="cursor-help px-1"
              data-bs-toggle="tooltip"
        >
            {{ ux_icon('info') }}
        </span>
    {% else %}
        {{ gridView.renderBlock('grid_action_cell', {actionColumn: actionColumn, row: row}) }}
    {% endif %}
{% endblock %}

{% block grid_value_cell_id_name %}
    <span class="status status-{{ row.cs.statusType|complaint_status_color }}">
        <span class="status-dot"></span>
        {{ value }}
    </span>
{% endblock %}

{% block grid_value_cell_id_statusType %}
    {{ complaintStatusTypeEnum.getTranslation(value) }}
{% endblock %}

{% block grid_value_cell_edit_id_statusType %}
    {% if row is not null and row.cs.statusType is same as(constant('STATUS_TYPE_NEW', complaintStatusTypeEnum)) %}
        {{ complaintStatusTypeEnum.getTranslation(row.cs.statusType) }}
        {{ info_icon('The type of this status can\'t be changed. This is automatically assigned status to all new complaints.'|trans) }}
    {% else %}
        {{ form_widget(form.statusType) }}
    {% endif %}
{% endblock %}

{% block grid_no_data %}
    {{ 'No complaint statuses found.'|trans }}
{% endblock %}

{% block grid_pager_totalcount %}
    {% set entityName = 'complaint statuses'|trans %}
    {{ parent() }}
{% endblock %}

{% block grid_inline_edit_add_button %}
    {% set addEntity = 'Create new complaint status'|trans %}
    {{ parent() }}
{% endblock %}
