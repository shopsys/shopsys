{% extends '@ShopsysAdministration/datagrid/grid.html.twig' %}

{% block grid_value_cell_id_name %}
    <a href="{{ url('admin_stock_edit', { id: row.s.id }) }}">{{ value }}</a>
    {% for domainId in defaultDomainIdsByStockId[row.s.id] | default([]) %}
        <span class="badge badge-pill bg-secondary-lt">{{ 'default (%domainName%)'|trans({'%domainName%': getDomainName(domainId)}) }}</span>
    {% endfor %}
{% endblock %}

{% block grid_pager_totalcount %}
    {% set entityName = 'Warehouse'|trans %}
    {{ parent() }}
{% endblock %}

{% block grid_no_data %}
    {{ 'There is no warehouse on this domain yet.'|trans }}
{% endblock %}

{% block grid_action_cell_type_delete %}
    {% if defaultDomainIdsByStockId[row.s.id] | default([]) | length > 0 %}
        {{ info_icon('Default warehouse cannot be removed'|trans) }}
    {% else %}
        {{ gridView.renderBlock('grid_action_cell', {actionColumn: actionColumn, row: row}) }}
    {% endif %}
{% endblock %}
