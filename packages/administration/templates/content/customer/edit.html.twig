{% extends '@ShopsysAdministration/content/customer/detail.html.twig' %}
{% import '@ShopsysAdministration/content/customer/loginAsUserLinkMacro.html.twig' as loginAsUserLinkMacro %}

{% block title %}- {{ 'Editing customer'|trans }} - {{ customerUser.fullName }}{% endblock %}

{% block pre_title %}{{ 'Editing customer'|trans }}{% endblock %}
{% block h1 %}{{ customerUser.fullName }}{% endblock %}

{% block btn %}
    {{ loginAsUserLinkMacro.loginAsUserLink(customerUser) }}
{% endblock %}

{% block main_content %}
    {{ parent() }}

    <div class="card">
        <div class="card-header">
            <h3 class="card-title">{{ 'History'|trans }}</h3>
        </div>
        <div class="card-body">
            {{ component('Admin:EntityLogTimeline', { entity: customerUser.customer }) }}
        </div>
    </div>
{% endblock %}
