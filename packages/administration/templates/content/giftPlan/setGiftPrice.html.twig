<div class="card">
    <div class="card-header">
        <h3 class="card-title">{{ 'Gift price'|trans }}</h3>
    </div>
    <div class="card-body">
        {{ form_start(form) }}
        <div class="row">
            {{ form_label(form.giftInputPrice) }}

            <div class="col-12 col-md mb-3 mb-md-0">
                {{ form_widget(form.giftInputPrice) }}
                {{ form_help(form.giftInputPrice) }}
                {{ form_errors(form.giftInputPrice) }}
            </div>
            <div class="col-12 col-md-auto">
                {{ form_widget(form.save) }}
            </div>
        </div>
    </div>
    {{ form_end(form) }}
</div>
