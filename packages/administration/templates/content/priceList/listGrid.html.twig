{% extends '@ShopsysAdministration/datagrid/grid.html.twig' %}

{% block grid_no_data %}
    {{ 'No product list found.'|trans }}
{% endblock %}

{% block grid_pager_totalcount %}
    {% set entityName = 'product lists'|trans %}
    {{ parent() }}
{% endblock %}

{% block grid_value_cell_id_validityStatus %}
    {% set statusMap = {
        '0': { 'class': 'green', 'label': 'Active'|trans },
        '1': { 'class': 'purple', 'label': 'Future'|trans },
        '-1': { 'class': 'red', 'label': 'Expired'|trans }
    } %}

    <span class="status status-{{ statusMap[value].class }}">
        {{ statusMap[value].label }}
    </span>
{% endblock %}
