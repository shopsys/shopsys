{% extends '@ShopsysAdministration/layout/layout_with_panel.html.twig' %}

{% block title %}- {{ 'Watchdog'|trans }} - {{ product|productDisplayName }}{% endblock %}

{% block pre_title %}{{ 'Watchdog'|trans }}{% endblock %}
{% block h1 %}{{ product|productDisplayName }}{% endblock %}

{% block btn %}
    {{ block('product_visibilities', '@ShopsysAdministration/content/product/edit.html.twig') }}
{% endblock %}

{% block main_content %}
    {{ form_start(quickSearchForm) }}
    {% include '@ShopsysAdministration/partial/_quick_search_form.html.twig' with {
        form_input: quickSearchForm.text,
        form_submit: quickSearchForm.submit,
        info_message: 'Searching searches in email. It is possible to use wildcards * and ?.'|trans,
    } %}
    {{ form_end(quickSearchForm) }}

    {{ render(controller('Shopsys\\FrameworkBundle\\Controller\\Admin\\DomainFilterController::domainFilterTabsAction', { namespace: domainFilterNamespace })) }}

    {{ gridView.render() }}

    {% embed '@ShopsysAdministration/partial/_fixed_bar.html.twig' %}
        {% block fixed_bar_content %}
            <a href="{{ url('admin_watchdog_list') }}" class="btn-link-style">{{ 'Back to overview'|trans }}</a>
        {% endblock %}
    {% endembed %}
{% endblock %}
