{% block grid_value_cell_id_averageDuration %}
    {% if value > row.cronTimeoutSecs %}
        <span class="badge bg-danger me-1"></span>
        <span class="text-danger">
    {% endif %}

    {{ value|formatDurationInSeconds }}

    {% if value > row.cronTimeoutSecs %}
        </span>
    {% endif %}
{% endblock %}
