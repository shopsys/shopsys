{% block advanced_search_form %}
    {{ form_start(advancedSearchForm) }}
        <div id="js-advanced-search-rules-box">
            {% block advanced_search_rules_container %}
                <div id="js-advanced-search-rules-container" data-rule-form-url="{{ ruleFormUrl|default(url('admin_advancedsearch_getruleform', {entityType: advancedSearchForm.vars.entity_type})) }}">
                    {% block advanced_search_rules_form %}
                        {% include '@ShopsysAdministration/content/advancedSearch/ruleForm.html.twig' with {rulesForm: advancedSearchForm} %}
                    {% endblock %}
                </div>
            {% endblock %}

            {% block advanced_search_actions %}
                <div class="row">
                    <div class="col">
                        {% block advanced_search_buttons_left %}
                            <button type="button" class="btn btn-sm btn-secondary" id="js-advanced-search-add-rule-button">
                                {{ ux_icon('circle-plus') }} {{ 'Add requirement'|trans }}
                            </button>
                            {% set routeParams = getRouteParams()|merge({ advancedSearch: true }) %}
                            <a href="{{ url(getRoute(), routeParams) }}" class="btn btn-sm">
                                {{ ux_icon('circle-cross') }}
                                {{ 'Reset filter'|trans }}
                            </a>
                        {% endblock %}
                    </div>
                    <div class="col-auto">
                        {% block advanced_search_submit %}
                            <input type="submit" value="{{ 'Search [verb]'|trans }}" class="btn btn-primary">
                        {% endblock %}
                    </div>
                </div>
            {% endblock %}
        </div>
    {{ form_end(advancedSearchForm) }}
{% endblock %}