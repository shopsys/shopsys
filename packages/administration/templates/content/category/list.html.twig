{% extends '@ShopsysAdministration/layout/layout_with_panel.html.twig' %}
{% import _self as self %}

{% block title %}- {{ 'Categories'|trans }}{% endblock %}

{% block pre_title %}{{ 'Overview'|trans }}{% endblock %}
{% block h1 %}{{ 'Categories'|trans }}{% endblock %}


{% block btn %}
    <a href="{{ url('admin_category_new') }}" class="btn btn-primary">
        {{ ux_icon('plus') }}
        {{ 'Create new category'|trans }}
    </a>
{% endblock %}

{% block main_content %}
    {{ render(controller('Shopsys\\FrameworkBundle\\Controller\\Admin\\DomainFilterController::domainFilterTabsAction', { namespace: domainFilterNamespace })) }}

    {% macro categoryTreeItem(categoriesWithPreloadedChildren, isFirstLevel, disabledFormFields, allCategoryIdsInSeoMixes, visibilityOfCategoriesIndexedById, isForAllDomains) %}
        {% import _self as self %}
        <ul class="{{ disabledFormFields ? '' : 'js-category-tree-items ' }}{{ isFirstLevel ? 'tree' : 'tree-group' }}">
            {% for categoryWithPreloadedChildren in categoriesWithPreloadedChildren %}
                {% set category = categoryWithPreloadedChildren.category %}
                {% set categoryHasSeoMix = categoryWithPreloadedChildren.category.id in allCategoryIdsInSeoMixes ? true : false %}

                <li class="js-category-tree-item tree-item" id="js-category-tree-{{ categoryWithPreloadedChildren.category.id }}">
                    <div class="tree-item-content{{ disabledFormFields ? '' : ' js-category-tree-item-line' }}">
                        <div class="js-category-tree-item-line js-category-tree-item-handle tree-item-label text-truncate{% if isForAllDomains %} cursor-grab{% endif %}">
                            {{ categoryWithPreloadedChildren.category.name|nameWithFallbackOnEmpty }}
                        </div>

                        <div class="tree-item-actions">
                            {% if visibilityOfCategoriesIndexedById is not null %}
                                {% if visibilityOfCategoriesIndexedById[category.id] is defined %}
                                    {% if visibilityOfCategoriesIndexedById[category.id] is same as('all') %}
                                        <span class="text-success" title="{{ 'Category is visible on all domains'|trans }}">
                                            {{ ux_icon('visible') }}
                                        </span>
                                    {% else %}
                                        <span class="text-warning" title="{{ 'Category is visible on some domains'|trans }}">
                                            {{ ux_icon('visible') }}
                                        </span>
                                    {% endif %}
                                {% else %}
                                    <span title="{{ 'Category is hidden on all domains'|trans }}">
                                        {{ ux_icon('invisible') }}
                                    </span>
                                {% endif %}
                            {% endif %}

                            <a href="{{ url('admin_category_edit', {id: categoryWithPreloadedChildren.category.id}) }}"
                               class="link-secondary"
                            >{{ ux_icon('pencil') }}</a>

                            {% set csrfTokenId = constant('Shopsys\\FrameworkBundle\\Component\\Router\\Security\\RouteCsrfProtector::CSRF_TOKEN_ID_PREFIX') ~ 'admin_category_delete' %}
                            {% set categoryDeleteUrl = url('admin_category_delete', {
                                id: categoryWithPreloadedChildren.category.id,
                                (constant('Shopsys\\FrameworkBundle\\Component\\Router\\Security\\RouteCsrfProtector::CSRF_TOKEN_REQUEST_PARAMETER')): csrf_token(csrfTokenId)
                            }) %}
                            <a href="{{ categoryDeleteUrl }}"
                               class="link-secondary"
                               data-confirm-window
                               data-confirm-message="{{ categoryHasSeoMix ? 'Do you really want to remove this category even with their SEO mixes?'|trans : 'Do you really want to delete this category?'|trans }}"
                            >{{ ux_icon('trash') }}</a>
                        </div>
                    </div>

                    {{ self.categoryTreeItem(categoryWithPreloadedChildren.children, false, disabledFormFields, allCategoryIdsInSeoMixes, visibilityOfCategoriesIndexedById, isForAllDomains) }}
                </li>
            {% endfor %}
        </ul>
    {% endmacro %}

    <div class="card">
        <div class="card-body">
            {% if isForAllDomains %}
                <div id="js-category-tree-sorting">

                    {{ self.categoryTreeItem(categoriesWithPreloadedChildren, true, disabledFormFields, allCategoryIdsInSeoMixes, visibilityOfCategoriesIndexedById, isForAllDomains) }}
                </div>

                {% if can_edit(constant('Shopsys\\FrameworkBundle\\Component\\Security\\Role\\AdminRoleConstant::ROLE_CATEGORY')) %}
                    {% embed '@ShopsysAdministration/partial/_fixed_bar.html.twig' %}
                        {% block fixed_bar_content %}
                            <button class="btn"
                                    disabled
                                    id="js-category-tree-sorting-save-button"
                                    data-category-apply-sorting-url="{{ url('admin_category_applysorting') }}"
                                    type="button"
                            >
                                {{ 'Save changes in order'|trans }}
                            </button>
                        {% endblock %}
                    {% endembed %}
                {% endif %}
            {% else %}
                {% if disabledFormFields == false %}
                    <div class="alert alert-warning">
                        {{ ux_icon('warning') }}
                        {{ 'In a particular domain tab it is not possible to adjust the order and plunge of categories. Please go to the category detail or to overview of categories of all domains'|trans }}
                    </div>
                {% endif %}

                {{ self.categoryTreeItem(categoriesWithPreloadedChildren, true, disabledFormFields, allCategoryIdsInSeoMixes, visibilityOfCategoriesIndexedById, isForAllDomains) }}
            {% endif %}
        </div>
    </div>
{% endblock %}
