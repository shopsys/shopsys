{% extends '@ShopsysAdministration/content/product/listGrid.html.twig' %}

{% block grid_action_cell_type_edit %}{% endblock %}

{% block grid_value_cell_id_name_product_name %}
    {{ row.name|nameWithFallbackOnEmpty }}
{% endblock %}

{% block grid_value_cell_id_select %}
    {%- if not allowMainVariants and row.variantType == VARIANT_TYPE_MAIN %}
        {{ info_icon('You cannot choose product that is main variant'|trans) }}
    {% elseif not allowVariants and row.variantType == VARIANT_TYPE_VARIANT %}
        {{ info_icon('You cannot choose product that is variant'|trans) }}
    {% elseif isMultiple %}
        <a href="#"
           class="{% if withPrice %}js-price-list-product-picker-window-add-product{% else %}js-products-picker-window-add-product{% endif %} btn btn-sm align-items-baseline"
           data-product-picker-instance-id="{{ jsInstanceId }}"
           data-product-picker-basic-price-url="{{ url('admin_productpicker_basicproductprice') }}"
           data-product-picker-product-image-url="{{ url('admin_productpicker_productimage') }}"
           data-product-picker-product-id="{{ row.id }}"
           data-product-picker-domain-id="{{ domainId }}"
           data-product-picker-product-name="{{ row.name }}"
           data-product-picker-product-price="{{ row.priceForProductList ? row.priceForProductList.amount|round(2) : 0 }}"
           data-product-picker-product-ean="{{ row.ean }}"
           data-product-picker-product-catnum="{{ row.catnum }}"
        >
            <span class="js-products-picker-icon icon-wrapper">
                {{ ux_icon('plus') }}
            </span>
            <span class="js-products-picker-label">
                {{ 'Add'|trans }}
            </span>
        </a>
    {% else %}
        <button type="button"
                class="btn btn-sm align-items-baseline"
                data-js-single-picker-window-select
                data-picker-instance-id="{{ jsInstanceId }}"
                data-picker-id="{{ row.id }}"
                data-picker-name="{{ row.name }}"
        >
            <span class="js-products-picker-icon icon-wrapper">
                {{ ux_icon('plus') }}
            </span>
            <span class="js-products-picker-label">
                {{ 'Choose'|trans }}
            </span>
        </button>
    {% endif %}
{% endblock %}
