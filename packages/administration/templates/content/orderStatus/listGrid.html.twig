{% extends '@ShopsysAdministration/datagrid/grid.html.twig' %}

{% block grid_action_cell_type_delete %}
    {% if row.os.type == TYPE_NEW %}
        <span title="{{ 'This status can\'t be deleted. This is automatically assigned status to all new orders.'|trans }}"
              class="cursor-help px-1"
              data-bs-toggle="tooltip"
        >
            {{ ux_icon('info') }}
        </span>
    {% elseif row.os.type == TYPE_DONE %}
        <span title="{{ 'This status can\'t be deleted, because there is a functionality bounded to it - it identifies orders that were successfully processed.'|trans }}"
              class="cursor-help px-1"
              data-bs-toggle="tooltip"
        >
            {{ ux_icon('info') }}
        </span>
    {% elseif row.os.type == TYPE_CANCELED %}
        <span title="{{ 'This status can\'t be deleted, because there is a functionality bounded to it - it identifies orders that were not successfully processed.'|trans }}"
              class="cursor-help px-1"
              data-bs-toggle="tooltip"
        >
            {{ ux_icon('info') }}
        </span>
    {% elseif row.os.type == TYPE_WITHDRAWN %}
        <span title="{{ 'This status can\'t be deleted, because there is a functionality bounded to it - it identifies orders with withdrawal requests.'|trans }}"
              class="cursor-help px-1"
              data-bs-toggle="tooltip"
        >
            {{ ux_icon('info') }}
        </span>
    {% else %}
        {{ gridView.renderBlock('grid_action_cell', {actionColumn: actionColumn, row: row}) }}
    {% endif %}
{% endblock %}

{% block grid_value_cell_id_name %}
    {% if row.os.type is same as(constant('Shopsys\\FrameworkBundle\\Model\\Order\\Status\\OrderStatusTypeEnum::TYPE_NEW')) %}
        {% set status_class = 'yellow' %}
    {% elseif row.os.type is same as(constant('Shopsys\\FrameworkBundle\\Model\\Order\\Status\\OrderStatusTypeEnum::TYPE_DONE')) %}
        {% set status_class = 'green' %}
    {% elseif row.os.type is same as(constant('Shopsys\\FrameworkBundle\\Model\\Order\\Status\\OrderStatusTypeEnum::TYPE_CANCELED')) %}
        {% set status_class = 'red' %}
    {% elseif row.os.type is same as(constant('Shopsys\\FrameworkBundle\\Model\\Order\\Status\\OrderStatusTypeEnum::TYPE_WITHDRAWN')) %}
        {% set status_class = 'black' %}
    {% else %}
        {% set status_class = 'blue' %}
    {% endif %}

    <span class="status status-{{ status_class }}">
        <span class="status-dot"></span>
        {{ value }}
    </span>
{% endblock %}

{% block grid_no_data %}
    {{ 'No orders status found.'|trans }}
{% endblock %}

{% block grid_pager_totalcount %}
    {% set entityName = 'order statuses'|trans %}
    {{ parent() }}
{% endblock %}

{% block grid_inline_edit_add_button %}
    {% set addEntity = 'Create new order status'|trans %}
    {{ parent() }}
{% endblock %}
