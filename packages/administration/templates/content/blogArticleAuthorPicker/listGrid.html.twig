{% extends '@ShopsysAdministration/datagrid/grid.html.twig' %}

{% block grid_value_cell_id_select %}
    <button type="button"
            class="js-single-picker-window-select btn btn-sm align-items-baseline"
            data-picker-instance-id="{{ jsInstanceId }}"
            data-picker-id="{{ row.ba.id }}"
            data-picker-name="{{ row.ba.name }}"
    >
        <span class="icon-wrapper">
            {{ ux_icon('plus') }}
        </span>
        <span>
            {{ 'Choose'|trans }}
        </span>
    </button>
{% endblock %}
