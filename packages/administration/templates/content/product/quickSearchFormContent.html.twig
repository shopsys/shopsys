{{ form_start(quickSearchForm) }}
    <div class="mb-3">
        <div class="input-group input-group-flat">
            {{ form_widget(quickSearchForm.text, { attr:
                {
                    placeholder: 'Search by name, catalog number, or product part number...'|trans
                }
            }) }}
            <span class="input-group-text">
                {{ info_icon('Searching searches in name, catalog number or product part number. It is possible to use wildcards * and ?.'|trans) }}
                </span>
            {{ form_widget(quickSearchForm.submit, { label: 'Search [verb]'|trans, attr: { class: 'btn'}, full_name: '' }) }}
        </div>
    </div>
{{ form_end(quickSearchForm) }}
