<h4>
    {{ 'Sellability on each domain'|trans }}
</h4>
<p>
    {% for domain in domains %}
        {% set url = findUrlByDomainId('front_product_detail', { id: product.id }, domain.id) %}
        {% set isSellable = isSellableOnDomain(product, domain.id) %}

        {% if isSellable %}
            {% set sellabilityClass = 'text-green' %}
            {% set sellabilityIcon = 'cart' %}
            {% set sellabilityTitle = 'Yes'|trans %}
        {% else %}
            {% set sellabilityClass = 'text-secondary' %}
            {% set sellabilityIcon = 'cart-off' %}
            {% set sellabilityTitle = 'No'|trans %}
        {% endif %}

        <div class="row align-items-center mb-3">
            <div class="col-auto {{ sellabilityClass }}" title="{{ sellabilityTitle }}">
                {{ ux_icon(sellabilityIcon) }}
            </div>

            {% if isMultidomain() %}
                <div class="col-auto">
                    {{ domain_icon(domain.id) }}
                </div>
            {% endif %}

            <div class="col">
                {% if isSellable %}
                    <a href="{{ url }}" class="" target="_blank">
                        {{ getDomainName(domain.id) }}
                        {{ ux_icon('forward-page') }}
                    </a>
                {% else %}
                    {{ getDomainName(domain.id) }}
                {% endif %}
            </div>
        </div>
    {% endfor %}
</p>
