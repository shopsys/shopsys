{% extends '@ShopsysAdministration/layout/layout_with_panel.html.twig' %}

{% block title %}- {{ 'Products overview'|trans }}{% endblock %}

{% block h1 %}{{ 'Products'|trans }}{% endblock %}
{% block pre_title %}{{ 'Overview'|trans }}{% endblock %}

{% block btn %}
    {% if productCanBeCreated %}
        <a href="{{ url('admin_product_createvariant') }}" class="btn btn-secondary">
            {{ ux_icon('plus') }}{{ 'Create variant'|trans }}
        </a>
        <a href="{{ url('admin_product_new') }}" class="btn btn-primary">
            {{ ux_icon('plus') }}{{ 'Create new product'|trans }}
        </a>
    {% else %}

    {% endif %}
{% endblock %}

{% block main_content %}
    <div class="card">
        <div class="card-header">
            <ul class="nav nav-tabs card-header-tabs" data-bs-toggle="tabs">
                <li class="nav-item">
                    <a href="#quick"
                       class="nav-link{{ not isAdvancedSearchFormSubmitted ? ' active' }}"
                       data-bs-toggle="tab"
                    >
                        {{ 'Quick search'|trans }}
                    </a>
                </li>
                <li class="nav-item">
                    <a href="#advanced"
                       class="nav-link{{ isAdvancedSearchFormSubmitted ? ' active' }}"
                       data-bs-toggle="tab"
                    >
                        {{ 'Advanced search'|trans }}
                    </a>
                </li>
            </ul>
        </div>
        <div class="card-body">
            <div class="tab-content">
                <div class="tab-pane{{ not isAdvancedSearchFormSubmitted ? ' active show' }}" id="quick">
                    {% include '@ShopsysAdministration/content/product/quickSearchFormContent.html.twig'
                        with {quickSearchForm: quickSearchForm} %}
                </div>
                <div class="tab-pane{{ isAdvancedSearchFormSubmitted ? ' active show' }}" id="advanced">
                    {% include '@ShopsysAdministration/content/product/advancedSearch/advancedSearch.html.twig'
                        with {advancedSearchForm: advancedSearchForm} %}
                </div>
            </div>
        </div>
    </div>

    {{ form_start(massActionForm) }}
    <div class="wrap-divider wrap-divider--bottom">
        <div class="js-product-list-with-filter">
            <div class="box-mass-action" id="js-mass-action">
                    <span class="box-mass-action__click" id="js-mass-action-button">
                        {{ 'Bulk edit'|trans }}:
                        {{ ux_icon('arrow', { class: 'box-mass-action__click__icon' }) }}
                    </span>
                <div class="box-mass-action__content">
                    <strong class="box-mass-action__title">
                        {{ 'Change for'|trans }}:
                    </strong>
                    <div class="box-mass-action__filter">
                        <div class="box-mass-action__filter__line__item">
                            {{ form_widget(massActionForm.selectType, { attr: { class: 'js-mass-action-select-type' } , isSimple: true }) }}
                        </div>
                    </div>
                    <div class="box-mass-action__filter">
                        <strong class="box-mass-action__title">
                            {{ 'Make modification'|trans }}:
                        </strong>

                        <div class="box-mass-action__filter__line">
                            <div class="box-mass-action__filter__line__item">
                                {{ form_widget(massActionForm.action , { isSimple: true }) }}
                            </div>

                            <div class="box-mass-action__filter__line__item">
                                {{ form_widget(massActionForm.subject, { isSimple: true }) }}
                            </div>

                            <div class="box-mass-action__filter__line__item">
                                {{ form_widget(massActionForm.value, { attr: { class: 'js-mass-action-value' }, isSimple: true }) }}
                            </div>
                        </div>

                        <div class="box-mass-action__filter__line box-mass-action__filter__line--submit">
                            <div class="box-mass-action__filter__line__item">
                                {{ form_widget(massActionForm.submit, { label: 'Make modification'|trans, attr: { class: 'btn btn--primary btn--medium js-mass-action-submit' } }) }}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {{ gridView.render() }}
    {{ gridView.renderHiddenInputs('page') }}
    {{ form_end(massActionForm) }}
{% endblock %}
