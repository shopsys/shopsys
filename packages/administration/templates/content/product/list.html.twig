{% extends '@ShopsysAdministration/layout/layout_with_panel.html.twig' %}

{% block title %}- {{ 'Products overview'|trans }}{% endblock %}

{% block h1 %}{{ 'Products'|trans }}{% endblock %}
{% block pre_title %}{{ 'Overview'|trans }}{% endblock %}

{% block btn %}
    {% if productCanBeCreated %}
        <a href="{{ url('admin_product_createvariant') }}" class="btn btn-secondary">
            {{ ux_icon('plus') }}{{ 'Create variant'|trans }}
        </a>
        <a href="{{ url('admin_product_new') }}" class="btn btn-primary">
            {{ ux_icon('plus') }}{{ 'Create new product'|trans }}
        </a>
    {% else %}

    {% endif %}
{% endblock %}

{% block main_content %}
    <div class="card">
        <div class="card-header">
            <ul class="nav nav-tabs card-header-tabs" data-bs-toggle="tabs">
                <li class="nav-item">
                    <a href="#quick"
                       class="nav-link{{ not isAdvancedSearchFormSubmitted ? ' active' }}"
                       data-bs-toggle="tab"
                    >
                        {{ 'Quick search'|trans }}
                    </a>
                </li>
                <li class="nav-item">
                    <a href="#advanced"
                       class="nav-link{{ isAdvancedSearchFormSubmitted ? ' active' }}"
                       data-bs-toggle="tab"
                    >
                        {{ 'Advanced search'|trans }}
                    </a>
                </li>
                <li class="nav-item">
                    <a href="#bulk-edit"
                       class="nav-link"
                       data-bs-toggle="tab"
                    >
                        {{ 'Bulk edit'|trans }}
                    </a>
                </li>
            </ul>
        </div>
        <div class="card-body">
            <div class="tab-content">
                <div class="tab-pane{{ not isAdvancedSearchFormSubmitted ? ' active show' }}" id="quick">
                    {{ form_start(quickSearchForm) }}
                    {% include '@ShopsysAdministration/partial/_quick_search_form.html.twig' with {
                        form_input: quickSearchForm.text,
                        form_submit: quickSearchForm.submit,
                        hide_title: true,
                        placeholder: 'Search by name, catalog number, product part number, or UUID...'|trans,
                        info_message: 'Searching searches in <ul><li>name</li><li>catalog number</li><li>product part number</li><li>UUID</li></ul> It is possible to use wildcards * and ?.'|trans,
                    } %}
                    {{ form_end(quickSearchForm) }}
                </div>
                <div class="tab-pane{{ isAdvancedSearchFormSubmitted ? ' active show' }}" id="advanced">
                    {% include '@ShopsysAdministration/content/advancedSearch/advancedSearch.html.twig'
                        with {advancedSearchForm: advancedSearchForm} %}
                </div>
                <div class="tab-pane" id="bulk-edit">
                    {{ form_start(massActionForm) }}

                    <div class="mb-4">
                        <strong class="text-body-secondary mb-2 d-inline-block fw-semibold">{{ 'Change for'|trans }}:</strong>
                        {{ form_widget(massActionForm.selectType, { attr: { class: 'js-mass-action-select-type' } , isSimple: true }) }}
                    </div>

                    <div class="mb-4">
                        <strong class="text-body-secondary mb-2 d-inline-block fw-semibold">{{ 'Make modification'|trans }}:</strong>
                        <div class="row">
                            <div class="col-12 col-lg mb-2 mb-lg-0">
                                {{ form_widget(massActionForm.action , { isSimple: true }) }}
                            </div>
                            <div class="col-12 col-lg mb-2 mb-lg-0">
                                {{ form_widget(massActionForm.subject, { isSimple: true }) }}
                            </div>
                            <div class="col-12 col-lg">
                                {{ form_widget(massActionForm.value, { attr: { class: 'js-mass-action-value' }, isSimple: true }) }}
                            </div>
                        </div>
                    </div>
                    {{ form_widget(massActionForm.submit, { label: 'Make modification'|trans, attr: { class: 'btn js-mass-action-submit' } }) }}
                </div>
            </div>
        </div>
    </div>

    {{ gridView.render() }}
    {{ gridView.renderHiddenInputs('page') }}
    {{ form_end(massActionForm) }}
{% endblock %}
