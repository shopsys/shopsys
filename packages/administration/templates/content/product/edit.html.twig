{% extends '@ShopsysAdministration/content/product/detail.html.twig' %}

{% block title %}- {{ 'Editing product'|trans }} - {{ product.name }}{% endblock %}

{% block pre_title %}{{ 'Editing product'|trans}}{% endblock %}
{% block h1 %}{{ product.name|default(product.catnum) }}{% endblock %}

{% block btn_wrapper %}
    {{ block('product_visibilities') }}
{% endblock %}

{% block product_visibilities %}
    {% if isVisibleForDefaultPricingGroupOnEachDomain(product) %}
        {% set visibilityClass = 'text-green' %}
        {% set visibilityIcon = 'visible' %}
    {% elseif isVisibleForDefaultPricingGroupOnSomeDomain(product) %}
        {% set visibilityClass = 'text-orange' %}
        {% set visibilityIcon = 'visible' %}
    {% else %}
        {% set visibilityClass = 'text-secondary' %}
        {% set visibilityIcon = 'invisible' %}
    {% endif %}

    {% if product.isSellableOnAllDomains() %}
        {% set sellabilityClass = 'text-green' %}
        {% set sellabilityIcon = 'cart' %}
    {% elseif product.isSellableOnAnyDomain() %}
        {% set sellabilityClass = 'text-orange' %}
        {% set sellabilityIcon = 'cart' %}
    {% else %}
        {% set sellabilityClass = 'text-secondary' %}
        {% set sellabilityIcon = 'cart-off' %}
    {% endif %}

    {% if isMultidomain() %}
        <div class="dropdown"
             data-bs-toggle="popover"
             data-bs-trigger="click"
             data-bs-html="true"
             data-bs-content="{{ 'Loading'|trans }}..."
             data-bs-container="body"
             data-bs-placement="left"
             data-content-url="{{ url('admin_product_visibility', {productId: product.id}) }}"
        >
            <button type="button" class="btn">
                <span class="{{ visibilityClass }}">{{ ux_icon(visibilityIcon) }}</span>
                <span class="{{ sellabilityClass }}">{{ ux_icon(sellabilityIcon) }}</span>
                {{ 'Preview'|trans }}
            </button>
        </div>
    {% else %}
        {{ render(controller('Shopsys\\FrameworkBundle\\Controller\\Admin\\ProductController::visibilityAction', { productId: product.id, withHeadline: false })) }}
    {% endif %}
{% endblock %}
