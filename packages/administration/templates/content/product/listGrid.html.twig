{% extends '@ShopsysAdministration/datagrid/grid.html.twig' %}

{% block grid_no_data %}
    {{ 'No product found.'|trans }}
{% endblock %}

{% block grid_value_cell_id_name %}
    {% if row.productType == TYPE_INQUIRY %}
        <span class="cursor-help badge badge-pill bg-indigo-lt"
              data-bs-toggle="tooltip"
              data-bs-placement="top"
              title="{{ 'Upon inquiry'|trans }}"
        >
            {{ 'Upon inquiry [abbreviation]'|trans }}
        </span>
    {% endif %}
    {% if row.variantType == VARIANT_TYPE_MAIN %}
        <span class="cursor-help badge badge-pill bg-lime-lt"
              data-bs-toggle="tooltip"
              data-bs-placement="top"
              title="{{ 'Main variant'|trans }}"
        >
            {{ 'Main variant [abbreviation]'|trans }}
        </span>
    {% endif %}
    {% if row.variantType == VARIANT_TYPE_VARIANT %}
        <span class="cursor-help badge badge-pill bg-cyan-lt"
              data-bs-toggle="tooltip"
              data-bs-placement="top"
              title="{{ 'Variant'|trans }}"
        >
            {{ 'Variant [abbreviation]'|trans }}
        </span>
    {% endif %}
    {% block grid_value_cell_id_name_product_name %}
        <a href="{{ url('admin_product_edit', { id: row.id }) }}">{{ row.name|productListDisplayNameByName }}</a>
    {% endblock %}
{% endblock %}

{% block grid_value_cell_id_visibility %}
    {% if isMultidomain() %}
        <span data-bs-toggle="popover"
              data-bs-trigger="click"
              data-bs-html="true"
              data-bs-content="{{ 'Loading'|trans }}..."
              data-bs-container="body"
              data-content-url="{{ url('admin_product_visibility', {productId: row.id}) }}"
              class="position-relative cursor-pointer"
        >
            {% if row.isVisible %}
                {% set visibilityClass = 'text-green' %}
                {% set visibilityIcon = 'visible' %}
            {% elseif row.isVisibleOnSomeDomain %}
                {% set visibilityClass = 'text-orange' %}
                {% set visibilityIcon = 'visible' %}
            {% else %}
                {% set visibilityClass = 'text-secondary' %}
                {% set visibilityIcon = 'invisible' %}
            {% endif %}
            <span class="{{ visibilityClass }}">
                {{ ux_icon(visibilityIcon) }}
            </span>
        </span>

        <span data-bs-toggle="popover"
              data-bs-trigger="click"
              data-bs-html="true"
              data-bs-content="{{ 'Loading'|trans }}..."
              data-bs-container="body"
              data-content-url="{{ url('admin_product_sellability', {productId: row.id}) }}"
              class="position-relative cursor-pointer"
        >
            {% if row.sellingDeniedDomainsCount == getDomainsCount() %}
                {% set sellabilityClass = 'text-secondary' %}
                {% set sellabilityIcon = 'cart-off' %}
            {% elseif row.isVisibleOnSomeDomain %}
                {% set sellabilityClass = 'text-orange' %}
                {% set sellabilityIcon = 'cart' %}
            {% else %}
                {% set sellabilityClass = 'text-green' %}
                {% set sellabilityIcon = 'cart' %}
            {% endif %}
            <span class="{{ sellabilityClass }}">
                {{ ux_icon(sellabilityIcon) }}
            </span>
        </span>
    {% else %}
        {% if row.isVisible %}
            <a href="{{ findUrlByDomainId('front_product_detail', { id: row.id }, getFirstDomain().id) }}">
                {{ ux_icon('visible') }}
            </a>
        {% else %}
            {{ ux_icon('invisible') }}
        {% endif %}

        {% if row.sellingDeniedDomainsCount > 0 %}
            {% set sellabilityIcon = 'cart-off' %}
            {% set sellabilityTitleTitle = 'Product excluded from sale'|trans %}
        {% else %}
            {% set sellabilityIcon = 'cart' %}
            {% set sellabilityTitleTitle = 'Product is sellable'|trans %}
        {% endif %}
        <span data-bs-toggle="popover"
              data-bs-trigger="hover"
              data-bs-content="{{ sellabilityTitleTitle }}"
        >
            {{ ux_icon(sellabilityIcon) }}
        </span>
    {% endif %}
{% endblock %}

{% block grid_pager_totalcount %}
    {% set entityName = 'products'|trans %}
    {{ parent() }}
{% endblock %}
