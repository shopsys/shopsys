{% extends '@ShopsysAdministration/layout/layout_error.html.twig' %}

{% block title %}- {{ 'Reset administrator password'|trans }}{% endblock %}

{% block error_content %}
    <div class="empty-icon">{{ ux_icon('mood-confused') }}</div>
    <p class="empty-title">{{ 'Invalid reset password hash for administrator'|trans }}</p>
    <p class="empty-subtitle text-secondary">
        {{ 'The password reset link you used is invalid, expired, or has already been used.'|trans }}<br>
        {{ 'For security reasons, password reset links are only valid for a limited time.'|trans }}
    </p>
    <div class="empty-action">
        <a href="{{ url('admin_login') }}" class="btn btn-primary btn-4">
            {{ ux_icon('chevron-left', {class: 'me-2'}) }}
            {{ 'Go to login page'|trans }}
        </a>
    </div>
{% endblock %}
