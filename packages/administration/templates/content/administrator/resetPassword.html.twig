{% extends '@ShopsysAdministration/layout/layout_blank.html.twig' %}

{% block title %}- {{ 'Reset administrator password'|trans }}{% endblock %}

{% block content %}
    <div class="container container-tight py-4">
        <div class="text-center mb-4">
            <a href="." class="navbar-brand navbar-brand-autodark">
                <a href="{{ url('admin_default_dashboard') }}">
                    <img class="navbar-brand-image" src="{{ asset('public/admin/images/logo.svg') }}" width="110" alt="Shopsys Platform">
                </a>
            </a>
        </div>
        {{ form_start(form, {attr: {class: 'card card-md'}}) }}
        <div class="card-body">
            {{ form_errors(form) }}

            <h2 class="card-title text-center mb-4">{{ 'Reset password'|trans }}</h2>
            <p class="text-secondary mb-4">{{ 'Create a strong new password to secure your account.'|trans }}</p>

            {{ form_row(form.password) }}

            <div class="form-footer">
                {{ form_widget(form.save, {
                    attr: {class: 'btn btn-primary btn-4 w-100'},
                    label_html: true,
                    label: (ux_icon('lock', {class: 'me-1'}) ~ 'Reset password')
                }) }}
            </div>
        </div>
        {{ form_end(form) }}
        <div class="text-center text-secondary mt-3">
            {{ '<a href="%url%">Go back</a> to login page.'|trans({ '%url%': url('admin_login') })|raw }}
        </div>
    </div>
{% endblock %}
