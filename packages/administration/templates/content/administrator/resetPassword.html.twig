{% extends '@ShopsysAdministration/layout/layout_box_center.html.twig' %}
{% form_theme form '@ShopsysAdministration/form/vertical.html.twig' %}

{% block title %}- {{ 'Reset administrator password'|trans }}{% endblock %}

{% block before_content %}
    <div class="text-center mb-4">
        <a href="." class="navbar-brand navbar-brand-autodark">
            <a href="{{ url('admin_default_dashboard') }}">
                <img class="navbar-brand-image" src="{{ asset('public/admin/images/logo.svg') }}" width="110" alt="Shopsys Platform">
            </a>
        </a>
    </div>
{% endblock %}

{% block heading %}
    {{ 'Reset password'|trans }}
{% endblock %}

{% block content %}
    {{ form_start(form) }}
    {{ form_errors(form) }}

    <p class="text-secondary mb-4">{{ 'Create a strong new password to secure your account.'|trans }}</p>

    {{ form_row(form.password) }}

    <div class="form-footer">
        {{ form_widget(form.save, {
            attr: {class: 'btn btn-primary w-100'},
            label_html: true,
            label: (ux_icon('lock', {class: 'me-1'}) ~ 'Reset password'|trans)
        }) }}
    </div>
    {{ form_end(form) }}
{% endblock %}

{% block after_content %}
    <div class="text-center text-secondary mt-3">
        {{ '<a href="%url%">Go back</a> to login page.'|trans({ '%url%': url('admin_login') })|raw }}
    </div>
{% endblock %}
