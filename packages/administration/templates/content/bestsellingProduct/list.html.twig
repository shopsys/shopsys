{% extends '@ShopsysAdministration/layout/layout_with_panel.html.twig' %}
{% import _self as self %}

{% block title %}- {{ 'Bestsellers'|trans }}{% endblock %}

{% block pre_title %}{{ 'Overview'|trans }}{% endblock %}
{% block h1 %}{{ 'Bestsellers'|trans }}{% endblock %}

{% block main_content %}
    {% import _self as self %}

    {{ render(controller('Shopsys\\FrameworkBundle\\Controller\\Admin\\DomainController::domainTabsAction')) }}

    <div class="card">
        <div class="card-body">
            {{ self.categoryTreeItem(categoriesWithPreloadedChildren, true, selectedDomainId, bestsellingProductsInCategories) }}
        </div>
    </div>
{% endblock %}

{% macro categoryTreeItem(categoriesWithPreloadedChildren, isFirstLevel, selectedDomainId, bestsellingProductsInCategories) %}
    <ul class="{{ isFirstLevel ? 'tree' : 'tree-group' }}">
        {% for categoryWithPreloadedChildren in categoriesWithPreloadedChildren %}
            <li class="tree-item">
                <div class="tree-item-content">
                    <div class="tree-item-label text-truncate">
                        <a href="{{ url('admin_bestsellingproduct_detail', {categoryId: categoryWithPreloadedChildren.category.id, domainId: selectedDomainId}) }}">
                            {{ categoryWithPreloadedChildren.category.name }}
                        </a>

                        {% set count_color = bestsellingProductsInCategories[categoryWithPreloadedChildren.category.id] ? 'azure' %}
                        {% set badge_class = count_color > 0 ? ' bg-azure text-azure-fg' : '' %}
                        <span class="badge{{ badge_class }} ms-2">
                            {{ bestsellingProductsInCategories[categoryWithPreloadedChildren.category.id] }}
                        </span>
                    </div>
                </div>

                {{ self.categoryTreeItem(categoryWithPreloadedChildren.children, false, selectedDomainId, bestsellingProductsInCategories) }}
            </li>
        {% endfor %}
    </ul>
{% endmacro %}
