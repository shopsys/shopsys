{% extends '@ShopsysAdministration/datagrid/grid.html.twig' %}

{% block grid_value_cell_id_name %}
    <a href="{{ url('admin_store_edit', { id: row.s.id }) }}">{{ value }}</a>
    {% if row.s.isDefault %}
        <span class="badge badge-pill bg-secondary-lt">{{ 'default'|trans }}</span>
    {% endif %}
{% endblock %}

{% block grid_pager_totalcount %}
    {% set entityName = 'Store'|trans %}
    {{ parent() }}
{% endblock %}

{% block grid_no_data %}
    {{ 'No store is created. You have to create one first.'|trans }}
{% endblock %}

{% block grid_action_cell_type_delete %}
    {% if row.s.isDefault %}
        {{ info_icon('Default store cannot be removed'|trans) }}
    {% else %}
        {{ gridView.renderBlock('grid_action_cell', {actionColumn: actionColumn, row: row}) }}
    {% endif %}
{% endblock %}
