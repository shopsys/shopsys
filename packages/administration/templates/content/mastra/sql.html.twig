{% extends '@ShopsysAdministration/layout/layout_with_panel.html.twig' %}

{% block title %}- {{ 'SQL Assistant'|trans }}{% endblock %}

{% block pre_title %}{{ 'Integrations'|trans }}{% endblock %}
{% block h1 %}{{ 'SQL Database Assistant'|trans }}{% endblock %}

{% block main_content %}
    {# Chat Container #}
    <div class="card mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h3 class="card-title mb-0">{{ 'Conversation'|trans }}</h3>
            <div>
                <small class="text-muted me-3">
                    {{ 'Resource'|trans }}: <code>{{ resourceId }}</code> |
                    {{ 'Thread'|trans }}: <code>{{ threadId }}</code>
                </small>
                <a href="{{ url('admin_mastra_newsqlconversation') }}" class="btn btn-sm btn-outline-secondary">
                    {{ 'New Conversation'|trans }}
                </a>
            </div>
        </div>
        <div class="card-body" style="max-height: 600px; overflow-y: auto; background-color: #f8f9fa;" id="chat-container">
            <div id="messages-list">
                <div class="alert alert-info">
                    <h5>{{ 'Welcome to SQL Assistant'|trans }}</h5>
                    <p>{{ 'Ask questions about your Shopsys database in natural language.'|trans }}</p>
                    <p><strong>{{ 'Examples:'|trans }}</strong></p>
                    <ul>
                        <li>{{ 'Show me top 10 best-selling products'|trans }}</li>
                        <li>{{ 'How many orders were placed last month?'|trans }}</li>
                        <li>{{ 'List categories with the most products'|trans }}</li>
                        <li>{{ 'What are the most popular brands?'|trans }}</li>
                    </ul>
                    <p class="mb-0"><em>{{ 'All queries will be shown for review before execution.'|trans }}</em></p>
                </div>
            </div>
        </div>
    </div>

    {# Input Form #}
    <div class="card">
        <div class="card-body">
            <form id="mastra-form" onsubmit="return false;">
                <div class="mb-3">
                    <label for="message-input" class="form-label">{{ 'Your question'|trans }}</label>
                    <input id="message-input"
                           class="form-control"
                           type="text"
                           placeholder="{{ 'Ask about products, orders, customers...'|trans }}"
                    />
                </div>
                <button id="send-btn" class="btn btn-primary" type="submit">
                    {{ 'Send'|trans }}
                </button>
            </form>
        </div>
    </div>

    <style>
        .message {
            padding: 12px 16px;
            margin-bottom: 12px;
            border-radius: 8px;
            max-width: 90%;
        }
        .message-user {
            background-color: #0d6efd;
            color: white;
            margin-left: auto;
            text-align: right;
        }
        .message-assistant {
            background-color: white;
            border: 1px solid #dee2e6;
            margin-right: auto;
        }
        .message-loading {
            background-color: #e9ecef;
            margin-right: auto;
            font-style: italic;
            color: #6c757d;
        }
        .message-error {
            background-color: #f8d7da;
            border: 1px solid #f5c2c7;
            color: #842029;
            margin-right: auto;
        }
        .message-sql-preview {
            background-color: #fff3cd;
            border: 2px solid #ffc107;
            margin-right: auto;
        }
        .sql-code, .message-content pre {
            background-color: #f8f9fa;
            color: #212529;
            padding: 12px;
            border-radius: 4px;
            font-family: 'Courier New', monospace;
            font-size: 13px;
            overflow-x: auto;
            margin: 8px 0;
        }
        .message-content pre code {
            color: inherit;
            word-break: normal;
        }
        .sql-approval-buttons {
            margin-top: 12px;
        }
        .results-table {
            margin-top: 12px;
            overflow-x: auto;
        }
.results-table table {
            width: 100%;
            font-size: 13px;
        }
        .tool-call {
            margin-top: 8px;
        }
        .tool-call summary {
            cursor: pointer;
            font-weight: 600;
        }
        .tool-call-body {
            margin-top: 4px;
        }
        .tool-call-json {
            background-color: #f8f9fa;
            color: #212529; /* override theme light text color so it's visible on light background */
            padding: 8px;
            border-radius: 4px;
            font-family: 'Courier New', monospace;
            font-size: 12px;
            max-height: 260px;
            overflow: auto;
        }
    </style>

    <script>
        (function () {
            const threadId = '{{ threadId|e('js') }}';
            const resourceId = '{{ resourceId|e('js') }}';
            const form = document.getElementById('mastra-form');
            const sendBtn = document.getElementById('send-btn');
            const input = document.getElementById('message-input');
            const messagesList = document.getElementById('messages-list');
            const chatContainer = document.getElementById('chat-container');

            let lastUserQuestion = null;

            function isEmptyAgentResponse(json) {
                if (!json || typeof json !== 'object') {
                    return false;
                }

                const hasToolResults = Array.isArray(json.toolResults) && json.toolResults.length > 0;
                const hasText = typeof json.text === 'string' && json.text.trim().length > 0;

                let totalTokens = null;
                if (json.usage && typeof json.usage.totalTokens === 'number') {
                    totalTokens = json.usage.totalTokens;
                } else if (Array.isArray(json.steps) && json.steps[0]?.usage?.totalTokens !== undefined) {
                    totalTokens = json.steps[0].usage.totalTokens;
                }

                const zeroTokens = totalTokens === 0;

                return !hasToolResults && !hasText && zeroTokens;
            }

            function showAgentEmptyError(json, contextLabel, retryCallback) {
                console.error('[Mastra SQL Assistant] Empty agent response during ' + contextLabel, json);

                const container = document.createElement('div');

                const title = document.createElement('strong');
                title.textContent = '{{ 'The SQL assistant returned no output.'|trans }}';
                container.appendChild(title);

                const desc = document.createElement('p');
                desc.textContent = '{{ 'This is likely an internal error in the AI service. No SQL was executed.'|trans }}';
                container.appendChild(desc);

                const details = document.createElement('ul');
                details.style.fontSize = '12px';

                function addDetail(label, value) {
                    if (!value) {
                        return;
                    }
                    const li = document.createElement('li');
                    li.textContent = label + ': ' + value;
                    details.appendChild(li);
                }

                addDetail('Context', contextLabel);
                addDetail('Thread ID', json.threadId);
                addDetail('Resource ID', json.resourceId);
                addDetail('Trace ID', json.traceId);
                addDetail('Finish reason', json.finishReason || (Array.isArray(json.steps) && json.steps[0]?.finishReason));

                if (json.usage && typeof json.usage.totalTokens === 'number') {
                    addDetail('Total tokens', String(json.usage.totalTokens));
                }

                if (details.children.length > 0) {
                    const detailsTitle = document.createElement('p');
                    detailsTitle.textContent = '{{ 'Debug details for developers:'|trans }}';
                    container.appendChild(detailsTitle);
                    container.appendChild(details);
                }

                if (Array.isArray(json.warnings) && json.warnings.length > 0) {
                    const warningsTitle = document.createElement('p');
                    warningsTitle.textContent = '{{ 'Warnings:'|trans }}';
                    container.appendChild(warningsTitle);

                    const warningsList = document.createElement('ul');
                    warningsList.style.fontSize = '12px';

                    json.warnings.forEach((w) => {
                        const li = document.createElement('li');
                        li.textContent = typeof w === 'string' ? w : JSON.stringify(w);
                        warningsList.appendChild(li);
                    });

                    container.appendChild(warningsList);
                }

                if (typeof retryCallback === 'function') {
                    const actionsDiv = document.createElement('div');
                    actionsDiv.style.marginTop = '8px';

                    const retryBtn = document.createElement('button');
                    retryBtn.className = 'btn btn-warning btn-sm';
                    retryBtn.textContent = '{{ 'Retry'|trans }}';
                    retryBtn.onclick = () => {
                        retryCallback();
                    };

                    actionsDiv.appendChild(retryBtn);
                    container.appendChild(actionsDiv);
                }

                addMessage('assistant', container, 'error');
            }

            function renderMarkdown(md) {
                if (!md) {
                    return '';
                }

                let html = md;

                // Code blocks ``` ... ```
                html = html.replace(/```([\s\S]*?)```/g, (match, code) => {
                    const escaped = code
                        .replace(/&/g, '&amp;')
                        .replace(/</g, '&lt;')
                        .replace(/>/g, '&gt;');
                    return '<pre><code>' + escaped + '</code></pre>';
                });

                // Headings
                html = html.replace(/^######\s+(.+)$/gm, '<h6>$1</h6>');
                html = html.replace(/^#####\s+(.+)$/gm, '<h5>$1</h5>');
                html = html.replace(/^####\s+(.+)$/gm, '<h4>$1</h4>');
                html = html.replace(/^###\s+(.+)$/gm, '<h3>$1</h3>');
                html = html.replace(/^##\s+(.+)$/gm, '<h2>$1</h2>');
                html = html.replace(/^#\s+(.+)$/gm, '<h1>$1</h1>');

                // Bold and italic
                html = html.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
                html = html.replace(/__(.+?)__/g, '<strong>$1</strong>');
                html = html.replace(/\*(.+?)\*/g, '<em>$1</em>');
                html = html.replace(/_(.+?)_/g, '<em>$1</em>');

                // Inline code
                html = html.replace(/`([^`]+)`/g, (match, code) => {
                    const escaped = code
                        .replace(/&/g, '&amp;')
                        .replace(/</g, '&lt;')
                        .replace(/>/g, '&gt;');
                    return '<code>' + escaped + '</code>';
                });

                // Unordered lists
                html = html.replace(/(^|\n)([-*]\s+.+(\n[-*]\s+.+)*)/g, (match, prefix, list) => {
                    const items = list.split(/\n/).map(line => line.replace(/^[-*]\s+/, '').trim());
                    const lis = items.map(i => '<li>' + i + '</li>').join('');
                    return prefix + '<ul>' + lis + '</ul>';
                });

                // Ordered lists
                html = html.replace(/(^|\n)((\d+)\.\s+.+(\n\d+\.\s+.+)*)/g, (match, prefix, list) => {
                    const items = list.split(/\n/).map(line => line.replace(/^\d+\.\s+/, '').trim());
                    const lis = items.map(i => '<li>' + i + '</li>').join('');
                    return prefix + '<ol>' + lis + '</ol>';
                });

                // Paragraphs: split by blank lines
                const blocks = html.split(/\n{2,}/);
                html = blocks.map(block => {
                    const trimmed = block.trim();
                    if (!trimmed) {
                        return '';
                    }
                    if (/^<(h\d|ul|ol|pre|table|blockquote)/.test(trimmed)) {
                        return trimmed;
                    }
                    return '<p>' + trimmed + '</p>';
                }).join('\n');

                return html;
            }

            function scrollToBottom() {
                chatContainer.scrollTop = chatContainer.scrollHeight;
            }

            function createMessageElement(role, content, type = 'normal') {
                const messageDiv = document.createElement('div');
                messageDiv.className = 'message';

                if (type === 'loading') {
                    messageDiv.className += ' message-loading';
                } else if (type === 'error') {
                    messageDiv.className += ' message-error';
                } else if (type === 'sql-preview') {
                    messageDiv.className += ' message-sql-preview';
                } else if (role === 'user') {
                    messageDiv.className += ' message-user';
                } else {
                    messageDiv.className += ' message-assistant';
                }

                const contentDiv = document.createElement('div');
                contentDiv.className = 'message-content';

                if (typeof content === 'string') {
                    if (role === 'assistant' && type === 'normal') {
                        contentDiv.innerHTML = renderMarkdown(content);
                    } else {
                        contentDiv.innerHTML = content;
                    }
                } else {
                    contentDiv.appendChild(content);
                }

                messageDiv.appendChild(contentDiv);
                return messageDiv;
            }

            function addMessage(role, content, type = 'normal') {
                const welcomeAlert = messagesList.querySelector('.alert-info');
                if (welcomeAlert) {
                    welcomeAlert.remove();
                }

                const messageEl = createMessageElement(role, content, type);
                messagesList.appendChild(messageEl);
                scrollToBottom();
                return messageEl;
            }

            function formatProposal(text) {
                const container = document.createElement('div');

                const contentDiv = document.createElement('div');
                contentDiv.innerHTML = renderMarkdown(text);
                container.appendChild(contentDiv);

                const buttonsDiv = document.createElement('div');
                buttonsDiv.className = 'sql-approval-buttons';

                const approveBtn = document.createElement('button');
                approveBtn.className = 'btn btn-success btn-sm me-2';
                approveBtn.textContent = '{{ 'Execute'|trans }}';
                approveBtn.onclick = () => {
                    buttonsDiv.style.display = 'none';
                    executeApprovedQuery();
                };

                const cancelBtn = document.createElement('button');
                cancelBtn.className = 'btn btn-secondary btn-sm';
                cancelBtn.textContent = '{{ 'Cancel'|trans }}';
                cancelBtn.onclick = () => {
                    buttonsDiv.remove();
                    addMessage('user', '{{ 'Cancel'|trans }}');
                };

                buttonsDiv.appendChild(approveBtn);
                buttonsDiv.appendChild(cancelBtn);
                container.appendChild(buttonsDiv);

                return container;
            }

            function formatResults(data, rowCount) {
                if (!data || data.length === 0) {
                    return '<em>{{ 'No results found'|trans }}</em>';
                }

                const container = document.createElement('div');
                container.className = 'results-table';

                const summary = document.createElement('p');
                summary.innerHTML = `<strong>{{ 'Results:'|trans }}</strong> ${rowCount} {{ 'rows returned'|trans }}`;
                container.appendChild(summary);

                const table = document.createElement('table');
                table.className = 'table table-sm table-bordered table-striped';

                const thead = document.createElement('thead');
                const headerRow = document.createElement('tr');
                const firstRow = data[0];
                for (const key in firstRow) {
                    const th = document.createElement('th');
                    th.textContent = key;
                    headerRow.appendChild(th);
                }
                thead.appendChild(headerRow);
                table.appendChild(thead);

                const tbody = document.createElement('tbody');
                for (const row of data) {
                    const tr = document.createElement('tr');
                    for (const key in row) {
                        const td = document.createElement('td');
                        td.textContent = row[key] !== null ? row[key] : '(null)';
                        tr.appendChild(td);
                    }
                    tbody.appendChild(tr);
                }
                table.appendChild(tbody);
                container.appendChild(table);

                return container;
            }

            function createToolCallElement(toolName, state, input, output) {
                const details = document.createElement('details');
                details.className = 'tool-call';

                const summary = document.createElement('summary');
                const stateLabel = state ? ` (${state})` : '';
                summary.textContent = `${toolName}${stateLabel}`;
                details.appendChild(summary);

                const body = document.createElement('div');
                body.className = 'tool-call-body';

                const pre = document.createElement('pre');
                pre.className = 'tool-call-json';

                const payload = {};
                if (input && Object.keys(input).length > 0) {
                    payload.input = input;
                }
                if (output !== undefined && output !== null) {
                    payload.output = output;
                }

                try {
                    pre.textContent = JSON.stringify(payload, null, 2);
                } catch (e) {
                    pre.textContent = String(output ?? '');
                }

                body.appendChild(pre);
                details.appendChild(body);

                return details;
            }

            async function sendMessage(messageOverride = null) {
                const message = messageOverride !== null ? messageOverride : input.value.trim();
                if (!message) {
                    return;
                }

                if (messageOverride === null) {
                    input.value = '';
                }

                sendBtn.disabled = true;

                addMessage('user', message);
                lastUserQuestion = message;

                const loadingEl = addMessage('assistant', '{{ 'Processing your query...'|trans }}', 'loading');

                try {
                    const res = await fetch('/mastra/api/agents/sqlAgent/generate', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            messages: [{ role: 'user', content: message }],
                            threadId: threadId,
                            resourceId: resourceId,
                        })
                    });

                    loadingEl.remove();

                    if (!res.ok) {
                        const text = await res.text().catch(() => '');
                        throw new Error(`HTTP ${res.status}: ${text}`);
                    }

                    const json = await res.json();
                    const responseText = json?.text || '';

                    // Debug: Log the full response
                    console.log('Agent response:', json);
                    console.log('Response text:', responseText);

                    // Render any tool calls (e.g. databaseIntrospectionTool, sqlExecutionTool)
                    if (Array.isArray(json.toolResults)) {
                        json.toolResults.forEach((t) => {
                            const toolName = t.toolName || t.payload?.toolName || 'tool';
                            const input = t.args || t.payload?.args || {};
                            const output = t.result || t.payload?.result;
                            const state = t.state || 'output-available';
                            const toolEl = createToolCallElement(toolName, state, input, output);
                            addMessage('assistant', toolEl);
                        });
                    }

                    if (isEmptyAgentResponse(json)) {
                        showAgentEmptyError(json, 'SQL generation', () => {
                            if (lastUserQuestion) {
                                sendMessage(lastUserQuestion);
                            }
                        });
                        return;
                    }

                    const hasToolResults = Array.isArray(json.toolResults) && json.toolResults.length > 0;

                    if (hasToolResults) {
                        // Agent executed a tool (possibly SQL) directly in the generation step.
                        console.warn('[Mastra SQL Assistant] Agent executed tool(s) during SQL generation step (sendMessage).', json);

                        const executionResult = json.toolResults.find(t =>
                            t.toolName === 'sqlExecutionTool' ||
                            t.payload?.toolName === 'sqlExecutionTool'
                        );

                        if (executionResult) {
                            const result = executionResult?.payload?.result || executionResult?.result;

                            if (result && result.success) {
                                addMessage('assistant', formatResults(result.data, result.rowCount));
                            } else {
                                addMessage('assistant', result?.error || '{{ 'Query execution failed'|trans }}', 'error');
                            }

                            pendingQuery = null;
                            return;
                        }
                        // If there are only non-SQL tools (e.g. introspection), fall through to normal text handling below.
                    }

                    if (responseText.toUpperCase().includes('SELECT')) {
                        addMessage('assistant', formatProposal(responseText));
                    } else {
                        addMessage('assistant', responseText || '{{ 'No results'|trans }}');
                    }

                } catch (err) {
                    loadingEl.remove();
                    const errorMessage = '{{ 'Error'|trans }}: ' + (err?.message || err);
                    addMessage('assistant', errorMessage, 'error');
                } finally {
                    sendBtn.disabled = false;
                    input.focus();
                }
            }

            async function executeApprovedQuery() {
                const loadingEl = addMessage('assistant', '{{ 'Executing query...'|trans }}', 'loading');

                try {
                    const executionMessage = 'Approved, please execute.';

                    const res = await fetch('/mastra/api/agents/sqlAgent/generate', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            messages: [{ role: 'user', content: executionMessage }],
                            threadId: threadId,
                            resourceId: resourceId,
                        })
                    });

                    loadingEl.remove();

                    if (!res.ok) {
                        throw new Error(`HTTP ${res.status}`);
                    }

                    const json = await res.json();

                    // Debug: Log execution response
                    console.log('Execution response:', json);
                    console.log('Tool results:', json.toolResults);

                    // Render any tool calls for the execution step
                    if (Array.isArray(json.toolResults)) {
                        json.toolResults.forEach((t) => {
                            const toolName = t.toolName || t.payload?.toolName || 'tool';
                            const input = t.args || t.payload?.args || {};
                            const output = t.result || t.payload?.result;
                            const state = t.state || 'output-available';
                            const toolEl = createToolCallElement(toolName, state, input, output);
                            addMessage('assistant', toolEl);
                        });
                    }

                    if (isEmptyAgentResponse(json)) {
                        showAgentEmptyError(json, 'SQL execution', () => {
                            executeApprovedQuery();
                        });
                        return;
                    }

                    const hasToolResults = Array.isArray(json.toolResults) && json.toolResults.length > 0;
                    const hasText = typeof json.text === 'string' && json.text.trim().length > 0;

                    if (hasToolResults) {
                        // Tool name is 'sqlExecutionTool' not 'sql-execution'
                        const sqlResults = json.toolResults.filter(t =>
                            t.toolName === 'sqlExecutionTool' ||
                            t.payload?.toolName === 'sqlExecutionTool'
                        );

                        if (sqlResults.length > 0) {
                            sqlResults.forEach(executionResult => {
                                console.log('Execution result:', executionResult);
                                // Result is inside payload
                                const result = executionResult?.payload?.result || executionResult?.result;

                                if (result && result.success) {
                                    addMessage('assistant', formatResults(result.data, result.rowCount));
                                } else {
                                    addMessage('assistant', result?.error || '{{ 'Query execution failed'|trans }}', 'error');
                                }
                            });
                        }
                    }
                    
                    if (hasText) {
                        // Agent response text (summary/explanation)
                        addMessage('assistant', json.text);
                    } else if (!hasToolResults && !hasText) {
                        // Unexpected shape but not the classic empty-agent case
                        showAgentEmptyError(json, 'SQL execution', () => {
                            executeApprovedQuery();
                        });
                    }
                    
                } catch (err) {
                    loadingEl.remove();
                    addMessage('assistant', '{{ 'Execution error'|trans }}: ' + (err?.message || err), 'error');
                }
            }

            async function loadConversationHistory() {
                try {
                    const res = await fetch(`/mastra/api/memory/threads/${encodeURIComponent(threadId)}/messages?agentId=sqlAgent`);
                    if (res.ok) {
                        const data = await res.json();

                        // Prefer Mastra's UI-friendly representation if available
                        const uiMessages = Array.isArray(data.uiMessages) ? data.uiMessages : [];
                        const coreMessages = Array.isArray(data.messages) ? data.messages : [];

                        // If no uiMessages are present (older versions), fall back to core messages
                        const history = uiMessages.length > 0 ? uiMessages : coreMessages;

                        if (history.length > 0) {
                            // Remove welcome message
                            const welcomeAlert = messagesList.querySelector('.alert-info');
                            if (welcomeAlert) {
                                welcomeAlert.remove();
                            }

                            history.forEach((msg) => {
                                const role = msg.role || 'assistant';
                                const parts = Array.isArray(msg.parts) ? msg.parts : [];

                                const textParts = parts.filter(
                                    (p) => p.type === 'text' && typeof p.text === 'string'
                                );
                                const toolParts = parts.filter(
                                    (p) => typeof p.type === 'string' && p.type.indexOf('tool-') === 0
                                );

                                if (textParts.length > 0) {
                                    const combined = textParts.map((p) => p.text).join('\n\n');
                                    addMessage(role, combined);
                                } else if (typeof msg.content === 'string') {
                                    // Core message shape with simple string content
                                    addMessage(role, msg.content);
                                }

                                // Render any tool call parts as expandable blocks
                                toolParts.forEach((toolPart) => {
                                    const toolName = toolPart.toolName
                                        || (toolPart.type || '').replace(/^tool-/, '')
                                        || 'tool';
                                    const state = toolPart.state || 'output-available';
                                    const input = toolPart.input || {};
                                    const output = toolPart.output;
                                    const toolEl = createToolCallElement(
                                        toolName,
                                        state,
                                        input,
                                        output
                                    );
                                    addMessage('assistant', toolEl);
                                });
                            });
                        }
                    }
                } catch (err) {
                    console.error('Failed to load conversation history:', err);
                }
            }

            form.addEventListener('submit', (e) => {
                e.preventDefault();
                sendMessage();
            });

            sendBtn.addEventListener('click', (e) => {
                e.preventDefault();
                sendMessage();
            });

            input.addEventListener('keypress', (e) => {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    sendMessage();
                }
            });

            // Load conversation history on page load
            loadConversationHistory();

            input.focus();
        })();
    </script>
{% endblock %}
