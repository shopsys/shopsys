{% extends '@ShopsysAdministration/datagrid/grid.html.twig' %}
{% import _self as self %}

{% macro getLabel(row) %}
    {{ row.feedLabel }} - {{ row.domainConfig.name }}
    {% if row.additionalInformation is not null %}
        {{ info_icon(row.additionalInformation) }}
    {% endif %}
{% endmacro %}

{% block grid_value_cell_id_label %}
    {% import _self as self %}
    {% if row.created %}
        <a href="{{ row.url }}" target="_blank" rel="noopener">{{ self.getLabel(row) }}</a>
    {% else %}
        {{ self.getLabel(row) }}
    {% endif %}
{% endblock %}

{% block grid_value_cell_id_generate %}
    <a href="{{ url(
        'admin_feed_generate', {
            feedName: row.feedName,
            domainId: row.domainConfig.id
        }
    ) }}" class="btn">{{ 'Generate'|trans }}</a>

{% endblock %}

{% block grid_value_cell_id_schedule %}
    {% if value is same as(false) %}
        <a href="{{ url(
            'admin_feed_schedule', {
                feedName: row.feedName,
                domainId: row.domainConfig.id
            }
        ) }}" class="btn">{{ 'Schedule'|trans }}</a>
    {% else %}
        <span class="text-success">{{ ux_icon('checked') }} {{ 'Scheduled'|trans }}</span>
    {% endif %}

{% endblock %}
