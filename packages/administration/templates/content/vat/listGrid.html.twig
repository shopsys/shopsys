{% extends '@ShopsysAdministration/datagrid/grid.html.twig' %}

{% block grid_value_cell_edit_id_percent %}
    {% if row is not null %}
        {{ form_widget(form.percent, {
            symbolAfterInput: '%',
            rawSymbolBeforeInput: info_icon('Rate can\'t be modified. It is necessary to create new rate, remove existing one and replace it with new one.'|trans)
        }) }}
    {% else %}
        {{ form_widget(form.percent, { symbolAfterInput: '%'}) }}
    {% endif %}
{% endblock %}

{% block grid_value_cell_id_percent %}
    {{ value|formatPercent }}
{% endblock %}

{% block grid_no_data %}
    {{ 'No VAT rate found. You have to create some first.'|trans }}
{% endblock %}

{% block grid_pager_totalcount %}
    {% set entityName = 'VAT rates'|trans %}
    {{ parent() }}
{% endblock %}

{% block grid_inline_edit_add_button %}
    {% set addEntity = 'Create VAT rate'|trans %}
    {{ parent() }}
{% endblock %}
