{% extends '@ShopsysAdministration/datagrid/grid.html.twig' %}

{% block grid_value_cell_edit_id_percent %}
    {% if row is not null %}
        {{ form_widget(form.percent, {
            symbolAfterInput: '%',
            rawSymbolBeforeInput: info_icon('Rate can\'t be modified. It is necessary to create new rate, remove existing one and replace it with new one.'|trans)
        }) }}
    {% else %}
        {{ form_widget(form.percent, { symbolAfterInput: '%'}) }}
    {% endif %}
{% endblock %}

{% block grid_value_cell_id_name %}
    {% if row.vat.markedAsDeleted %}
        <span class="text-muted">
            {{ value }}
            {{ info_icon('VAT rate is marked for deleting and will be soon automatically removed. Conversion rate is several hundreds of products in 5 minutes.'|trans) }}
        </span>
    {% else %}
        {{ value }}
    {% endif %}
{% endblock %}

{% block grid_action_cell %}
    {% if row.vat.markedAsDeleted %}
        {{ info_icon('VAT rate is marked for deleting and will be soon automatically removed. Conversion rate is several hundreds of products in 5 minutes.'|trans, additionalClasses: 'text-muted') }}
    {% elseif row.asReplacementCount > 0 %}
        {{ info_icon('VAT rate can\'t be removed because it is being currently used for conversion to this VAT rate'|trans, additionalClasses: 'text-muted') }}
    {% else %}
        {{ parent() }}
    {% endif %}
{% endblock %}

{% block grid_value_cell_id_percent %}
    {{ value|formatPercent }}
{% endblock %}

{% block grid_no_data %}
    {{ 'No VAT rate found. You have to create some first.'|trans }}
{% endblock %}

{% block grid_pager_totalcount %}
    {% set entityName = 'VAT rates'|trans %}
    {{ parent() }}
{% endblock %}

{% block grid_inline_edit_add_button %}
    {% set addEntity = 'Create VAT rate'|trans %}
    {{ parent() }}
{% endblock %}
