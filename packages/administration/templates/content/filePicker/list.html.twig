{% extends '@ShopsysAdministration/layout/layout_window.html.twig' %}

{% block content %}
    <div class="mb-3">
        {{ form_start(quickSearchForm) }}
        {% include '@ShopsysAdministration/partial/_quick_search_form.html.twig' with {
            form_input: quickSearchForm.text,
            form_submit: quickSearchForm.submit,
            info_message: 'Searching searches in slugs. It is possible to use wildcards * and ?.'|trans,
            placeholder: 'Search by slug...'|trans
        } %}
        {{ form_end(quickSearchForm) }}
    </div>

    {{ gridView.render() }}
    {{ gridView.renderHiddenInputs('page') }}
{% endblock %}
