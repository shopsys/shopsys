{% extends '@ShopsysAdministration/layout/layout_with_panel.html.twig' %}

{% block title %}- {{ 'Email allowed recipients (whitelist)'|trans }}{% endblock %}

{% block pre_title %}{{ 'Overview'|trans }}{% endblock %}
{% block h1 %}{{ 'Email allowed recipients (whitelist)'|trans }}{% endblock %}

{% block main_content %}
    {% if isDeliveryDisabled %}
        <div class="card">
            <div class="card-header">
                <h3 class="card-title text-danger">{{ 'Sending emails is turned off, no email will be sent from the app.'|trans }}</h3>
            </div>
        </div>
    {% elseif patternsByDomainId is defined and patternsByDomainId is not empty %}
        {% for domainId, patterns in patternsByDomainId %}
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">{{ domain_icon(domainId) }} {{ getDomainName(domainId) }}</h3>
                </div>
                <div class="card-body">
                    {% if enabledWhitelistByDomainId[domainId] %}
                        {% if patterns is not empty %}
                            <p>{{ 'Emails will be sent only to addresses matching at least one of these patterns:'|trans }}</p>
                            <div class="ms-3 divide-y-2">
                                {% for pattern in patterns %}
                                    <div><code>{{ pattern }}</code></div>
                                {% endfor %}
                            </div>
                        {% else %}
                            <p>
                                <strong>{{ 'No email will be sent from this domain.'|trans }}</strong>
                            </p>
                        {% endif %}
                    {% else %}
                        <p>{{ 'Emails are sent normally on this domain'|trans }}</p>
                    {% endif %}
                </div>
            </div>
        {% endfor %}
    {% endif %}
    {% if is_granted(constant('\\Shopsys\\FrameworkBundle\\Component\\Security\\Role\\SystemRole::SUPER_ADMIN')) %}
        <p class="ms-3 text-secondary">
            {{ ux_icon('info') }}
            {{ 'You can change the settings <a href="%linkUrl%">here</a>.'|trans({ '%linkUrl%': url('admin_superadmin_mailwhitelist') })|raw }}
        </p>
    {% endif %}
{% endblock %}
