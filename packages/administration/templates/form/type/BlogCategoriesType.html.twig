{% block blog_categories_widget %}
    <div class="js-category-tree-form"
         data-prototype="{{ '<li class="tree-item js-category-tree-form-item">' ~
         form_widget(form.vars.prototype) ~
         '<ul class="js-category-tree-form-children-container tree-group">' ~
         '</ul></li>' }}"
         data-hidden-item-class="text-secondary"
    >
        <ul class="js-category-tree-form-children-container tree">
                {% set level = 1 %}

                {% for child in form.children %}
                {% set currentLevel = child.vars.level %}

                {% if not loop.first %}
                {% if currentLevel <= level %}
                {% for i in currentLevel .. level %}</ul></li>{% endfor %}
            {% endif %}
            {% endif %}

            <li class="tree-item {% if not child.vars.visible %}text-secondary{% endif %} js-category-tree-form-item"
                data-load-url="{{ url('admin_blogcategory_loadbranchjson', {id: child.vars.name, domainId: domain_id}) }}"
                data-has-children="{{ child.vars.has_children ? 'true' : 'false' }}"
            >
                {{ form_widget(child) }}
            <ul class="js-category-tree-form-children-container tree-group">
                    {% set level = currentLevel %}
                    {% endfor %}

                    {% for i in 1 .. level %}</ul></li>{% endfor %}
            </ul>
        </div>
{% endblock %}
