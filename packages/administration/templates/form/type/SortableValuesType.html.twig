{%- block sortable_values_widget -%}
    {% import _self as self %}

    <div class="row g-2 js-sortable-values-container">
        {% set item_input_name = full_name ~ '[]' %}
        {% set full_name = "" %}
        {% set attr = attr|merge({
            'class': (attr.class|default('') ~ ' js-sortable-values-input input')|trim,
        }) %}
        {% set select_label = label ?: placeholder ?: 'Select value'|trans %}

        <div class="col">
            <label for="{{ id }}" class="visually-hidden">{{ select_label }}</label>
            <select
                id="{{ id }}"
                name="{{ full_name }}"
                {% if disabled %}disabled="disabled"{% endif %}
                {% if required %}required="required"{% endif %}
                {{ block('attributes') }}
                data-item-template="{{ self.sortableValuesWidgetItem(item_input_name, '%value%', '%label%')|escape('html_attr') }}"
            >
                <option value="" selected="selected">{{ placeholder }}</option>
                {% for labelValue, label in labels_by_value %}
                    <option value="{{ labelValue }}"{% if labelValue in value %} disabled="disabled"{% endif %}>
                        {{ label }}
                    </option>
                {% endfor %}
            </select>
        </div>

        <div class="js-sortable-values-items list-group list-group-flush list-group-hoverable">
            {% for valueItem in value %}
                {{ self.sortableValuesWidgetItem(item_input_name, valueItem, labels_by_value[valueItem]|default(valueItem)) }}
            {% endfor %}
        </div>
    </div>
{%- endblock sortable_values_widget -%}

{% macro sortableValuesWidgetItem(inputName, value, label) %}
    <div class="js-sortable-values-item list-group-item">
        <div class="row align-items-center">
            <div class="col-auto cursor-move js-sortable-values-item-handle" title="{{ 'Move'|trans }}">
               {{ ux_icon('move', {class: 'icon icon-sm d-flex'}) }}
            </div>
            <div class="col text-truncate">
                {{ label }}
            </div>

            <div class="col-auto">
                <span class="js-sortable-values-item-remove list-group-item-actions cursor-pointer">
                    {{ ux_icon('delete') }}
                </span>
            </div>
        </div>
        <input class="js-sortable-values-item-input" type="hidden" name="{{ inputName }}" value="{{ value }}">
    </div>
{% endmacro %}
