{% block content_editor_widget %}
    <div data-content-editor-widget>
        {{ form_widget(form) }}
        {{ component('Admin:ContentEditor', {
            documentJson: value,
            profile: profile,
            allowedTypes: allowed_types,
            variables: variables,
            domainId: domain_id,
            validated: validated,
            targetInputId: id,
        }) }}
        {{ component('Admin:ContentEditor:MediaPicker', {instanceId: id}) }}
    </div>
{% endblock %}
