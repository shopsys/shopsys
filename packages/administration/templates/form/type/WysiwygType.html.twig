{% block wysiwyg_widget %}
    {% set commandGroups = [
        {
            bold: {icon: 'bold', title: 'Bold'|trans},
            italic: {icon: 'italic', title: 'Italic'|trans},
            underline: {icon: 'underline', title: 'Underline'|trans},
            strike: {icon: 'strikethrough', title: 'Strikethrough'|trans},
        },
        {
            h2: {icon: 'heading-2', title: 'Heading 2'|trans},
            h3: {icon: 'heading-3', title: 'Heading 3'|trans},
            h4: {icon: 'heading-4', title: 'Heading 4'|trans},
        },
        {
            bulletList: {icon: 'list-bullet', title: 'Bullet list'|trans},
            orderedList: {icon: 'list-numbered', title: 'Numbered list'|trans},
            blockquote: {icon: 'quote', title: 'Quote'|trans},
            horizontalRule: {icon: 'horizontal-line', title: 'Horizontal line'|trans},
        },
    ] %}
    {% set tableCommands = {
        insertTable: 'Insert table'|trans,
        addRow: 'Add row'|trans,
        deleteRow: 'Delete row'|trans,
        addColumn: 'Add column'|trans,
        deleteColumn: 'Delete column'|trans,
        deleteTable: 'Delete table'|trans,
    } %}

    <div data-controller="wysiwyg" data-live-ignore data-tid="wysiwyg">
        <div class="wysiwyg-toolbar">
            {% for group in commandGroups %}
                <div class="btn-group btn-group-sm">
                    {% for command, definition in group %}
                        <button type="button"
                                class="btn"
                                title="{{ definition.title }}"
                                aria-label="{{ definition.title }}"
                                data-action="wysiwyg#command"
                                data-wysiwyg-command-param="{{ command }}"
                                data-wysiwyg-target="button"
                                data-tid="wysiwyg-{{ command }}">{{ ux_icon(definition.icon) }}</button>
                    {% endfor %}
                </div>
            {% endfor %}
            <div class="btn-group btn-group-sm">
                <div class="btn-group btn-group-sm" data-wysiwyg-target="linkDropdown">
                    <button type="button"
                            class="btn"
                            data-bs-toggle="dropdown"
                            title="{{ 'Link'|trans }}"
                            aria-label="{{ 'Link'|trans }}"
                            data-bs-auto-close="outside"
                            data-action="wysiwyg#prepareLink"
                            data-wysiwyg-target="button"
                            data-tid="wysiwyg-link">{{ ux_icon('link') }}</button>
                    <div class="dropdown-menu p-3 wysiwyg-link-panel">
                        <div class="mb-2">
                            <label class="form-label">{{ 'Link address'|trans }}</label>
                            <input type="text"
                                   class="form-control"
                                   data-action="keydown.enter->wysiwyg#applyLink"
                                   data-wysiwyg-target="linkHref"
                                   data-tid="wysiwyg-link-href">
                        </div>
                        <div class="mb-2">
                            <label class="form-label">{{ 'Link title'|trans }}</label>
                            <input type="text"
                                   class="form-control"
                                   data-action="keydown.enter->wysiwyg#applyLink"
                                   data-wysiwyg-target="linkTitle"
                                   data-tid="wysiwyg-link-title">
                        </div>
                        <label class="form-check mb-3">
                            <input type="checkbox"
                                   class="form-check-input"
                                   data-wysiwyg-target="linkNewTab"
                                   data-tid="wysiwyg-link-new-tab">
                            <span class="form-check-label">{{ 'Open in a new tab'|trans }}</span>
                        </label>
                        <div class="btn-list">
                            <button type="button" class="btn btn-sm btn-primary" data-action="wysiwyg#applyLink" data-tid="wysiwyg-link-apply">
                                {{ 'Apply'|trans }}
                            </button>
                            <button type="button" class="btn btn-sm" data-action="wysiwyg#removeLink" data-tid="wysiwyg-link-remove">
                                {{ 'Remove link'|trans }}
                            </button>
                        </div>
                    </div>
                </div>
                <button type="button"
                        class="btn"
                        title="{{ 'Unlink'|trans }}"
                        aria-label="{{ 'Unlink'|trans }}"
                        data-action="wysiwyg#removeLink"
                        data-wysiwyg-target="button"
                        data-tid="wysiwyg-unlink">{{ ux_icon('unlink') }}</button>
            </div>
            <div class="btn-group btn-group-sm">
                <button type="button"
                        class="btn dropdown-toggle"
                        title="{{ 'Table'|trans }}"
                        aria-label="{{ 'Table'|trans }}"
                        data-bs-toggle="dropdown"
                        data-wysiwyg-target="button"
                        data-tid="wysiwyg-table">{{ ux_icon('table') }}</button>
                <div class="dropdown-menu">
                    {% for command, label in tableCommands %}
                        <button type="button"
                                class="dropdown-item"
                                data-action="wysiwyg#command"
                                data-wysiwyg-command-param="{{ command }}"
                                data-tid="wysiwyg-{{ command }}">{{ label }}</button>
                    {% endfor %}
                </div>
            </div>
            <div class="btn-group btn-group-sm">
                <button type="button"
                        class="btn"
                        title="{{ 'Clear formatting'|trans }}"
                        aria-label="{{ 'Clear formatting'|trans }}"
                        data-action="wysiwyg#command"
                        data-wysiwyg-command-param="clearFormatting"
                        data-wysiwyg-target="button"
                        data-tid="wysiwyg-clearFormatting">{{ ux_icon('clear-formatting') }}</button>
                <button type="button"
                        class="btn"
                        title="{{ 'HTML source'|trans }}"
                        aria-label="{{ 'HTML source'|trans }}"
                        data-action="wysiwyg#toggleSource"
                        data-wysiwyg-target="sourceToggle"
                        data-tid="wysiwyg-source">{{ ux_icon('source-code') }}</button>
            </div>
            {% if variables is not empty %}
                <div class="btn-group btn-group-sm">
                    <button type="button"
                            class="btn dropdown-toggle"
                            title="{{ 'Insert variable'|trans }}"
                            aria-label="{{ 'Insert variable'|trans }}"
                            data-bs-toggle="dropdown"
                            data-wysiwyg-target="button"
                            data-tid="wysiwyg-variables">{{ ux_icon('variable') }}</button>
                    <div class="dropdown-menu">
                        {% for variable in variables %}
                            <button type="button"
                                    class="dropdown-item"
                                    data-action="wysiwyg#insertVariable"
                                    data-wysiwyg-placeholder-param="{{ variable.placeholder }}"
                                    data-tid="wysiwyg-variable">{{ variable.label }}</button>
                        {% endfor %}
                    </div>
                </div>
            {% endif %}
        </div>

        <div class="form-control p-0 wysiwyg-editor" data-wysiwyg-target="editor"></div>
        <textarea class="form-control wysiwyg-source d-none"
                  data-action="input->wysiwyg#onSourceInput"
                  data-wysiwyg-target="source"
                  data-tid="wysiwyg-source-textarea"></textarea>

        {{ form_widget(form, {attr: {'data-wysiwyg-target': 'textarea', class: 'd-none'}}) }}
    </div>
{% endblock %}
