{% block localized_widget %}
    {% set itemCount = form|length %}
    {% set columnClass = itemCount == 1 ? 'col-12' : (itemCount == 2 ? 'col-12 col-xl-6' : 'col-12 col-xl-4') %}
    {% set columnSpacing = itemCount > 1 ? ' mb-3 mb-xl-0' : '' %}
    
    <div class="row">
        {% for child in form %}
            <div class="{{ display_mode == 'columns' ? columnClass ~ columnSpacing : 'col-12 mb-3' }}">
                {{- form_widget(child, { rawSymbolBeforeInput: localeFlag(child.vars.attr['data-locale']) }) -}}
                {{- form_help(child) -}}
                {{- form_errors(child) -}}
            </div>
        {% endfor %}
    </div>
{% endblock %}

{% block localized_row %}
    {%- set row_class = (row_attr.class|default(''))|trim -%}
    <div {% with {attr: row_attr|merge({class: row_class})} %}{{ block('attributes') }}{% endwith %}>
        {{ form_label(form) }}

        {% if layout is same as constant('\\Shopsys\\FrameworkBundle\\Form\\FormTypeLayout::LAYOUT_INLINE') %}
            <fieldset>
                {{ form_widget(form) }}
                {{ form_help(form) }}
            </fieldset>
        {% else %}
            {% set itemCount = form|length %}
            {% set columnClass = itemCount == 1 ? 'col-12' : (itemCount == 2 ? 'col-12 col-xl-6' : 'col-12 col-xl-4') %}
            {% set columnSpacing = itemCount > 1 ? ' mb-3 mb-xl-0' : '' %}
            
            <div class="row">
                {% for child in form %}

                    <div class="{{ display_mode == 'columns' ? columnClass ~ columnSpacing : 'col-12 mb-3' }}">
                            <div class="card">
                                <div class="card-header card-header-light py-2">
                                    <span>
                                        {{ localeFlag(child.vars.attr['data-locale']) }}
                                    </span>
                                </div>
                                <div class="card-body">
                                    {{- form_widget(child) -}}
                                    {{- form_errors(child) -}}
                                </div>
                            </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
        {{ form_errors(form) }}
    </div>
{% endblock %}
