{# @deprecated - localized_full_width is now same as localized #}
{% block localized_full_width_row %}
    {{ block('localized_row') }}
{% endblock %}

{% block localized_row %}
    <div class="mb-3">
        {{ form_label(form) }}

        {{ form_help(form) }}

        {% if layout is same as constant('\\Shopsys\\FrameworkBundle\\Form\\Locale\\LocalizedType::LAYOUT_INLINE') %}
            <fieldset>
                {% for child in form %}
                    <div class="input-icon mb-3">
                    <span class="input-icon-addon">
                        {{ localeFlag(child.vars.attr['data-locale']) }}
                    </span>
                        {{- form_widget(child) -}}
                    </div>
                {% endfor %}
            </fieldset>
        {% else %}
            {% for child in form %}
                <div class="card mb-3">
                    <div class="row">
                        <div class="col-auto">
                            <div class="card-body">
                                {{ localeFlag(child.vars.attr['data-locale']) }}
                            </div>
                        </div>
                        <div class="col">
                            <div class="card-body">
                                {{- form_widget(child) -}}
                            </div>
                        </div>
                    </div>
                </div>
            {% endfor %}
        {% endif %}
        {{ form_errors(form) }}
    </div>
{% endblock %}
