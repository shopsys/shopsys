{% macro flagRow(flag, index) %}
    <tr class="js-flags-item js-form-group" data-index="{{ index }}">
        <td class="align-middle">
            {{ form_widget(flag.flag) }}
            {{ form_errors(flag.flag) }}
        </td>
        <td class="text-center align-middle">
            {{ ux_icon('arrow-simple') }}
        </td>
        <td class="align-middle">
            {{ form_widget(flag.type) }}
            {{ form_errors(flag.type) }}
        </td>
        <td class="text-center align-middle">
            <a href="#" class="js-flags-item-remove">{{ ux_icon('delete') }}</a>
        </td>
    </tr>
{% endmacro %}

{% block promo_code_flag_collection_widget %}
    {% import _self as self %}
    <div class="js-form-group form-group">
        <table class="table" id="promo_code_flags">
            <thead>
                <tr>
                    <th colspan="2">{{ 'Flag'|trans }}</th>
                    <th colspan="2">{{ 'Type'|trans }}</th>
                </tr>
            </thead>
            <tbody class="js-flags" data-prototype="{{ self.flagRow(form.vars.prototype)|escape }}" data-index="{{ form|length }}">
                {% for key, flag in form %}
                    {{ self.flagRow(flag, key) }}
                {% else %}
                    {% do form.setRendered %}
                {% endfor %}

                <tr class="js-flags-empty-item">
                    <td colspan="4">{{ 'Add some flag'|trans }}</td>
                </tr>
            </tbody>
        </table>

        <button type="button" class="btn js-flags-item-add">
            {{ ux_icon('plus') }}
            {{ 'Add another flag'|trans }}
        </button>
    </div>
{% endblock %}
