{% block friendly_url_row %}
    <div class="js-entity-url-list-new-row mb-2" data-index="{{ form.vars.name }}">
        <div class="row g-2">
            <div class="col input-group">
                <span class="input-group-text">{{ domainUrl|default('') }}/</span>
                {{ form_widget(form) }}
            </div>

            <div class="col-auto">
                <button class="js-entity-url-list-new-row-delete-button btn btn-icon" type="button">
                    {{ ux_icon('delete') }}
                </button>
            </div>
        </div>
        {{ form_errors(form) }}
        {{ form_help(form) }}
    </div>
{% endblock %}
