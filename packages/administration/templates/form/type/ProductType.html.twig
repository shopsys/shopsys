{% block product_widget %}
    {% if attr %}
        <div {{ block('attributes') }}>
    {% endif %}

    <div class="input-group js-product-picker-container" data-placeholder="{{ placeholder }}">
        <input type="text"
               class="form-control js-product-picker-label"
               value="{{ productName|default(placeholder) }}"
               disabled="disabled"
               readonly="readonly"
        />

        <button type="button"
                data-product-picker-url="{{ url('admin_productpicker_picksingle', {allowMainVariants: allow_main_variants, allowVariants: allow_variants}) }}"
                class="js-product-picker-create-picker-button btn"
                title="{{ 'Click to go to product section'|trans }}"
        >
            ...
        </button>

        {% if enableRemove %}
            <button type="button"
                    data-product-picker-url="{{ url('admin_productpicker_picksingle', {allowMainVariants: allow_main_variants, allowVariants: allow_variants}) }}"
                    class="js-product-picker-remove-button btn btn-icon"
                    disabled
                    title="{{ 'Remove'|trans }}"
            >
                {{ ux_icon('trash') }}
            </button>
        {% endif %}

        {{ form_widget(form, {attr: {class: 'js-product-picker-input'}}) }}
    </div>

    {% if attr %}
        </div>
    {% endif %}
{% endblock %}

{% block product_row %}
    <div class="mb-3 row">
        {{- form_label(form) -}}
        {{- form_widget(form, {attr: {class: 'col-sm-10'}}) -}}
    </div>
{% endblock %}
