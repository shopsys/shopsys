{% macro treeSelectionItem(loadChildrenUrl, hasChildren, isVisible, checkboxId, checkboxName, value, label, isChecked, renderClosingTags) %}
    <li class="tree-item {% if not isVisible %}text-secondary{% endif %} js-tree-selection-form-item"
        data-load-url="{{ loadChildrenUrl }}"
        data-has-children="{{ hasChildren }}"
    >
        <div class="tree-item-content">
            <div class="tree-item-label">
                <div class="d-flex gap-2 align-items-baseline">
                    <div class="w-3 h-3 flex-shrink-0">
                        <div class="js-tree-selection-form-item-icon"></div>
                    </div>
                    <div class="form-check">
                        <input
                            type="checkbox"
                            id="{{ checkboxId }}"
                            name="{{ checkboxName }}"
                            value="{{ value }}"
                            class="js-tree-selection-form-item-checkbox form-check-input"
                            {% if isChecked %}checked="checked"{% endif %}
                        >
                        <label for="{{ checkboxId }}" class="form-check-label">
                            {{ label }}
                        </label>
                    </div>
                </div>
            </div>
        </div>
        <ul class="js-tree-selection-form-children-container tree-group">
    {% if renderClosingTags %}
        </ul>
    </li>
    {% endif %}
{% endmacro %}

{% block tree_selection_widget %}
    {% if main_category_path is defined and main_category_path is not null %}
        <div>
            {{ ux_icon('tag') }}
            <strong>{{ 'Main category'|trans }}:</strong>
            {{ main_category_path }}
        </div>

        <hr class="my-2">
    {% endif %}

    <div class="js-tree-selection-form"
         data-checkbox-name="{{ checkbox_name }}"
         data-checkbox-id-prefix="{{ checkbox_id_prefix }}"
         data-hidden-item-class="text-secondary"
    >
        <template class="js-tree-selection-form-item-template">
            {{ _self.treeSelectionItem(
                loadChildrenUrl='__load_children_url__',
                hasChildren='__has_children__',
                isVisible=true,
                checkboxId='__checkbox_id__',
                checkboxName='__checkbox_name__',
                value='__value__',
                label='__label__',
                isChecked=false,
                renderClosingTags=true,
            ) }}
        </template>
        <ul class="js-tree-selection-form-children-container tree">
            {% set level = 1 %}

            {% for item in tree_items %}
            {% set currentLevel = item.level %}

            {% if not loop.first %}
            {% if currentLevel <= level %}
            {% for i in currentLevel .. level %}</ul></li>{% endfor %}
        {% endif %}
        {% endif %}

        {{ _self.treeSelectionItem(
            loadChildrenUrl=url(branch_load_route, {id: item.id, domainId: domain_id}),
            hasChildren=item.hasChildren ? 'true' : 'false',
            isVisible=domain_id is null ? true : item.isVisible(domain_id),
            checkboxId=checkbox_id_prefix ~ '_' ~ item.id,
            checkboxName=checkbox_name,
            value=item.id,
            label=item.name,
            isChecked=item.id in selected_ids,
            renderClosingTags=false,
        ) }}
        {% set level = currentLevel %}
        {% endfor %}

            {% if tree_items is not empty %}
                {% for i in 1 .. level %}</ul></li>{% endfor %}
            {% endif %}
        </ul>
    </div>
{% endblock %}
