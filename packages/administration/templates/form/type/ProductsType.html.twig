{% block products_row %}
    <div class="card mb-3">
        <div class="card-header">
            <h3 class="card-title">
                {{- form_label(form) -}}
            </h3>
            <div class="card-actions">
                {{- form_errors(form) -}}
            </div>
        </div>
        {{- form_widget(form) -}}
    </div>
{% endblock %}

{% block products_label -%}
    {{ label|trans }}
{% endblock -%}

{% block products_widget %}
    {% import _self as self %}
    {% if disabled is same as false %}
        {% set attr = attr|merge({'class': (attr.class|default('') ~ ' js-products-picker')|trim}) %}
    {% endif %}
    <div
            {{ block('widget_attributes') }}
            {% if disabled is same as false %}
                data-products-picker-prototype="{{ self.productsWidgetItem(null, form.vars.prototype, form.vars.sortable, disabled)|e }}"
                data-products-picker-url="{{ url('admin_productpicker_pickmultiple', {jsInstanceId: '__js_instance_id__', allowMainVariants: allow_main_variants, allowVariants: allow_variants}) }}"
                data-products-picker-main-product-id="{{ form.vars.main_product ? form.vars.main_product.id : '' }}"
            {% endif %}
    >
        <div class="card-body p-0">
            <div class="list-group list-group-flush list-group-hoverable js-products-picker-items">
                {% for key, productForm in form %}
                    {{ self.productsWidgetItem(form.vars.products[key], productForm, form.vars.sortable, disabled) }}
                {% endfor %}
            </div>
        </div>
        {%- if disabled is same as false %}
            <div class="card-footer">
                <button type="button" class="btn js-products-picker-button-add">
                    {{ ux_icon('plus') }}
                    {{ label_button_add }}
                </button>
            </div>
        {% endif -%}
    </div>
{% endblock %}

{% macro productsWidgetItem(product, form, sortable, disabled) %}
    <div class="list-group-item py-2 js-products-picker-item">
        <div class="row align-items-center">
            {% if sortable and disabled is same as false %}
                <div class="col-auto">
                    <span class="js-products-picker-item-handle cursor-move">
                        {{ ux_icon('move', {class: 'icon icon-sm d-flex'}) }}
                    </span>
                </div>
            {% endif %}

            <div class="col-auto">
                {% if product is not null %}
                    <span class="avatar bg-white product-picker-image-avatar">
                        {{ image(product) }}
                    </span>
                {% else %}
                    <span class="avatar bg-white product-picker-image-avatar js-products-picker-item-product-image"></span>
                {% endif %}
            </div>

            <div class="col text-truncate js-products-picker-item-product-name">
                {% if product is not null %}
                    <a href="{{ url('admin_product_edit', {id: product.id}) }}" target="_blank" rel="noopener">
                        <span>{{ product.name }}</span>&nbsp;{{ ux_icon('forward-page') }}
                    </a>
                    <div class="d-block text-secondary text-truncate">{{ product.catnum }}</div>
                {% endif %}
            </div>

            <div class="col-auto">
                {%- if disabled is same as false %}
                    <a href="#" class="list-group-item-actions js-products-picker-item-button-delete">
                        {{ ux_icon('delete') }}
                    </a>
                    {{ form_widget(form, {attr: {class: 'js-products-picker-item-input d-none'}}) }}
                {% endif -%}
            </div>
        </div>
    </div>
{% endmacro %}
