{% extends '@ShopsysAdministration/form/type/fileUpload/AbstractFileUploadType.html.twig' %}

{% block multi_locale_basic_file_upload_widget %}
    {% embed "@ShopsysAdministration/form/type/fileUpload/AbstractFileUploadType.html.twig" %}
        {% block widget_attributes %}
            {{ block("widget_attributes", "form_div_layout.html.twig") }}
        {% endblock %}

        {% block abstract_file_upload_widget_uploaded_files %}
            <div class="file-upload-card-container js-file-upload-uploaded-files"
                 data-prototype="{{ _self.uploadedFile(form.uploadedFiles.vars.prototype, form.uploadedFilenames.vars.prototype, '', null, false, 'js-file-upload-uploaded-file-template', [form.names.vars.prototype])|escape }}"
            >
                {% for key, uploadedFile in form.uploadedFiles %}
                    {% set fileThumbnailInfo = getFileThumbnailInfoByTemporaryFilename(uploadedFile.vars.value) %}
                    {{ _self.uploadedFile(uploadedFile, form.uploadedFilenames[key], getLabelByTemporaryFilename(uploadedFile.vars.value), fileThumbnailInfo.iconType, fileThumbnailInfo.imageUri, '', [form.names[key]]) }}
                {% else %}
                    {% do form.children.uploadedFiles.setRendered %}
                {% endfor %}
            </div>
        {% endblock abstract_file_upload_widget_uploaded_files %}
    {% endembed %}

    <div class="d-none">
        {{ form_widget(form.uploadedFilenames) }}
        {{ form_widget(form.names) }}
    </div>
{% endblock multi_locale_basic_file_upload_widget %}
