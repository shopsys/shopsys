{% block file_upload_row %}
    {% if entity is not null %}
        {% if form.orderedFiles|length > 0 %}
            <div class="file-upload-card-container js-file-upload">
                {% for fileForm in form.orderedFiles %}
                    {% set file = files_by_id[fileForm.vars.value] %}
                    {% set isRemoved = false %}
                    {% if not multiple and loop.index > 1 %}
                        {% set isRemoved = true %}
                    {% endif %}

                    <div class="card card-sm mb-3 js-file-upload-file" data-id="{{ file.id }}" data-delete-input="#{{ form.filesToDelete.vars.id }}" style="max-width: 17.5rem;">
                        {% if multiple or (not isRemoved) %}
                            <div class="card-header d-flex justify-content-between align-items-center py-1">
                                {% if multiple %}
                                    <div class="js-file-upload-file-handle d-flex align-items-center" title="{{ 'Move'|trans }}">
                                        {{ ux_icon('move', {class: 'me-2 text-muted cursor-move'}) }}
                                    </div>
                                {% else %}
                                    {# helps keep the delete button at the right side of the card #}
                                    <div class="ms-auto"></div>
                                {% endif %}

                                {% if not isRemoved %}
                                    <button type="button" class="js-file-upload-delete-button btn btn-sm btn-ghost-danger" title="{{ 'Delete'|trans }}">
                                        {{ ux_icon('delete', {class: 'icon mx-0'}) }}
                                    </button>
                                    <button type="button" class="js-file-upload-delete-revert-button btn btn-sm" style="display: none;" title="{{ 'Return back'|trans }}">
                                        {{ ux_icon('revert') }}
                                        {{ 'Undo delete'|trans }}
                                    </button>
                                {% endif %}
                            </div>
                        {% endif %}

                        <div class="position-relative ratio ratio-16x9 overflow-hidden">
                            {{ uploadedFilePreviewWithLink(file) }}

                            <div class="position-absolute top-0 start-0 w-100 h-100 opacity-75 bg-dark z-3 d-none text-center align-items-center justify-content-center js-file-upload-file-overlay px-3">
                                <div class="text-white">
                                    <strong>{{ 'File will be removed from the record after saving'|trans }}</strong>
                                </div>
                            </div>
                        </div>

                        <div class="card-footer pb-0">
                            {{ form_widget(fileForm, { full_name: form.orderedFiles.vars.full_name ~ '[]'}) }}
                            {{ form_widget(form.currentFilenamesIndexedById.children[fileForm.vars.value], { attr: { class: "mb-3" } }) }}

                            {% if requires_friendly_name %}
                                {{ form_widget(form.namesIndexedById.children[fileForm.vars.value]) }}
                                <div class="mb-3">
                                    {{ form_help(form.namesIndexedById.children[fileForm.vars.value]) }}
                                </div>
                            {% endif %}
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% else %}
            {% do form.orderedFiles.setRendered %}
        {% endif %}
    {% endif %}

    <div class="d-none">
        {{ form_widget(form.filesToDelete) }}
    </div>

    <div class="{{ disabledField is defined ? 'disabled' }}">
        {{ form_errors(form) }}
        {{ form_errors(form.relations) }}
        {{ form_label(form, label) }}
        {% if multiple %}
            {% embed "@ShopsysAdministration/form/type/fileUpload/filesPicker.html.twig" %}
                {% block files_picker %}
                    {% if requires_friendly_name %}
                        <div
                                id="{{ form.relations.vars.id }}"
                                class="js-files-picker"
                                data-picker-prototype="{{ _self.pickerWidgetItem(null, form.relations.vars.prototype, form.relations.vars.sortable, null, null, null, form.relationsFilenames.vars.prototype, [form.relationsNames.vars.prototype])|e }}"
                                data-picker-url="{{ form.relations.vars.picker_url }}"
                        >
                            <div class="file-upload-card-container js-file-upload js-picker-items">
                                {% for key, formRow in form.relations %}
                                    {{ _self.pickerWidgetItem(form.relations.vars.items[key], formRow, form.relations.vars.sortable, form.relations.vars.item_names[key], form.relations.vars.item_routes[key] ?? null, key, form.relationsFilenames[key], [form.relationsNames[key]]) }}
                                {% endfor %}
                            </div>
                        </div>
                    {% else %}
                        {{ parent() }}
                    {% endif %}
                {% endblock files_picker %}
            {% endembed %}
        {% else %}
            {% embed "@ShopsysAdministration/form/type/fileUpload/filePicker.html.twig" %}
                {% block file_picker %}
                    {% if requires_friendly_name %}
                        <div id="{{ form.relations.vars.id }}_single_picker"
                             class="js-file-picker"
                             data-picker-prototype="{{ _self.pickerWidgetItem(null, form.relations.vars.prototype, form.relationsFilenames.vars.prototype, [form.relationsNames.vars.prototype])|e }}"
                             data-picker-url="{{ form.relations.vars.picker_url }}"
                        >
                            <div class="file-upload-card-container js-picker-items">
                                {% for key, formRow in form.relations %}
                                    {{ _self.pickerWidgetItem(form.relations.vars.items[key], formRow, form.relationsFilenames[key], [form.relationsNames[key]]) }}
                                {% endfor %}
                            </div>
                        </div>
                    {% else %}
                        {{ parent() }}
                    {% endif %}
                {% endblock file_picker %}
            {% endembed %}
        {% endif %}
        {{ form_widget(form) }}
        {{ form_help(form) }}
    </div>
{% endblock file_upload_row %}

{% block file_upload_widget %}
    {% embed "@ShopsysAdministration/form/type/fileUpload/AbstractFileUploadType.html.twig" %}
        {% block abstract_file_upload_widget_uploaded_files %}
            {% set additionalTypesToRender = requires_friendly_name ? [form.names.vars.prototype] : [] %}
            <div class="file-upload-card-container js-file-upload-uploaded-files"
                 data-prototype="{{ _self.uploadedFile(form.uploadedFiles.vars.prototype, form.uploadedFilenames.vars.prototype, '', null, false, 'js-file-upload-uploaded-file-template', additionalTypesToRender)|escape }}"
            >
                {% for key, uploadedFile in form.uploadedFiles %}
                    {% set fileThumbnailInfo = getFileThumbnailInfoByTemporaryFilename(uploadedFile.vars.value) %}
                    {% set additionalTypesToRender = requires_friendly_name ? [form.names[key]] : [] %}
                    {{ _self.uploadedFile(uploadedFile, form.uploadedFilenames[key], getLabelByTemporaryFilename(uploadedFile.vars.value), fileThumbnailInfo.iconType, fileThumbnailInfo.imageUri, '', additionalTypesToRender) }}
                {% else %}
                    {% do form.children.uploadedFiles.setRendered %}
                {% endfor %}
            </div>
        {% endblock abstract_file_upload_widget_uploaded_files %}

        {% block abstract_file_upload_widget_buttons %}
            <button type="button"
                    class="btn form-control {{ multiple ? 'js-picker-button-add' }}"
                    data-picker-target="{{ form.relations.vars.id }}{{ multiple ? '' : '_single_picker' }}"
            >
                {{ ux_icon('plus') }}
                {{ form.relations.vars.label_button_add }}
            </button>
        {% endblock abstract_file_upload_widget_buttons %}
    {% endembed %}
{% endblock file_upload_widget %}
