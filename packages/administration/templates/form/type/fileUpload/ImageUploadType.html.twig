{% block image_upload_row %}
    {% if entity is not null %}
        {% if form.orderedImages|length > 0 %}
            <div class="file-upload-card-container js-file-upload">
                {% for imageForm in form.orderedImages %}
                    {% set image = images_by_id[imageForm.vars.value] %}
                    {% set isRemoved = false %}
                    {% if not multiple and loop.index > 1 %}
                        {% set isRemoved = true %}
                    {% endif %}

                    <div class="card card-sm mb-3 js-file-upload-file" data-id="{{ image.id }}" data-delete-input="#{{ form.imagesToDelete.vars.id }}" style="max-width: 17.5rem;">
                        {% if multiple or (not isRemoved and not hide_delete_button) %}
                            <div class="card-header d-flex justify-content-between align-items-center py-1">
                                {% if multiple %}
                                    <div class="js-file-upload-file-handle d-flex align-items-center" title="{{ 'Move'|trans }}">
                                        {{ ux_icon('move', {class: 'me-2 text-muted cursor-move'}) }}
                                    </div>
                                {% else %}
                                    {# helps keep the delete button at the right side of the card #}
                                    <div class="ms-auto"></div>
                                {% endif %}

                                <div class="d-flex align-items-center gap-1">
                                    {% set currentImageUrl = imageUrl(image, image_type) %}
                                    {% if currentImageUrl %}
                                        <a href="{{ currentImageUrl }}" target="_blank" class="btn btn-sm btn-ghost-secondary" title="{{ 'View'|trans }}" rel="noopener">
                                            {{ ux_icon('forward-page', {class: 'icon mx-0'}) }}
                                        </a>
                                        <a href="{{ currentImageUrl }}" download class="btn btn-sm btn-ghost-secondary" title="{{ 'Download'|trans }}">
                                            {{ ux_icon('download', {class: 'icon mx-0'}) }}
                                        </a>
                                    {% endif %}

                                    {% if not isRemoved and not hide_delete_button %}
                                        <button type="button" class="js-file-upload-delete-button btn btn-sm btn-ghost-danger" title="{{ 'Delete'|trans }}">
                                            {{ ux_icon('delete', {class: 'icon mx-0'}) }}
                                        </button>
                                        <button type="button" class="js-file-upload-delete-revert-button btn btn-sm" style="display: none;" title="{{ 'Return back'|trans }}">
                                            {{ ux_icon('revert') }}
                                            {{ 'Undo delete'|trans }}
                                        </button>
                                    {% endif %}
                                </div>
                            </div>
                        {% endif %}

                        <div class="position-relative ratio ratio-16x9 overflow-hidden">
                            {{ image(image, { type: image_type, class: 'w-100 h-100 object-contain', width: 400}) }}

                            {% if image.filesize is not null %}
                                <span class="badge bg-dark bg-opacity-50 text-white z-2 d-inline-flex" style="position: absolute; width: auto; height: auto; top: auto; left: auto; bottom: 4px; right: 4px; font-size: .7rem;">{{ image.filesize|formatFileSize }}</span>
                            {% endif %}

                            <div class="position-absolute top-0 start-0 w-100 h-100 opacity-75 bg-dark z-3 d-none text-center align-items-center justify-content-center js-file-upload-file-overlay px-3">
                                <div class="text-white">
                                    <strong>{{ 'Image will be deleted after saving'|trans }}</strong>
                                </div>
                            </div>
                        </div>

                        {% if multiple %}
                            <div class="ribbon ribbon-start mt-4 d-none main-image-ribbon">
                                {{ 'Main image'|trans }}
                            </div>
                        {% endif %}

                        <div class="card-footer pb-0">
                            {{ form_row(imageForm, { full_name: form.orderedImages.vars.full_name ~ '[]'}) }}
                            {{ form_widget(form.namesIndexedByImageIdAndLocale.children[imageForm.vars.value]) }}
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% else %}
            {% do form.orderedImages.setRendered %}

            <div class="row">
                <label class="col-form-label col-sm-2">
                    {{ 'Image'|trans }}:
                </label>
                <div class="col-sm-10">
                    <div style="max-width: 15em;">
                        {{ image(entity, {class: 'img-thumbnail'}) }}
                    </div>
                </div>
            </div>
        {% endif %}

        <div class="d-none">
            {{ form_widget(form.imagesToDelete) }}
        </div>
    {% endif %}

    {% set disabledField = form.vars.disabled %}
    <div class="{{ disabledField is same as true ? 'disabled' }}">
        {{ form_errors(form) }}
        {{ form_label(form, label) }}
        {{ form_widget(form) }}
    </div>
{% endblock image_upload_row %}
