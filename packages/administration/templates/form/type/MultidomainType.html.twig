{% block multidomain_row %}
    <div class="mb-3">
        {{ form_label(form) }}

        {{ form_help(form) }}

        {% if layout is same as constant('\\Shopsys\\FrameworkBundle\\Form\\Locale\\LocalizedType::LAYOUT_INLINE') %}
            <fieldset>
                {% for child in form %}
                    <div class="input-group input-group-flat mb-3">
                    <span class="input-group-text">
                        {{ domain_icon(child.vars.attr['data-domain-id']) }}
                    </span>
                        {{- form_widget(child) -}}
                    </div>
                {% endfor %}
            </fieldset>
        {% else %}
            {% for child in form %}
                {% set childContent = form_widget(child)|trim %}

                {% if childContent is not empty %}
                    <div class="card mb-3">
                        <div class="card-header card-header-light py-2">
                        <span>
                            {{ domain_icon(child.vars.attr['data-domain-id']) }}
                            {{ 'Domain'|trans }}
                            <strong>{{ getDomainName(child.vars.attr['data-domain-id']) }}</strong>
                        </span>
                        </div>
                        <div class="card-body">
                            {{- childContent|raw -}}
                        </div>
                    </div>
                {% endif %}
            {% endfor %}
        {% endif %}
        {{ form_errors(form) }}
    </div>
{% endblock %}
