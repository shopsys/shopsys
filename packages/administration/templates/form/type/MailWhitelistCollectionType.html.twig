{% macro mailWhitelistRow(mailWhitelist, index) %}
    <tr class="js-mail-whitelist-item js-form-group" data-index="{{ index }}">
        <td>
            <div>
                {{ form_widget(mailWhitelist) }}
                {{ form_errors(mailWhitelist) }}
            </div>
        </td>
        <td class="align-middle">
            <a href="#" class="js-mail-whitelist-item-remove">{{ ux_icon('delete') }}</a>
        </td>
    </tr>
{% endmacro %}

{% block mail_whitelist_collection_widget %}
    {% import _self as self %}
    <div class="js-form-group form-group">
        <table class="table" id="mail-whitelist">
            <tbody class="js-mail-whitelist" data-prototype="{{ self.mailWhitelistRow(form.vars.prototype)|escape }}" data-index="{{ form|length }}">

            {% for key, mailWhitelist in form %}
                {{ self.mailWhitelistRow(mailWhitelist, key) }}
            {% else %}
                {% do form.setRendered %}
            {% endfor %}

            <tr class="js-mail-whitelist-empty-item">
                <td colspan="4">{{ 'Add some mail whitelist patterns'|trans }}</td>
            </tr>
            </tbody>
        </table>

        <div>
            <div>
                <a href="#" class="js-mail-whitelist-item-add btn btn-secondary">
                    {{ ux_icon('plus') }}
                    {{ 'Add another mail whitelist pattern'|trans }}
                </a>
            </div>
        </div>
    </div>
{% endblock %}
