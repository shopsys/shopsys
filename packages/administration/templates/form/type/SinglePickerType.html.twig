{% block single_picker_row %}
    <div class="mb-3 row">
        {% if inline_label %}
            <div class="col">
                {{ form_widget(form) }}
            </div>
        {% else %}
            {{- form_label(form) -}}
            {{- form_widget(form, {attr: {class: 'col-sm-10'}}) -}}
        {% endif %}
    </div>
{% endblock %}

{% block single_picker_widget %}
    {% if attr %}
        <div {{ block('attributes') }}>
    {% endif %}

    <div class="input-group js-single-picker"
         data-picker-url="{{ picker_url }}"
         data-picker-title="{{ picker_title }}"
         data-placeholder="{{ placeholder }}"
    >
        {% if inline_label %}
            <span class="input-group-text"><strong>{{ label|trans({}, translation_domain) }}</strong></span>
        {% endif %}

        <input type="text"
               class="form-control js-single-picker-label{% if inline_label %} bg-white{% endif %}"
               {% if inline_label %}style="color: var(--tblr-body-color);"{% endif %}
               value="{{ selected_name|default(placeholder) }}"
               disabled="disabled"
               readonly="readonly"
        />

        <button type="button"
                class="js-single-picker-button-add btn{% if inline_label %} btn-icon{% endif %}"
                title="{{ picker_title }}"
        >
            {% if inline_label %}{{ ux_icon('search') }}{% else %}...{% endif %}
        </button>

        {% if enable_remove %}
            <button type="button"
                    class="js-single-picker-button-remove btn btn-icon"
                    disabled
                    title="{{ 'Remove'|trans }}"
            >
                {{ ux_icon('trash') }}
            </button>
        {% endif %}

        {{ form_widget(form, {attr: {class: 'js-single-picker-input'}}) }}
    </div>

    {% if attr %}
        </div>
    {% endif %}
{% endblock %}
