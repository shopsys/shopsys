{%- block phone_widget -%}
    <div class="row">
        {% for child in form %}
            <div class="{{ loop.first ? 'col-3' : 'col' }}">
                {{- form_widget(child) -}}
                {{- form_errors(child) -}}
            </div>
        {% endfor %}
    </div>
    {% if form.vars.unknownPrefix is not null %}
        <div class="mt-2 text-warning small">
            {{ ux_icon('warning', { class: 'me-1 icon icon-sm' }) }}
            {{ 'Unknown phone prefix "%prefix%" is stored. Please verify it.'|trans({'%prefix%': form.vars.unknownPrefix}) }}
        </div>
    {% endif %}
{%- endblock -%}
