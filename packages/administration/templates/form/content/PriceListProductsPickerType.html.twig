{% block price_list_products_picker_row -%}
    <div class="card mb-3">
        <div class="card-header">
            <h3 class="card-title">{{ 'Products'|trans }}</h3>
        </div>
        <div class="card-body p-0">
            {{- form_widget(form) -}}
        </div>
    </div>
{%- endblock %}

{% block price_list_products_picker_widget %}
    {% import _self as self %}
    {% set attr = attr|merge({'class': (attr.class|default('') ~ ' js-price-list-product-picker')|trim}) %}
    <div {{ block('widget_attributes') }}
            data-products-picker-prototype="{{ self.productsWidgetItem(null, form.vars.prototype, domainId)|e }}"
            data-products-picker-url="{{ url('admin_productpicker_pickmultiple', {jsInstanceId: '__js_instance_id__', allowMainVariants: 0, allowVariants: 1, withPrice: 1, domainId: domainId}) }}"
    >
        <div class="table-responsive">
            <table class="table">
                <thead class="js-price-list-product-picker-header">
                    <tr>
                        <th>{{ 'Catalog number'|trans }}</th>
                        <th>{{ 'EAN'|trans }}</th>
                        <th>{{ 'Name'|trans }}</th>
                        <th>{{ 'Special price' |trans }} {{ priceVatLabel() }}</th>
                        <th>{{ 'Basic price'|trans }} {{ priceVatLabel() }}</th>
                        <th class="text-wrap">{{ 'Discount against basic price'|trans }} {{ priceVatLabel() }}</th>
                        <th>% {{ 'discount'|trans }}</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody class="js-price-list-product-picker-items">
                    {% for key, productForm in form %}
                        {{ self.productsWidgetItem(form.vars.priceListProductPrices[key], productForm, domainId) }}
                    {% endfor %}
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="8" class="text-end">
                            <button type="button" class="btn js-price-list-product-picker-button-add">
                                {{ ux_icon('plus') }}
                                {{ 'Add product'|trans }}
                            </button>
                        </td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
{% endblock %}

{% macro productsWidgetItem(priceListProductPrice, form, domainId) %}
    {% set product = null %}
    {% set discount = null %}
    {% set hasDiscount = null %}
    {% set currency = currencyCode(domainId) %}

    {% if priceListProductPrice is not null %}
        {% set product = priceListProductPrice.product %}
        {% set discount = priceListProductPrice.discount %}
        {% set hasDiscount = priceListProductPrice.hasDiscount %}
    {% endif %}

    <tr class="js-price-list-product-picker-item">
        <td>
            <span class="js-price-list-product-picker-item-product-catnum">
                {% if product is not null %}
                    {{ product.catnum }}
                {% endif %}
            </span>
        </td>
        <td>
            <span class="js-price-list-product-picker-item-product-ean">
                {% if product is not null %}
                    {{ product.ean }}
                {% endif %}
            </span>
        </td>
        <td>
            <span class="js-price-list-product-picker-item-product-name">
                {% if product is not null %}
                    <a href="{{ url('admin_product_edit', {id: product.id}) }}"
                       target="_blank"
                       rel="noopener"
                    >
                        {{ product.getName(getDomain().getDomainConfigById(domainId).getLocale()) }}
                        {{ ux_icon('forward-page') }}
                    </a>
                {% endif %}
            </span>
        </td>
        <td>
            {{ form_widget(form.priceAmount, {
                symbolAfterInput: currencySymbolByDomainId(domainId),
                attr: { class: 'js-price-list-product-picker-item-price-input js-price-list-product-picker-item-input-reorder', 'data-name': 'priceAmount' }
            }) }}
            {{ form_errors(form.priceAmount) }}
        </td>
        <td>
            {% if product is not null %}
                <span class="js-price-list-product-picker-item-product-price"
                      data-price="{{ priceListProductPrice.basicPrice|moneyFormat }}" data-currency="{{ currency }}"
                      data-locale="{{ app.request.locale }}">
                    {{ priceListProductPrice.basicPrice|priceWithCurrencyByDomainId(domainId) }}
                </span>
            {% else %}
                <span class="js-price-list-product-picker-item-product-price" data-price="0"
                      data-currency="{{ currency }}" data-locale="{{ app.request.locale }}">
                </span>
            {% endif %}
        </td>
        <td>
            {% if product is not null %}
                {{ _self.productPrice(discount, hasDiscount, domainId) }}
            {% else %}
                <span class="js-price-list-product-picker-item-product-price-discount"></span>
            {% endif %}
        </td>
        <td>
            {% if product is not null %}
                {{ _self.productDiscount(priceListProductPrice, discount, hasDiscount) }}
            {% else %}
                <span class="js-price-list-product-picker-item-product-price-discount-percentage"></span>
            {% endif %}
        </td>
        <td>
            <span class="cursor-pointer js-price-list-product-picker-item-button-delete">
                {{ ux_icon('delete') }}
                {{ form_widget(form.product, {attr: {class: 'js-price-list-product-picker-item-input js-price-list-product-picker-item-input-reorder', 'data-name': 'product'}}) }}
                {{ form_widget(form.basicPrice, {attr: {class: 'js-price-list-product-picker-item-base-price-input js-price-list-product-picker-item-input-reorder', 'data-name': 'basicPrice'}}) }}
            </span>
        </td>
    </tr>
{% endmacro %}

{% macro productPrice(discount, hasDiscount, domainId) %}
    {{ _self.showContent(
        discount|priceWithCurrencyByDomainId(domainId),
        hasDiscount,
        'js-price-list-product-picker-item-product-price-discount'
    ) }}
{% endmacro %}

{% macro productDiscount(priceListProductPrice, discount, hasDiscount) %}
    {{ _self.showContent(
        (discount.amount / (priceListProductPrice.basicPrice.amount == 0 ? 1 : priceListProductPrice.basicPrice.amount) * 100)|round(0, 'floor') ~ '%',
    hasDiscount,
    'js-price-list-product-picker-item-product-price-discount-percentage'
    ) }}
{% endmacro %}

{% macro showContent(content, hasDiscount, class) %}
    <span style="color: {{ hasDiscount ? 'green' : 'red' }}" class="{{ class }}">
       {{ content }}
    </span>
{% endmacro %}
