{% macro productVideoRow(formData) %}
    <div class="row mb-3 border-bottom">
        <div class="col">
            {{ form_widget(formData) }}
            {{ form_errors(formData) }}
        </div>
        <div class="col-auto">
            <button class="js-remove-row btn btn-icon btn-ghost-danger" type="button">{{ ux_icon('delete') }}</button>
        </div>
    </div>
{% endmacro %}

{% block _product_form_videosGroup_widget %}
    <div class="js-form-group">
        <div class="js-videos-collection"
             data-prototype="{{ _self.productVideoRow(form.children.productVideosData.vars.prototype)|escape }}"
             data-index="{{ form.children.productVideosData.children|length }}"
        >
            {% for productVideosDataRow in form.children.productVideosData %}
                {{ _self.productVideoRow(productVideosDataRow) }}
            {% endfor %}
        </div>

        {% do form.setRendered() %}

        <span class="js-videos-collection-add-row btn">
            {{ ux_icon('plus') }}
            {{ 'Add video'|trans }}
        </span>
    </div>
{% endblock %}
