{% block _store_form_userInformation_openingHours_widget %}
    {% set dayNamesIndexedByDayNumber = {
        1: 'Monday'|trans,
        2: 'Tuesday'|trans,
        3: 'Wednesday'|trans,
        4: 'Thursday'|trans,
        5: 'Friday'|trans,
        6: 'Saturday'|trans,
        7: 'Sunday'|trans,
    } %}

    {{ form_errors(form) }}

    {% for openingHours in form %}
        <div class="row py-3{{ not loop.last ? ' border-bottom' }}">
            <div class="col-3">
                <strong>{{ dayNamesIndexedByDayNumber[openingHours.vars.value.dayOfWeek] }}</strong>
            </div>

            <div class="col">
                {% embed '@ShopsysAdministration/partial/_interactive_collection.html.twig' with { form: openingHours.openingHoursRanges } %}
                    {% block collection_entry %}
                        <div class="row g-2 align-items-center">
                            <div class="col">
                                {{ form_widget(entry.openingTime) }}
                                {{ form_errors(entry.openingTime) }}
                            </div>

                            <div class="col-auto">—</div>

                            <div class="col">
                                {{ form_widget(entry.closingTime) }}
                                {{ form_errors(entry.closingTime) }}
                            </div>
                        </div>
                        {{ form_errors(entry) }}
                    {% endblock %}
                {% endembed %}
            </div>
        </div>
    {% endfor %}
{% endblock %}
