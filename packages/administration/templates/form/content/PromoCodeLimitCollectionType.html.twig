{% block promo_code_limit_collection_widget %}
    {% embed '@ShopsysAdministration/partial/_interactive_collection.html.twig' %}
        {% block collection_header %}
            <div class="row mb-3 text-uppercase fs-5 bg-surface-tertiary text-secondary p-2 border-bottom d-none d-md-flex">
                <div class="col-6">
                    <strong>{{ 'From (with VAT)'|trans }}</strong>
                </div>
                <div class="col-6">
                    <strong>{{ 'Discount'|trans }}</strong>
                </div>
            </div>
        {% endblock %}

        {% block collection_entry %}
            <div class="row g-2 align-items-center">
                <div class="col-12 col-md">
                    <label class="d-md-none col-form-label" for="{{ entry.fromPrice.vars.id }}">{{ 'From (with VAT)'|trans }}</label>
                    {{ form_widget(entry.fromPrice) }}
                    {{ form_errors(entry.fromPrice) }}
                </div>
                <div class="d-none d-md-block col-md-auto">
                    {{ ux_icon('arrow-simple') }}
                </div>
                <div class="col-12 col-md">
                    <label class="d-md-none col-form-label" for="{{ entry.discount.vars.id }}">{{ 'Discount'|trans }}</label>
                    {{ form_widget(entry.discount) }}
                    {{ form_errors(entry.discount) }}
                </div>
            </div>
        {% endblock %}
    {% endembed %}
{% endblock promo_code_limit_collection_widget %}
