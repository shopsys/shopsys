{% block order_items_row %}
    {% import '@ShopsysAdministration/content/order/orderItem.html.twig' as orderItemMacro %}
    {% set isEditable = canEdit|default(false) %}
    {% set isEditMode = form.vars.submitted and not form.vars.valid %}
    {% set canRemovePreviewItem = isEditable and form.itemsWithoutTransportAndPayment|length > 1 %}

    <div class="card mb-3 js-order-items-card" data-initial-mode="{{ isEditMode ? 'edit' : 'preview' }}">
        <div class="card-header d-flex flex-wrap align-items-center justify-content-between gap-2">
            <h3 class="card-title mb-0">{{ 'Order items'|trans }}</h3>
            {% if isEditable %}
                <div class="btn-list js-order-items-preview-only{% if isEditMode %} d-none{% endif %}">
                    <button type="button"
                            class="btn btn-sm btn-outline-primary js-order-items-add-product-preview"
                    >
                        {{ 'Add product'|trans }}
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-primary js-order-items-add-item-preview">
                        {{ 'Add item'|trans }}
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-primary js-order-items-switch-to-edit">
                        {{ 'Edit items'|trans }}
                    </button>
                </div>
                <div class="btn-list js-order-items-edit{% if not isEditMode %} d-none{% endif %}">
                    <button type="button"
                            id="js-order-item-add-product"
                            class="btn btn-sm btn-outline-primary"
                            data-product-picker-url="{{ url('admin_productpicker_picksingle', {allowMainVariants: false}) }}"
                    >
                        {{ 'Add product'|trans }}
                    </button>
                    <button type="button"
                            id="js-order-item-add"
                            class="btn btn-sm btn-outline-primary"
                    >
                        {{ 'Add item'|trans }}
                    </button>
                </div>
            {% endif %}
        </div>

        <div class="card-body p-0 js-order-items-preview{% if isEditMode %} d-none{% endif %}">
            <div class="table-responsive">
                <table class="table table-hover table-striped table-vcenter mb-0 order-items-preview-table">
                    <thead>
                        <tr>
                            <th class="order-items-preview-col-name">{{ 'Name'|trans }}</th>
                            <th class="text-end order-items-preview-col-amount">{{ 'Amount'|trans }}</th>
                            <th class="text-end order-items-preview-col-unit-price order-items-preview-col-label-wrap">{{ 'Unit price including VAT'|trans }} ({{ currencySymbolByCode(order.currencyCode) }})</th>
                            <th class="text-end order-items-preview-col-total order-items-preview-col-label-wrap">{{ 'Total including VAT'|trans }} ({{ currencySymbolByCode(order.currencyCode) }})</th>
                            {% if isEditable %}
                                <th class="order-items-preview-col-action"></th>
                            {% endif %}
                        </tr>
                    </thead>
                    <tbody>
                        {% for orderItemId, orderItemForm in form.itemsWithoutTransportAndPayment %}
                            {% set itemData = orderItemForm.vars.data %}
                            {% set productItemData = (itemData is not null and itemData.type in ['product', 'productGift']) ? itemData : null %}
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        {% if productItemData and productItemData.product %}
                                            <div class="order-item-thumb">
                                                {{ image(productItemData.product, { width: 36, height: 36, class: 'order-item-thumb__image' }) }}
                                            </div>
                                        {% endif %}
                                        <div class="min-w-0">
                                            <div class="d-flex align-items-center gap-1 min-w-0">
                                                {% if productItemData and productItemData.product %}
                                                    <a href="{{ path('admin_product_edit', { id: productItemData.product.id }) }}"
                                                       class="fw-medium"
                                                       target="_blank"
                                                       title="{{ 'Open product detail'|trans }}">
                                                        {{ itemData.name }}
                                                        {{ ux_icon('forward-page', { class: 'icon icon-sm' }) }}
                                                    </a>
                                                {% else %}
                                                    <span class=" text-truncate">{{ itemData.name }}</span>
                                                {% endif %}
                                            </div>
                                            {% if itemData.catnum %}
                                                <div class="small text-secondary">{{ itemData.catnum }}</div>
                                            {% endif %}
                                        </div>
                                    </div>
                                </td>
                                <td class="text-end text-nowrap">{{ itemData.quantity }} {{ itemData.unitName ?: '-' }}</td>
                                <td class="text-end text-nowrap">{{ itemData.unitPriceWithVat|priceWithCurrencyByOrder(order) }}</td>
                                <td class="text-end text-nowrap ">{{ itemData.totalPriceWithVat|priceWithCurrencyByOrder(order) }}</td>
                                {% if isEditable %}
                                    <td class="text-center align-middle">
                                        {% if canRemovePreviewItem %}
                                            <a href="#"
                                               class="text-secondary js-order-item-remove-preview"
                                               data-index="{{ orderItemId }}"
                                               title="{{ 'Remove item'|trans }}">
                                                {{ ux_icon('trash', { class: 'icon icon-sm' }) }}
                                            </a>
                                        {% else %}
                                            <span class="text-secondary"
                                                  title="{{ 'Order must contain at least one item'|trans }}">
                                                {{ ux_icon('trash', { class: 'icon icon-sm' }) }}
                                            </span>
                                        {% endif %}
                                    </td>
                                {% endif %}
                            </tr>
                        {% endfor %}

                        {% set transportData = form.orderTransport.vars.data %}
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="text-secondary d-inline-flex align-items-center">
                                        {{ ux_icon('tabler:truck', { class: 'icon icon-sm' }) }}
                                    </span>
                                    <span class="">{{ transportData.name }}</span>
                                </div>
                            </td>
                            <td class="text-end text-nowrap">1</td>
                            <td class="text-end text-nowrap">{{ transportData.unitPriceWithVat|priceWithCurrencyByOrder(order) }}</td>
                            <td class="text-end text-nowrap ">{{ transportData.unitPriceWithVat|priceWithCurrencyByOrder(order) }}</td>
                            {% if isEditable %}
                                <td></td>
                            {% endif %}
                        </tr>

                        {% set paymentData = form.orderPayment.vars.data %}
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="text-secondary d-inline-flex align-items-center">
                                        {{ ux_icon('tabler:credit-card', { class: 'icon icon-sm' }) }}
                                    </span>
                                    <span class="">{{ paymentData.name }}</span>
                                </div>
                            </td>
                            <td class="text-end text-nowrap">1</td>
                            <td class="text-end text-nowrap">{{ paymentData.unitPriceWithVat|priceWithCurrencyByOrder(order) }}</td>
                            <td class="text-end text-nowrap ">{{ paymentData.unitPriceWithVat|priceWithCurrencyByOrder(order) }}</td>
                            {% if isEditable %}
                                <td></td>
                            {% endif %}
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="3" class="text-end text-nowrap">
                                <strong>{{ 'Total'|trans }}</strong>
                            </td>
                            <td class="text-end text-nowrap">
                                <strong>{{ order.totalPriceWithVat|priceWithCurrencyByOrder(order) }}</strong>
                            </td>
                            {% if isEditable %}
                                <td></td>
                            {% endif %}
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>

        <div class="card-body p-0 js-order-items-edit{% if not isEditMode %} d-none{% endif %}">
            <div class="table-responsive">
                {{ form_errors(form.itemsWithoutTransportAndPayment) }}

                <table class="table table-hover table-vcenter">
                    <thead>
                        <tr>
                            <th style="min-width: 280px;">{{ 'Name'|trans }}</th>
                            <th style="width: 120px;">{{ 'Catalog number'|trans }}</th>
                            <th class="text-end" style="width: 70px;">{{ 'Amount'|trans }}</th>
                            <th class="text-end" style="width: 70px;">{{ 'Unit'|trans }}</th>
                            <th class="text-wrap text-end">{{ 'Unit price excluding VAT'|trans }} ({{ currencySymbolByCode(order.currencyCode) }})</th>
                            <th class="text-wrap text-end" style="width: 80px;">{{ 'VAT rate (%)'|trans }}</th>
                            <th class="text-wrap text-end">{{ 'Unit price including VAT'|trans }} ({{ currencySymbolByCode(order.currencyCode) }})</th>
                            <th class="text-wrap text-end">{{ 'Total excluding VAT'|trans }} ({{ currencySymbolByCode(order.currencyCode) }})</th>
                            <th class="text-wrap text-end">{{ 'Total including VAT'|trans }} ({{ currencySymbolByCode(order.currencyCode) }})</th>
                            <th class="text-wrap text-center" style="width: 90px;">
                                {{ 'Set prices manually'|trans }}
                                {{ info_icon('All prices have to be handled manually if checked, otherwise the unit price without VAT and the total prices for that item will be recalculated automatically.'|trans) }}
                            </th>
                            <th style="width: 40px;"></th>
                        </tr>
                    </thead>
                    <tbody id="js-order-items"
                           data-prototype="{{ orderItemMacro.orderItem(form.itemsWithoutTransportAndPayment.vars.prototype, null, null, inputPriceType)|escape }}"
                           data-order-product-add-url="{{ url('admin_order_addproduct', { orderId: order.id }) }}"
                    >
                        {% for orderItemId, orderItemForm in form.itemsWithoutTransportAndPayment %}
                            {% set itemData = orderItemForm.vars.data %}
                            {% set productItemData = (itemData is not null and itemData.type in ['product', 'productGift']) ? itemData : null %}
                            {{ orderItemMacro.orderItem(orderItemForm, orderItemId, productItemData, inputPriceType) }}
                        {% endfor %}

                        {{ orderItemMacro.orderTransport(form.orderTransport, transportPricesWithVatByTransportId, transportVatPercentsByTransportId, inputPriceType) }}
                        {{ orderItemMacro.orderPayment(form.orderPayment, paymentPricesWithVatByPaymentId, paymentVatPercentsByPaymentId, inputPriceType) }}
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="7" class="text-end">
                                <strong>{{ 'Total'|trans }}</strong>
                            </td>
                            <td class="text-end">
                                <strong>{{ order.totalPriceWithoutVat|priceWithCurrencyByOrder(order) }}</strong>
                            </td>
                            <td class="text-end">
                                <strong>{{ order.totalPriceWithVat|priceWithCurrencyByOrder(order) }}</strong>
                            </td>
                            <td></td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
{% endblock %}
