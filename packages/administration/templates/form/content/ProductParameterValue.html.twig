{% macro parameterRow(parameter, index) %}
    {% set parameterUnit = parameter.parameter.vars.data.unit ?? null %}
    <div class="js-parameters-item js-form-group row align-items-center mb-3 pb-3 border-bottom" data-index="{{ index }}">
        <div class="col-11 col-md-5 mb-2 mb-md-0">
            <label class="d-md-none col-form-label">{{ 'Parameter'|trans }}</label>
            {{ form_widget(parameter.parameter, { isSimple: true} ) }}
        </div>
        <div class="d-none d-md-block col-md-1 text-center">
            {{ ux_icon('arrow-simple') }}
        </div>
        <div class="col-11 col-md-5">
            <label class="d-md-none col-form-label">{{ 'Value'|trans }}</label>
            {% for locale, valueTextLocaleForm in parameter.valueTextsByLocale %}
                <div class="mb-3">
                    {% if parameterUnit is not null %}
                        {{ form_widget(valueTextLocaleForm, {
                            rawSymbolBeforeInput: localeFlag(locale),
                            symbolAfterInput: parameterUnit.getName(locale)}
                        ) }}
                    {% else %}
                        {{ form_widget(valueTextLocaleForm, { rawSymbolBeforeInput: localeFlag(locale) }) }}
                    {% endif %}
                </div>
                {{ form_errors(valueTextLocaleForm) }}
            {% endfor %}
        </div>
        <div class="col-1 text-center">
            <a href="#" class="js-parameters-item-remove">{{ ux_icon('delete') }}</a>
        </div>
    </div>
{% endmacro %}

{% block product_parameter_value_row %}
    {% import _self as self %}
    <div class="js-form-group">
        {% if form_errors(form) is not empty %}
            <p class="card-subtitle">{{ form_errors(form) }}</p>
        {% endif %}

        {% if form_help(form) is not empty %}
            <p class="card-subtitle">{{ form_help(form) }}</p>
        {% endif %}

        <div id="product_form_parameters">
            <div class="row mb-3 text-uppercase fs-5 bg-surface-tertiary text-secondary p-2 border-bottom d-none d-md-flex">
                <div class="col-6">
                    <strong>{{ 'Parameter'|trans }}</strong>
                </div>
                <div class="col-6">
                    <strong>{{ 'Value'|trans }}</strong>
                </div>
            </div>
            <div class="js-parameters" data-prototype="{{ self.parameterRow(form.vars.prototype)|escape }}" data-index="{{ form|length }}">
                {% for key, parameter in form %}
                    {{ self.parameterRow(parameter, key) }}
                {% else %}
                    {% do form.setRendered %}
                {% endfor %}

                <div class="js-parameters-empty-item row" style="display: none">
                    <div class="col-12 text-muted">{{ 'Add some parameters'|trans }}</div>
                </div>
            </div>
        </div>

        <div>
            <button type="button" class="js-parameters-item-add btn">
                {{ ux_icon('plus') }}
                {{ 'Add another parameter'|trans }}
            </button>
        </div>
    </div>
{% endblock %}
