{% block product_parameter_value_row %}
    {% if form_errors(form) is not empty %}
        <p class="card-subtitle">{{ form_errors(form) }}</p>
    {% endif %}

    {% if form_help(form) is not empty %}
        <p class="card-subtitle">{{ form_help(form) }}</p>
    {% endif %}

    {% embed '@ShopsysAdministration/partial/_interactive_collection.html.twig' %}
        {% block collection_header %}
            <div class="row mb-3 text-uppercase fs-5 bg-surface-tertiary text-secondary p-2 border-bottom d-none d-md-flex">
                <div class="col-6">
                    <strong>{{ 'Parameter'|trans }}</strong>
                </div>
                <div class="col-6">
                    <strong>{{ 'Value'|trans }}</strong>
                </div>
            </div>
        {% endblock %}

        {% block collection_entry %}
            {% set parameterUnit = entry.parameter.vars.data.unit ?? null %}
            <div class="row g-2 align-items-center">
                <div class="col-12 col-md">
                    <label class="d-md-none col-form-label">{{ 'Parameter'|trans }}</label>
                    {{ form_widget(entry.parameter, { isSimple: true} ) }}
                </div>
                <div class="d-none d-md-block col-md-auto">
                    {{ ux_icon('arrow-simple') }}
                </div>
                <div class="col-12 col-md">
                    <label class="d-md-none col-form-label">{{ 'Value'|trans }}</label>
                    {% for locale, valueTextLocaleForm in entry.valueTextsByLocale %}
                        <div class="mb-3">
                            {% if parameterUnit is not null %}
                                {{ form_widget(valueTextLocaleForm, {
                                    rawSymbolBeforeInput: localeFlag(locale),
                                    symbolAfterInput: parameterUnit.getName(locale)}
                                ) }}
                            {% else %}
                                {{ form_widget(valueTextLocaleForm, { rawSymbolBeforeInput: localeFlag(locale) }) }}
                            {% endif %}
                        </div>
                        {{ form_errors(valueTextLocaleForm) }}
                    {% endfor %}
                </div>
            </div>
        {% endblock %}
    {% endembed %}
{% endblock %}
