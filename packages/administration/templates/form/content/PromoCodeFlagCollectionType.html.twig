{% block promo_code_flag_collection_widget %}
    {% embed '@ShopsysAdministration/partial/_interactive_collection.html.twig' %}
        {% block collection_header %}
            <div class="row mb-3 text-uppercase fs-5 bg-surface-tertiary text-secondary p-2 border-bottom d-none d-md-flex">
                <div class="col-6">
                    <strong>{{ 'Flag'|trans }}</strong>
                </div>
                <div class="col-6">
                    <strong>{{ 'Type'|trans }}</strong>
                </div>
            </div>
        {% endblock %}

        {% block collection_entry %}
            <div class="row g-2 align-items-center">
                <div class="col-12 col-md">
                    {{ form_widget(entry.flag) }}
                    {{ form_errors(entry.flag) }}
                </div>
                <div class="d-none d-md-block col-md-auto">
                    {{ ux_icon('arrow-simple') }}
                </div>
                <div class="col-12 col-md">
                    {{ form_widget(entry.type) }}
                    {{ form_errors(entry.type) }}
                </div>
            </div>
        {% endblock %}
    {% endembed %}
{% endblock %}
