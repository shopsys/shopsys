{% block prices_by_pricing_groups_row %}
    <div class="row">
        <div class="col">
            <h4>{{ inputPriceLabel() }}</h4>
        </div>
        <div class="col text-end d-none d-md-block">
            <h4>{{ 'Selling prices'|trans }}</h4>
        </div>
    </div>
    {{ form_widget(form) }}
{% endblock %}

{% block pricing_group_currency_prices_row %}
    {% if form.vars.label %}
        <div class="row">
            <div class="col">
                <h5 class="mb-0 mt-2">{{ form.vars.label }}</h5>
            </div>
        </div>
    {% endif %}

    {% for currencyPriceInput in form %}
        {{ form_row(currencyPriceInput) }}
    {% endfor %}

    {{ form_errors(form) }}
{% endblock %}

{% block pricing_group_price_input_row %}
    {% set domainId = form.parent.parent.vars.domain_id %}
    {% set currencyCode = form.vars.currency_code %}

    <div class="row align-items-center">
        {{ form_label(form) }}

        <div class="col-12 col-md-6">
           {{ form_widget(form, { symbolAfterInput: currencyCode is not null ? currencySymbolByCode(currencyCode) : currencySymbolByDomainId(domainId) }) }}
            {{ form_errors(form) }}
        </div>

        <div class="mt-2 d-md-none">
            <h4>{{ 'Selling prices'|trans }}</h4>
        </div>

        {% if form.vars.product_price %}
            <div class="col-6 col-md-2 text-md-end ms-auto">
                {{ form.vars.product_price.price.priceWithoutVat|priceWithCurrencyByDomainId(domainId) }}
                <br>
                <span class="small">{{ 'Excl. VAT'|trans }}</span>
            </div>
            <div class="col-6 col-md-2 text-md-end">
                <strong>
                    {{ form.vars.product_price.price.priceWithVat|priceWithCurrencyByDomainId(domainId) }}
                </strong>
                <br>
                <span class="small">{{ 'Incl. VAT'|trans }}</span>
            </div>
        {% endif %}
    </div>
{% endblock %}
