{% set exportedDocumentJson = this.exportedDocumentJson %}
<div {{ attributes.defaults({
    'class': 'modal-content',
    'data-controller': 'content-editor block-picker-filter',
    'data-content-editor-exported-document-value': exportedDocumentJson,
    'data-tid': 'content-editor',
}) }}>
    <div class="modal-header">
        <h5 class="modal-title">{{ this.label }}</h5>
        <div class="ms-auto d-flex gap-2">
            <button type="button"
                    class="btn btn-outline-secondary"
                    data-action="content-editor-overlay#close"
                    data-tid="content-editor-close">{{ 'Close'|trans }}</button>
            {{ component('Admin:LiveActionButton', {
                action: 'finish',
                label: 'Done'|trans,
                buttonClass: 'btn btn-primary',
                'data-tid': 'content-editor-done',
            }) }}
        </div>
    </div>
    <div class="modal-body p-0 content-editor-panes">
        <div class="content-editor-preview-pane" data-tid="content-editor-preview">
            {% if this.profile == 'web' %}
                {% include '@ShopsysAdministration/content_editor/preview_web.html.twig' %}
            {% elseif this.profile == 'mail' %}
                {% include '@ShopsysAdministration/content_editor/preview_mail.html.twig' %}
            {% else %}
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">{{ 'Preview'|trans }}</h3>
                    </div>
                    <div class="card-body text-secondary">
                        {{ 'Preview is not available yet'|trans }}
                    </div>
                </div>
            {% endif %}
        </div>
        <div class="content-editor-blocks-pane">
            {% include '@ShopsysAdministration/content_editor/block_list.html.twig' with {blocks: form.blocks, slotPath: ''} %}
        </div>
    </div>

    {% include '@ShopsysAdministration/content_editor/picker.html.twig' %}
</div>
