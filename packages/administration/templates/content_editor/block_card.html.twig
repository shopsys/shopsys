{# blockForm: form of the block, path: path of the block, isFirst and isLast: position of the block in its list #}
{% set blockValues = blockForm.vars.value %}
{% set definition = this.blockDefinition(blockValues.type) %}
{% set isContainer = blockForm['children'] is defined %}
{% set toolbarButtonClass = 'btn btn-ghost-secondary btn-icon btn-sm' %}

{# the narrow pane has no room for the labels beside the inputs #}
{% form_theme blockForm.data '@ShopsysAdministration/form/vertical.html.twig' %}

{# the id contains the position and the number of discards, so a block that changed it is rendered anew and its rich text editors are initialized from the new state #}
<div class="card content-editor-card"
     id="content-editor-card-{{ path|replace({'/': '-'}) }}-{{ blockValues.id }}-{{ this.discardCount }}"
     data-content-editor-card
     data-content-editor-collapsible
     data-content-editor-key="{{ blockValues.id }}"
     data-content-editor-empty="{{ this.blockEmpty(blockValues) ? '1' : '0' }}"
     {% if not blockForm.vars.valid %}data-content-editor-has-errors{% endif %}
     data-tid="content-editor-block"
>
    <div class="card-header content-editor-header" data-action="click->content-editor#toggle">
        {% if definition.icon %}
            <span class="flex-shrink-0">{{ ux_icon(definition.icon) }}</span>
        {% endif %}
        <span class="fw-bold flex-shrink-0">{{ definition.label|trans }}</span>
        <span class="text-secondary text-truncate flex-fill" data-tid="content-editor-block-summary">{{ this.blockSummary(blockValues) }}</span>
        <div class="content-editor-toolbar">
            {{ component('Admin:LiveActionButton', {
                action: 'moveUp',
                label: '',
                icon: 'chevron-up',
                buttonClass: toolbarButtonClass,
                liveParams: {path: path},
                disabled: isFirst,
                title: 'Move up'|trans,
                'aria-label': 'Move up'|trans,
                'data-tid': 'content-editor-block-move-up',
            }) }}
            {{ component('Admin:LiveActionButton', {
                action: 'moveDown',
                label: '',
                icon: 'chevron-down',
                buttonClass: toolbarButtonClass,
                liveParams: {path: path},
                disabled: isLast,
                title: 'Move down'|trans,
                'aria-label': 'Move down'|trans,
                'data-tid': 'content-editor-block-move-down',
            }) }}
            {{ component('Admin:LiveActionButton', {
                action: 'duplicateBlock',
                label: '',
                icon: 'duplicate',
                buttonClass: toolbarButtonClass,
                liveParams: {path: path},
                title: 'Duplicate'|trans,
                'aria-label': 'Duplicate'|trans,
                'data-tid': 'content-editor-block-duplicate',
            }) }}
            {{ component('Admin:LiveActionButton', {
                action: 'removeBlock',
                label: '',
                icon: 'trash',
                buttonClass: toolbarButtonClass,
                liveParams: {path: path},
                title: 'Remove'|trans,
                'aria-label': 'Remove'|trans,
                'data-content-editor-remove': '',
                'data-tid': 'content-editor-block-remove',
            }) }}
            <button type="button"
                    class="{{ toolbarButtonClass }} content-editor-toggle"
                    title="{{ 'Collapse or expand'|trans }}"
                    aria-label="{{ 'Collapse or expand'|trans }}"
                    data-content-editor-toggle
                    data-tid="content-editor-block-toggle">{{ ux_icon('chevron-down') }}</button>
        </div>
    </div>

    <div class="card-body" data-content-editor-body>
        {% for field in blockForm.data %}
            {{ form_row(field) }}
        {% endfor %}

        {% if isContainer %}
            {% for slotForm in blockForm['children'] %}
                <div class="content-editor-slot"
                     data-content-editor-collapsible
                     data-content-editor-key="{{ blockValues.id }}:slot:{{ loop.index0 }}"
                     {% if not slotForm.vars.valid %}data-content-editor-has-errors{% endif %}
                     data-tid="content-editor-slot"
                >
                    <div class="content-editor-header" data-action="click->content-editor#toggle">
                        <span class="fw-bold">{{ 'Column %number%'|trans({'%number%': loop.index}) }}</span>
                        <button type="button"
                                class="{{ toolbarButtonClass }} content-editor-toggle"
                                title="{{ 'Collapse or expand'|trans }}"
                                aria-label="{{ 'Collapse or expand'|trans }}"
                                data-content-editor-toggle
                                data-tid="content-editor-slot-toggle">{{ ux_icon('chevron-down') }}</button>
                    </div>
                    <div data-content-editor-body>
                        {% include '@ShopsysAdministration/content_editor/block_list.html.twig' with {
                            blocks: slotForm,
                            slotPath: path ~ '/' ~ loop.index0,
                        } %}
                    </div>
                </div>
            {% endfor %}
        {% endif %}
    </div>
</div>
