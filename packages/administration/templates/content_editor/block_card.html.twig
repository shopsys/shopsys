{# blockForm: form of the block, path: path of the block, isFirst and isLast: position of the block in its list #}
{% set blockValues = blockForm.vars.value %}
{% set definition = this.blockDefinition(blockValues.type) %}
{% set isContainer = blockForm['children'] is defined %}
{% set toolbarButtonClass = 'btn btn-ghost-secondary btn-icon btn-sm' %}

{# the id contains the position, so a block that changed it is rendered anew and its rich text editors are initialized from the new state #}
<div class="card content-editor-card"
     id="content-editor-card-{{ path|replace({'/': '-'}) }}-{{ blockValues.id }}"
     data-content-editor-card
     data-content-editor-block-id="{{ blockValues.id }}"
     data-content-editor-empty="{{ this.blockEmpty(blockValues) ? '1' : '0' }}"
     {% if not blockForm.vars.valid %}data-content-editor-has-errors{% endif %}
     data-tid="content-editor-block"
>
    <div class="card-header content-editor-card-header" data-action="click->content-editor#toggle">
        {% if definition.icon %}
            <span class="me-2">{{ ux_icon(definition.icon) }}</span>
        {% endif %}
        <span class="fw-bold me-2">{{ definition.label|trans }}</span>
        <span class="text-secondary text-truncate flex-fill" data-tid="content-editor-block-summary">{{ this.blockSummary(blockValues) }}</span>
        <div class="btn-list flex-nowrap ms-2">
            {{ component('Admin:LiveActionButton', {
                action: 'moveUp',
                label: '',
                icon: 'chevron-up',
                buttonClass: toolbarButtonClass,
                liveParams: {path: path},
                disabled: isFirst,
                title: 'Move up'|trans,
                'aria-label': 'Move up'|trans,
                'data-tid': 'content-editor-block-move-up',
            }) }}
            {{ component('Admin:LiveActionButton', {
                action: 'moveDown',
                label: '',
                icon: 'chevron-down',
                buttonClass: toolbarButtonClass,
                liveParams: {path: path},
                disabled: isLast,
                title: 'Move down'|trans,
                'aria-label': 'Move down'|trans,
                'data-tid': 'content-editor-block-move-down',
            }) }}
            {{ component('Admin:LiveActionButton', {
                action: 'duplicateBlock',
                label: '',
                icon: 'duplicate',
                buttonClass: toolbarButtonClass,
                liveParams: {path: path},
                title: 'Duplicate'|trans,
                'aria-label': 'Duplicate'|trans,
                'data-tid': 'content-editor-block-duplicate',
            }) }}
            {{ component('Admin:LiveActionButton', {
                action: 'removeBlock',
                label: '',
                icon: 'trash',
                buttonClass: toolbarButtonClass,
                liveParams: {path: path},
                title: 'Remove'|trans,
                'aria-label': 'Remove'|trans,
                'data-content-editor-remove': '',
                'data-tid': 'content-editor-block-remove',
            }) }}
            <button type="button"
                    class="{{ toolbarButtonClass }} content-editor-toggle"
                    title="{{ 'Collapse or expand'|trans }}"
                    aria-label="{{ 'Collapse or expand'|trans }}"
                    data-content-editor-toggle
                    data-tid="content-editor-block-toggle">{{ ux_icon('chevron-down') }}</button>
        </div>
    </div>

    <div class="card-body" data-content-editor-body>
        {% if isContainer and blockForm.data.layout is defined %}
            <div class="mb-3">
                <label class="form-label">{{ 'Layout'|trans }}</label>
                <div class="btn-group" role="group" data-tid="content-editor-layout">
                    {% for choice in blockForm.data.layout.vars.choices %}
                        {{ component('Admin:LiveActionButton', {
                            action: 'changeLayout',
                            label: choice.label|replace({'-': ' + '}),
                            buttonClass: 'btn btn-sm ' ~ (blockForm.data.layout.vars.value == choice.value ? 'btn-primary' : 'btn-outline-secondary'),
                            liveParams: {path: path, layout: choice.value},
                            'data-tid': 'content-editor-layout-' ~ choice.value,
                        }) }}
                    {% endfor %}
                </div>
            </div>
        {% endif %}

        {# the layout of a container is changed with the buttons above, because the slots have to follow it #}
        {% for field in blockForm.data %}
            {% if not (isContainer and field.vars.name == 'layout') %}
                {{ form_row(field) }}
            {% endif %}
        {% endfor %}

        {% if isContainer %}
            <div class="content-editor-slots" data-layout="{{ blockForm.data.layout.vars.value|default('') }}">
                {% for slotForm in blockForm['children'] %}
                    <div class="content-editor-slot" data-tid="content-editor-slot">
                        {% include '@ShopsysAdministration/content_editor/block_list.html.twig' with {
                            blocks: slotForm,
                            slotPath: path ~ '/' ~ loop.index0,
                        } %}
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
</div>
