{% extends '@ShopsysAdministration/layout/base.html.twig' %}

{% block html_body %}
    <div class="page">
        {% block aside %}{% endblock %}

        {% block header %}
            <header class="navbar sticky-lg-top d-print-none flex-column p-0">
                {% if isMailerSettingUnusual() %}
                    <div class="mailer-info py-1 px-3 w-100">
                        <div class="d-flex align-items-center justify-content-center">
                            <div>
                                <span class="alert-icon">{{ ux_icon('warning') }}</span>
                                <span class="d-none d-lg-inline">{{ getMailerSettingInfo() }}</span>
                                <span class="d-lg-none">{{ 'Mailing:' }}</span>
                                <a href="{{ url("admin_mailallowedrecipient_list") }}" class="alert-action">{{ 'View allowed recipients.'|trans }}</a>
                            </div>
                        </div>
                    </div>
                {% endif %}
                <div class="container-fluid py-2" id="navbar-menu">
                    <div class="d-none d-xxl-flex navbar-nav min-h-0">
                        <div class="dropdown">
                            <div class="my-2 my-md-0">
                                <div class="input-group input-group-flat">
                                    <span class="input-group-text">{{ ux_icon('search') }}</span>
                                    <input type="text"
                                           class="form-control js-search-input"
                                           placeholder="{{ "Search by section name…"|trans }}"
                                           data-search-callback-url="{{ url('admin_searchadmin_search') }}"
                                           aria-label="{{ 'Search navigation'|trans }}"
                                    >
                                    <span class="input-group-text d-sm-none d-md-flex">{{ 'type&nbsp;%key%&nbsp;to search'|trans({'%key%': '<kbd>/</kbd>'})|raw }}</span>
                                </div>
                            </div>

                            <div class="dropdown-menu dropdown-menu-arrow dropdown-menu-card js-search-results">
                                <span class="dropdown-header text-end">
                                    <small>{{ 'use %keyTab% or %keyShiftTab%'|trans({'%keyTab%': '<kbd class="small">tab</kbd>', '%keyShiftTab%': '<kbd class="small">shift+tab</kbd>'})|raw }}</small>
                                </span>
                                <div class="list-group list-group-flush overflow-auto js-search-results__window" style="max-height: 35rem"></div>
                            </div>
                        </div>
                    </div>

                    <div class="d-xxl-none">
                        <a class="btn btn-icon" data-bs-toggle="offcanvas" href="#mobile-search-menu" role="button" aria-controls="offcanvasStart">{{ ux_icon('search') }}</a>
                        <div
                                class="offcanvas offcanvas-start"
                                tabindex="-1"
                                id="mobile-search-menu"
                                aria-labelledby="mobileSearchMenuLabel"
                        >
                            <div class="offcanvas-header">
                                <h2 class="offcanvas-title" id="mobileSearchMenuLabel">{{ 'Search by section name…'|trans }}</h2>
                                <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="{{ 'Close'|trans }}"></button>
                            </div>
                            <div class="offcanvas-body">
                                <input type="text"
                                       placeholder="{{ 'Search by section name…'|trans }}"
                                       class="form-control js-search-input"
                                       data-search-callback-url="{{ url('admin_searchadmin_search') }}"
                                       aria-label="{{ 'Search navigation'|trans }}"
                                >
                                <div class="js-search-results">
                                    <div class="list-group list-group-flush js-search-results__window"></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="navbar-nav flex-row order-md-last ms-auto">
                        {% if isMultidomain() %}
                            {% if allowedAdminLocales()|length > 1 %}
                                <div class="nav-item dropdown me-2">
                                    <a class="nav-link dropdown-toggle px-2"
                                       data-bs-toggle="dropdown"
                                       href="#"
                                       role="button"
                                       aria-expanded="false"
                                       title="{{ 'Switch locale'|trans }}"
                                    >
                                        <span class="nav-link-icon">{{ localeFlag(app.user.selectedLocale) }}</span>
                                    </a>
                                    <ul class="dropdown-menu overflow-auto" style="max-height: 300px">
                                        {% for locale in allowedAdminLocales() %}
                                            <li>
                                                <a href="{{ url('admin_localization_selectlocale', { locale: locale }) }}"
                                                   class="dropdown-item"
                                                   title="{{ languageName(locale, locale) }}"
                                                >
                                                    <span class="dropdown-item-icon">{{ localeFlag(locale, locale) }}</span>
                                                    {{ languageName(locale, locale) }}
                                                </a>
                                            </li>
                                        {% endfor %}
                                    </ul>
                                </div>
                            {% endif %}

                            <div class="nav-item dropdown me-2">
                                <a class="nav-link dropdown-toggle px-2" data-bs-toggle="dropdown" href="#" role="button" aria-expanded="false">
                                    <span class="nav-link-icon">{{ ux_icon('filter') }}</span>
                                    <span class="nav-link-title d-none d-md-inline">{{ 'Domain filter'|trans }}</span>
                                    {% if app.user.displayOnlyDomainIds|length > 0 %}
                                        <span class="badge badge-sm bg-red text-red-fg">{{ app.user.displayOnlyDomainIds|length }}</span>
                                    {% endif %}
                                </a>
                                {{ render(controller('Shopsys\\FrameworkBundle\\Controller\\Admin\\SelectAdminDomainsController::renderFormAction')) }}
                            </div>
                        {% endif %}

                        <div class="nav-item dropdown me-2">
                            <a class="nav-link dropdown-toggle px-2" data-bs-toggle="dropdown" href="#" role="button" aria-expanded="false">
                                <span class="nav-link-icon">{{ ux_icon('forward-page') }}</span>
                                <span class="d-none d-md-inline">{{ 'Go to Frontend'|trans }}</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end overflow-auto" style="max-height: 300px; max-width: 270px;">
                                {% for domainConfig in getDomain().getAll() %}
                                    <li>
                                        <a href="{{ domainConfig.url }}"
                                           target="_blank"
                                           class="dropdown-item"
                                           title="{{ domainConfig.name }}"
                                        >
                                            {{ domainConfig.name }}
                                        </a>
                                    </li>
                                {% endfor %}
                            </ul>
                        </div>

                        <div class="nav-item dropdown">
                            <a href="#"
                               class="nav-link dropdown-toggle d-flex lh-1 text-reset p-0 px-2"
                               data-bs-toggle="dropdown"
                               aria-label="{{ 'Open user menu'|trans }}"
                            >
                                <span class="avatar avatar-sm  rounded-circle">
                                    {{ ux_icon('person-man') }}
                                </span>
                                <div class="d-none d-xl-block ps-2">
                                    {{ app.user.realName }}
                                </div>
                            </a>
                            <div class="dropdown-menu dropdown-menu-end dropdown-menu-arrow">
                                {{ renderAdminDropdownMenuItems() }}
                            </div>
                        </div>
                    </div>
                </div>
            </header>
        {% endblock %}

        {% block content %}{% endblock %}

        {% block footer %}{% endblock %}
    </div>
{% endblock %}
