{% extends '@ShopsysAdministration/layout/layout.html.twig' %}

{% block aside %}
    <aside class="navbar navbar-vertical navbar-expand-lg sticky-top" data-bs-theme="dark">
        <div class="container-fluid">
            <h1 class="navbar-brand navbar-brand-autodark">
                <a href="{{ url('admin_default_dashboard') }}">
                    {% block sidebar_project_logo %}
                        <img class="navbar-brand-image" src="{{ asset('public/admin/images/logo-project.svg') }}" alt="Your logo">
                    {% endblock %}
                </a>
            </h1>
            <button class="navbar-toggler collapsed"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#sidebar-menu"
                    aria-controls="sidebar-menu"
                    aria-expanded="false"
                    aria-label="{{ 'Toggle navigation'|trans }}"
            >
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="sidebar-menu">
                {% block menu_panel %}
                    {{ knp_menu_render('admin_side_menu', {template: '@ShopsysAdministration/partial/side_menu.html.twig'}) }}
                {% endblock %}
                <div class="navbar-platform-brand">
                    {% block sidebar_platform_logo %}
                        <img class="navbar-platform-brand-image" src="{{ asset('public/admin/images/logo.svg') }}" alt="Shopsys Platform">
                    {% endblock %}
                </div>
            </div>
        </div>
    </aside>
{% endblock %}

{% block content %}
    <div class="page-wrapper">
        <div class="page-header d-print-none">
            <div class="container-xl">

                {{ render(controller('Shopsys\\FrameworkBundle\\Controller\\Admin\\FlashMessageController::indexAction')) }}

                {{ render_required_settings() }}

                <div class="row mb-3">
                    <div class="col">
                        <div class="small text-secondary">
                            {% block breadcrumb %}
                                {{ render(controller('Shopsys\\FrameworkBundle\\Controller\\Admin\\BreadcrumbController::indexAction')) }}
                            {% endblock %}
                        </div>
                    </div>
                </div>

                <div class="row g-2 align-items-center">
                    <div class="col">
                        <div class="page-pretitle">
                            {% block pre_title %}{% endblock %}
                        </div>
                        <h2 class="page-title">
                            {% block h1 %}{{ 'Administration'|trans }}{% endblock %}
                            <span class="ms-5 btn-list d-inline-flex">
                                {% block links_after_title %}
                                    {% include '@ShopsysAdministration/partial/display_uuid.html.twig' %}
                                {% endblock %}
                            </span>
                        </h2>
                        <div class="page-subtitle">
                            {% block sub_title %}{% endblock %}
                        </div>
                    </div>
                    <div class="col-auto text-end">
                        {% block btn_wrapper %}
                            {% set btnContent %}{% block btn %}{% endblock %}{% endset %}

                            {% if btnContent|trim %}
                                <div class="dropdown d-md-none">
                                    <button class="btn dropdown-toggle" data-bs-toggle="dropdown">{{ ux_icon('dots') }}</button>
                                    <div class="dropdown-menu">
                                        <div class="btn-list m-3 justify-content-end">
                                            {{ btnContent|raw }}
                                        </div>
                                    </div>
                                </div>

                                <div class="btn-list d-none d-md-flex">
                                    {{ btnContent|raw }}
                                </div>
                            {% endif %}
                        {% endblock %}
                    </div>
                </div>
            </div>
        </div>
        <div class="page-body">
            <div class="container-xl space-y">
                {% block main_content %}{% endblock %}
            </div>
        </div>
    </div>
{% endblock %}
