{% extends '@ShopsysAdministration/layout/layout_with_panel.html.twig' %}
{% import '@ShopsysAdministration/crud/inline/actions.html.twig' as actions %}

{% block title %}- {{ title }}{% endblock %}

{% block pre_title %}{{ 'Overview'|trans }}{% endblock %}
{% block h1 %}{{ title }}{% endblock %}

{% block btn %}
    {{ actions.render(topActions) }}
{% endblock %}

{% block main_content %}
    {% block datagrid_controls %}
        {# the domain control displays nothing without a choice, the domain condition applies anyway #}
        {% set domainChoice = domainControlScope is not null and domainControlScope.offersChoice %}
        {% if quickSearch is not null %}
            <div class="row row-deck row-cards mb-3">
                <div class="col-12{{ domainChoice ? ' col-xl-8' }}">
                    <div class="card">
                        <div class="card-body">
                            {{ component('Admin:Grid:QuickSearch', { quickSearch: quickSearch, gridView: grid, embedded: true }) }}
                        </div>
                    </div>
                </div>
                {% if domainChoice %}
                    <div class="col-12 col-xl-4">
                        <div class="card">
                            <div class="card-body d-grid align-items-center row-gap-2 column-gap-3" style="grid-template-columns: auto minmax(0, 1fr)">
                                {{ component('Admin:Grid:DomainControl', { scope: domainControlScope, select: true }) }}
                            </div>
                        </div>
                    </div>
                {% endif %}
            </div>
        {% elseif domainChoice %}
            {{ component('Admin:Grid:DomainControl', { scope: domainControlScope }) }}
        {% endif %}
    {% endblock %}

    {% block before_grid %}{% endblock %}

    {% block grid %}
        {{ grid.render }}
    {% endblock %}

    {% block after_grid %}{% endblock %}
{% endblock %}
