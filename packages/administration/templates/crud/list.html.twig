{% extends '@ShopsysAdministration/layout/layout_with_panel.html.twig' %}
{% import '@ShopsysAdministration/crud/inline/actions.html.twig' as actions %}

{% block title %}- {{ title }}{% endblock %}

{% block pre_title %}{{ 'Overview'|trans }}{% endblock %}
{% block h1 %}{{ title }}{% endblock %}

{% block btn %}
    {{ actions.render(topActions) }}
{% endblock %}

{% block main_content %}
    {# the filter narrows the datagrid only once a rule is composed, which is also when the button counts them #}
    {% set filterActive = filterForm is not null and filterForm.vars.submitted and filterForm.vars.data.hasRules() %}
    {% set filterRuleCount = filterActive ? filterForm.vars.data.groups|reduce((count, group) => count + group.rules|length, 0) : 0 %}
    {% set filterPanelId = filterForm is not null ? filterForm.vars.id ~ '_panel' %}

    {# the domain tabs, the toolbar and the grid read as one surface, so they are styled as one shell #}
    <div class="datagrid-shell">
        {% block datagrid_controls %}
            {% if domainControlScope is not null %}
                {{ component('Admin:Grid:DomainControl', { scope: domainControlScope }) }}
            {% endif %}

            {% if quickSearch is not null or filterForm is not null %}
                <div class="card datagrid-toolbar">
                    <div class="card-body datagrid-toolbar__row">
                        {% if quickSearch is not null %}
                            {{ component('Admin:Grid:QuickSearch', { quickSearch: quickSearch, gridView: grid, embedded: true }) }}
                        {% endif %}

                        {% if filterForm is not null %}
                            {# the panel only hides the composed rules, it never drops them — that is what the bar of active conditions is for #}
                            <button type="button"
                                    class="btn datagrid-toolbar__filter-toggle"
                                    data-bs-toggle="offcanvas"
                                    data-bs-target="#{{ filterPanelId }}"
                                    aria-controls="{{ filterPanelId }}"
                            >
                                {{ ux_icon('filter') }}
                                {{ 'Advanced filter'|trans }}
                                {% if filterRuleCount > 0 %}
                                    <span class="badge bg-blue-lt text-blue-lt-fg">{{ filterRuleCount }}</span>
                                {% endif %}
                            </button>
                        {% endif %}
                    </div>

                    {{ component('Admin:Grid:ActiveFilters', {
                        filterForm: filterForm,
                        quickSearch: quickSearch,
                        filterActive: filterActive,
                    }) }}
                </div>
            {% endif %}
        {% endblock %}

        {{ grid.render }}
    </div>

    {% block datagrid_filter_panel %}
        {% if filterForm is not null %}
            {# the filter slides in from the side of the page, so the records stay where they are while it is composed #}
            <div class="offcanvas offcanvas-end datagrid-filter-panel" tabindex="-1" id="{{ filterPanelId }}" aria-labelledby="{{ filterPanelId }}_title">
                <div class="offcanvas-header">
                    <h2 class="offcanvas-title" id="{{ filterPanelId }}_title">{{ 'Advanced filter'|trans }}</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="{{ 'Close'|trans }}"></button>
                </div>
                {{ component('Admin:Grid:Filters', { filterForm: filterForm, gridView: grid, embedded: true }) }}
            </div>
        {% endif %}
    {% endblock %}
{% endblock %}
