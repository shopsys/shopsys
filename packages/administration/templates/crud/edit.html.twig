{% extends '@ShopsysAdministration/layout/layout_with_panel.html.twig' %}
{% import '@ShopsysAdministration/crud/inline/actions.html.twig' as actions %}

{% block title %}- {{ title }}{% endblock %}

{% block pre_title %}{{ 'Editing'|trans }}{% endblock %}
{% block h1 %}{{ title }}{% endblock %}

{% block btn %}
    {{ actions.render(topActions, entity|default(null)) }}
{% endblock %}

{% block main_content %}
    {{ form(form) }}

    {{ block('entity_log') }}
{% endblock %}

{% block entity_log %}
    {% if showEntityLog|default(false) %}
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">{{ 'History'|trans }}</h3>
            </div>
            <div class="card-body">
                {{ component('Admin:EntityLogTimeline', { entity: entity }) }}
            </div>
        </div>
    {% endif %}
{% endblock %}
