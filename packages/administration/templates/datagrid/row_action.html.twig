{% set url = action_url(actionRoute, row) %}

{% if action_has_access(actionRoute) %}
    {% set tag = disabled ? 'span' : 'a' %}

    <{{ tag }}
    {{ attributes|raw }}
    {% if confirmMessage is not null %} data-confirm-window data-confirm-message="{{ action_confirm_message(confirmMessage, confirmMessageParameters) }}"{% endif %}
    {% if not disabled %} href="{{ url }}"{% endif %}
    >
    {{ ux_icon(icon) }}
    </{{ tag }}>
{% endif %}
