{% block grid %}
    <div class="js-grid card"
         data-total-count="{{ grid.totalCount }}"
         data-grid-id="{{ grid.id|escape('html_attr') }}"
            {% if grid.inlineEdit %}
                data-inline-edit-service-name="{{ grid.inlineEditService.serviceName }}"
                data-inline-edit-url-get-form="{{ url('admin_grid_getform') }}"
                data-inline-edit-url-save-form="{{ url('admin_grid_saveform') }}"
            {% endif %}
            {% if grid.dragAndDrop %}
                data-drag-and-drop-ordering-entity-class="{{ grid.orderingEntityClass }}"
                data-drag-and-drop-url-save-ordering="{{ url('admin_grid_saveordering') }}"
            {% endif %}
    >
        {% if grid.rows is not empty or grid.inlineEdit or grid.multipleDragAndDrop %}


            {% if grid.title %}
                <div class="card-header card-header-no-bg d-flex align-items-center">
                    <h2 class="card-title">
                        {{ gridView.renderBlock('grid_multiple_drag_and_drop_title', { grid_title: grid.title }) }}
                    </h2>
                </div>
            {% endif %}

            {% if grid.inlineEdit and grid.inlineEditService.canAddNewRow %}
                <div class="card-header card-header-no-bg d-flex align-items-center">
                    {{ gridView.renderBlock('grid_inline_edit_add_button') }}
                </div>
            {% elseif grid.enabledPaging %}
                <div class="card-header card-header-no-bg d-flex align-items-center">
                    {{ gridView.renderBlock('grid_pager') }}
                </div>
            {% endif %}

            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    {{ gridView.renderBlock('grid_titles') }}
                    {{ gridView.renderBlock('grid_rows') }}
                </table>
            </div>

            {% if grid.enabledPaging %}
                <div class="card-footer card-footer-no-bg d-flex align-items-center">
                    {{ gridView.renderBlock('grid_pager') }}
                </div>
            {% endif %}

            {% if grid.dragAndDrop %}
                <div class="card-footer card-footer-no-bg d-flex align-items-center flex-wrap gap-3" data-js-unsaved-changes-container>
                    <button class="{% if grid.multipleDragAndDrop %}js-drag-and-drop-grid-submit-all{% else %}js-drag-and-drop-grid-submit{% endif%} ms-auto btn" disabled type="button">{{ 'Save changes in order'|trans }}</button>
                </div>
            {% endif %}
        {% else %}
            <div class="empty">
                <div class="empty-icon">
                    {{ ux_icon('notes-off', { class: 'text-secondary' }) }}
                </div>
                <p class="empty-title">{{ gridView.renderBlock('grid_no_data') }}</p>
                <p class="empty-subtitle text-secondary">
                    {{ gridView.renderBlock('grid_no_data_subtitle') }}
                </p>
            </div>
        {% endif %}
    </div>
{% endblock %}

{% block grid_no_data %}
    {{ 'No records found.'|trans }}
{% endblock %}

{% block grid_no_data_subtitle %}
    {{ 'Try adjusting your search or filter to find what you’re looking for, or create a new one if needed.'|trans }}
{% endblock %}

{% block grid_value_cell %}
    {{ value }}
{% endblock %}

{% block grid_value_cell_edit %}
    {% if form[column.id] is defined %}
        {{ form_widget(form[column.id]) }}
    {% endif %}
{% endblock %}

{% block grid_titles %}
    <thead>
        <tr>
            {% if grid.dragAndDrop or grid.multipleDragAndDrop %}
                <th class="w-1"></th>
            {% endif %}
            {% if grid.enabledSelecting %}
                <th class="w-1">
                    <input class="form-check-input m-0 align-middle js-grid-mass-action-select-all" type="checkbox" aria-label="{{ 'Select all'|trans }}">
                </th>
            {% endif %}
            {% for column in grid.columnsById %}
                <th{% if column.classAttribute %} class="{{ column.classAttribute }}"{% endif %}>
                    {{ gridView.renderTitleCell(column) }}
                </th>
            {% endfor %}
            {% if grid.actionColumns is not empty or grid.inlineEdit %}
                <th class="text-center w-1 {{ grid.actionColumnClassAttribute }}">{{ 'Modifications'|trans }}</th>
            {% endif %}
        </tr>
    </thead>
{% endblock %}

{% block grid_title_cell %}
    <span class="d-inline-flex align-items-center gap-1">
        {% if (column.sortable) %}
            {% if grid.orderSourceColumnName == column.id and grid.orderDirection == 'asc' %}
                {% set orderBy = '-' ~ column.id %}
            {% else %}
                {% set orderBy = column.id %}
            {% endif %}
            <a href="{{ gridView.url({'order': orderBy}) }}"
               class="{{ grid.orderSourceColumnName == column.id ? 'table-sort link-primary ' ~ grid.orderDirection : 'table-sort link-secondary' }}"
            >
                {{ column.title }}
            </a>
        {% else %}
            {{ column.title }}
        {% endif %}

        {% if column.help is not null %}
            {{ info_icon(column.help) }}
        {% endif %}
    </span>
{% endblock %}

{% block grid_rows %}
    <tbody class="js-inline-edit-rows {% if grid.dragAndDrop %}js-drag-and-drop-grid-rows{% endif %}">
        {% if grid.multipleDragAndDrop %}
            <tr class="js-grid-row-holder">
                <td colspan="100" class="align-middle">
                    {{ gridView.renderBlock('grid_multiple_drag_and_drop_row_holder') }}
                </td>
            </tr>
        {% endif %}
        {% for row in grid.rows %}
            {{ gridView.renderBlock(
                'grid_row',
                {
                    loopIndex: loop.index,
                    lastRow: loop.last,
                    row: row
                }
            ) }}
        {% endfor %}
    </tbody>
{% endblock %}

{% block grid_multiple_drag_and_drop_row_holder %}
    {{ 'You can drag additional content here.'|trans }}
{% endblock %}

{% block grid_row %}
    <tr class="js-grid-row test-grid-row"
            {% if grid.inlineEdit and row is not null %} data-inline-edit-row-id="{{ grid.getRowId(row)|json_encode() }}"{% endif %}
            {% if (grid.dragAndDrop or grid.multipleDragAndDrop) and row is not null %} data-drag-and-drop-grid-row-id="{{ grid.getRowId(row)|json_encode() }}"{% endif %}
    >
        {% if (grid.dragAndDrop or grid.multipleDragAndDrop) %}
            <td class="align-middle">
                {% if (row is not null) %}{{ ux_icon('move', { class: 'js-move-handle cursor-move icon icon-sm' }) }}{% endif %}
            </td>
        {% endif %}
        {% if grid.enabledSelecting %}
            <td class="align-middle">
                <label>
                    <input
                            class="js-grid-mass-action-select-row form-check-input m-0 align-middle"
                            type="checkbox"
                            name="g[{{ grid.id|escape('html_attr') }}][selectedRowIds][]"
                            value="{{ grid.getRowId(row)|json_encode() }}"
                            {% if grid.isRowSelected(row) %}checked="checked"{% endif %}
                            aria-label="{{ 'Select row'|trans }}"
                    />
                </label>
            </td>
        {% endif %}
        {% for column in grid.columnsById %}
            <td class="align-middle js-grid-column-{{ column.id }} test-grid-column-{{ column.id }}{% if column.classAttribute %} {{ column.classAttribute }}{% endif %}">
                {{ gridView.renderCell(column, row, form|default(null)) }}
            </td>
        {% endfor %}
        {% if grid.actionColumns|length > 0 or grid.inlineEdit %}
            <td class="js-inline-edit-unmatched-inputs text-center w-1 text-nowrap align-middle">
                {% if grid.inlineEdit and form is defined %}
                    <div class="js-inline-edit-buttons">
                        <a href="#" class="btn btn-icon btn-ghost-success js-inline-edit-save test-inline-edit-save" title="{{ 'Save changes'|trans }}">
                            {{ ux_icon('checked') }}
                        </a>
                        <a href="#" class="btn btn-icon btn-ghost-secondary js-inline-edit-cancel" title="{{ 'Discard changes'|trans }}">
                            {{ ux_icon('delete') }}
                        </a>
                    </div>
                    <div class="js-inline-edit-saving">
                        <div class="spinner-border"></div>
                    </div>
                {% else %}
                    {% if grid.inlineEdit %}
                        <a href="#" class="px-1 link-secondary js-inline-edit-edit test-inline-edit-edit" title="{{ 'Edit'|trans }}">{{ ux_icon('pencil') }}</a>
                    {% endif %}
                    {% for actionColumn in grid.actionColumns %}
                        {{ gridView.renderActionCell(actionColumn, row)|raw }}
                    {% endfor %}
                {% endif %}
                {% if form is defined %}
                    {% if not render_rest is defined or render_rest %}
                        {{- form_rest(form) -}}
                    {% endif %}
                {% endif %}
            </td>
        {% endif %}
    </tr>
{% endblock %}

{% block grid_action_cell %}
    {% if actionColumn.type == 'edit' %}
        {% set icon = 'pencil' %}
    {% elseif actionColumn.type == 'delete' %}
        {% set icon = 'trash' %}
    {% elseif actionColumn.type == 'resetPassword' %}
        {% set icon = 'letter' %}
    {% else %}
        {% set icon = actionColumn.type %}
    {% endif %}
    <a
            class="px-1 link-secondary{% if actionColumn.classAttribute %} {{ actionColumn.classAttribute }}{% endif %}{% if actionColumn.ajaxConfirm %} js-ajax-confirm{% endif %} test-type-{{ actionColumn.type }}"
            {% if actionColumn.ajaxConfirm %}
                data-ajax-confirm-on-open="true"
            {% endif %}
            href="{{ actionColumn.targetUrl(row) }}"
            title="{{ actionColumn.title }}"
            {% if actionColumn.confirmMessage is not empty %}
                data-confirm-window
                data-confirm-style="{{ actionColumn.type is same as('delete') ? 'danger' : 'info' }}"
                data-confirm-message="{{ actionColumn.confirmMessage }}"
            {% endif %}
    >{{ ux_icon(icon) }}</a>
{% endblock %}

{% block grid_pager_totalcount %}
    <div class="d-flex align-items-center">
        <div class="text-secondary">
            {{ 'Displaying'|trans }}

            <div class="dropdown d-inline-block mx-2">
                <a href="#" class="btn dropdown-toggle btn-sm" data-bs-toggle="dropdown">{{ grid.limit }}</a>
                <div class="dropdown-menu">
                    {% for value in grid.allowedLimits %}
                        {% if value is not same as(grid.limit) %}
                            <a class="dropdown-item" href="{{ gridView.url({'limit' : value}, 'page') }}">{{ value }}</a>
                        {% endif %}
                    {% endfor %}
                </div>
            </div>

            {{ entityName|default('records'|trans)|trim }}:
            {{ grid.paginationResults.fromItem }} - {{ grid.paginationResults.toItem }} {{ 'from'|trans }} {{ grid.totalCount }}
        </div>
    </div>
{% endblock %}

{% block grid_pager_selectpage %}
    <ul class="pagination">
        {% if grid.page > 1 %}
            <li class="page-item">
                <a class="page-link" href="{{ gridView.url({'page': grid.page - 1}) }}">
                    {{ ux_icon('chevron-left') }}
                </a>
            </li>

            <li class="page-item">
                <a class="page-link" href="{{ gridView.url({'page': 1}) }}">1</a>
            </li>
        {% endif %}

        {% set pagerExpand = 2 %}

        {% if grid.page > pagerExpand + 2 %}
            <li class="page-item disabled">
                <span class="page-link">...</span>
            </li>

        {% endif %}

        {% for page in ((grid.page - pagerExpand)..(grid.page))|filter(page => page > 1 and page < grid.page) %}
            <li class="page-item">
                <a class="page-link" href="{{ gridView.url({'page': page}) }}">{{ page }}</a>
            </li>
        {% endfor %}
        <li class="page-item active">
            <span class="page-link">{{ grid.page }}</span>
        </li>

        {% for page in ((grid.page + 1)..(grid.page + pagerExpand))|filter(page => page > grid.page and page < grid.pageCount) %}
            <li class="page-item">
                <a class="page-link" href="{{ gridView.url({'page': page}) }}">{{ page }}</a>
            </li>
        {% endfor %}

        {% if grid.page <= grid.pageCount - pagerExpand - 2 %}
            <li class="page-item disabled">
                <span class="page-link">...</span>
            </li>
        {% endif %}

        {% if grid.page < grid.pageCount %}
            <li class="page-item">
                <a class="page-link" href="{{ gridView.url({'page': grid.pageCount}) }}">{{ grid.pageCount }}</a>
            </li>
            <li class="page-item">
                <a class="page-link" href="{{ gridView.url({'page': grid.page + 1}) }}">
                    {{ ux_icon('chevron-right') }}
                </a>
            </li>
        {% endif %}
    </ul>
{% endblock %}

{% block grid_pager_results_perpage %}
    <div class="align-items-center js-grid-go-to d-none d-lg-flex">
        <div class="text-secondary text-nowrap me-2">{{ 'Go to page:'|trans }}</div>
        <div class="input-group">
            <input
                    type="number"
                    min="1"
                    max="{{ grid.pageCount }}"
                    value="{{ grid.page }}"
                    class="form-control form-control-sm js-grid-go-to-input"
                    style="min-width: 4em"
            />
            <a class="btn btn-sm js-grid-go-to-button" href="#" data-url="{{ gridView.url({'page' : '--page--'}) }}">{{ ux_icon('arrow-strong') }}</a>
        </div>
    </div>
{% endblock %}

{% block grid_pager %}
    <div class="container">
        <div class="row">
            <div class="col-lg-4 mb-3 mb-lg-0 d-flex justify-content-center justify-content-lg-start">
                {{ gridView.renderBlock('grid_pager_totalcount', { 'pageCount': grid.pageCount }) }}
            </div>

            <div class="col-lg mb-3 mb-lg-0 d-flex justify-content-center">
                {{ gridView.renderBlock('grid_pager_selectpage') }}
            </div>

            <div class="col-lg-4 d-flex justify-content-center justify-content-lg-end">
                {{ gridView.renderBlock('grid_pager_results_perpage') }}
            </div>
        </div>
    </div>
{% endblock %}

{% block grid_value_cell_type_boolean %}
    {% if value is same as(true) %}
        <span class="badge bg-green-lt text-green-lt-fg">{{ 'Yes'|trans }}</span>
    {% else %}
        <span class="badge bg-red-lt text-red-lt-fg">{{ 'No'|trans }}</span>
    {% endif %}
{% endblock %}

{% block grid_value_cell_id_visible %}
    {% if value %}
        {% set visibilityClass = 'text-green' %}
        {% set visibilityIcon = 'visible' %}
        {% set visibilityTitle = 'Yes'|trans %}
    {% else %}
        {% set visibilityClass = 'text-secondary' %}
        {% set visibilityIcon = 'invisible' %}
        {% set visibilityTitle = 'No'|trans %}
    {% endif %}
    <span class="{{ visibilityClass }}"
          title="{{ visibilityTitle }}"
    >{{ ux_icon(visibilityIcon) }}</span>
{% endblock %}

{% block grid_value_cell_type_DateTime %}
    {{ value|formatDateTime }}
{% endblock %}

{% block grid_value_cell_type_Symfony_Component_Clock_DatePoint %}
    {{ value|formatDateTime }}
{% endblock %}

{% block grid_value_cell_type_DateTimeImmutable %}
    {{ value|formatDateTime }}
{% endblock %}

{% block grid_value_cell_id_domainId %}
    {{ domain_icon(value) }}
{% endblock %}

{% block grid_value_cell_id_domain_id %}
    {{ domain_icon(value) }}
{% endblock %}

{% block grid_value_cell_type_Shopsys_FrameworkBundle_Component_Money_Money %}
    {% if 'domainId' in row|keys %}
        {{ value|priceWithCurrencyByDomainId(row.domainId) }}
    {% else %}
        {{ value|priceWithCurrencyAdmin }}
    {% endif %}
{% endblock %}

{% block grid_hidden_inputs %}
    {% set name = name|default('') %}
    {% if parameter is iterable %}
        {% for key, value in parameter %}
            {% set currentParameter = parameter %}
            {% set parameter = value %}
            {% set currentName = name %}
            {% if name != '' %}
                {% set name = name ~ '[' ~ key ~ ']' %}
            {% else %}
                {% set name = key %}
            {% endif %}

            {{ block('grid_hidden_inputs') }}
            {% set parameter = currentParameter %}
            {% set name = currentName %}
        {% endfor %}
    {% else %}
        <input type="hidden" name="{{ name }}" value="{{ parameter }}" />
    {% endif %}
{% endblock %}

{% block grid_inline_edit_add_button %}
    <div class="ms-auto">
        <a href="#" class="btn btn-primary js-inline-edit-add test-inline-edit-add">
            {{ ux_icon('plus') }}
            {{ addEntity|default('Create record'|trans) }}
        </a>
    </div>
{% endblock %}

{% block grid_multiple_drag_and_drop_title %}
    {{ grid_title }}
{% endblock %}
