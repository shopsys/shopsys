{% macro render(actions) %}
    <div class="wrap-bar__buttons">
        {% for action in actions %}
            <a href="{{ action.url }}"
               class="btn wrap-bar__btn {{ action.cssClass }}"
               {% if action.openInNewTab %}target="_blank"{% endif %}
            >
                {% if action.icon is not null %}
                    {{ ux_icon(action.icon) }}
                {% endif %}
                {{ action.label }}
            </a>
        {% endfor %}
    </div>
{% endmacro %}