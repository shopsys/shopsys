msgid "Payment transaction is not refundable."
msgstr "Platební transakci nelze refundovat."

msgid "Refund amount must be greater than zero."
msgstr "Částka refundace musí být větší než nula."

msgid "Refunded amount cannot be negative."
msgstr "Refundovaná částka nemůže být záporná."

msgid "You can refund only %refundableAmount%."
msgstr "Můžete refundovat pouze %refundableAmount%."

msgid "You can set refunded amount only up to %paidAmount%."
msgstr "Refundovanou částku můžete nastavit maximálně na %paidAmount%."

