{
    "name": "shopsys/product-feed-heureka-delivery",
    "type": "library",
    "description": "Shopsys Platform plugin interface for Heureka delivery XML product feed generation",
    "keywords": [
        "Heureka",
        "product delivery feed",
        "XML feed",
        "plugin",
        "Shopsys Platform",
        "SSFW"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Shopsys",
            "homepage": "https://www.shopsys.com/"
        }
    ],
    "autoload": {
        "psr-4": {
            "Shopsys\\ProductFeed\\HeurekaDeliveryBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\ProductFeed\\HeurekaDeliveryBundle\\": "tests/"
        }
    },
    "require": {
        "php": "^8.3",
        "doctrine/orm": "^2.11.2",
        "shopsys/form-types-bundle": "14.5.1",
        "shopsys/framework": "14.5.1",
        "shopsys/migrations": "14.5.1",
        "shopsys/plugin-interface": "14.5.1",
        "symfony/config": "^6.4",
        "symfony/dependency-injection": "^6.4",
        "symfony/framework-bundle": "^6.4",
        "symfony/http-kernel": "^6.4",
        "twig/twig": "^3.14.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.2.1"
    },
    "config": {
        "allow-plugins": {
            "symfony/flex": true
        }
    }
}
