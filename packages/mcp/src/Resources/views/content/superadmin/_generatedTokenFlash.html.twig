<div class="w-100">
    {{ 'Copy the new MCP Bearer token now. It will not be shown again:'|trans }}

    <div class="input-group input-group-flat mt-2 w-100">
        <input type="text" value="{{ tokenString }}" class="form-control" readonly>
        <span class="input-group-text">
            <a href="#" class="link-secondary" data-js-clipboard-copy="{{ tokenString }}" title="{{ 'Copy token'|trans }}">
                {{ ux_icon('duplicate') }}
            </a>
        </span>
    </div>

    {{ include('@ShopsysMcp/content/superadmin/_codexSetup.html.twig', {
        bearerTokenEnvVarName: bearerTokenEnvVarName,
        mcpServerName: mcpServerName,
        mcpEndpointUrl: mcpEndpointUrl,
        tokenString: tokenString,
    }) }}
</div>
