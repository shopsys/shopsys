{% import '@ShopsysAdministration/partial/copyable_code_block.html.twig' as copyableCodeBlock %}

{% set codexExportCommand = 'export ' ~ bearerTokenEnvVarName ~ '="' ~ (tokenString ?? '<token>') ~ '"' %}
{%- set codexAddCommand -%}
codex mcp add {{ mcpServerName }} \
--url {{ mcpEndpointUrl }} \
--bearer-token-env-var {{ bearerTokenEnvVarName }}
{%- endset -%}

<details class="w-100 mt-4">
    <summary class="fw-semibold cursor-pointer">
        {{ 'View Codex CLI instructions'|trans }}
    </summary>

    <div class="mt-3">
        <p class="mb-2">{{ 'Export the manual token in your current shell, then add the MCP server once.'|trans }}</p>

        <div class="mb-3">
            <label class="form-label">{{ 'Per-shell token command'|trans }}</label>
            {{ copyableCodeBlock.render(codexExportCommand, 'Copy command'|trans) }}
        </div>

        <p class="text-muted mb-3">{{ 'Environment variables exported this way are available only in the current shell session unless you add them to your shell profile.'|trans }}</p>

        <div>
            <label class="form-label">{{ 'One-time setup command'|trans }}</label>
            {{ copyableCodeBlock.render(codexAddCommand, 'Copy command'|trans) }}
        </div>
    </div>
</details>
