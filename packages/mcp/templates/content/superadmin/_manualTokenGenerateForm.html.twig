{% form_theme form '@ShopsysAdministration/form/vertical.html.twig' %}

<div class="text-start">
    {{ form_start(form) }}
    {{ form_errors(form) }}
    <div class="alert alert-danger js-mcp-manual-token-errors" style="display: none">
        <div class="alert-description">
            <ul class="alert-list"></ul>
        </div>
    </div>

    {{ form_row(form.label) }}
    {{ form_row(form.expirationPreset) }}
    {{ form_row(form.expiresAt) }}
    {{ form_widget(form.save, { attr: { class: 'btn-primary w-100' } }) }}

    {{ form_end(form) }}
</div>
