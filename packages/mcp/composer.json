{
    "name": "shopsys/mcp",
    "type": "library",
    "description": "MCP server integration for Shopsys Platform",
    "keywords": [
        "Shopsys Platform",
        "SSFW",
        "MCP"
    ],
    "license": "proprietary",
    "authors": [
        {
            "name": "Shopsys",
            "homepage": "https://www.shopsys.com/"
        }
    ],
    "autoload": {
        "psr-4": {
            "Shopsys\\McpBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\McpBundle\\": "tests/"
        }
    },
    "require": {
        "php": "^8.5",
        "ext-pg_query": "*",
        "shopsys/administration": "20.0.x-dev",
        "shopsys/framework": "20.0.x-dev",
        "shopsys/mcp-attributes": "20.0.x-dev",
        "shopsys/migrations": "20.0.x-dev",
        "symfony/clock": "^8.1",
        "symfony/config": "^8.1",
        "symfony/dependency-injection": "^8.1",
        "symfony/http-foundation": "^8.1",
        "symfony/http-kernel": "^8.1",
        "symfony/mcp-bundle": "^0.8",
        "symfony/password-hasher": "^8.1",
        "symfony/routing": "^8.1",
        "symfony/security-core": "^8.1",
        "symfony/security-http": "^8.1"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1.16",
        "phpstan/phpstan-doctrine": "^2.0.3",
        "phpstan/phpstan-phpunit": "^2.0.6",
        "phpstan/phpstan-symfony": "^2.0.6",
        "phpunit/phpunit": "^12.5",
        "shopsys/coding-standards": "20.0.x-dev"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "symfony": {
            "require": "^8.1",
            "docker": false
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/flex": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
