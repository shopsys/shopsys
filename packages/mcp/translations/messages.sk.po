msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Language: sk\n"

msgid "Actions"
msgstr "Akcie"

msgid "Active"
msgstr "Aktívny"

msgid "Add the server once, then authenticate it in Claude Code when prompted."
msgstr "Pridajte server raz a potom ho v Claude Code po vyzvaní overte."

msgid "Allow access"
msgstr "Povoliť prístup"

msgid "Approve MCP access"
msgstr "Schváliť prístup MCP"

msgid "Authentication steps"
msgstr "Kroky overenia"

msgid "Authorization header"
msgstr "Autorizačná hlavička"

msgid "Authorize MCP client"
msgstr "Autorizovať MCP klienta"

msgid "Authorized MCP clients"
msgstr "Autorizovaní MCP klienti"

msgid "Claude Code client setup"
msgstr "Nastavenie klienta Claude Code"

msgid "Client"
msgstr "Klient"

msgid "Complete the browser login and approve MCP access in Shopsys administration."
msgstr "Dokončite prihlásenie v prehliadači a v administrácii Shopsysu schváľte prístup MCP."

msgid "Copy command"
msgstr "Kopírovať príkaz"

msgid "Copy the new MCP Bearer token now. It will not be shown again:"
msgstr "Skopírujte si teraz nový Bearer token pre MCP. Už sa znovu nezobrazí:"

msgid "Copy token"
msgstr "Kopírovať token"

msgid "Created at"
msgstr "Vytvorené"

msgid "Deny access"
msgstr "Odmietnuť prístup"

msgid "Do you really want to revoke MCP access for \"%clientLabel%\"?"
msgstr "Naozaj chcete odvolať prístup MCP pre \"%clientLabel%\"?"

msgid "Do you really want to revoke the active MCP token?"
msgstr "Naozaj chcete odvolať aktívny MCP token?"

msgid "Endpoint URL"
msgstr "URL endpointu"

msgid "Environment variables exported this way are available only in the current shell session unless you add them to your shell profile."
msgstr "Takto exportované premenné prostredia sú dostupné iba v aktuálnej shellovej relácii, pokiaľ ich nepridáte do profilu shellu."

msgid "Expires at"
msgstr "Vyprší"

msgid "Export the manual token in your current shell, then add the MCP server once."
msgstr "Exportujte manuálny token v aktuálnom shelli a potom raz pridajte MCP server."

msgid "Generate MCP token"
msgstr "Vygenerovať MCP token"

msgid "Generated tokens are shown only once. Regenerating a token revokes the previous token immediately."
msgstr "Vygenerované tokeny sa zobrazia iba raz. Opätovné vygenerovanie tokenu okamžite zneplatní predchádzajúci token."

msgid "Generating a new MCP token revokes the previous one immediately. Do you want to continue?"
msgstr "Vygenerovaním nového MCP tokenu sa okamžite zneplatní ten predchádzajúci. Chcete pokračovať?"

msgid "Last used at"
msgstr "Naposledy použité"

msgid "MCP server"
msgstr "MCP server"

msgid "MCP session revoked"
msgstr "MCP relácia bola odvolaná"

msgid "MCP token revoked"
msgstr "MCP token bol odvolaný"

msgid "Manual token"
msgstr "Manuálny token"

msgid "Never used"
msgstr "Nikdy nepoužité"

msgid "No active manual MCP token is configured for your administrator account."
msgstr "Pre váš administrátorský účet nie je nakonfigurovaný žiadny aktívny manuálny MCP token."

msgid "No authorized MCP client is currently active for your administrator account."
msgstr "Pre váš administrátorský účet nie je momentálne aktívny žiadny autorizovaný MCP klient."

msgid "One-time setup command"
msgstr "Jednorazový inštalačný príkaz"

msgid "Other MCP clients"
msgstr "Ostatní MCP klienti"

msgid "Per-shell token command"
msgstr "Príkaz pre token v shelli"

msgid "Please check the correctness of all data filled."
msgstr "Prosím, skontrolujte správnosť všetkých vyplnených údajov."

msgid "Regenerate MCP token"
msgstr "Znovu vygenerovať MCP token"

msgid "Revoke MCP token"
msgstr "Odvolať MCP token"

msgid "Revoke access"
msgstr "Odvolať prístup"

msgid "Run the command above once in the shell where you use Claude Code."
msgstr "Vyššie uvedený príkaz spustite raz v shelli, v ktorom používate Claude Code."

msgid "Select Authenticate for the Shopsys MCP server."
msgstr "Pri Shopsys MCP serveri zvoľte Authenticate."

msgid "Settings"
msgstr "Nastavenia"

msgid "Start Claude Code and run /mcp."
msgstr "Spustite Claude Code a zadajte /mcp."

msgid "Status"
msgstr "Stav"

msgid "The selected MCP session cannot be revoked."
msgstr "Vybranú MCP reláciu nie je možné odvolať."

msgid "There is no active MCP session to revoke."
msgstr "Neexistuje žiadna aktívna MCP relácia, ktorú by bolo možné odvolať."

msgid "There is no active MCP token to revoke."
msgstr "Neexistuje žiadny aktívny MCP token, ktorý by bolo možné odvolať."

msgid "This client is requesting access to the Shopsys MCP server with your administrator account."
msgstr "Tento klient požaduje prístup k Shopsys MCP serveru pod vaším administrátorským účtom."

msgid "Use a manual token for clients such as Codex CLI."
msgstr "Pre klientov ako Codex CLI použite manuálny token."

msgid "View Codex CLI instructions"
msgstr "Zobraziť pokyny pre Codex CLI"
