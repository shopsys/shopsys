msgstr "Nahraný súbor je príliš veľký ({{ size }} {{ suffix }}). Maximálna veľkosť súboru je {{ limit }} {{ suffix }}."

msgid "Uploaded image is to large ({{ size }} {{ suffix }}). Maximum size of an image is {{ limit }} {{ suffix }}."
msgstr "Nahraný obrázok je príliš veľký ({{ size }} {{ suffix }}). Maximálna veľkosť obrázka je {{ limit }} {{ suffix }}."

msgid "Username cannot be longer than {{ limit }} characters"
msgstr "Používateľské meno nemôže byť dlhšie ako {{ limit }} znakov"

msgid "VAT name cannot be longer than {{ limit }} characters"
msgstr "Názov DPH nemôže byť dlhší ako {{ limit }} znakov"

msgid "Value must not be neither of following: {{ array }}"
msgstr "Hodnota nesmie byť žiadna z nasledujúcich: {{ array }}"

msgid "Values are duplicate."
msgstr "Hodnoty sú duplicitné."

msgid "Variable {{ needle }} is required"
msgstr "Premenná {{ needle }} je povinná"

msgid "Variant alias cannot be longer than {{ limit }} characters"
msgstr "Alias variantu nemôže byť dlhší ako {{ limit }} znakov"

msgid "Warehouse cannot be default on a domain where it is not enabled."
msgstr "Sklad nemôže byť predvolený na doméne, kde nie je povolený."

msgid "Warehouse name cannot be longer than {{ limit }} characters"
msgstr "Názov skladu nemôže byť dlhší ako {{ limit }} znakov"

msgid "Warehouse with this external code already exists"
msgstr "Sklad s týmto externým kódom už existuje"

msgid "Withdrawal deadline must be a positive number."
msgstr "Lehota na odstúpenie od zmluvy musí byť kladné číslo."

msgid "You entered same product twice. In list of bestsellers can be product only once. Please correct it and then save form again."
msgstr "Zadali ste rovnaký produkt dvakrát. V zozname bestsellerov môže byť produkt len raz. Prosím, opravte to a potom znovu uložte formulár."

msgid "You have to select any domain."
msgstr "Musíte vybrať nejakú doménu."

msgid "Zip code cannot be longer than {{ limit }} characters"
msgstr "PSČ nemôže byť dlhšie ako {{ limit }} znakov"

msgid "column {{ column_name }} cannot be empty"
msgstr "stĺpec {{ column_name }} nemôže byť prázdny"

msgid "column {{ column_name }} must be greater than 0"
msgstr "stĺpec {{ column_name }} musí byť väčší ako 0"

msgid "column {{ column_name }} must be number, {{ value }} provided"
msgstr "stĺpec {{ column_name }} musí byť číslo, zadané bolo {{ value }}"

