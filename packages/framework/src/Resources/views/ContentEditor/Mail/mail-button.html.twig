<table role="presentation" width="100%" border="0" cellspacing="0" cellpadding="0">
    <tr>
        <td align="{{ data.position }}" style="padding:10px 0;">
            <table role="presentation" border="0" cellspacing="0" cellpadding="0">
                <tr>
                    <td align="center" bgcolor="{{ data.color }}" style="background-color:{{ data.color }}; border-radius:4px;">
                        <a href="{{ data.url }}" target="_blank" style="display:inline-block; padding:12px 24px; font-family:Arial, Helvetica, sans-serif; font-size:16px; font-weight:bold; line-height:1.3; color:#ffffff; text-decoration:none;" rel="noopener">{{ data.text }}</a>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>
