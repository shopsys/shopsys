{% extends '@ShopsysFramework/Admin/Grid/Grid.html.twig' %}

{% block grid_no_data %}
    {{ 'No product found.'|trans }}
{% endblock %}

{% block grid_action_cell_type_edit %}
    <a
        class="in-icon in-icon--edit table-action{% if actionColumn.classAttribute %} {{ actionColumn.classAttribute }}{% endif %}"
        href="{{ actionColumn.targetUrl(row) }}"
        title = "{{ actionColumn.title }}"
    >{{ ux_icon('pencil') }}</a>
{% endblock %}

{% block grid_value_cell_id_name %}
    {% if row.productType == TYPE_INQUIRY %}
        <span class="in-letter cursor-help js-tooltip" title="{{ 'Upon inquiry'|trans }}">{{ 'Upon inquiry [abbreviation]'|trans }}</span>
    {% endif %}
    {% if row.variantType == VARIANT_TYPE_MAIN %}
        <span class="in-letter cursor-help js-tooltip" title="{{ 'Main variant'|trans }}">{{ 'Main variant [abbreviation]'|trans }}</span>
    {% endif %}
    {% if row.variantType == VARIANT_TYPE_VARIANT %}
        <span class="in-letter cursor-help js-tooltip" title="{{ 'Variant'|trans }}">{{ 'Variant [abbreviation]'|trans }}</span>
    {% endif %}
    <a href="{{ url('admin_product_edit', { id: row.id }) }}">{{ row.name|productListDisplayNameByName }}</a>
{% endblock %}

{% block grid_value_cell_id_visibility %}
    {% if isMultidomain() %}
        <span class="js-product-visibility position-relative" data-visibility-url="{{ url('admin_product_visibility', {productId: row.id}) }}">
            {% if row.isVisible %}
                {% set visibilityClass = 'in-icon--visible' %}
                {% set visibilityIcon = 'visible' %}
            {% elseif row.isVisibleOnSomeDomain %}
                {% set visibilityClass = 'in-icon--partially-visible' %}
                {% set visibilityIcon = 'visible' %}
            {% else %}
                {% set visibilityClass = 'in-icon--invisible' %}
                {% set visibilityIcon = 'invisible' %}
            {% endif %}
            <span class="js-product-visibility-icon in-icon {{ visibilityClass }}">
                {{ ux_icon(visibilityIcon) }}
            </span>
            <span class="js-product-visibility-box">
                <span class="in-product-visibility js-product-visibility-box-window display-none"></span>
            </span>
        </span>
    {% else %}
        {% if row.isVisible %}
            {% apply spaceless %}
                <a href="{{ findUrlByDomainId('front_product_detail', { id: row.id }, getDomain().id) }}">
                    <span class="in-icon in-icon--visible">{{ ux_icon('visible') }}</span>
                </a>
            {% endapply %}
        {% else %}
            <span class="in-icon in-icon--invisible">{{ ux_icon('invisible') }}</span>
        {% endif %}
    {% endif %}
    {% if row.calculatedSellingDenied %}
        <span class="in-icon in-icon--denied" title="{{ 'Product excluded from sale'|trans }}">{{ ux_icon('cart') }}</span>
    {% endif %}
{% endblock %}

{% block grid_pager_totalcount %}
    {% set entityName = 'products'|trans %}
    {{ parent() }}
{% endblock %}
