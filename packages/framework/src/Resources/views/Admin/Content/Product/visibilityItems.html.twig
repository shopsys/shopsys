<ul class="list-domain">
    {% for domain in domains %}
        <li class="list-domain__item">
            {% set url = findUrlByDomainId('front_product_detail', { id: product.id }, domain.id) %}
            {% set isVisible = isVisibleForDefaultPricingGroup(product, domain.id) %}

            {% if isMultidomain() %}
                <div class="list-domain__item__image">
                    {{ domainIcon(domain.id) }}
                </div>
            {% endif %}

            <div class="list-domain__item__info">
                {% if isVisible %}
                    {% set visibilityClass = 'in-icon--visible' %}
                    {% set visibilityIcon = 'visible' %}
                    {% set visibilityTitle = 'Yes'|trans %}
                {% else %}
                    {% set visibilityClass = 'in-icon--invisible' %}
                    {% set visibilityIcon = 'invisible' %}
                    {% set visibilityTitle = 'No'|trans %}
                {% endif %}
                <span class="list-domain__item__info__visible {{ visibilityClass }}" title="{{ visibilityTitle }}">
                    {{ ux_icon(visibilityIcon) }}
                </span>
            </div>

            {% if isVisible %}
                <a href="{{ url }}" class="list-domain__item__name" target="_blank">
                    {{ getDomainName(domain.id) }}
                    {{ ux_icon('forward-page') }}
                </a>
            {% else %}
                <span class="list-domain__item__name">
                    {{ getDomainName(domain.id) }}
                </span>
            {% endif %}
        </li>
    {% endfor %}
</ul>
