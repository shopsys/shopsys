{% extends '@ShopsysFramework/Admin/Layout/layoutWithPanel.html.twig' %}

{% block title %}- {{ 'Email allowed recipients'|trans }}{% endblock %}
{% block h1 %}{{ 'Email allowed recipients'|trans }}{% endblock %}

{% block main_content %}
    {% if isDeliveryDisabled %}
        <div class="form-line">
            <p><strong>{{ 'Sending emails is turned off, no email will be sent from the app.'|trans }}</strong></p>
        </div>
    {% elseif patternsByDomainId is defined and patternsByDomainId is not empty %}
        {% for domainId, patterns in patternsByDomainId %}
            <div class="form-line">
                <div class="form-line__box">
                    <div class="form-line__box__title">
                        <span class="form-line__box__title__image">
                            {{ domainIcon(domainId) }}
                        </span>
                        <strong class="form-line__box__title__name">
                            {{ getDomainName(domainId) }}
                        </strong>
                    </div>

                    <div class="form-line__box__content">
                        {% if enabledWhitelistByDomainId[domainId] %}
                            {% if patterns is not empty %}
                                <p>{{ 'Emails will be sent only to addresses matching at least one of these patterns:'|trans }}</p>
                                <ul>
                                    {% for pattern in patterns %}
                                        <li><code>{{ pattern }}</code></li>
                                    {% endfor %}
                                </ul>
                            {% else %}
                                <p>
                                    <strong>{{ 'No email will be sent from this domain.'|trans }}</strong>
                                </p>
                            {% endif %}
                        {% else %}
                            <p>{{ 'Emails are sent normally on this domain'|trans }}</p>
                        {% endif %}
                    </div>
                </div>
            </div>
        {% endfor %}
    {% else %}
        <h2>Email Allowed Recipients</h2>
        <p><strong>No email patterns configured.</strong> All outgoing emails are currently blocked.</p>
    {% endif %}
{% endblock %}
