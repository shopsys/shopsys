{% macro inputPriceWidget(priceForm) %}
    <span class="text-no-wrap">
        {{ form_widget(priceForm, {attr: { class: 'input--small text-right'}}, {errors_attr: { class: 'in-message--pin' }}) }}
        <span class="display-inline-block text-normal-wrap">
            {{ ux_icon('warning', { class: 'js-setting-prices-manually-warning js-tooltip table-action cursor-help', 'title': 'Using price calculation has been disabled, don\'t forget to edit all prices.'|trans, 'data-toggle': 'tooltip', 'data-placement': 'top' }) }}
        </span>
        {{ form_errors(priceForm, {errors_attr: { inline: false }}) }}
    </span>
{% endmacro %}

{% macro calculablePriceWidget(calculablePriceForm) %}
    <span class="text-no-wrap">
        {{ form_widget(calculablePriceForm, {attr: { class: 'input--small text-right js-calculable-price'}}) }}
        {{ form_errors(calculablePriceForm, {errors_attr: { inline: false }}) }}
    </span>
{% endmacro %}
