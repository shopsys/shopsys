{% extends '@ShopsysFramework/Admin/Layout/layoutWithPanel.html.twig' %}

{% block title %}- {{ 'Contact form settings'|trans }}{% endblock %}
{% block h1 %}{{ 'Contact form settings'|trans }}{% endblock %}

{% block main_content %}

    {{ render(controller('Shopsys\\FrameworkBundle\\Controller\\Admin\\DomainController::domainTabsAction')) }}

    {{ form_start(form) }}
        <div class="wrap-divider">
            <div class="form-group">
                <div class="form-group__title">
                    {{ 'Main text'|trans }}
                </div>
                <div>
                    {{ form_widget(form.settings.mainText) }}
                </div>
            </div>
        </div>

        {{ form_widget(form.actionBar) }}
    {{ form_end(form) }}

{% endblock %}
