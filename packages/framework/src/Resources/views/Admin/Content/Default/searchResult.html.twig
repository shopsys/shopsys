<div class="web__header__search--results--container">
    {% for result in results %}
        <div class="result--item">
            <a href="{{ result['uri'] }}">
                {{ result['label'] }}
                <br/>
                <span class="result--path">
                    {{ '(' ~ result['pathLabels']|join(' > ') ~ ')' }}
                </span>
            </a>
        </div>
    {% endfor %}
</div>