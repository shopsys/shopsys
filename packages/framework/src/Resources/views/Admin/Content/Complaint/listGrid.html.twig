{% extends '@ShopsysFramework/Admin/Grid/Grid.html.twig' %}

{% block grid_value_cell_id_number %}
    <a href="{{ url('admin_complaint_edit', { id: row.cmp.id }) }}">{{ value }}</a>
{% endblock %}

{% block grid_value_cell_id_order_number %}
    {% if row.orderId is not null %}
        <a href="{{ url('admin_order_edit', { id: row.orderId }) }}">{{ value }}</a>
    {% else %}
        {{ row.cmp.manualDocumentNumber }}
        <span title="{{ 'Complaint was created manually without link to a particular order'|trans }}"
          class="js-tooltip cursor-help in-icon in-icon--info" data-toggle="tooltip" data-placement="right">
            {{ icon('info') }}
        </span>
    {% endif %}
{% endblock %}

{% block grid_value_cell_id_domain_id %}
    {{ domainIcon(value, 'small') }}
{% endblock %}

{% block grid_value_cell_id_customer_name %}
    <a href="{{ url('admin_customer_edit', { id: row.customerUserId }) }}">{{ value }}</a>
{% endblock %}

{% block grid_value_cell_id_created_at %}
    {{ value|formatDateTime }}
{% endblock %}

{% block grid_no_data %}
    {{ 'No complaints found.'|trans }}
{% endblock %}

{% block grid_pager_totalcount %}
    {% set entityName = 'complaints'|trans %}
    {{ parent() }}
{% endblock %}
