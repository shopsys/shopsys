{{ form_start(quickSearchForm) }}
    <div class="box-quick-search">
        <div class="box-quick-search__input">
            {{ form_widget(quickSearchForm.text, { attr:
                {
                    placeholder: 'Search by slug...'|trans
                }
            })}}
            {{ ux_icon('tabler:info-circle-filled', { class: 'cursor-help js-tooltip box-quick-search__icon in-icon in-icon--info', 'data-toggle': 'tooltip', 'data-placement': 'top', 'title': 'Searching searches in slugs. It is possible to use wildcards * and ?.'|trans }) }}
        </div>
        {{ form_widget(quickSearchForm.submit, { label: 'Search [verb]'|trans, attr: { class: 'box-quick-search__btn'}, full_name: '' }) }}
    </div>
{{ form_end(quickSearchForm) }}
