{% extends '@ShopsysFramework/Admin/Content/Product/listGrid.html.twig' %}

{% block grid_action_cell_type_edit %}{% endblock %}

{% block grid_value_cell_id_name %}
    {% if row.variantType == VARIANT_TYPE_MAIN %}
        <span class="in-letter cursor-help js-tooltip" title="{{ 'Main variant'|trans }}">{{ 'Main variant [abbreviation]'|trans }}</span>
    {% endif %}
    {% if row.variantType == VARIANT_TYPE_VARIANT %}
        <span class="in-letter cursor-help js-tooltip" title="{{ 'Variant'|trans }}">{{ 'Variant [abbreviation]'|trans }}</span>
    {% endif %}
    {{ row.name|productListDisplayNameByName }}
{% endblock %}

{% block grid_value_cell_id_select %}
    {%- if not allowMainVariants and row.variantType == VARIANT_TYPE_MAIN %}
        <i class="in-icon in-icon--info svg svg-info cursor-help js-tooltip"
            data-toggle="tooltip" data-placement="left"
            title="" data-original-title="{{ 'You cannot choose product that is main variant'|trans }}"
        ></i>
    {% elseif not allowVariants and row.variantType == VARIANT_TYPE_VARIANT %}
        <i class="in-icon in-icon--info svg svg-info cursor-help js-tooltip"
            data-toggle="tooltip" data-placement="left" title=""
            data-original-title="{{ 'You cannot choose product that is variant'|trans }}"
        ></i>
    {% elseif isMultiple %}
        <a
            class="{% if withPrice %}js-price-list-product-picker-window-add-product{% else %}js-products-picker-window-add-product{% endif %} btn btn--light btn--plus btn--small"
            href="#"
            data-product-picker-instance-id="{{ jsInstanceId }}"
            data-product-picker-basic-price-url="{{ url('admin_productpicker_basicproductprice') }}"
            data-product-picker-product-id="{{ row.id }}"
            data-product-picker-domain-id="{{ domainId }}"
            data-product-picker-product-name="{{ row.name }}"
            data-product-picker-product-price="{{ row.priceForProductList ? row.priceForProductList.amount|round(2) : 0 }}"
            data-product-picker-product-ean="{{ row.ean }}"
            data-product-picker-product-catnum="{{ row.catnum }}"
        >
            <i class="js-products-picker-icon btn__icon">+</i>
            <span class="js-products-picker-label">
                {{ 'Add'|trans }}
            </span>
        </a>
    {% else %}
        <a
            href="#"
            class="btn btn--light btn--plus btn--small js-product-picker-select"
            data-instance-id="{{ parentInstanceId }}"
            data-product-id="{{ row.id }}"
            data-product-name="{{ row.name }}"
            data-product-picker-product-ean="{{ row.ean }}"
            data-product-picker-product-catnum="{{ row.catnum }}"
        >
            <i class="js-products-picker-icon btn__icon">+</i>
            <span class="js-products-picker-label">
                {{ 'Choose'|trans }}
            </span>
        </a>
    {% endif %}
{% endblock %}
