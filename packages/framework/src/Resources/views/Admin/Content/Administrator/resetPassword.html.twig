{% extends '@ShopsysFramework/Admin/Layout/layoutBlank.html.twig' %}

{% block title %}- {{ 'Reset administrator password'|trans }}{% endblock %}

{% block content %}

    {% if form is not null %}
        {{ form_start(form, {attr: {class: 'box-reset-password'}}) }}
        {{ form_errors(form) }}

        <h1 class="box-reset-password__heading">{{ 'Reset password'|trans }}</h1>

        {{ form_end(form) }}
    {% else %}
        <div class="box-reset-password">
            <div class="error">
                <p>{{ 'Invalid reset password hash for administrator'|trans }}</p>
            </div>
        </div>
    {% endif %}

{% endblock %}
