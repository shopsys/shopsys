{% macro render_actions(target = null, showText = true, cssClass = 'roles-grid__action', deselectTitle = '', selectTitle = '', tooltipPalcement = null) %}
    <a href="#"
        class="{{ cssClass }} {{ tooltipPalcement is not null ? 'js-tooltip'}} js-roles-action"
        data-type="deselect"
        data-target="{{ target ? target : '' }}"
        title="{{ deselectTitle }}"
        {% if tooltipPalcement is not null %}
            data-placement="{{ tooltipPalcement }}"
        {% endif %}
    >
        {{ ux_icon('unselect-all') }}
        {% if showText %}<span>{{ 'Deselect All'|trans }}</span>{% endif %}
    </a>
    <a href="#"
        class="{{ cssClass }} {{ tooltipPalcement is not null ? 'js-tooltip'}} js-roles-action"
        data-type="select"
        data-target="{{ target ? target : '' }}"
        title="{{ selectTitle }}"
        {% if tooltipPalcement is not null %}
            data-placement="{{ tooltipPalcement }}"
        {% endif %}
    >
        {{ ux_icon('select-all') }}
        {% if showText %}<span>{{ 'Select All'|trans }}</span>{% endif %}
    </a>
{% endmacro %}