{% block role_section_widget %}

{% import '@ShopsysFramework/Admin/Form/_rolesMacros.html.twig' as rolesMacros %}

{% set section = form.vars.section %}

{% if form.vars.show_header %}
    <div class="roles-grid__section" data-scope="{{ section.identifier }}">
        <div class="roles-grid__section-header">
            <div class="roles-grid__section-title">
                {% if section.icon %}
                    {{ ux_icon(section.icon, {'class': 'roles-grid__section-icon'}) }}
                {% endif %}
                {{ section.name }}
            </div>
            {% if not form.vars.disabled %}
                <div class="roles-grid__actions">
                    {{ rolesMacros.render_actions(section.identifier, true, 'roles-grid__action', 'Deselect all permissions in section'|trans, 'Select all permissions in section'|trans) }}
                </div>
            {% endif %}
        </div>
        
        {% for roleForm in form %}
            {{ form_widget(roleForm) }}
        {% endfor %}
    </div>
{% else %}
    <div class="roles-grid__section roles-grid__section--no-header">
        {% for roleForm in form %}
            {{ form_widget(roleForm) }}
        {% endfor %}
    </div>
{% endif %}
{% endblock role_section_widget %}