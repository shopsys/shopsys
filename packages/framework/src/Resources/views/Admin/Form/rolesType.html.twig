{% block roles_widget -%}
    {% import '@ShopsysFramework/Admin/Form/_rolesMacros.html.twig' as rolesMacros %}

    {% set attr = attr|merge({
        class: (
        (attr.class|default('')) ~
        ' form-line__item'
        )|trim
    }) %}

    {% set isSingleGrid = form.vars.permissions|length == 0 %}

    {% with { attr: attr } %}
        <div {{ block('widget_container_attributes') }}>
            <div class="roles-grid js-roles-grid {{ isSingleGrid ? 'roles-grid--single' : '' }}" data-dependencies="{{ form.vars.permission_dependencies|json_encode|e('html_attr') }}" style="--permissions-count: {{ form.vars.permissions|length }}">
                {# Header row #}
                <div class="roles-grid__header-wrapper">
                    <div class="roles-grid__header">
                        <div class="roles-grid__cell roles-grid__cell--role-name">
                            <span>{{ 'Role'|trans }}</span>
                            {% if not form.vars.disabled and not isSingleGrid %}
                                <div class="roles-grid__actions roles-grid__actions--header">
                                    {{ rolesMacros.render_actions(null, false, 'roles-grid__action', 'Deselect all permissions'|trans, 'Select all permissions'|trans, 'bottom') }}
                                </div>
                            {% endif %}
                        </div>
                        {% for permission in form.vars.permissions %}
                            <div class="roles-grid__cell roles-grid__cell--permission">
                                <div class="roles-grid__permission-label">{{ permission.getName() }}</div>
                            </div>
                        {% endfor %}
                    </div>
                </div>

                {# Data content #}
                <div class="roles-grid__content">
                    {% for child in form %}
                        {{ form_widget(child) }}
                    {% endfor %}
                </div>
            </div>
        </div>
    {% endwith %}
{%- endblock roles_widget %}