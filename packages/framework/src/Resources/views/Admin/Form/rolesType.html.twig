{% block roles_widget -%}
<div {{ block('widget_container_attributes') }} class="form-line__side">
    <div class="roles-grid js-roles-grid" data-dependencies="{{ form.vars.permission_dependencies|json_encode|e('html_attr') }}">
        {# Header row with permission columns #}
        <div class="roles-grid__header">
            <div class="roles-grid__cell roles-grid__cell--role-name">{{ 'Role'|trans }}</div>
            {% for permission in form.vars.permissions %}
                <div class="roles-grid__cell roles-grid__cell--permission">
                    <div class="roles-grid__header-content">
                        <div class="roles-grid__permission-label">{{ permission|lower|trans }}</div>
                        {% if not form.vars.disabled and (permission == 'VIEW' or permission == 'FULL') %}
                            <div class="roles-grid__header-checkbox">
                                <input type="checkbox" id="select-all-{{ permission|lower }}" data-permission="{{ permission }}" class="css-checkbox roles-grid__select-all js-roles-select-all">
                                <label for="select-all-{{ permission|lower }}" class="roles-grid__select-all-label css-checkbox__image"></label>
                            </div>
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
        </div>

        {# Data rows with roles and their checkboxes #}
        {% for roleConstant, roleData in form.vars.grid_structure %}
            <div class="roles-grid__row">
                <div class="roles-grid__cell roles-grid__cell--role-name">
                    <strong>{{ roleData.name|trans }}</strong>
                </div>
                
                {% for permission in form.vars.permissions %}
                    <div class="roles-grid__cell roles-grid__cell--permission">
                        {% if form[roleConstant] is defined and form[roleConstant][permission] is defined %}
                            {% if form[roleConstant][permission].vars.disabled %}
                                <div class="roles-grid__display-icon">
                                    {% if form[roleConstant][permission].vars.checked %}
                                        {{ ux_icon('checked-circle', {'title': 'Granted'|trans}) }}
                                    {% else %}
                                        {{ ux_icon('minus', {'title': 'Not granted'|trans}) }}
                                    {% endif %}
                                </div>
                            {% else %}
                                <div class="roles-grid__checkbox">
                                    {{ form_widget(form[roleConstant][permission], {
                                        'attr': {
                                            'class': 'roles-grid__permission-checkbox js-roles-permission-checkbox',
                                            'data-permission': permission,
                                            'data-role': roleConstant
                                        }
                                    }) }}
                                    {{ form_label(form[roleConstant][permission], '', {label_attr: {class: 'sr-only'}}) }}
                                </div>
                            {% endif %}
                        {% else %}
                            <div class="roles-grid__cell--empty">&nbsp;</div>
                        {% endif %}
                    </div>
                {% endfor %}
            </div>
        {% endfor %}
    </div>
</div>
{%- endblock roles_widget %}