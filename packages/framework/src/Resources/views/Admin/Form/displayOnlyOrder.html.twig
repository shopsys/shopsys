{% block display_only_order_widget %}
    <div class="form-line__side">
        <div class="form-line__item form-line__item--text">
            {% if order is not null %}
                <a href="{{ path('admin_order_edit', { id: order.id }) }}" target="_blank">
                    {{ order.number }}
                    <i class="svg svg-forward-page"></i>
                </a>
            {% else %}
                {{ manualDocumentNumber }}
                <span title="{{ 'Complaint was created manually without link to a particular order'|trans }}"
                      class="js-tooltip cursor-help in-icon in-icon--info" data-toggle="tooltip" data-placement="right">
                    {{ icon('info') }}
                </span>
            {% endif %}
        </div>
    </div>
{% endblock %}
