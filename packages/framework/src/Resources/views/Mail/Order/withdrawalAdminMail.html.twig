<h1>{{ 'New Withdrawal Request'|trans }}</h1>

<p>{{ 'A customer has requested withdrawal from contract for the following order'|trans }}</p>

<h2>{{ 'Order information'|trans }}</h2>
<ul>
    <li><strong>{{ 'Order number'|trans }}:</strong> {{ order.number }}</li>
    <li><strong>{{ 'Customer email'|trans }}:</strong> {{ order.email }}</li>
    <li><strong>{{ 'Order date'|trans }}:</strong> {{ order.createdAt|formatDateTime }}</li>
    {% if order.deliveredAt %}
        <li><strong>{{ 'Delivered at'|trans }}:</strong> {{ order.deliveredAt|formatDateTime }}</li>
    {% endif %}
</ul>

<h2>{{ 'Withdrawal request details'|trans }}</h2>
<ul>
    <li><strong>{{ 'Requested at'|trans }}:</strong> {{ order.withdrawalRequestedAt|formatDateTime }}</li>
    <li><strong>{{ 'First name'|trans }}:</strong> {{ order.withdrawalFirstName }}</li>
    <li><strong>{{ 'Last name'|trans }}:</strong> {{ order.withdrawalLastName }}</li>
    <li><strong>{{ 'Email'|trans }}:</strong> {{ order.withdrawalEmail }}</li>
    {% if order.withdrawalTelephone %}
        <li><strong>{{ 'Phone'|trans }}:</strong> {{ order.withdrawalTelephone }}</li>
    {% endif %}
    {% if order.withdrawalNote %}
        <li><strong>{{ 'Note'|trans }}:</strong> {{ order.withdrawalNote }}</li>
    {% endif %}
</ul>
