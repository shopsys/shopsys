{% trans_default_domain 'customerMessages' %}
<table  border="0" cellpadding="0" cellspacing="0" role="presentation" width="100%">
    <tbody>
        <tr>
            <td>
                <table border="0" cellpadding="0" cellspacing="0" role="presentation" width="100%">
                    <tbody>
                        <tr>
                            <td>
                                <h2 style="margin:0 0 12px; font-size:16px; color:#385483;">{% trans into orderLocale %}Delivery address{% endtrans %}</h2>
                            </td>
                        </tr>
                        {% if isEmailTransport|default(false) %}
                            <tr>
                                <td>
                                    {% trans into orderLocale %}Delivered by email{% endtrans %}
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td>
                                    {{ order.deliveryFirstName }} {{ order.deliveryLastName }}
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    {{ order.deliveryCompanyName }}
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    {{ order.deliveryTelephone }}
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    {{ order.deliveryStreet }}, {{ order.deliveryCity }}, {{ order.deliveryPostcode }}
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    {{ order.country.name(orderLocale) }}
                                </td>
                            </tr>
                        {% endif %}
                    </tbody>
                </table>
            </td>
        </tr>
    </tbody>
</table>
