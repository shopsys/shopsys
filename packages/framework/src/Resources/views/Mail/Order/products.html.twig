{% trans_default_domain 'customerMessages' %}
{% import _self as self %}

<h2 style="font-size:20px; margin:24px 0 12px;">{% trans into orderLocale %}Order items{% endtrans %}</h2>
{% set nestedDiscountItemIds = [] %}
<table border="0" cellpadding="0" cellspacing="0" role="presentation" width="100%" style="border-bottom:1px solid #e5e5e5; margin-bottom:12px;">
    {% for orderItem in order.itemsSortedWithRelatedItems %}
        {% if not orderItem.isTypeAdditionalService and not orderItem.isTypeRounding and not orderItem.isTypeTransport and not orderItem.isTypePayment and orderItem.id not in nestedDiscountItemIds %}
            <tr>
                <td style="padding:16px 0; border-top:1px solid #e5e5e5;">
                    {% if orderItem.isTypeProductGift %}
                        {% set heading %}{% trans into orderLocale %}Gift with purchase{% endtrans %}{% endset %}
                        {{ self.sectionHeading(heading) }}
                    {% endif %}
                    {{ self.orderItemRow(orderItem, order, orderLocale, orderItemTotalPricesById, displayPrice) }}
                    {% set discountItems = orderItem.relatedItems|filter(relatedItem => (relatedItem.isTypeDiscount or relatedItem.isTypePromotion) and relatedItem.id not in nestedDiscountItemIds) %}
                    {% for discountItem in discountItems %}
                        {{ self.orderItemRow(discountItem, order, orderLocale, orderItemTotalPricesById, displayPrice) }}
                    {% endfor %}
                    {% set nestedDiscountItemIds = nestedDiscountItemIds|merge(discountItems|map(discountItem => discountItem.id)) %}
                    {% set additionalServiceItems = orderItem.relatedItems|filter(relatedItem => relatedItem.isTypeAdditionalService) %}
                    {% if additionalServiceItems|length > 0 %}
                        <table border="0" cellpadding="0" cellspacing="0" role="presentation" width="100%">
                            <tr>
                                <td class="additional-services" style="padding:16px 0 0 84px;">
                                    {% set heading %}{% trans into orderLocale %}Additional services{% endtrans %}{% endset %}
                                    {{ self.sectionHeading(heading) }}
                                    {% for relatedItem in additionalServiceItems %}
                                        {{ self.orderItemRow(relatedItem, order, orderLocale, orderItemTotalPricesById, displayPrice) }}
                                    {% endfor %}
                                </td>
                            </tr>
                        </table>
                    {% endif %}
                </td>
            </tr>
        {% endif %}
    {% endfor %}
</table>

{% macro orderItemRow(orderItem, order, orderLocale, orderItemTotalPricesById, displayPrice) %}
    {% set entity = null %}
    {% if orderItem.isTypeProduct %}
        {% set entity = orderItem.product %}
    {% elseif orderItem.isTypeProductGift %}
        {% set entity = orderItem.productGift %}
    {% elseif orderItem.isTypeAdditionalService %}
        {% set entity = orderItem.additionalService %}
    {% endif %}
    {% set displayBoth = displayPrice is same as(constant('Shopsys\\FrameworkBundle\\Model\\Mail\\MailDisplayPriceResolver::DISPLAY_PRICE_BOTH')) %}
    {% set displayWithoutVat = displayPrice is same as(constant('Shopsys\\FrameworkBundle\\Model\\Mail\\MailDisplayPriceResolver::DISPLAY_PRICE_WITHOUT_VAT')) or displayBoth %}
    {% set displayWithVat = displayPrice is same as(constant('Shopsys\\FrameworkBundle\\Model\\Mail\\MailDisplayPriceResolver::DISPLAY_PRICE_WITH_VAT')) or displayBoth %}
    {% set totalPrice = orderItemTotalPricesById[orderItem.id] %}
    {% set hasUnitPrice = orderItem.isTypeProduct or orderItem.isTypeProductGift or orderItem.isTypeAdditionalService %}
    <table border="0" cellpadding="0" cellspacing="0" role="presentation" width="100%">
        <tr>
            {% if hasUnitPrice %}
                <td width="{{ orderItem.isTypeAdditionalService ? 32 : 72 }}" valign="top" style="padding:0 12px 8px 0;">
                    {% if entity is not null %}
                        {{ image(entity, { width: orderItem.isTypeAdditionalService ? 24 : 60, style: 'display:block; height:auto;' }, order.domainId) }}
                    {% endif %}
                </td>
            {% endif %}
            <td valign="top" style="padding-bottom:8px;">
                <table border="0" cellpadding="0" cellspacing="0" role="presentation" width="100%">
                    <tr>
                        <td class="product-description" valign="top" style="font-size:14px; overflow-wrap:anywhere;">
                            <strong>{{ orderItem.name }}</strong>
                            {% if hasUnitPrice %}
                                <div style="color:#385483; font-size:13px; padding-top:4px;">
                                    {% if displayWithoutVat and not (displayBoth and orderItem.unitPriceWithoutVat.isZero) %}
                                        {{ orderItem.quantity|formatNumber(orderLocale) }} {{ orderItem.unitName }} × {{ orderItem.unitPriceWithoutVat|priceTextWithCurrencyByOrderAndLocale(order, orderLocale)|hidePrice(order.customerUser) }} / {{ orderItem.unitName }}
                                        {% if displayBoth %}{% trans into orderLocale %}ex VAT{% endtrans %}<br>{% endif %}
                                    {% endif %}
                                    {% if displayWithVat %}
                                        {{ orderItem.quantity|formatNumber(orderLocale) }} {{ orderItem.unitName }} × {{ orderItem.unitPriceWithVat|priceTextWithCurrencyByOrderAndLocale(order, orderLocale)|hidePrice(order.customerUser) }} / {{ orderItem.unitName }}
                                        {% if displayBoth %}{% trans into orderLocale %}inc VAT{% endtrans %}{% endif %}
                                    {% endif %}
                                </div>
                                {% if not orderItem.isTypeAdditionalService and orderItem.catnum %}
                                    <div style="color:#385483; font-size:12px; padding-top:2px;">{% trans into orderLocale %}Catalog number{% endtrans %}: {{ orderItem.catnum }}</div>
                                {% endif %}
                            {% endif %}
                        </td>
                        <td class="product-price" align="right" valign="top" style="padding-left:12px; font-size:14px; color:{{ orderItem.isTypeAdditionalService ? '#202139' : '#006bd6' }};">
                            {% if displayWithoutVat and not (displayBoth and totalPrice.priceWithVat.isZero) %}
                                <span style="white-space:nowrap; font-weight:{{ displayBoth ? 'normal' : 'bold' }};">{{ totalPrice.priceWithoutVat|priceTextWithCurrencyByOrderAndLocale(order, orderLocale)|hidePrice(order.customerUser) }}</span>
                                {% if displayBoth %}<span style="white-space:nowrap; font-size:12px;">{% trans into orderLocale %}ex VAT{% endtrans %}</span><br>{% endif %}
                            {% endif %}
                            {% if displayWithVat %}
                                <strong style="white-space:nowrap;">{{ totalPrice.priceWithVat|priceTextWithCurrencyByOrderAndLocale(order, orderLocale)|hidePrice(order.customerUser) }}</strong>
                                {% if displayBoth and not totalPrice.priceWithVat.isZero %}<span style="white-space:nowrap; font-size:12px;">{% trans into orderLocale %}inc VAT{% endtrans %}</span>{% endif %}
                            {% endif %}
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
{% endmacro %}

{% macro sectionHeading(label) %}
    <table border="0" cellpadding="0" cellspacing="0" role="presentation" style="margin-bottom:10px;">
        <tr>
            <td style="color:#385483; font-size:14px; font-weight:600;">{{ label }}</td>
        </tr>
    </table>
{% endmacro %}
