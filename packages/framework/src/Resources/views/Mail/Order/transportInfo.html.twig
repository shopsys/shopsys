{% trans_default_domain 'customerMessages' %}
<h2>{% trans into orderLocale %}Transport{% endtrans %}</h2>
<table border="0" cellpadding="0" cellspacing="0" role="presentation" width="100%">
    <tbody>
        <tr>
            <td style="width: 40px; padding-right: 15px;">
                {% if orderTransportItem.transport is not null %}
                    {{ imageForEmail(orderTransportItem.transport, { width: 40 }, order.domainId) }}
                {% endif %}
            </td>
            <td>
                <strong>{{ orderTransportItem.name }}</strong>
            </td>
            <td align="right">
                {% set doNotDisplayBoth = displayPrice is not same as(constant('Shopsys\\FrameworkBundle\\Model\\Mail\\MailDisplayPriceResolver::DISPLAY_PRICE_BOTH')) %}
                {% set displayBoth = displayPrice is same as(constant('Shopsys\\FrameworkBundle\\Model\\Mail\\MailDisplayPriceResolver::DISPLAY_PRICE_BOTH')) %}
                {% set displayWithoutVat = displayPrice is same as(constant('Shopsys\\FrameworkBundle\\Model\\Mail\\MailDisplayPriceResolver::DISPLAY_PRICE_WITHOUT_VAT')) or displayBoth %}
                {% set displayWithVat = displayPrice is same as(constant('Shopsys\\FrameworkBundle\\Model\\Mail\\MailDisplayPriceResolver::DISPLAY_PRICE_WITH_VAT')) or displayBoth %}
                {% set isZeroPrice = orderTransportTotalPrice.priceWithVat.isZero is same as(true) %}

                {% if displayWithoutVat %}
                    {% if not (displayBoth and isZeroPrice) %}
                        {% if doNotDisplayBoth %}
                            <strong style="white-space: nowrap; padding-left: 10px;">
                        {% endif %}

                        {{ orderTransportTotalPrice.priceWithoutVat|priceTextWithCurrencyByCurrencyIdAndLocale(order.currency.id, orderLocale)|hidePrice(order.customerUser) }}
                        {% if displayBoth %}
                            {{ 'ex VAT'|trans }}&nbsp;
                        {% endif %}

                        {% if doNotDisplayBoth %}
                            </strong>
                        {% endif %}
                    {% endif %}
                {% endif %}

                {% if displayBoth %}
                    <br>
                {% endif %}

                {% if displayWithVat %}
                    <strong style="white-space: nowrap; padding-left: 10px;">
                        {{ orderTransportTotalPrice.priceWithVat|priceTextWithCurrencyByCurrencyIdAndLocale(order.currency.id, orderLocale)|hidePrice(order.customerUser) }}
                        {% if displayBoth and not isZeroPrice %}
                            {{ 'inc VAT'|trans }}&nbsp;
                        {% endif %}
                    </strong>
                {% endif %}
            </td>
        </tr>
    </tbody>
</table>
