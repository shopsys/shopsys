{% trans_default_domain 'customerMessages' %}
<table  border="0" cellpadding="0" cellspacing="0" role="presentation" width="100%">
    <tbody>
        <tr>
            <td style="vertical-align:top;" width="60">
                <img src="{{ mailImageSrc(order.domainId, 'billing-address.png') }}" style="box-sizing: border-box; color: black; margin: 0; height: 35px;">
            </td>
            <td>
                <table border="0" cellpadding="0" cellspacing="0" role="presentation" width="100%">
                    <tbody>
                        <tr>
                            <td>
                                <h2 style="margin: 0 0 5px 0;">{% trans into orderLocale %}Billing address{% endtrans %}</h2>
                            </td>
                        </tr>
                        <tr>
                            <td>
                                {{ order.firstName }} {{ order.lastName }}
                            </td>
                        </tr>
                        <tr>
                            <td>
                                {{ order.companyName }}
                            </td>
                        </tr>
                        <tr>
                            <td>
                                {{ order.companyNumber }}
                            </td>
                        </tr>
                        <tr>
                            <td>
                                {{ order.companyTaxNumber }}
                            </td>
                        </tr>
                        <tr>
                            <td>
                                {{ order.telephone }}
                            </td>
                        </tr>
                        <tr>
                            <td>
                                {{ order.street }},  {{ order.city }},  {{ order.postcode }}
                            </td>
                        </tr>
                        <tr>
                            <td>
                                {{ order.country.name(orderLocale) }}
                            </td>
                        </tr>
                    </tbody>
                </table>
            </td>
        </tr>
    </tbody>
</table>
