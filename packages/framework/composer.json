{
    "name": "shopsys/framework",
    "type": "library",
    "description": "Core of Shopsys Platform - open source framework for building large, scalable, fast-growing e-commerce projects based on Symfony",
    "license": "proprietary",
    "autoload": {
        "psr-4": {
            "Shopsys\\FrameworkBundle\\": "src/",
            "Tests\\FrameworkBundle\\Test\\": "tests/Test/"
        },
        "files": [
            "src/Component/Filesystem/Flysystem/VolumeDriver.php",
            "src/Component/Doctrine/doctrine_annotations_polyfill.php",
            "src/Component/Translation/functions.php",
            "src/Component/VarDumper/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\FrameworkBundle\\": "tests/"
        }
    },
    "require": {
        "php": "^8.5",
        "ext-amqp": "*",
        "ext-bcmath": "*",
        "ext-calendar": "*",
        "ext-ctype": "*",
        "ext-curl": "*",
        "ext-dom": "*",
        "ext-fileinfo": "*",
        "ext-filter": "*",
        "ext-gd": "*",
        "ext-iconv": "*",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-pdo_pgsql": "*",
        "ext-redis": "*",
        "ext-xml": "*",
        "arvenil/ninja-mutex": "^0.6",
        "giggsey/libphonenumber-for-php": "^8.13",
        "barryvdh/elfinder-flysystem-driver": "^0.5",
        "becklyn/ordered-form-bundle": "^1.4",
        "brick/math": "^0.12",
        "commerceguys/intl": "^2.0.0",
        "composer/composer": "^2.2.12",
        "defuse/php-encryption": "^2.2.1",
        "doctrine/collections": "^2.6",
        "doctrine/data-fixtures": "^2.2",
        "doctrine/dbal": "^4.4",
        "doctrine/doctrine-bundle": "^3.2",
        "doctrine/doctrine-fixtures-bundle": "^4.3",
        "doctrine/orm": "^3.6",
        "doctrine/persistence": "^4.1",
        "dragonmantank/cron-expression": "^3.0",
        "elasticsearch/elasticsearch": "^7.6.1",
        "endroid/qr-code": "^6.0",
        "fakerphp/faker": "^1.19.0",
        "friendsofsymfony/ckeditor-bundle": "^2.1",
        "gopay/payments-sdk-php": "^1.7",
        "gedmo/doctrine-extensions": "^3.22",
        "guzzlehttp/guzzle": "^7.5",
        "helios-ag/fm-elfinder-bundle": "^13.0",
        "heureka/overeno-zakazniky": "^4.0.1",
        "jms/metadata": "^2.6.1",
        "jms/translation-bundle": "^2.2.1",
        "knplabs/knp-menu-bundle": "^3.5",
        "league/csv": "^9.6",
        "league/flysystem": "^3.11",
        "league/iso3166": "^4.2.1",
        "lorisleiva/cron-translator": "^0.5.0",
        "nette/utils": "^4.0",
        "nikic/php-parser": "^5.1",
        "phar-io/version": "^3.0",
        "phpdocumentor/reflection-docblock": "^5.3.0",
        "presta/sitemap-bundle": "^4.1",
        "prezent/doctrine-translatable": "^5.0",
        "prezent/doctrine-translatable-bundle": "^3.0",
        "psr/log": "^3.0",
        "ramsey/uuid": "^4.3.1",
        "roave/better-reflection": "^6.37",
        "sentry/sentry-symfony": "^5.0.1",
        "sentry/sentry": "^4.10.0",
        "scheb/2fa-bundle": "^8.6.0",
        "scheb/2fa-email": "^8.6.0",
        "scheb/2fa-google-authenticator": "^8.6.0",
        "shopsys/form-types-bundle": "20.0.x-dev",
        "shopsys/mcp-attributes": "20.0.x-dev",
        "shopsys/migrations": "20.0.x-dev",
        "shopsys/plugin-interface": "20.0.x-dev",
        "snc/redis-bundle": "^4.8.0",
        "spatie/holidays": "^1.23",
        "spatie/opening-hours": "^4.0",
        "stof/doctrine-extensions-bundle": "^1.15",
        "symfony/amqp-messenger": "^8.1",
        "symfony/intl": "^8.1",
        "symfony/clock": "^8.1",
        "symfony/css-selector": "^8.1",
        "symfony/doctrine-messenger": "^8.1",
        "symfony/dom-crawler": "^8.1",
        "symfony/error-handler": "^8.1",
        "symfony/event-dispatcher": "^8.1",
        "symfony/html-sanitizer": "^8.1",
        "symfony/http-client": "^8.1",
        "symfony/mailer": "^8.1",
        "symfony/messenger": "^8.1",
        "symfony/monolog-bundle": "^4.0",
        "symfony/property-info": "^8.1",
        "symfony/rate-limiter": "^8.1",
        "symfony/security-bundle": "^8.1",
        "symfony/security-core": "^8.1",
        "symfony/security-http": "^8.1",
        "symfony/serializer": "^8.1",
        "symfony/service-contracts": "^3.5",
        "symfony/ux-icons": "^2.22",
        "symfony/validator": "^8.1",
        "symfony/workflow": "^8.1",
        "symfony-cmf/routing": "^3.0.3",
        "symfony-cmf/routing-bundle": "^3.0.3",
        "symfony/polyfill-php80": "^1.24.0",
        "tracy/tracy": "^2.4.13",
        "twig/twig": "^3.14.0",
        "webmozart/assert": "^2.1"
    },
    "require-dev": {
        "php-mock/php-mock-phpunit": "^2.7",
        "phpstan/phpstan": "^2.1.16",
        "phpstan/phpstan-doctrine": "^2.0.3",
        "phpstan/phpstan-phpunit": "^2.0.6",
        "phpstan/phpstan-symfony": "^2.0.6",
        "phpunit/phpunit": "^12.5",
        "psr/event-dispatcher": "^1.0.0",
        "shopsys/biome-config": "20.0.x-dev",
        "shopsys/coding-standards": "20.0.x-dev",
        "sspooky13/yaml-standards": "^9.0",
        "symfony/maker-bundle": "^1.62",
        "symfony/process": "^8.1",
        "symfony/var-dumper": "^8.1",
        "symfony/yaml": "^8.1"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "symfony": {
            "require": "^8.1",
            "docker": false
        }
    },
    "suggest": {
        "ext-pgsql": "Required for dumping the Postgres database in shopsys:database:dump command"
    },
    "config": {
        "allow-plugins": {
            "symfony/flex": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
