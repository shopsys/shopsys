{
    "name": "shopsys/cli",
    "type": "project",
    "description": "Shopsys CLI - Command-line tool for configuring new Shopsys Platform projects",
    "license": "MIT",
    "bin": ["bin/shopsys"],
    "autoload": {
        "psr-4": {
            "Shopsys\\Cli\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Cli\\": "tests/"
        }
    },
    "require": {
        "php": "^8.3",
        "commerceguys/intl": "^2.0",
        "symfony/config": "^6.4",
        "symfony/console": "^6.4",
        "symfony/dependency-injection": "^6.4",
        "symfony/filesystem": "^6.4",
        "symfony/finder": "^6.4",
        "symfony/process": "^6.4",
        "symfony/yaml": "^6.4",
        "twig/twig": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.2",
        "phpstan/phpstan": "^2.1"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": false
        }
    }
}
