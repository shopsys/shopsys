parameters:
    treatPhpDocTypesAsCertain: false
    # inline ignores of shipmonk.* errors match only in the monorepo analysis where the dead code detector runs
    reportUnmatchedIgnoredErrors: false

    excludePaths:
        # Exclude template files for generating code via maker commands
        - %currentWorkingDirectory%/templates/*
includes:
    - vendor/phpstan/phpstan-doctrine/extension.neon
    - vendor/phpstan/phpstan-phpunit/extension.neon
    - vendor/phpstan/phpstan-symfony/extension.neon
    - vendor/phpstan/phpstan-symfony/rules.neon
    - vendor/shopsys/coding-standards/extension.neon
