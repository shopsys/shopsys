{
    "name": "shopsys-storefront",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "next lint",
        "lint--fix": "eslint '*/**/*.js' --fix",
        "format": "prettier --ignore-path .eslintignore --write '*/**/*.js'",
        "translate": "i18next 'pages/**/*.js' 'components/**/*.js' --config config/i18next-parser.config.js",
