{
    "name": "shopsys-storefront",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "eslint '*/**/*.{js,ts,tsx}'",
        "lint--fix": "eslint '*/**/*.{js,ts,tsx}' --fix",
        "format": "prettier --ignore-path .eslintignore --write '*/**/*.{js,ts,tsx}'",
        "translate": "i18next --config config/i18next-parser.config.js",
        "typecheck": "tsc --pretty --noEmit",
        "styleguide-server": "styleguidist server --config config/styleguide.config.js",
        "styleguide-build": "styleguidist build --config config/styleguide.config.js",
        "gql": "npm run gql:docs && npm run gql:codegen",
        "gql:codegen": "graphql-codegen --config codegen.yml",
        "gql:docs": "graphql-markdown schema.graphql > graphql/docs/schema.md",
        "tests-jest": "jest"
    },
    "dependencies": {
        "@babel/preset-react": "^7.14.5",
        "@graphql-codegen/cli": "^2.1.1",
        "@graphql-codegen/fragment-matcher": "^3.1.0",
        "@graphql-codegen/typescript-operations": "^2.1.2",
        "@graphql-codegen/typescript-urql": "^3.1.2",
        "@hookform/error-message": "^2.0.0",
        "@hookform/resolvers": "^2.6.1",
        "@reduxjs/toolkit": "^1.6.1",
        "@sentry/nextjs": "^6.15.0",
        "@types/styled-components": "^5.1.11",
        "@types/tinycolor2": "^1.4.3",
        "@urql/exchange-auth": "^0.1.6",
        "@urql/exchange-graphcache": "^4.3.5",
        "babel-loader": "^8.2.2",
        "google-map-react": "^2.1.10",
        "graphql": "^15.5.1",
        "graphql-codegen": "^0.4.0",
        "graphql-markdown": "^6.0.0",
        "i18next-intervalplural-postprocessor": "^3.0.0",
        "js-base64": "^3.7.2",
        "keen-slider": "^5.5.1",
        "next": "^11.0.0",
        "next-i18next": "^8.5.5",
        "next-redux-wrapper": "^7.0.5",
        "next-urql": "^3.1.0",
        "nookies": "^2.5.2",
        "react": "^17.0.2",
        "react-docgen-typescript": "^2.0.0",
        "react-dom": "^17.0.2",
        "react-hook-form": "^7.11.1",
        "react-is": "^17.0.2",
        "react-redux": "^7.2.4",
        "react-select": "^5.0.0",
        "react-tabs": "^3.2.2",
        "react-toastify": "^8.0.2",
        "react-transition-group": "^4.4.2",
        "simple-react-lightbox": "^3.6.7",
        "smoothscroll-polyfill": "^0.4.4",
        "styled-components": "^5.3.0",
        "styled-reset": "^4.3.4",
        "tinycolor2": "^1.4.2",
        "url-loader": "^4.1.1",
        "urql": "^2.0.4",
        "yup": "^0.32.9"
    },
    "devDependencies": {
        "@graphql-codegen/introspection": "^2.1.0",
        "@jest/globals": "^27.4.2",
        "@testing-library/react": "^12.1.2",
        "@types/google-map-react": "^2.1.3",
        "@types/prop-types": "^15.7.4",
        "@types/react": "^17.0.14",
        "@types/react-dom": "^17.0.11",
        "@types/react-tabs": "^2.3.3",
        "@types/react-test-renderer": "^17.0.1",
        "@types/react-transition-group": "^4.4.2",
        "@types/simple-react-lightbox": "^3.6.1",
        "@types/smoothscroll-polyfill": "^0.3.1",
        "@types/uuid": "^8.3.1",
        "@typescript-eslint/eslint-plugin": "^4.28.4",
        "@typescript-eslint/parser": "^4.28.4",
        "eslint": "^7.31.0",
        "eslint-config-next": "^11.0.0",
        "eslint-config-prettier": "^8.3.0",
        "eslint-plugin-prettier": "^3.4.0",
        "eslint-plugin-react": "^7.24.0",
        "eslint-plugin-unused-imports": "^1.1.2",
        "i18next-parser": "^5.0.0",
        "jest": "^27.4.2",
        "jest-styled-components": "^7.0.8",
        "prettier": "^2.3.2",
        "react-docgen": "^5.4.0",
        "react-styleguidist": "^11.1.7",
        "react-test-renderer": "^17.0.2",
        "typescript": "^4.3.5",
        "webpack": "^5.59.1"
    }
}
