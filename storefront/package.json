        "@typescript-eslint/parser": "^4.28.4",
        "eslint": "^7.31.0",
        "eslint-config-next": "11.0.0",
        "eslint-config-prettier": "^8.3.0",
        "eslint-plugin-prettier": "^3.4.0",
        "eslint-plugin-react": "^7.24.0",
        "eslint-plugin-unused-imports": "^1.1.2",
        "prettier": "^2.3.2",
        "react-docgen": "^5.4.0",
        "react-styleguidist": "^11.1.7",
        "typescript": "^4.3.5",
        "webpack": "^4.44.2"
    }
