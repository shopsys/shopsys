    "scripts": {
        "post-install-cmd": [
            "App\\Environment::checkEnvironment",
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "App\\Environment::checkEnvironment",
            "@auto-scripts"
        ],
        "security-check": "security-checker security:check",
        "auto-scripts": {
            "php project-base/app/app/downloadPhing.php": "script",
            "php phing clean": "script",
            "shopsys:domains-urls:configure": "symfony-cmd",
            "ckeditor:install --clear=skip --release=full --tag=4.22.1": "symfony-cmd",
            "composer security-check": "script"
        }
    },
    "config": {
        "preferred-install": "dist",
        "component-dir": "project-base/app/web/components",
        "sort-packages": true,
        "platform": {
            "php": "8.5.0"
        },
        "allow-plugins": {
            "cweagans/composer-patches": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "ocramius/package-versions": true,
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        }
    },
    "extra": {
        "bin-dir": "project-base/app/bin",
        "config-dir": "project-base/app/config",
        "src-dir": "project-base/app/src",
        "var-dir": "project-base/app/var",
        "public-dir": "project-base/app/web",
        "symfony": {
            "allow-contrib": true,
            "require": "^8.1",
            "docker": false
        },
        "runtime": {
            "dotenv_path": "project-base/app/.env"
        },
        "patches": {
            "enlightn/security-checker": {
                "Use Application::addCommand() because Application::add() was removed in Symfony 8": "project-base/app/patch/enlightn-security-checker-symfony8.patch"
            },
            "jms/translation-bundle": {
                "Load DI config via PHP files because Symfony 8 removed the XML configuration format": "project-base/app/patch/jms-translation-symfony8-php-config.patch"
            },
            "overblog/graphiql-bundle": {
                "Load DI config via PHP files because Symfony 8 removed the XML configuration format": "project-base/app/patch/overblog-graphiql-symfony8-php-config.patch"
            },
            "overblog/graphql-bundle": {
                "Remove kernel.reset tag from Executor to prevent schema clearing": "project-base/app/patch/overblog-executor-reset.patch",
                "Use customerValidators translation domain in InputValidator": "project-base/app/patch/overblog-validator.patch"
            },
            "prezent/doctrine-translatable-bundle": {
                "Load DI config via PHP files because Symfony 8 removed the XML configuration format": "project-base/app/patch/prezent-translatable-symfony8-php-config.patch"
            }
        }
    },
