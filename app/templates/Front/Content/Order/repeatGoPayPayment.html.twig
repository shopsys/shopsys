{% extends '/Front/Layout/layoutWithoutPanel.html.twig' %}

{% block meta_robots -%}
    <meta name="robots" content="noindex, follow">
{% endblock %}

{% block title %}
    {{ 'Opakovat platbu'|trans }}
{% endblock %}

{% block breadcrumb %}
{% endblock %}

{% block main_content %}
    <div class="web__line web__line--spacing web__line--spacing--big web__line--spacing--bottom-small">
        <div class="web__container">
            <div class="wrap-box wrap-box--v2 wrap-box--empty wrap-box--payment-reload">
                <h1 class="wrap-box__heading">
                    {{ 'Děkujeme za vaši objednávku.<br>Budete přesměrování na platební bránu.'|transHtml }}
                </h1>
                <span class="in-overlay__spinner__icon wrap-box__spinner">
                    <i class="svg svg-spinner"></i>
                </span>
            </div>
        </div>
    </div>

    {% if goPayData is defined and goPayData|length != 0 %}
        {% include '/Front/Inline/Payment/goPayPayment.html.twig' %}
    {% endif %}
{% endblock %}
