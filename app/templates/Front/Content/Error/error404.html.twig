{% extends 'Front/Content/Error/errorCommon.html.twig' %}

{% block error_content %}
    <div class="box-error-page__text">
        <h1 class="box-error-page__text__heading">{{ 'We have nothing to show you at this url.'|trans }}</h1>
        <p class="box-error-page__text__main">
            {{ 'But at other addresses we have a lot for you...'|trans }}
        </p>
    </div>
    <picture class="box-error-page__picture">
        <source media="(max-width: 599px)" srcset="{{ asset('public/frontend/images/404_m.png') }}">
        <source srcset="{{ asset('public/frontend/images/404_desktop_2x.jpg') }} 2x, {{ asset('public/frontend/images/404_desktop.jpg') }} 1x">
        <img
            loading="lazy"
            class="box-error-page__image"
            data-src="{{ asset('public/frontend/images/404_desktop.jpg') }} 1x"
            alt="{{ '404'|trans }}"
        >
    </picture>
{% endblock %}
