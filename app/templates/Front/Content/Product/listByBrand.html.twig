{% extends 'Front/Layout/layoutWithoutPanel.html.twig' %}
{% import 'Front/Inline/Paginator/paginator.html.twig' as paginator %}

{% set domain = getDomain() %}

{% block meta_robots %}
    {{ paginator.metaRobots(paginationResult, disableIndexingBySeznamBot) }}
{% endblock %}

{% block prev_next_links %}
    {% if paginationResult.previousPage is not null%}
        <link href="{{ url('front_brand_detail', { id: brand.id }) }}?page={{ paginationResult.previousPage }}" rel="prev">
    {% endif %}
    {% if paginationResult.nextPage is not null%}
        <link href="{{ url('front_brand_detail', { id: brand.id }) }}?page={{ paginationResult.nextPage }}" rel="next">
    {% endif %}
{% endblock %}

{% block title %}
    {{ seoTitle }}
{% endblock %}

{% block meta_description %}
    {{ brand.getSeoMetaDescription(domain.id)|default(getSeoMetaDescription()) }}
{% endblock %}

{% block main_content %}
    <div class="web__line">
        <div class="web__container">
            <h1>{{ seoH1 }}</h1>
            <div class="box-list__producer">
                {% if imageExists(brand) %}
                    <div class="box-list__producer__image">
                        {{ image(brand, { alt: brand.name }) }}
                    </div>
                {% endif %}
                <div class="box-list__producer__text">
                    {% if paginationResult.page == 1 and brand.description is not null %}
                        {{ brand.description|raw }}
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
    <div class="web__line">
        <div class="web__container">
            <div class="box-list box-list--brand-page js-product-list-with-filter">
                <div class="box-list__content box-list__content--without-gap">
                    <div class="js-product-list-ajax-filter-products-with-controls">
                        <div class="box-list__top js-product-sort">
                            <div class="box-list__top__wrap">
                                {{ render(controller('App\\Controller\\Front\\ProductController:selectOrderingModeForListByBrandAction')) }}
                                <div class="box-list__top__info">
                                    {% include 'Front/Content/Product/productSortCount.html.twig' with {paginationResult: paginationResult} %}
                                </div>
                            </div>
                        </div>
                        {% include 'Front/Content/Product/productsWithControls.html.twig' with {paginationResult: paginationResult, filterFormSubmitted: false } %}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
