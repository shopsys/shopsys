{% import 'Front/Content/Product/productListMacro.html.twig' as productList %}
{% import 'Front/Inline/Paginator/paginator.html.twig' as paginator %}

{% if paginationResult.results|length > 0 %}
    <div class="js-product-list-with-paginator">
        {% set entityName = 'products'|trans %}

        {{ productList.list(paginationResult.results, null, null, gtmList|default(null), nextIndex|default(1)) }}

        {% if paginationResult.pageCount > 1 %}
            <div class="list-pagination">
                <div class="list-pagination__button">
                    {{ paginator.loadMoreButton(paginationResult) }}
                </div>
                <div>
                    {{ paginator.paginatorNavigation(paginationResult, entityName) }}
                </div>
            </div>
        {% endif %}
    </div>
{% else %}
    <div class="box-list__content__message">
        {% if (filterFormSubmitted) %}
            <strong>{{ 'No results matching filter'|trans }}</strong>
            <p class="box-list__content__message__text">
                {{ 'Pro vaše přesné vyhledávání momentálně nemáme žádné výsledky.<br>
                Zkuste být více specifičtí, nebo se podívejte, jestli jste nevyfiltrovali neexistující údaje.'|transHtml }}
            </p>
        {% elseif searchText is defined %}
            <strong>{{ 'Search didn\'t find any products.'|trans }}</strong>
        {% elseif category is defined %}
            <strong>{{ 'This category contains no products.'|trans }}</strong>
            <p class="box-list__content__message__text">
                {{ 'Na jejím naplnění intenzivně pracujeme. Do té doby si můžete prohlédnout jiné kategorie plné doplňků a nábytku.'|trans }}
            </p>
            <a class="btn" href="{{ url('front_homepage') }}">{{ 'Zpět do e-shopu'|trans }}</a>
        {% else %}
            <strong>{{ 'No products found for this brand'|trans }}</strong>
        {% endif %}
    </div>
{% endif %}
