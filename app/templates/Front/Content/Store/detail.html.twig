{% extends 'Front/Layout/layoutWithoutPanel.html.twig' %}
{% import 'Front/Content/Store/storeAddressMacro.html.twig' as storeAddressMacro %}

{% block breadcrumb %}
{% endblock %}

{% block title %}
    {{- store.name -}}
{% endblock %}

{% block main_content %}
    <div class="web__line web__line--spacing">
        <div class="web__container">
            {{ render(controller('App\\Controller\\Front\\BreadcrumbController:indexAction', { routeName: getRoute(), routeParameters: getRouteParams() } )) }}
            <div class="box-stores box-stores--detail{{ imageExists(store, 'main') ? ' box-stores--detail-has-img' }}">
                <div class="box-stores__info box-stores__info--detail">
                    <h1 class="heading heading--primary heading--primary-subpage box-stores__heading">{{ store.name }}</h1>
                    <div class="box-stores__info__grid">
                        <div class="box-stores__info__grid__item">
                            <strong class="box-stores__store__subtitle box-stores__store__subtitle--detail">
                                {{ 'Store description'|trans }}
                            </strong>
                            {{ store.description|raw }}
                        </div>
                        <div class="box-stores__info__grid__item">
                            <strong class="box-stores__store__subtitle box-stores__store__subtitle--detail">
                                {{ 'Adresa obchodu'|trans }}
                            </strong>
                            {{ storeAddressMacro.storeAddress(store) }}
                        </div>
                        <div class="box-stores__info__grid__item">
                            <strong class="box-stores__store__subtitle box-stores__store__subtitle--detail">
                                {{ 'Otevírací doba'|trans }}
                            </strong>
                            <div class="box-stores__store__hours">
                                <div class="box-stores__store__hours__detail">{{ store.openingHours }}</div>
                            </div>
                        </div>
                        <div class="box-stores__info__grid__item">
                            <strong class="box-stores__store__subtitle box-stores__store__subtitle--detail">
                                {{ 'Kontakt na obchodní dům'|trans }}
                            </strong>
                            {{ store.contactInfo }}
                        </div>
                        <div class="box-stores__info__grid__item">
                            <strong class="box-stores__store__subtitle box-stores__store__subtitle--detail">
                                {{ 'Special message'|trans }}
                            </strong>
                            {{ store.specialMessage }}
                        </div>
                    </div>
                    <div class="box-stores__map box-stores__map--detail">
                        <div id="js-google-map-box" class="box-stores__map__google box-stores__map__google--detail"></div>
                        {% if imageExists(store) %}
                            {{ image(store, { itemprop: 'image', lazy:true}) }}
                        {% endif %}
                    </div>

                    <div class="box-stores-list">
                        <div class="box-stores-list__item box-stores-list__item--detail">
                            <a class="box-stores-list__item__link" href="{{ url('front_contacts') }}">
                                <i class="box-stores-list__item__icon box-stores-list__item__icon--detail svg svg-chat"></i>
                                <strong class="box-stores-list__item__name">{{ 'Máte další otázky?'|trans }}</strong>
                                <span class="box-stores-list__item__to-detail">
                                    <span class="box-stores-list__item__to-detail__text box-stores-list__item__to-detail__text--detail">
                                        {{ 'Zákaznické centrum'|trans }}
                                    </span>
                                    <i class="svg svg-arrow"></i>
                                </span>
                            </a>
                        </div>
                    </div>

                    {% set galleryImages = getImages(store, 'gallery') %}
                    {% if galleryImages is not empty %}
                        <div class="box-stores__gallery dont-print js-gallery">
                            <div class="box-stores__gallery__wrap">
                                {% for galleryImage in galleryImages %}
                                    <div class="box-stores__gallery__item js-gallery-item">
                                        <a
                                            data-fancybox="products-gallery"
                                            href="{{ imageUrl(galleryImage, 'original') }}"
                                            class="box-stores__ballery__item__link">
                                            {{ image(galleryImage, { itemprop: 'image', lazy: true, type: 'gallery' }) }}
                                        </a>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts_bottom %}
    {{ parent() }}
    <script type="text/javascript">
        var markersData = [];

        {% if store.locationLatitude is not null and store.locationLongitude is not null  %}
            markersData.push({locations: {lat: {{ store.locationLatitude }}, lng: {{ store.locationLongitude }} }, data: {id: '{{ store.id }}' }});
        {% endif %}
    </script>
    <script src="https://maps.googleapis.com/maps/api/js?key={{ googleMapApiKey }}"></script>
{% endblock %}
