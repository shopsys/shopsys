{% if readyCategorySeoMixes|length > 0 %}
    <div class="box-list__section">
        <ul class="list-categories-seo">
            {% for readyCategorySeoMix in readyCategorySeoMixes %}
                <li class="list-categories-seo__item">
                    <a href="{{ url('front_category_seo', { id: readyCategorySeoMix.id }) }}"
                        class="btn btn--small {{ readyCategorySeoMix.id == selectedReadyCategorySeoMixId ? 'btn--secondary' : '' }} js-category-seo-mix js-category-seo-mix-{{ readyCategorySeoMix.id }}"
                    >
                        {{ readyCategorySeoMix.h1 }}
                    </a>
                </li>
            {% endfor %}
        </ul>
    </div>
{% endif %}
