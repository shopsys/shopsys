{% block roles_widget -%}
<div {{ block('widget_container_attributes') }} class="form-line__side">
    {% for name, choices in form.vars.choices %}
        {% if choices is iterable  %}
            <div class="form-choice-list roles-row">
                {% if choices|length == 1 %}
                    <div class="form-choice-list__item roles-column"></div>
                {% endif %}

                {% for key,choice in choices %}
                    <div class="form-choice-list__item roles-column">
                        {{ form_widget(form[key]) }}
                        {{ form_label(form[key]) }}
                    </div>
                {% endfor %}
            </div>
        {% else %}
            {{- form_widget(form[name]) -}}
            {{- form_label(form[name], null, {translation_domain: choice_translation_domain}) -}}
        {% endif %}
    {% endfor %}
{%- endblock roles_widget %}