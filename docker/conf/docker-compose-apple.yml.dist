services:
    postgres:
        build:
            context: app
            dockerfile: app/docker/postgres/Dockerfile.apple
        container_name: postgres
        volumes:
            - postgres-data:/var/lib/postgresql/data
        environment:
            PGDATA: /var/lib/postgresql/data/pgdata
            POSTGRES_USER: root
            POSTGRES_PASSWORD: root
            POSTGRES_DB: shopsys
        platform: linux/arm64
        dns_search: shopsys

    webserver:
        build:
            context: app
            dockerfile: app/docker/nginx/Dockerfile.apple
        container_name: webserver
        depends_on:
            - php-fpm
            - storefront
        volumes:
            - /private/var/www/globus/app:/var/www/html
        ports:
            - "8000:8080"
        platform: linux/arm64
        dns_search: shopsys

    storefront:
        restart: always
        image: node:20-alpine3.17
        container_name: storefront
        working_dir: /home/node/app
        volumes:
            - /private/var/www/globus/storefront:/home/node/app
        ports:
            - "3000:3000"
        environment:
            APP_ENV: development
            NEXT_TELEMETRY_DISABLED: 1
            NEXT_PUBLIC_GRAPHQL_ENDPOINT: http://webserver:8080/graphql/
        command: ["/bin/sh", "-c", "corepack enable && corepack prepare --activate pnpm@9.0.5 && pnpm install && pnpm run dev"]
        platform: linux/arm64
        dns_search: shopsys

        #    storefront-cypress:
        #        restart: always
        #        build:
        #            context: ./storefront
        #            dockerfile: docker/dev.Dockerfile
        #            target: development
        #            args:
        #                node_uid: 1000
        #        container_name: shopsys-framework-storefront-cypress
        #        command:
        #            - build
        #        volumes:
        #            - storefront:/home/node/app
        #        healthcheck:
        #            test: ["CMD-SHELL", "wget --no-verbose --tries=1 --spider http://localhost:3000/api/health || exit 1"]
        #            start_period: 30s
        #            interval: 30s
        #            timeout: 10s
        #            retries: 5
        #        profiles:
        #            - storefront-acceptance-tests
        #        ports:
        #            - "3001:3000"  # Changed from 3000 to avoid conflict

        #    cypress:
        #        build:
        #            context: ./storefront/cypress
        #            dockerfile: docker/Dockerfile
        #        container_name: shopsys-framework-cypress
        #        volumes:
        #            - ./storefront/cypress:/app
        #            - ./storefront/config:/app/config
        #            - ./storefront/pages:/app/pages
        #            - node_modules:/app/node_modules
        #        profiles:
        #            - storefront-acceptance-tests
        #        # Removed network_mode: "host" for better compatibility
        #
    php-fpm:
        build:
            context: app
            dockerfile: app/docker/php-fpm/Dockerfile.apple
            target: development
            args:
                www_data_uid: 1000
                www_data_gid: 1000
                project_root: /private/var/www/globus/app
        container_name: php-fpm
        deploy:
            resources:
                limits:
                    cpus: 8
                    memory: 9000M
        volumes:
            - /private/var/www/globus/app:/var/www/html
        ports:
            - "35729:35729"
            - "9000:9000"
        depends_on:
            - postgres
            - redis
        platform: linux/arm64
        dns_search: shopsys

    php-consumer:
        restart: always
        build:
            context: app
            dockerfile: app/docker/php-fpm/Dockerfile.apple
            target: development
            args:
                www_data_uid: 1000
                www_data_gid: 1000
                project_root: /private/var/www/globus/app
        depends_on:
            - php-fpm
            - rabbitmq
        container_name: php-consumer
        working_dir: /var/www/html
        volumes:
            - /private/var/www/globus/app:/var/www/html
        entrypoint: ["/bin/sh", "/var/www/html/docker/php-fpm/consumer-entrypoint.sh"]
        platform: linux/arm64
        dns_search: shopsys

    rabbitmq:
        image: rabbitmq:3.12-management-alpine
        container_name: rabbitmq
        ports:
            - "15672:15672"
        platform: linux/arm64
        dns_search: shopsys

    redis:
        image: redis:7.4-alpine
        container_name: redis
        platform: linux/arm64
        dns_search: shopsys
        #
        #    redis-commander:
        #        container_name: shopsys-framework-redis-commander
        #        image: ghcr.io/joeferner/redis-commander:latest
        #        restart: always
        #        environment:
        #            REDIS_HOSTS: redis
        #        ports:
        #            - "1600:8081"
        #        depends_on:
        #            - redis

        #    selenium-server:
        #        image: seleniarm/standalone-firefox:4.9.0
        #        container_name: shopsys-framework-acceptance-tests
        #        ports:
        #            - "4400:4444"
        #            - "5900:5900"
        #            - "7900:7900"
        #        environment:
        #            HUB_PORT_4444_TCP_ADDR: hub
        #            HUB_PORT_4444_TCP_PORT: 4444
        #        shm_size: '2GB'

        #    adminer:
        #        image: adminer:latest
        #        container_name: shopsys-framework-adminer
        #        ports:
        #            - "1100:8080"
        #        environment:
        #            ADMINER_DEFAULT_SERVER: postgres
        #        depends_on:
        #            - postgres

        #    smtp-server:
        #        image: ixdotai/smtp:latest
        #        container_name: shopsys-framework-smtp-server

    elasticsearch:
        build:
            context: app
            dockerfile: app/docker/elasticsearch/Dockerfile
        container_name: elasticsearch
        ports:
            - "9200:9200"
        volumes:
            - elasticsearch-data:/usr/share/elasticsearch/data
        environment:
            discovery.type: single-node
            ES_JAVA_OPTS: "-Xms1g -Xmx1g"
        deploy:
            resources:
                limits:
                    memory: 2048M
                    cpus: 3
        platform: linux/arm64
        dns_search: shopsys

