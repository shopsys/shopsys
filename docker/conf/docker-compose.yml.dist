x-variables:
    blackfire_environments: &blackfire_environments
        BLACKFIRE_SERVER_ID:
        BLACKFIRE_SERVER_TOKEN:
        BLACKFIRE_CLIENT_ID:
        BLACKFIRE_CLIENT_TOKEN:

services:
    # Uncomment the following lines and fill values in x-variables section to enable Blackfire
    #blackfire:
    #    image: blackfire/blackfire:2
    #    ports: ["8307"]
    #    environment:
    #        <<: *blackfire_environments

    postgres:
        image: postgres:18-alpine
        container_name: shopsys-framework-postgres
        volumes:
            - ./project-base/app/docker/postgres/postgres.conf:/etc/postgresql/postgresql.conf
            - ./project-base/app/var/postgres-data:/var/lib/postgresql
        environment:
            - POSTGRES_USER=root
            - POSTGRES_PASSWORD=root
            - POSTGRES_DB=shopsys
        command:
            - postgres
            - -c
            - config_file=/etc/postgresql/postgresql.conf

    webserver:
        image: nginx:1.29-alpine
        container_name: shopsys-framework-webserver
        depends_on:
            - php-fpm
            - storefront
        volumes:
            - ./project-base/app/web:/var/www/html/project-base/app/web
            - ./project-base/docker/nginx/nginx.conf:/etc/nginx/templates/default.conf.template
            - ./project-base/docker/nginx/12-set-env-variables.envsh:/docker-entrypoint.d/12-set-env-variables.envsh:delegated
        ports:
            - "8000:8080"

    storefront:
        restart: always
        build:
            context: ./project-base/storefront
            dockerfile: ./docker/dev.Dockerfile
            target: development
            args:
                node_uid: 1000
        container_name: shopsys-framework-storefront
        environment:
            # toggled by `make environment-dev` / `make environment-prod`; recreate the container to apply (dev = dev server, build = production build)
            - STOREFRONT_RUN_COMMAND=dev
        volumes:
            - ./project-base/storefront:/home/node/app
        ports:
            - "3000:3000"
            - "9229:9229"
            - "9230:9230"

    storefront-cypress:
        restart: always
        build:
            context: ./project-base/storefront
            dockerfile: ./docker/dev.Dockerfile
            target: development
            args:
                node_uid: 1000
        container_name: shopsys-framework-storefront-cypress
        command:
            - build
        environment:
            - CYPRESS_KEEP_TID=1
        volumes:
            - ./project-base/storefront:/home/node/app
        healthcheck:
            test: wget --no-verbose --tries=1 --spider http://localhost:3000/api/health || exit 1
            start_period: 30s
            interval: 30s
            timeout: 10s
            retries: 5
        profiles:
            - storefront-acceptance-tests
        ports:
            - "3000:3000"

    cypress:
        build:
            context: ./project-base/storefront/cypress
            dockerfile: ./docker/Dockerfile
        container_name: shopsys-framework-cypress
        volumes:
            - ./project-base/storefront/cypress:/app:delegated
            - ./project-base/storefront/config:/app/config
            - ./project-base/storefront/pages:/app/pages
            - ./project-base/storefront/public/locales:/app/public/locales:delegated
            - ./project-base/app/translations:/app/app-translations:delegated
            - node_modules:/app/node_modules
        profiles:
            - storefront-acceptance-tests
        network_mode: "host"

    php-fpm:
        build:
            context: .
            dockerfile: project-base/app/docker/php-fpm/Dockerfile
            target: development
            args:
                www_data_uid: 1000
                www_data_gid: 1000
                project_root: project-base/app
        container_name: shopsys-framework-php-fpm
        volumes:
            - ~/.gitconfig:/home/www-data/.gitconfig
            - .:/var/www/html
        environment:
            <<: *blackfire_environments
            LOCAL_PATH_TO_PROJECT_ROOT: /var/www/html
        ports:
            - "35729:35729"

    php-consumer:
        restart: always
        build:
            context: .
            dockerfile: project-base/app/docker/php-fpm/Dockerfile
            target: development
            args:
                www_data_uid: 1000
                www_data_gid: 1000
                project_root: project-base/app
        depends_on:
            - php-fpm
            - rabbitmq
        container_name: shopsys-framework-php-consumer
        volumes:
            - .:/var/www/html
        entrypoint:
            - /bin/sh
            - project-base/app/docker/php-fpm/consumer-entrypoint.sh

    rabbitmq:
        image: rabbitmq:4.1-management-alpine
        container_name: shopsys-framework-rabbitmq
        ports:
            - "15672:15672"

    redis:
        image: redis:7.4-alpine
        container_name: shopsys-framework-redis

    redis-commander:
        container_name: shopsys-framework-redis-commander
        image: ghcr.io/joeferner/redis-commander:latest
        restart: always
        environment:
            - REDIS_HOSTS=redis
        ports:
            - "1600:8081"

    adminer:
        image: adminer:latest
        container_name: shopsys-framework-adminer
        ports:
            - "1100:8080"
        environment:
            ADMINER_DEFAULT_SERVER: postgres

    smtp-server:
        image: maildev/maildev:latest
        container_name: shopsys-framework-smtp-server
        command: ["--auto-relay"]
        ports:
            - "1080:1080"
            - "1025:1025"
        # To forward outgoing mail to real recipients, uncomment the block below.
        # See FAQ for setup: https://docs.shopsys.com/en/latest/introduction/faq-and-common-issues/#how-do-i-deliver-emails-to-real-recipients-from-my-local-environment
        # environment:
        #     MAILDEV_OUTGOING_HOST: smtp.gmail.com
        #     MAILDEV_OUTGOING_PORT: 465
        #     MAILDEV_OUTGOING_SECURE: "true"
        #     MAILDEV_OUTGOING_USER: your-address@gmail.com
        #     MAILDEV_OUTGOING_PASS: ${MAILDEV_OUTGOING_PASS:-}

    elasticsearch:
        build:
            context: .
            dockerfile: project-base/app/docker/elasticsearch/Dockerfile
        container_name: shopsys-framework-elasticsearch
        ulimits:
            nofile:
                soft: 65536
                hard: 65536
        ports:
            - "9200:9200"
        volumes:
            - elasticsearch-data:/usr/share/elasticsearch/data
        environment:
            - discovery.type=single-node
            - bootstrap.memory_lock=true
            - "ES_JAVA_OPTS=-Xms1g -Xmx1g"
        deploy:
            resources:
                limits:
                    memory: 2G

    kibana:
        image: docker.elastic.co/kibana/kibana:7.17.2
        container_name: shopsys-framework-kibana
        depends_on:
            - elasticsearch
        ports:
            - "5601:5601"

    mkdocs:
        build:
            context: .
            dockerfile: docker/mkdocs/Dockerfile
        ports:
            - "1300:8000"
        volumes:
            - .:/var/www/html

    img-proxy:
        image: ghcr.io/imgproxy/imgproxy:latest
        container_name: shopsys-framework-img-proxy
        environment:
            IMGPROXY_AUTO_WEBP: true
            IMGPROXY_ENFORCE_WEBP: true
        ports:
            - "8060:8080"

volumes:
    elasticsearch-data:
        driver: local
    node_modules:
