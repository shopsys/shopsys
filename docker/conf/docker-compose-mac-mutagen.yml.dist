version: "3.7"

x-variables:
    common_build_args: &common_build_args
        www_data_uid: 501
        www_data_gid: 20

services:
    postgres:
        image: postgres:12.1-alpine
        container_name: shopsys-framework-postgres
        volumes:
            - ./app/docker/postgres/postgres.conf:/var/lib/postgresql/data/postgresql.conf:delegated
            - ./app/var/postgres-data:/var/lib/postgresql/data:cached
        environment:
            - PGDATA=/var/lib/postgresql/data/pgdata
            - POSTGRES_USER=root
            - POSTGRES_PASSWORD=root
            - POSTGRES_DB=shopsys
        command:
            - postgres
            - -c
            - config_file=/var/lib/postgresql/data/postgresql.conf

    webserver:
        image: nginx:1.13-alpine
        container_name: shopsys-framework-webserver
        depends_on:
            - php-fpm
            - storefront
        volumes:
            - ./app/web:/var/www/html/web:cached
            - ./docker/nginx/nginx.conf:/etc/nginx/conf.d/default.conf:delegated
        ports:
            - "8000:8080"

    storefront:
        restart: always
        build:
            context: ./storefront
            dockerfile: ./docker/Dockerfile
            target: development
            args:
                <<: *common_build_args
        container_name: shopsys-framework-storefront
        volumes:
            - storefront:/app
            - ./schema.graphql:/app/schema.graphql
        ports:
            - "3000:3000"

    storefront-styleguide:
        build:
            context: ./storefront
            dockerfile: ./docker/styleguide/Dockerfile
            target: development
        container_name: shopsys-framework-storefront-styleguide
        depends_on:
            - storefront
        volumes:
            - storefront:/app
        ports:
            - "6060:6060"

    cypress:
        build:
            context: ./storefront
            dockerfile: ./cypress/docker/Dockerfile
        container_name: shopsys-framework-cypress
        volumes:
            - ./storefront/cypress:/app:delegated
        profiles:
            - storefront-acceptance-tests

    php-fpm:
        build:
            context: ./app
            dockerfile: docker/php-fpm/Dockerfile
            target: development
            args:
                <<: *common_build_args
        container_name: shopsys-framework-php-fpm
        volumes:
            - source-code:/var/www/html
            - ./.npm-global:/var/www/html/.npm-global
            - ./schema.graphql:/var/www/html/schema.graphql
        ports:
            - "35729:35729"

    redis:
        image: redis:5.0-alpine
        container_name: shopsys-framework-redis

    redis-admin:
        image: erikdubbelboer/phpredisadmin:v1.10.2
        container_name: shopsys-framework-redis-admin
        environment:
            - REDIS_1_HOST=redis
        ports:
            - "1600:80"

    selenium-server:
        image: selenium/standalone-chrome-debug:3.141.5
        container_name: shopsys-framework-acceptance-tests
        ports:
            - "4400:4444"
            - "5900:5900"
        environment:
            - HUB_PORT_4444_TCP_ADDR=hub
            - HUB_PORT_4444_TCP_PORT=4444

    adminer:
        image: adminer:4.7.6
        container_name: shopsys-framework-adminer
        ports:
            - "1100:8080"

    smtp-server:
        image: namshi/smtp:latest
        container_name: shopsys-framework-smtp-server

    elasticsearch:
        build:
            context: ./app
            dockerfile: docker/elasticsearch/Dockerfile
        container_name: shopsys-framework-elasticsearch
        ulimits:
            nofile:
                soft: 65536
                hard: 65536
        ports:
            - "9200:9200"
        volumes:
            - ./app/var/elasticsearch-data:/usr/share/elasticsearch/data:cached
        environment:
            - discovery.type=single-node
            - cluster.routing.allocation.disk.watermark.flood_stage=0.99

    kibana:
        image: docker.elastic.co/kibana/kibana-oss:7.6.0
        container_name: shopsys-framework-kibana
        depends_on:
            - elasticsearch
        ports:
            - "5602:5601"

volumes:
    source-code:
    storefront:

x-mutagen:
    sync:
        defaults:
            ignore:
                vcs: true
            permissions:
                defaultOwner: "id:501"
        source-code:
            alpha: "./app"
            beta: "volume://source-code"
            mode: "two-way-resolved"
            configurationBeta:
                permissions:
                    defaultOwner: "id:501"
                    defaultDirectoryMode: 0777
            ignore:
                paths:
                    - ./.DS_Store
                    - ./.idea
                    - ./.npm-global
                    - ./nbproject
                    - ./storefront
                    - ./app/var/elasticsearch-data
                    - ./app/var/postgres-data
        storefront:
            alpha: "./storefront"
            beta: "volume://storefront"
            mode: "two-way-resolved"
            configurationBeta:
                permissions:
                    defaultOwner: "id:501"
                    defaultDirectoryMode: 0777
