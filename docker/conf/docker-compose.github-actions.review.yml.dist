services:
    postgres:
        restart: always
        image: postgres:18-alpine
        volumes:
            - postgres-conf:/var/lib/postgresql/conf
        environment:
            - POSTGRES_USER=root
            - POSTGRES_PASSWORD=root
            - POSTGRES_DB=shopsys
        command:
            - postgres
            - -c
            - config_file=/var/lib/postgresql/conf/postgres.conf
        networks:
            - default
        labels:
            - traefik.enable=false
        healthcheck:
            test: ["CMD", "pg_isready"]
            start_period: 10s
            interval: 10s
            timeout: 10s
            retries: 15

    webserver:
        restart: always
        image: nginx:1.29-alpine
        depends_on:
            - php-fpm
        volumes:
            - web-volume:/var/www/html/project-base/app/web
            - ./nginx.conf:/etc/nginx/templates/default.conf.template
            - ./12-set-env-variables.envsh:/docker-entrypoint.d/12-set-env-variables.envsh
        labels:
            - traefik.backend=${BRANCH_NAME_ESCAPED}
            - traefik.http.routers.${BRANCH_NAME_ESCAPED}.rule=${TRAEFIK_HOSTS}
            - traefik.http.routers.${BRANCH_NAME_ESCAPED}.entrypoints=http,https
            - traefik.http.routers.${BRANCH_NAME_ESCAPED}.tls.certresolver=letsencrypt
            - traefik.http.services.${BRANCH_NAME_ESCAPED}.loadbalancer.server.port=8080
            - traefik.docker.network=github-runner_traefik-network
            - traefik.enable=true
        networks:
            - default
            - github-runner_traefik-network
        deploy:
            resources:
                limits:
                    memory: 200M

    php-fpm:
        restart: always
        image: php-fpm-image
        volumes:
            - web-volume:/var/www/html/project-base/app/web
            - postgres-conf:/var/www/html/project-base/app/docker/postgres
            - ./ci-www.conf:/usr/local/etc/php-fpm.d/www.conf
        depends_on:
            - postgres
        environment:
            IGNORE_DEFAULT_ADMIN_PASSWORD_CHECK: 1
            FORCE_ELASTIC_LIMITS: true
            GOPAY_CONFIG: "${GOPAY_CONFIG_VALUE}"
            PACKETERY_API_KEY: "${PACKETERY_API_KEY_VALUE}"
            PACKETERY_API_PASSWORD: "${PACKETERY_API_PASSWORD_VALUE}"
            SENTRY_DSN: "${SENTRY_DSN_VALUE}"
            SENTRY_ENVIRONMENT: "${SENTRY_ENVIRONMENT_VALUE}"
            SENTRY_RELEASE: "${SENTRY_RELEASE_VALUE}"
            SENTRY_CRON_MONITORING_ENABLED: 0
            FACEBOOK_CLIENT_ID: "${FACEBOOK_CLIENTID}"
            FACEBOOK_CLIENT_SECRET: "${FACEBOOK_CLIENTSECRET}"
            GOOGLE_CLIENT_ID: "${GOOGLE_CLIENTID}"
            GOOGLE_CLIENT_SECRET: "${GOOGLE_CLIENTSECRET}"
            SEZNAM_CLIENT_ID: "${SEZNAM_CLIENTID}"
            SEZNAM_CLIENT_SECRET: "${SEZNAM_CLIENTSECRET}"
            GOOGLE_MAP_API_KEY: "${GOOGLE_MAP_API_KEY}"
            MCP_DATABASE_USER: shopsys_mcp
            MCP_DATABASE_PASSWORD: shopsys_mcp
        networks:
            - default
        labels:
            - traefik.enable=false
            - chadburn.enabled=true
            - chadburn.job-exec.${BRANCH_NAME_ESCAPED}-cron.schedule=@every 1m
            - chadburn.job-exec.${BRANCH_NAME_ESCAPED}-cron.command=php bin/console shopsys:cron --scheduled-only
            - chadburn.job-exec.${BRANCH_NAME_ESCAPED}-cron.no-overlap=true
            - chadburn.job-exec.${BRANCH_NAME_ESCAPED}-cron.user=www-data
            - chadburn.job-exec.${BRANCH_NAME_ESCAPED}-cron.tty=true
        deploy:
            resources:
                limits:
                    memory: 1G

    php-consumer:
        restart: always
        image: php-fpm-image
        volumes:
            - web-volume:/var/www/html/project-base/app/web
        depends_on:
            - php-fpm
            - rabbitmq
        environment:
            IGNORE_DEFAULT_ADMIN_PASSWORD_CHECK: 1
            FORCE_ELASTIC_LIMITS: true
            GOPAY_CONFIG: "${GOPAY_CONFIG_VALUE}"
            PACKETERY_API_KEY: "${PACKETERY_API_KEY_VALUE}"
            PACKETERY_API_PASSWORD: "${PACKETERY_API_PASSWORD_VALUE}"
            SENTRY_DSN: "${SENTRY_DSN_VALUE}"
            SENTRY_ENVIRONMENT: "${SENTRY_ENVIRONMENT_VALUE}"
            SENTRY_RELEASE: "${SENTRY_RELEASE_VALUE}"
            FACEBOOK_CLIENT_ID: "${FACEBOOK_CLIENTID}"
            FACEBOOK_CLIENT_SECRET: "${FACEBOOK_CLIENTSECRET}"
            GOOGLE_CLIENT_ID: "${GOOGLE_CLIENTID}"
            GOOGLE_CLIENT_SECRET: "${GOOGLE_CLIENTSECRET}"
            GOOGLE_MAP_API_KEY : "${GOOGLE_MAP_API_KEY}"
            SEZNAM_CLIENT_ID: "${SEZNAM_CLIENTID}"
            SEZNAM_CLIENT_SECRET: "${SEZNAM_CLIENTSECRET}"
        networks:
            - default
        entrypoint:
            - /bin/sh
            - -c
            - sleep 5 && project-base/app/docker/php-fpm/consumer-entrypoint.sh 600
        labels:
            - traefik.enable=false
        deploy:
            resources:
                limits:
                    memory: 400M

    rabbitmq:
        image: rabbitmq:4.1-management-alpine
        ports:
            - "15672:15672"

    storefront:
        restart: always
        image: storefront-image
        environment:
            PACKETERY_API_KEY: "${PACKETERY_API_KEY_VALUE}"
            GOOGLE_MAP_API_KEY: "${GOOGLE_MAP_API_KEY_VALUE}"
            GTM_ID: "${GTM_ID_VALUE}"
            SENTRY_DSN: "${SENTRY_DSN_VALUE}"
            SENTRY_ENVIRONMENT: "${SENTRY_ENVIRONMENT_VALUE}"
        networks:
            - default
        labels:
            - traefik.enable=false
        deploy:
            resources:
                limits:
                    memory: 500M

    redis:
        image: redis:7.4-alpine
        networks:
            - default
        labels:
            - traefik.enable=false

    gotenberg:
        image: gotenberg/gotenberg:8
        command:
            - gotenberg
            - --chromium-deny-private-ips
            - --api-download-from-deny-private-ips
        networks:
            - default
        labels:
            - traefik.enable=false

    smtp-server:
        image: boky/postfix:latest
        environment:
            ALLOWED_SENDER_DOMAINS: ${ALLOWED_SENDER_DOMAINS:-shopsys.com}
        networks:
            - default
        labels:
            - traefik.enable=false

    elasticsearch:
        image: elasticsearch-image
        ulimits:
            nofile:
                soft: 65536
                hard: 65536
        environment:
            - discovery.type=single-node
            - "ES_JAVA_OPTS=-Xms512m -Xmx512m"
        deploy:
            resources:
                limits:
                    memory: 1G
        networks:
            - default
        labels:
            - traefik.enable=false

    img-proxy:
        image: ghcr.io/imgproxy/imgproxy:latest
        environment:
            IMGPROXY_AUTO_WEBP: true
            IMGPROXY_ENFORCE_WEBP: true

volumes:
    web-volume:
    postgres-conf:

networks:
    github-runner_traefik-network:
        external: true
    default:
